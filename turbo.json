{
  "$schema": "https://turborepo.com/schema.json",
  "futureFlags": {
    "experimentalTaskCommand": true
  },
  "globalDependencies": [
    "pnpm-workspace.yaml",
    ".nvmrc"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "NODE_OPTIONS",
    "MISSION_REPO_ROOT",
    "MISSION_MCP_PROFILE",
    "SSR",
    "STORYBOOK_FRAMEWORK",
    "AUDIT_PORT",
    "AUDIT_WORKERS",
    "SONARLINT_LS_JAR",
    "SONARLINT_ANALYZERS",
    "SONARLINT_JAVA"
  ],
  "globalPassThroughEnv": [
    "FORGE_BUILD_STAGE_ROOT",
    "FORGE_CMS_ARTIFACT_MODE",
    "FORGE_CMS_STORYBLOK_TARGET",
    "FORGE_FRAMEWORK_TARGET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "build:forge",
        "build:react",
        "build:vue",
        "build:svelte",
        "build:solid",
        "build:web-components",
        "build:cms-storyblok:assets"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/**",
        ".vite/**"
      ]
    },
    "build:check": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ]
    },
    "build:forge": {
      "dependsOn": [
        "^build:forge",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/components/**",
        "dist/styles/**",
        "dist/sprite/**",
        "dist/*.d.ts",
        "dist/*.js"
      ]
    },
    "build:react": {
      "dependsOn": [
        "^build:react",
        "build:forge"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/react/**"
      ]
    },
    "build:vue": {
      "dependsOn": [
        "^build:vue",
        "build:forge"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/vue/**"
      ]
    },
    "build:svelte": {
      "dependsOn": [
        "^build:svelte",
        "build:forge"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/svelte/**"
      ]
    },
    "build:solid": {
      "dependsOn": [
        "^build:solid",
        "build:forge"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/solid/**"
      ]
    },
    "build:web-components": {
      "dependsOn": [
        "^build:web-components",
        "build:forge"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/web-components/**"
      ]
    },
    "build:cms-storyblok:assets": {
      "dependsOn": [
        "build:forge",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": [
        "dist/cms/**"
      ]
    },
    "bench": {
      "cache": false,
      "env": [
        "FORGE_BENCH_RUN",
        "FORGE_BENCH_IMPLEMENTATION",
        "FORGE_BENCH_OUTPUT",
        "FORGE_BENCH_COMMAND"
      ]
    },
    "docs:generate": {
      "dependsOn": [
        "@mission-platform/flint#build"
      ],
      "inputs": [
        "$TURBO_ROOT$/scripts/extract-package-docs.ts",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/extensions/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reference/generated/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/**/docs/reference/generated/**",
        "$TURBO_ROOT$/extensions/**/docs/reference/generated/**"
      ]
    },
    "validate:locales": {
      "inputs": [
        "$TURBO_ROOT$/scripts/validate-doc-locales.ts",
        "$TURBO_ROOT$/scripts/doc-locales-lib.ts",
        "$TURBO_ROOT$/scripts/documentation-sources.ts",
        "$TURBO_ROOT$/scripts/doc-locales-backlog.json",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/packages/**/docs/**",
        "$TURBO_ROOT$/extensions/**/docs/**"
      ]
    },
    "validate:exports": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_ROOT$/scripts/validate-package-exports.mjs",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/packages/**/dist/**"
      ]
    },
    "validate:component-properties": {
      "inputs": [
        "$TURBO_ROOT$/scripts/validate-component-property-declarations.ts",
        "$TURBO_ROOT$/packages/**/*.scss"
      ]
    },
    "validate:inventory": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/.artifacts/runtime-validation/**"
      ]
    },
    "validate:framework": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/storybook/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/.artifacts/runtime-validation/**"
      ]
    },
    "validate:app": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/.artifacts/runtime-validation/**"
      ]
    },
    "validate:target": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/storybook/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/.artifacts/runtime-validation/**"
      ]
    },
    "validate:runtime": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/.artifacts/runtime-validation/**"
      ],
      "cache": false
    },
    "visual:parity": {
      "inputs": [
        "$TURBO_ROOT$/scripts/visual-parity/**",
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/storybook/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/.artifacts/visual-parity/**"
      ],
      "cache": false
    },
    "test:runtime-validation": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/scripts/**/*.spec.ts",
        "$TURBO_ROOT$/packages/ui/components/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ]
    },
    "test:watch": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "transit"
      ],
      "cache": false
    },
    "lint:style": {},
    "lint:style:fix": {
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ],
      "cache": false
    },
    "deploy:staging": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID"
      ],
      "cache": false
    },
    "build-storybook": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "STORYBOOK_FRAMEWORK",
        "STORYBOOK_VITE_CACHE_DIR"
      ],
      "outputs": [
        "storybook-static/**"
      ]
    },
    "i18n:extract": {
      "outputs": [
        "locales/**"
      ]
    }
  }
}
