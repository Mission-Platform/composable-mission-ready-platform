{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "futureFlags": {
    "experimentalTaskCommand": true
  },
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".nvmrc",
    "tsconfig*.json",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/config.toml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "SSR",
    "MISSION_REPO_ROOT",
    "NODE_OPTIONS",
    "STORYBOOK_FRAMEWORK",
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/**",
        ".vite/**"
      ]
    },
    "build:check": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": []
    },
    "build:neutral": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/**",
        "!dist/vue/**",
        "!dist/react/**",
        "!dist/solid/**",
        "!dist/web-components/**",
        "!dist/storyblok/**",
        "!dist/**/*.d.ts",
        "!dist/**/*.d.ts.map"
      ]
    },
    "build:bundle": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/**",
        "!dist/**/*.d.ts",
        "!dist/**/*.d.ts.map"
      ]
    },
    "build:solid": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/solid/**"
      ]
    },
    "build:svelte": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/svelte/**"
      ]
    },
    "build:web-components": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/web-components/**"
      ]
    },
    "build:storyblok-vue": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/storyblok/vue/**",
        "dist/storyblok/*.json"
      ]
    },
    "build:storyblok-react": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/storyblok/react/**"
      ]
    },
    "build:watch": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "with": [
        "@mission-platform/components#build:watch"
      ],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "storybook-react": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ]
    },
    "test:watch": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:wasm": {
      "dependsOn": [
        "^build"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "transit"
      ],
      "cache": false
    },
    "lint:style": {},
    "lint:style:fix": {
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "deploy": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "i18n:extract": {
      "dependsOn": [
        "^i18n:extract"
      ],
      "outputs": [
        "locales/*.yaml",
        "i18n-meta.json"
      ]
    },
    "i18n:types": {
      "dependsOn": [
        "i18n:extract",
        "^i18n:types"
      ],
      "outputs": [
        "src/locales/types.d.ts",
        "src/locales/resources.d.ts"
      ]
    },
    "i18n:lint": {
      "dependsOn": [
        "i18n:extract"
      ]
    }
  }
}
