{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "futureFlags": {
    "experimentalTaskCommand": true
  },
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".nvmrc",
    "tsconfig*.json",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/config.toml"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "SSR",
    "MISSION_REPO_ROOT",
    "NODE_OPTIONS",
    "STORYBOOK_FRAMEWORK",
    "FORGE_FRAMEWORK_TARGET",
    "FORGE_CMS_STORYBLOK_TARGET",
    "FORGE_CMS_ARTIFACT_MODE",
    "FORGE_BENCH_RUN",
    "FORGE_BENCH_IMPLEMENTATION",
    "FORGE_BENCH_OUTPUT",
    "FORGE_BENCH_COMMAND",
    "FORGE_BUILD_STAGE_ROOT",
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "FORGE_BUILD_TARGET",
        "FORGE_FRAMEWORK_TARGET",
        "FORGE_CMS_STORYBLOK_TARGET",
        "FORGE_CMS_ARTIFACT_MODE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**", ".vite/**"]
    },
    "build:check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": []
    },
    "build:neutral": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/**",
        "!dist/vue/**",
        "!dist/react/**",
        "!dist/solid/**",
        "!dist/web-components/**",
        "!dist/cms/**",
        "!dist/**/*.d.ts",
        "!dist/**/*.d.ts.map"
      ]
    },
    "build:bundle": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/**", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map"]
    },
    "build:forge": {
      "dependsOn": ["^build"],
      "env": [
        "FORGE_BUILD_TARGET",
        "FORGE_FRAMEWORK_TARGET",
        "FORGE_CMS_STORYBLOK_TARGET",
        "FORGE_CMS_ARTIFACT_MODE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:react": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-forge.ts", "$TURBO_ROOT$/scripts/forge-build.ts", "!**/dist/**", "!**/node_modules/.cache/forge-build/**", "!**/.forge-promotion-*/**"],
      "outputs": ["dist/**"]
    },
    "build:vue": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-forge.ts", "$TURBO_ROOT$/scripts/forge-build.ts", "!**/dist/**", "!**/node_modules/.cache/forge-build/**", "!**/.forge-promotion-*/**"],
      "outputs": ["dist/**"]
    },
    "build:svelte": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-forge.ts", "$TURBO_ROOT$/scripts/forge-build.ts", "!**/dist/**", "!**/node_modules/.cache/forge-build/**", "!**/.forge-promotion-*/**"],
      "outputs": ["dist/**"]
    },
    "build:solid": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-forge.ts", "$TURBO_ROOT$/scripts/forge-build.ts", "!**/dist/**", "!**/node_modules/.cache/forge-build/**", "!**/.forge-promotion-*/**"],
      "outputs": ["dist/**"]
    },
    "build:web-components": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/build-forge.ts", "$TURBO_ROOT$/scripts/forge-build.ts", "!**/dist/**", "!**/node_modules/.cache/forge-build/**", "!**/.forge-promotion-*/**"],
      "outputs": ["dist/**"]
    },
    "build:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "bench": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["@mission-platform/components#build:watch"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "storybook-react": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:wasm": {
      "dependsOn": ["^build"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "lint:style": {},
    "lint:style:fix": {
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "i18n:extract": {
      "outputs": ["locales/**"]
    }
  }
}
