{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "futureFlags": {
    "experimentalTaskCommand": true
  },
  "globalDependencies": [
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    ".nvmrc",
    "tsconfig*.json",
    "Cargo.toml",
    "Cargo.lock",
    ".cargo/config.toml"
  ],
  "globalEnv": ["NODE_ENV", "CI", "SSR", "MISSION_REPO_ROOT", "NODE_OPTIONS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/**", ".vite/**"]
    },
    "build:check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": []
    },
    "build:neutral": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/**",
        "!dist/vue/**",
        "!dist/react/**",
        "!dist/solid/**",
        "!dist/svelte/**",
        "!dist/web-components/**",
        "!dist/storyblok/**",
        "!dist/**/*.d.ts",
        "!dist/**/*.d.ts.map"
      ]
    },
    "build:bundle": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/**", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map"]
    },
    "build:vue": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/vue/**"]
    },
    "build:react": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/react/**"]
    },
    "build:solid": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/solid/**"]
    },
    "build:svelte": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/svelte/**"]
    },
    "build:web-components": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/web-components/**"]
    },
    "build:storyblok-vue": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/storyblok/vue/**", "dist/storyblok/*.json"]
    },
    "build:storyblok-react": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/storyblok/react/**"]
    },
    "build:types": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": [
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map",
        "!dist/vue/**",
        "!dist/react/**",
        "!dist/solid/**",
        "!dist/svelte/**",
        "!dist/web-components/**",
        "!dist/storyblok/**"
      ]
    },
    "build:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "storybook-react": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "build:wasm:encode": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["src/generated/encode/**", "$TURBO_ROOT$/target/**"]
    },
    "build:wasm:decode": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["src/generated/decode/**", "$TURBO_ROOT$/target/**"]
    },
    "build:wasm:scan": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["src/generated/scan/**", "$TURBO_ROOT$/target/**"]
    },
    "test:wasm": {
      "dependsOn": ["^build"]
    },
    "test:wasm:encode": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["$TURBO_ROOT$/target/**"]
    },
    "test:wasm:decode": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["$TURBO_ROOT$/target/**"]
    },
    "test:wasm:scan": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/**"
      ],
      "outputs": ["$TURBO_ROOT$/target/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "lint:style": {},
    "lint:style:fix": {
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    },
    "i18n:extract": {
      "dependsOn": ["^i18n:extract"],
      "outputs": ["locales/*.yaml", "i18n-meta.json"]
    },
    "i18n:types": {
      "dependsOn": ["i18n:extract", "^i18n:types"],
      "outputs": ["src/locales/types.d.ts", "src/locales/resources.d.ts"]
    },
    "i18n:lint": {
      "dependsOn": ["i18n:extract"]
    }
  }
}
