{
  "$schema": "https://turborepo.com/schema.json",
  "concurrency": "3",
  "futureFlags": {
    "experimentalTaskCommand": true
  },
  "globalDependencies": ["pnpm-workspace.yaml", ".nvmrc"],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "NODE_OPTIONS",
    "MISSION_REPO_ROOT",
    "MISSION_MCP_PROFILE",
    "SSR",
    "STORYBOOK_FRAMEWORK",
    "AUDIT_PORT",
    "AUDIT_WORKERS",
    "SONARLINT_LS_JAR",
    "SONARLINT_ANALYZERS",
    "SONARLINT_JAVA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**", ".vite/**"]
    },
    "build:check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ]
    },
    "build:bundle": {
      "dependsOn": ["^build"],
      "env": [
        "FORGE_BUILD_TARGET",
        "FORGE_FRAMEWORK_TARGET",
        "FORGE_CMS_STORYBLOK_TARGET",
        "FORGE_CMS_ARTIFACT_MODE",
        "FORGE_BUILD_STAGE_ROOT"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**"
      ],
      "outputs": ["dist/**", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map"]
    },
    "build:types": {
      "dependsOn": ["^build"],
      "env": [
        "FORGE_BUILD_TARGET",
        "FORGE_FRAMEWORK_TARGET",
        "FORGE_CMS_STORYBLOK_TARGET",
        "FORGE_CMS_ARTIFACT_MODE",
        "FORGE_BUILD_STAGE_ROOT"
      ],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    },
    "build:generate": {
      "dependsOn": ["^build"],
      "env": [
        "FORGE_BUILD_TARGET",
        "FORGE_FRAMEWORK_TARGET",
        "FORGE_CMS_STORYBLOK_TARGET",
        "FORGE_CMS_ARTIFACT_MODE",
        "FORGE_BUILD_STAGE_ROOT"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:forge": {
      "dependsOn": ["^build"],
      "env": [
        "FORGE_BUILD_TARGET",
        "FORGE_FRAMEWORK_TARGET",
        "FORGE_CMS_STORYBLOK_TARGET",
        "FORGE_CMS_ARTIFACT_MODE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/*.md",
        "!**/dist/**",
        "!**/storybook-static/**",
        "!**/.vite/**",
        "!**/coverage/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:react": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:vue": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:svelte": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:solid": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:web-components": {
      "dependsOn": ["^build"],
      "env": ["FORGE_BUILD_TARGET", "FORGE_FRAMEWORK_TARGET"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/build-forge.ts",
        "$TURBO_ROOT$/scripts/forge-build.ts",
        "!**/dist/**",
        "!**/node_modules/.cache/forge-build/**",
        "!**/.forge-promotion-*/**"
      ],
      "outputs": ["dist/**"]
    },
    "build:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "bench": {
      "cache": false,
      "env": [
        "FORGE_BENCH_RUN",
        "FORGE_BENCH_IMPLEMENTATION",
        "FORGE_BENCH_OUTPUT",
        "FORGE_BENCH_COMMAND"
      ]
    },
    "docs:generate": {
      "dependsOn": ["@mission-platform/flint#build"],
      "inputs": [
        "$TURBO_ROOT$/scripts/extract-package-docs.ts",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/extensions/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/reference/generated/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/**/docs/reference/generated/**",
        "$TURBO_ROOT$/extensions/**/docs/reference/generated/**"
      ]
    },
    "validate:exports": {
      "inputs": [
        "$TURBO_ROOT$/scripts/validate-package-exports.mjs",
        "$TURBO_ROOT$/packages/**/package.json",
        "$TURBO_ROOT$/packages/**/dist/**"
      ]
    },
    "validate:component-properties": {
      "inputs": [
        "$TURBO_ROOT$/scripts/validate-component-property-declarations.ts",
        "$TURBO_ROOT$/packages/**/*.scss"
      ]
    },
    "validate:inventory": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": ["$TURBO_ROOT$/.artifacts/runtime-validation/**"]
    },
    "validate:framework": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/storybook/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": ["$TURBO_ROOT$/.artifacts/runtime-validation/**"]
    },
    "validate:app": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": ["$TURBO_ROOT$/.artifacts/runtime-validation/**"]
    },
    "validate:target": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/storybook/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": ["$TURBO_ROOT$/.artifacts/runtime-validation/**"]
    },
    "validate:runtime": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": ["$TURBO_ROOT$/.artifacts/runtime-validation/**"],
      "cache": false
    },
    "visual:parity": {
      "inputs": [
        "$TURBO_ROOT$/scripts/visual-parity/**",
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/apps/storybook/**",
        "$TURBO_ROOT$/packages/**"
      ],
      "outputs": ["$TURBO_ROOT$/.artifacts/visual-parity/**"],
      "cache": false
    },
    "test:runtime-validation": {
      "inputs": [
        "$TURBO_ROOT$/scripts/runtime-validation/**",
        "$TURBO_ROOT$/scripts/**/*.spec.ts",
        "$TURBO_ROOT$/packages/ui/components/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "with": ["@mission-platform/components#build:watch"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["build", "^build"],
      "outputs": ["coverage/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "dependsOn": ["transit"],
      "cache": false
    },
    "lint:style": {},
    "lint:style:fix": {
      "cache": false
    },
    "format": {},
    "format:write": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build"],
      "env": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
      "cache": false
    },
    "deploy:staging": {
      "dependsOn": ["build"],
      "env": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"],
      "cache": false
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "env": ["STORYBOOK_FRAMEWORK", "STORYBOOK_VITE_CACHE_DIR"],
      "outputs": ["storybook-static/**"]
    },
    "i18n:extract": {
      "outputs": ["locales/**"]
    }
  }
}
