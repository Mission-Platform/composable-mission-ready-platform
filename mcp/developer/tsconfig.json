{
  "extends": "@mission-platform/typescript-config/node",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"],
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../shared/**/*.ts", "*.config.ts", "*.config.js", "*.config.mjs"]
}
