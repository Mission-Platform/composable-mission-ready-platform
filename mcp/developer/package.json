{
  "name": "@mission-platform/mcp-developer",
  "private": true,
  "version": "0.1.4",
  "license": "BSD-4-Clause",
  "description": "DEVELOPER MCP: Model Context Protocol server that helps AI assistants use the Mission Platform monorepo: component usage, and package/app/worker creation and development. (Compatibility note: previously @mission-platform/mcp)",
  "type": "module",
  "bin": {
    "mission-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-force-exit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@commitlint/lint": "^21.2.2",
    "@commitlint/load": "^21.2.2",
    "@mission-platform/flint": "workspace:*",
    "@mission-platform/flint-runtime": "workspace:*",
    "@mission-platform/flint-wasm": "workspace:*",
    "@mission-platform/mcp-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:mcp",
    "axe-core": "catalog:testing",
    "playwright": "catalog:testing",
    "zod": "catalog:mcp"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript"
  }
}
