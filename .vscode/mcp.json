{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "a11y-accessibility": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "a11y-mcp-server"
      ],
      "tools": [
        "*"
      ]
    },
    "mission-platform": {
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp/dist/index.js"
      ],
      "tools": [
        "*"
      ]
    },
    "DeepWiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp",
      "tools": [
        "*"
      ]
    },
    "playwright-test": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server"
      ],
      "tools": [
        "*"
      ]
    },
    "agent-lsp": {
      "type": "stdio",
      "command": "agent-lsp",
      "args": [
        "--config",
        "agent-lsp.json"
      ]
    }
  },
  "inputs": []
}
