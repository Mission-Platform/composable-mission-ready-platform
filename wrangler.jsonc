{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mission-platform",
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "my-care-notes": {
      "observability": {
        "enabled": true,
        "traces": {
          "enabled": true,
          "persist": false
        },
        "logs": {
          "enabled": true,
          "persist": false,
          "invocation_logs": true
        }
      },
      "name": "my-care-notes",
      "main": "./workers/base-spa/dist/index.js",
      "workers_dev": false,
      "preview_urls": true,
      "build": {
        "watch_dir": [
          "./components/**/src/*",
          "./apps/my-care-notes/src/*",
          "./workers/base-spa/src/*"
        ],
        "cwd": ".",
        "command": "pnpm build:config && pnpm build:workers && pnpm build:dependencies && pnpm run --filter @mission-platform/my-care-notes build"
      },
      "assets": {
        "not_found_handling": "single-page-application",
        "directory": "./apps/my-care-notes/dist/",
        "binding": "ASSETS",
        "run_worker_first": [
          "/*",
          "!/assets/*",
          "!/favicon.svg",
          "!/manifest.webmanifest",
          "!/pwa-192x192.png",
          "!/pwa-512x512.png",
          "!/registerSW.js",
          "!/sw.js",
          "!/workbox-dcde9eb3.js"
        ]
      },
      "routes": [
        {
          "zone_name": "mission-platform.com",
          "pattern": "care-notes.mission-platform.com",
          "custom_domain": true
        },
        {
          "pattern": "*-care-notes.mission-platform.dev",
          "custom_domain": true,
          "previews_enabled": true
        }
      ]
    }
  }
}
