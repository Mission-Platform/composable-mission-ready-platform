{
  "extends": "@mission-platform/typescript-config/react",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "@cloudflare/workers-types/experimental"],
    "customConditions": ["mp:react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "worker-configuration.d.ts"]
}
