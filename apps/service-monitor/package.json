{
  "name": "@mission-platform/service-monitor",
  "private": true,
  "version": "0.0.3",
  "license": "BSD-4-Clause",
  "type": "module",
  "description": "Server-side service monitoring app built with RedwoodSDK on Cloudflare, backed by a Durable Object SQLite time-series store, with a React + RxJS live dashboard.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "types": "wrangler types",
    "test": "vitest run",
    "i18n:extract": "i18next-cli extract --config i18next.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{scss,css}\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.{scss,css}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/breakpoints": "workspace:*",
    "@mission-platform/components": "workspace:*",
    "@mission-platform/d3": "workspace:*",
    "@mission-platform/forms": "workspace:*",
    "@mission-platform/float": "workspace:*",
    "@mission-platform/i18n": "workspace:*",
    "@mission-platform/icons": "workspace:*",
    "@mission-platform/layouts": "workspace:*",
    "@mission-platform/rxjs": "workspace:*",
    "@mission-platform/seo": "workspace:*",
    "@mission-platform/select": "workspace:*",
    "@mission-platform/theme": "workspace:*",
    "@mission-platform/typography": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "capnweb": "catalog:",
    "d3": "catalog:d3",
    "i18next": "catalog:i18next",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-i18next": "catalog:i18next",
    "react-server-dom-webpack": "catalog:react",
    "rwsdk": "catalog:cloudflare",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/i18n-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-i18n": "workspace:*",
    "@mission-platform/vite-plugin-token-overrides": "workspace:*",
    "@types/d3": "catalog:d3",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "eslint": "catalog:eslint",
    "i18next-cli": "1.68.0",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "wrangler": "catalog:cloudflare"
  }
}
