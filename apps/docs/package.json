{
  "name": "@mission-platform/docs",
  "private": true,
  "version": "0.0.2",
  "description": "Framework-free Web Components documentation site for the Mission Platform.",
  "type": "module",
  "scripts": {
    "prebuild": "node --experimental-strip-types ../../scripts/extract-package-docs.ts --all",
    "predev": "pnpm exec turbo run build --filter @mission-platform/docs^...",
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/prerender.ts && node --experimental-strip-types scripts/check-build.ts",
    "build:spa": "tsc -b && vite build",
    "build:check": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.{vue,scss,css}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/components": "workspace:*",
    "@mission-platform/content": "workspace:*",
    "@mission-platform/forms": "workspace:*",
    "@mission-platform/forge-router-web-components": "workspace:*",
    "@mission-platform/i18n": "workspace:*",
    "@mission-platform/layouts": "workspace:*",
    "@mission-platform/router": "workspace:*",
    "@mission-platform/seo": "workspace:*",
    "@mission-platform/select": "workspace:*",
    "@mission-platform/theme": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "highlight.js": "catalog:code",
    "marked": "catalog:code",
    "mermaid": "catalog:code"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-seo": "workspace:*",
    "@types/node": "catalog:typescript",
    "eslint": "catalog:eslint",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "sass-embedded": "catalog:vite",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing"
  }
}
