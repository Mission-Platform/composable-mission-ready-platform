{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "docs",
  // Deliberately aligned with the other application Workers; changing this
  // pin requires compatibility validation before altering runtime behavior.
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {
    "cwd": "../../",
    "watch_dir": ["./packages/**/src/*", "./apps/docs/src/**", "./docs/**"],
    "command": "pnpm exec turbo run build --filter=@mission-platform/docs"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./dist/"
  }
}
