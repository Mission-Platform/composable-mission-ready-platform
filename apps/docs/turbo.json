{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build:web-components",
        "^build:forge",
        "@mission-platform/scripts#docs:generate",
        "build:check",
        "build:bundle",
        "build:prerender",
        "build:verify"
      ],
      "env": ["VITE_*"],
      "outputs": ["dist/**", ".vite/**"]
    },
    "build:bundle": {
      "dependsOn": ["build:check"],
      "env": ["VITE_*"],
      "outputs": ["dist/**", ".vite/**"]
    },
    "build:prerender": {
      "dependsOn": ["build:bundle"],
      "outputs": ["dist/**"]
    },
    "build:verify": {
      "dependsOn": ["build:prerender"]
    },
    "build:check": {
      "dependsOn": ["^build:web-components", "^build:forge"]
    },
    "dev": {
      "dependsOn": ["^build:web-components", "^build:forge"],
      "cache": false,
      "persistent": true
    }
  }
}
