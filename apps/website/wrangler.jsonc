{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "website",
  // Deliberately aligned with the other application Workers; changing this
  // pin requires compatibility validation before altering runtime behavior.
  "compatibility_date": "2026-06-07",
  "compatibility_flags": ["nodejs_compat"],
  "main": "../../workers/forge-spa/dist/index.js",
  "first_party_worker": true,
  "dev": {
    "generate_types": true,
    "local_protocol": "https",
    "upstream_protocol": "https"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "persist": false
    },
    "logs": {
      "enabled": true,
      "persist": false,
      "invocation_logs": true
    }
  },
  "build": {
    "cwd": "../../",
    "watch_dir": [
      "./packages/**/src/*",
      "./packages/*-wasm/src/**",
      "./packages/**/src/wasm/**",
      "./crates/**",
      "./apps/website/src/*",
      "./workers/forge-spa/src/*"
    ],
    "command": "export PATH=\"$HOME/.cargo/bin:$PATH\" && if ! command -v rustup >/dev/null 2>&1; then curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal; fi && if [ -f \"$HOME/.cargo/env\" ]; then . \"$HOME/.cargo/env\"; fi && export PATH=\"$HOME/.cargo/bin:$PATH\" && if ! rustup run stable rustc --version >/dev/null 2>&1; then rustup toolchain install stable --profile minimal --no-self-update; fi && rustup target add wasm32-unknown-unknown --toolchain stable && export RUSTUP_TOOLCHAIN=stable && pnpm exec turbo run build --filter=@mission-platform/website --filter=@mission-platform/forge-spa",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./dist/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/manifest.webmanifest",
      "!/pwa-192x192.png",
      "!/pwa-512x512.png",
      "!/registerSW.js",
      "!/sw.js",
      "!/workbox-*.js"
    ]
  },
  "env": {
    "production": {
      "name": "website",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "zone_name": "mission-platform.com",
          "pattern": "mission-platform.com",
          "custom_domain": true
        }
      ]
    },
    "staging": {
      "name": "website-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "zone_name": "mission-platform.dev",
          "pattern": "staging.mission-platform.dev",
          "custom_domain": true
        }
      ]
    }
  }
}
