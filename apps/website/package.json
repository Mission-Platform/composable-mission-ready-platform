{
  "name": "@mission-platform/website",
  "private": true,
  "version": "0.0.10",
  "license": "BSD-4-Clause",
  "description": "Mission Platform public documentation and product website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite-ssg build",
    "build:spa": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "cf:dev": "wrangler dev --env staging",
    "cf:dev:production": "wrangler dev --env production",
    "version": "wrangler versions upload --env production",
    "version:staging": "wrangler versions upload --env staging",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "i18n:extract": "i18next-cli extract --config i18next.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.{vue,scss,css}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/breakpoints": "workspace:*",
    "@mission-platform/components": "workspace:*",
    "@mission-platform/content": "workspace:*",
    "@mission-platform/forge-adapters": "workspace:*",
    "@mission-platform/forge-jsx": "workspace:*",
    "@mission-platform/forms": "workspace:*",
    "@mission-platform/hunspell": "workspace:*",
    "@mission-platform/i18n": "workspace:*",
    "@mission-platform/icons": "workspace:*",
    "@mission-platform/layouts": "workspace:*",
    "@mission-platform/qr-code": "workspace:*",
    "@mission-platform/select": "workspace:*",
    "@mission-platform/seo": "workspace:*",
    "@mission-platform/theme": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "@mission-platform/typography": "workspace:*",
    "i18next": "catalog:i18next",
    "i18next-vue": "catalog:i18next",
    "js-yaml": "catalog:",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/i18n-config": "workspace:*",
    "@mission-platform/postcss-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-i18n": "workspace:*",
    "@mission-platform/vite-plugin-seo": "workspace:*",
    "@playwright/test": "catalog:testing",
    "@types/js-yaml": "catalog:typescript",
    "@types/node": "catalog:typescript",
    "@vitejs/plugin-vue": "catalog:vue",
    "beasties": "^0.4.3",
    "eslint": "catalog:eslint",
    "i18next-cli": "1.68.0",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "sass-embedded": "catalog:vite",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:vite",
    "vite-ssg": "catalog:vite",
    "vitest": "catalog:testing",
    "vue-tsc": "catalog:vue",
    "wrangler": "catalog:cloudflare"
  }
}
