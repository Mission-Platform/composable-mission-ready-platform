{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build:vue", "^build:forge"],
      "env": ["VITE_*"],
      "outputs": ["dist/**", ".output/**", ".vite/**", "public/sitemap.xml", "public/robots.txt"]
    },
    "build:spa": {
      "dependsOn": ["^build:vue", "^build:forge"],
      "env": ["VITE_*"],
      "outputs": ["dist/**", ".output/**", ".vite/**", "public/sitemap.xml", "public/robots.txt"]
    },
    "test:e2e": {
      "env": ["PLAYWRIGHT_BASE_URL"]
    },
    "deploy": {
      "dependsOn": ["build", "@mission-platform/forge-spa#build"],
      "cache": false
    },
    "deploy:staging": {
      "dependsOn": ["build", "@mission-platform/forge-spa#build"],
      "cache": false
    },
    "version": {
      "dependsOn": ["build", "@mission-platform/forge-spa#build"],
      "cache": false
    },
    "version:staging": {
      "dependsOn": ["build", "@mission-platform/forge-spa#build"],
      "cache": false
    }
  }
}
