// Byte-buffer dataset scan/reduction (divide-and-conquer).

export fn scan_bytes(data: bytes, lo: i32, hi: i32, threshold: i32) -> i32 {
  if lo >= hi {
    return 0;
  }
  if lo + 1 == hi {
    let b: i32 = bytes_byte_at(data, lo);
    if b >= threshold {
      return b + 1;
    }
    return 0;
  }
  let mid: i32 = lo + hi;
  let half: i32 = mid / 2;
  return scan_bytes(data, lo, half, threshold) + scan_bytes(data, half, hi, threshold);
}

export fn dataset_scan(data: bytes, threshold: i32) -> i32 {
  return scan_bytes(data, 0, bytes_length(data), threshold);
}
