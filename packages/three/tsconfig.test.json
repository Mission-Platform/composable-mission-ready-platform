{
  "extends": "@mission-platform/typescript-config/base",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["node", "vitest/globals", "@mission-platform/typescript-config/client", "@mission-platform/forge"],
    "jsx": "react-jsx",
    "jsxImportSource": "@mission-platform/forge"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.stories.tsx"]
}
