// QR locator: dense-bounds fallback with version search and finder-ratio assist.
// Fills modules[] with 0/1 samples and writes version into meta[0].
// Returns 1 when a plausible QR grid was sampled, else 0.
import "./common.fws" as c;
import "./image.fws" as img;

export fn qr_version_size(version: i32) -> i32 {
  if version < 1 || version > 40 {
    return 0;
  }
  return 17 + 4 * version;
}

fn finder_ratio_matches(r0: i32, r1: i32, r2: i32, r3: i32, r4: i32) -> i32 {
  let total: i32 = r0 + r1 + r2 + r3 + r4;
  if total < 7 {
    return 0;
  }
  // Round rather than floor: perspective-compressed modules commonly measure
  // just below their nominal pixel width and must not lose a module.
  let rounded_total: i32 = total + 3;
  let module_px: i32 = rounded_total / 7;
  if module_px < 1 {
    return 0;
  }
  if module_px < 3 {
    return 0;
  }
  if c.abs_i32(r0 - module_px) > module_px || c.abs_i32(r1 - module_px) > module_px {
    return 0;
  }
  if c.abs_i32(r3 - module_px) > module_px || c.abs_i32(r4 - module_px) > module_px {
    return 0;
  }
  if c.abs_i32(r2 - module_px * 3) > module_px * 3 {
    return 0;
  }
  return module_px;
}


// Confirm a horizontal finder candidate by walking the vertical 1:1:3:1:1 run
// through its centre column and return the refined (sub-pixel-ish) centre row,
// or a large negative sentinel when the vertical signature does not match.
// Mirrors check_vertical in crates/code-scan/src/qr.rs, which returns the
// refined centre rather than a plain boolean.
fn finder_vertical_centre(bits: u32, width: i32, height: i32, x: i32, y: i32, module_px: i32) -> i32 {
  let limit: i32 = module_px * 5 + 8;
  let mut up: i32 = 0;
  while up < limit && img.bitmap_get(bits, width, height, x, y - up - 1) {
    up = up + 1;
  }
  let mut down: i32 = 0;
  while down < limit && img.bitmap_get(bits, width, height, x, y + down + 1) {
    down = down + 1;
  }
  let centre: i32 = up + down + 1;
  let centre_expected: i32 = module_px * 3;
  if c.abs_i32(centre - centre_expected) > module_px * 2 {
    return 0 - 1000000;
  }
  let top: i32 = y - up - 1;
  let mut light_top: i32 = 0;
  while light_top < limit && !img.bitmap_get(bits, width, height, x, top - light_top) {
    light_top = light_top + 1;
  }
  let mut dark_top: i32 = 0;
  while dark_top < limit && img.bitmap_get(bits, width, height, x, top - light_top - dark_top) {
    dark_top = dark_top + 1;
  }
  let bottom: i32 = y + down + 1;
  let mut light_bottom: i32 = 0;
  while light_bottom < limit && !img.bitmap_get(bits, width, height, x, bottom + light_bottom) {
    light_bottom = light_bottom + 1;
  }
  let mut dark_bottom: i32 = 0;
  while dark_bottom < limit && img.bitmap_get(bits, width, height, x, bottom + light_bottom + dark_bottom) {
    dark_bottom = dark_bottom + 1;
  }
  let delta: i32 = down - up;
  let half: i32 = delta / 2;
  return y + half;
}


// Candidate finder clusters live in a host-provided scratch array as groups of
// four ints: [sum_x, sum_y, sum_module, support]. Unlike the three fixed slots
// the previous locator used, an arbitrary number of clusters is accumulated so
// spurious noise matches cannot crowd out the three real corner finders; the
// caller then keeps the three best-supported clusters (matching cluster() in
// crates/code-scan/src/qr.rs).
fn qr_record_finder(mut store: Array<i32>, cap: i32, count: i32, x: i32, y: i32, module_px: i32) -> i32 {
  let mut slot: i32 = 0;
  while slot < count {
    let base: i32 = slot * 4;
    let support: i32 = store[base + 3];
    let average_x: i32 = c.safe_div_i32(store[base], support);
    let average_y: i32 = c.safe_div_i32(store[base + 1], support);
    let tolerance: i32 = module_px * 2;
    if c.abs_i32(average_x - x) <= tolerance && c.abs_i32(average_y - y) <= tolerance {
      store[base] = store[base] + x;
      store[base + 1] = store[base + 1] + y;
      store[base + 2] = store[base + 2] + module_px;
      store[base + 3] = support + 1;
      return count;
    }
    slot = slot + 1;
  }
  if count < cap {
    let base: i32 = count * 4;
    store[base] = x;
    store[base + 1] = y;
    store[base + 2] = module_px;
    store[base + 3] = 1;
    return count + 1;
  }
  return count;
}

fn distance_sq(ax: i32, ay: i32, bx: i32, by: i32) -> i32 {
  let dx: i32 = ax - bx;
  let dy: i32 = ay - by;
  return dx * dx + dy * dy;
}

fn candidate_x(store: Array<i32>, index: i32) -> i32 {
  let base: i32 = index + index + index + index;
  return c.safe_div_i32(store[base], store[base + 3]);
}

fn candidate_y(store: Array<i32>, index: i32) -> i32 {
  let base: i32 = index + index + index + index;
  return c.safe_div_i32(store[base + 1], store[base + 3]);
}

fn finder_inside_bounds(x: i32, y: i32, x0: i32, y0: i32, x1: i32, y1: i32) -> bool {
  if x < x0 { return false; }
  if x >= x1 { return false; }
  if y < y0 { return false; }
  if y >= y1 { return false; }
  return true;
}

fn corner_candidate(
  store: Array<i32>,
  count: i32,
  corner: i32,
  x0: i32,
  y0: i32,
  x1: i32,
  y1: i32
) -> i32 {
  let mid_x: i32 = c.safe_div_i32(x0 + x1, 2);
  let mid_y: i32 = c.safe_div_i32(y0 + y1, 2);
  let mut target_x: i32 = x0;
  let mut target_y: i32 = y0;
  if corner == 1 { target_x = x1; }
  if corner == 2 { target_y = y1; }
  let mut best: i32 = 0 - 1;
  let mut best_score: i32 = 0 - 2147483647;
  let mut index: i32 = 0;
  while index < count {
    let x: i32 = candidate_x(store, index);
    let y: i32 = candidate_y(store, index);
    let mut in_corner: bool = false;
    if corner == 0 && x < mid_x && y < mid_y { in_corner = true; }
    if corner == 1 && x >= mid_x && y < mid_y { in_corner = true; }
    if corner == 2 && x < mid_x && y >= mid_y { in_corner = true; }
    if in_corner {
      let support: i32 = store[index * 4 + 3];
      let distance: i32 = distance_sq(x, y, target_x, target_y);
      let score: i32 = support * 1000 - distance;
      if score > best_score {
        best_score = score;
        best = index;
      }
    }
    index = index + 1;
  }
  return best;
}


fn integer_sqrt(value: i32) -> i32 {
  if value <= 0 {
    return 0;
  }
  let mut root: i32 = 1;
  while root * root <= value {
    root = root + 1;
  }
  return root - 1;
}


fn locate_qr_finder_modules(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut meta: Array<i32>
) -> i32 {
  if c.array_len_i32(meta) < 16 {
    return 0;
  }
  // The scanner scratch array is image-sized, but tiny/blank calls may provide
  // less storage than the finder record area. Bound the record list to the
  // actual array before clearing or writing it.
  let mut cap: i32 = c.array_len_i32(erasures) / 4;
  if cap > 512 { cap = 512; }
  if cap < 3 { return 0; }
  let mut clear_index: i32 = 0;
  let clear_limit: i32 = cap * 4;
  while clear_index < clear_limit {
    erasures[clear_index] = 0;
    clear_index = clear_index + 1;
  }
  if img.dense_dark_bounds(bits, width, height, meta) == 0 { return 0; }
  let bound_x0: i32 = meta[0];
  let bound_y0: i32 = meta[1];
  let bound_x1: i32 = meta[2];
  let bound_y1: i32 = meta[3];
  let mut cluster_count: i32 = 0;
  let mut scan_row: i32 = 0;
  while scan_row < height {
    let mut y: i32 = scan_row / 2;
    if scan_row - scan_row / 2 * 2 != 0 { y = height - 1 - scan_row / 2; }
    let mut r0: i32 = 0;
    let mut r1: i32 = 0;
    let mut r2: i32 = 0;
    let mut r3: i32 = 0;
    let mut r4: i32 = 0;
    let mut count: i32 = 0;
    let mut current_dark: bool = img.bitmap_get(bits, width, height, 0, y);
    let mut run: i32 = 1;
    let mut x: i32 = 1;
    while x <= width {
      let mut dark: bool = false;
      if x < width {
        dark = img.bitmap_get(bits, width, height, x, y);
      }
      if dark == current_dark {
        run = run + 1;
      } else {
        r0 = r1;
        r1 = r2;
        r2 = r3;
        r3 = r4;
        r4 = run;
        if count < 5 {
          count = count + 1;
        }
        if count >= 5 && current_dark {
          let module_px: i32 = finder_ratio_matches(r0, r1, r2, r3, r4);
          if module_px > 0 {
            let half_centre: i32 = r2 / 2;
            let centre_x: i32 = x - r4 - r3 - half_centre;
            let mut centre_y: i32 = finder_vertical_centre(bits, width, height, centre_x, y, module_px);
            if centre_y == 0 - 1000000 {
              // Shear and perspective move the vertical centre away from the
              // horizontal run's centre by a few pixels. Search the finder
              // width before discarding an otherwise valid 1:1:3:1:1 run.
              centre_y = finder_vertical_centre(bits, width, height, centre_x - module_px, y, module_px);
              if centre_y == 0 - 1000000 {
                centre_y = finder_vertical_centre(bits, width, height, centre_x + module_px, y, module_px);
              }
            }
            if centre_y != 0 - 1000000 && finder_inside_bounds(centre_x, centre_y, bound_x0, bound_y0, bound_x1, bound_y1) {
              cluster_count = qr_record_finder(erasures, cap, cluster_count, centre_x, centre_y, module_px);
            }
          }
        }
        run = 1;
        current_dark = dark;
      }
      x = x + 1;
    }
    scan_row = scan_row + 1;
  }
  if cluster_count < 3 {
    return 0;
  }
  let best0: i32 = corner_candidate(erasures, cluster_count, 0, bound_x0, bound_y0, bound_x1, bound_y1);
  let best1: i32 = corner_candidate(erasures, cluster_count, 1, bound_x0, bound_y0, bound_x1, bound_y1);
  let best2: i32 = corner_candidate(erasures, cluster_count, 2, bound_x0, bound_y0, bound_x1, bound_y1);
  if best0 < 0 || best1 < 0 || best2 < 0 {
    return 0;
  }
  let a_support: i32 = erasures[best0 * 4 + 3];
  let ax: i32 = c.safe_div_i32(erasures[best0 * 4], a_support);
  let ay: i32 = c.safe_div_i32(erasures[best0 * 4 + 1], a_support);
  let module_a: i32 = c.safe_div_i32(erasures[best0 * 4 + 2], a_support);
  let b_support: i32 = erasures[best1 * 4 + 3];
  let bx: i32 = c.safe_div_i32(erasures[best1 * 4], b_support);
  let by: i32 = c.safe_div_i32(erasures[best1 * 4 + 1], b_support);
  let module_b: i32 = c.safe_div_i32(erasures[best1 * 4 + 2], b_support);
  let c_support: i32 = erasures[best2 * 4 + 3];
  let cx: i32 = c.safe_div_i32(erasures[best2 * 4], c_support);
  let cy: i32 = c.safe_div_i32(erasures[best2 * 4 + 1], c_support);
  let module_c: i32 = c.safe_div_i32(erasures[best2 * 4 + 2], c_support);
  meta[6] = ax;
  meta[7] = ay;
  meta[8] = bx;
  meta[9] = by;
  meta[10] = cx;
  meta[11] = cy;
  let ab: i32 = distance_sq(ax, ay, bx, by);
  let ac: i32 = distance_sq(ax, ay, cx, cy);
  let bc: i32 = distance_sq(bx, by, cx, cy);
  let mut tlx: i32 = ax;
  let mut tly: i32 = ay;
  let mut px: i32 = bx;
  let mut py: i32 = by;
  let mut qx: i32 = cx;
  let mut qy: i32 = cy;
  if ab >= ac && ab >= bc {
    tlx = cx;
    tly = cy;
    px = ax;
    py = ay;
    qx = bx;
    qy = by;
  } else {
    if ac >= ab && ac >= bc {
      tlx = bx;
      tly = by;
      px = ax;
      py = ay;
      qx = cx;
      qy = cy;
    }
  }
  let right_x: i32 = px - tlx;
  let right_y: i32 = py - tly;
  let down_x: i32 = qx - tlx;
  let down_y: i32 = qy - tly;
  let cross: i32 = right_x * down_y - right_y * down_x;
  if cross < 0 {
    let swap_x: i32 = px;
    let swap_y: i32 = py;
    px = qx;
    py = qy;
    qx = swap_x;
    qy = swap_y;
  }
  let module_total: i32 = erasures[best0 * 4 + 2] + erasures[best1 * 4 + 2] + erasures[best2 * 4 + 2];
  let support_total: i32 = a_support + b_support + c_support;
  let module_px: i32 = c.safe_div_i32(module_total + support_total / 2, support_total);
  if module_px < 1 {
    return 0;
  }
  let right_length: i32 = integer_sqrt(distance_sq(tlx, tly, px, py));
  let down_length: i32 = integer_sqrt(distance_sq(tlx, tly, qx, qy));
  let length_total: i32 = right_length + down_length;
  let average_length: i32 = c.safe_div_i32(length_total, 2);
  let modules_span_fx: i32 = c.fx_div(c.fx_from_i32(average_length), c.fx_from_i32(module_px));
  let mut size: i32 = c.fx_to_i32(modules_span_fx) + 7;
  if size < 21 {
    return 0;
  }
  // Snap to the nearest valid QR module count (4v + 17); the finder-derived
  // estimate is integer-rounded, so tolerate a fractional module before the
  // grid sample and finder-corner checks validate the choice.
  let size_offset: i32 = size - 17;
  let version_round: i32 = size_offset + 2;
  let best_version: i32 = version_round / 4;
  if best_version < 1 || best_version > 40 {
    return 0;
  }
  size = qr_version_size(best_version);
  let legs: i32 = size - 7;
  let axis_x_x: i32 = c.fx_div(c.fx_from_i32(px - tlx), c.fx_from_i32(legs));
  let axis_x_y: i32 = c.fx_div(c.fx_from_i32(py - tly), c.fx_from_i32(legs));
  let axis_y_x: i32 = c.fx_div(c.fx_from_i32(qx - tlx), c.fx_from_i32(legs));
  let axis_y_y: i32 = c.fx_div(c.fx_from_i32(qy - tly), c.fx_from_i32(legs));
  let origin_x: i32 = c.fx_from_i32(tlx) - c.fx_mul(axis_x_x, 896) - c.fx_mul(axis_y_x, 896);
  let origin_y: i32 = c.fx_from_i32(tly) - c.fx_mul(axis_x_y, 896) - c.fx_mul(axis_y_y, 896);
  let filled: i32 = img.sample_module_grid(
    bits, width, height, origin_x, origin_y, axis_x_x, axis_x_y, axis_y_x, axis_y_y, size, size, modules
  );
  if filled != size * size || !qr_finder_corners_ok(modules, size) {
    return 0;
  }
  img.clear_array(erasures, size * size);
  meta[0] = best_version;
  meta[1] = module_px * 100;
  meta[2] = bound_x0;
  meta[3] = bound_y0;
  meta[4] = module_px * size;
  // Stash the affine sampling geometry so the orchestration can re-sample at
  // sub-module offsets when the offset-zero grid does not decode.
  meta[5] = origin_x;
  meta[6] = origin_y;
  meta[7] = axis_x_x;
  meta[8] = axis_x_y;
  meta[9] = axis_y_x;
  meta[10] = axis_y_y;
  meta[11] = 1;
  return 1;
}

// Try to sample a QR module grid from a binarised bitmap.
// meta layout: [version, module_px_x100, origin_x, origin_y, size_px]
export fn locate_qr_modules(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut meta: Array<i32>
) -> i32 {
  if c.array_len_i32(meta) < 5 {
    return 0;
  }
  let requested_version: i32 = meta[15] - 100;
  meta[15] = 0;
  if requested_version <= 0 {
    let from_finders: i32 = locate_qr_finder_modules(bits, width, height, modules, erasures, meta);
    if from_finders == 1 {
      return 1;
    }
  }
  let bounds: Array<i32> = meta;
  // Reuse meta temporarily for bounds then restore.
  let bound_ok: i32 = img.dense_dark_bounds(bits, width, height, meta);
  if bound_ok == 0 {
    return 0;
  }
  let x0: i32 = meta[0];
  let y0: i32 = meta[1];
  let x1: i32 = meta[2];
  let y1: i32 = meta[3];
  let bw: i32 = x1 - x0;
  let bh: i32 = y1 - y0;
  if bw < 21 || bh < 21 {
    return 0;
  }

  // Prefer near-square symbols.
  let diff: i32 = c.abs_i32(bw - bh);
  if diff * 5 > c.min_i32(bw, bh) {
    // Still try, but bias toward min side.
  }


  let side: i32 = c.min_i32(bw, bh);
  let mut version: i32 = 1;
  if requested_version > 0 { version = requested_version; }
  while version <= 40 {
    let size: i32 = qr_version_size(version);
    // Allow a little quiet-zone leakage by trying several effective sides.
    let mut pad: i32 = 0;
    while pad <= 4 {
      let effective: i32 = side - pad * 2;
      if effective >= size {
        let module_fx: i32 = c.fx_div(c.fx_from_i32(effective), c.fx_from_i32(size));
        if module_fx >= c.FX_SCALE() {
          let origin_x_fx: i32 = c.fx_from_i32(x0 + pad);
          let origin_y_fx: i32 = c.fx_from_i32(y0 + pad);
          let filled: i32 = img.sample_module_grid(
            bits,
            width,
            height,
            origin_x_fx,
            origin_y_fx,
            module_fx,
            0,
            0,
            module_fx,
            size,
            size,
            modules
          );
          let mut accepted: bool = filled == size * size;
          if requested_version <= 0 {
            if !qr_finder_corners_ok(modules, size) { accepted = false; }
          }
          if accepted {
            img.clear_array(erasures, size * size);
            meta[0] = version;
            meta[1] = c.fx_to_i32(module_fx * 100);
            meta[2] = x0 + pad;
            meta[3] = y0 + pad;
            meta[4] = effective;
            if c.array_len_i32(meta) >= 12 {
              meta[5] = origin_x_fx;
              meta[6] = origin_y_fx;
              meta[7] = module_fx;
              meta[8] = 0;
              meta[9] = 0;
              meta[10] = module_fx;
              meta[11] = 1;
            }
            return 1;
          }
        }
      }
      pad = pad + 1;
    }
    if requested_version > 0 { return 0; }
    version = version + 1;
  }
  return 0;
}

// Re-sample the located QR grid at a sub-module offset (module units, fixed
// point) so the caller can retry decoding when perspective drift shifts the
// true module centres off the offset-zero grid (mirrors SAMPLE_OFFSETS in
// crates/code-scan/src/lib.rs). Requires geometry stored by locate_qr_modules.
export fn resample_qr_at_offset(
  bits: u32,
  width: i32,
  height: i32,
  modules: Array<i32>,
  meta: Array<i32>,
  offset_x_fx: i32,
  offset_y_fx: i32
) -> i32 {
  if c.array_len_i32(meta) < 12 {
    return 0;
  }
  if meta[11] != 1 {
    return 0;
  }
  let size: i32 = qr_version_size(meta[0]);
  if size == 0 {
    return 0;
  }
  let axis_x_x: i32 = meta[7];
  let axis_x_y: i32 = meta[8];
  let axis_y_x: i32 = meta[9];
  let axis_y_y: i32 = meta[10];
  let shift_ax: i32 = c.fx_mul(offset_x_fx, axis_x_x);
  let shift_ay: i32 = c.fx_mul(offset_y_fx, axis_y_x);
  let shift_x: i32 = shift_ax + shift_ay;
  let shift_bx: i32 = c.fx_mul(offset_x_fx, axis_x_y);
  let shift_by: i32 = c.fx_mul(offset_y_fx, axis_y_y);
  let shift_y: i32 = shift_bx + shift_by;
  let origin_x: i32 = meta[5] + shift_x;
  let origin_y: i32 = meta[6] + shift_y;
  let filled: i32 = img.sample_module_grid(
    bits, width, height, origin_x, origin_y, axis_x_x, axis_x_y, axis_y_x, axis_y_y, size, size, modules
  );
  let expected: i32 = size * size;
  if filled != expected {
    return 0;
  }
  return 1;
}

fn qr_finder_corners_ok(modules: Array<i32>, size: i32) -> bool {
  // Each finder is 7x7. Require the centre module of each corner finder to be dark
  // and a light ring sample nearby.
  if size < 21 {
    return false;
  }
  if !finder_at(modules, size, 0, 0) {
    return false;
  }
  if !finder_at(modules, size, size - 7, 0) {
    return false;
  }
  if !finder_at(modules, size, 0, size - 7) {
    return false;
  }
  return true;
}

fn finder_at(modules: Array<i32>, size: i32, ox: i32, oy: i32) -> bool {
  // Centre of 7x7 finder at (ox+3, oy+3) should be dark.
  let cx: i32 = ox + 3;
  let cy: i32 = oy + 3;
  if modules[cy * size + cx] != 1 {
    return false;
  }
  // Outer corner should be dark.
  if modules[oy * size + ox] != 1 {
    return false;
  }
  // A module just inside the quiet separation (if present) is not checked here.
  // Check the white ring sample at (ox+1, oy+1) is light for standard finders.
  let ring: i32 = oy + 1;
  let ring_index: i32 = ring * size + ox + 1;
  if modules[ring_index] != 0 {
    // Tolerate imperfect sampling.
  }
  // Count dark modules in the 7x7; expect roughly half+.
  let mut dark: i32 = 0;
  let mut y: i32 = 0;
  while y < 7 {
    let mut x: i32 = 0;
    while x < 7 {
      let cell: i32 = oy + y;
      let cell_index: i32 = cell * size + ox + x;
      if modules[cell_index] == 1 {
        dark = dark + 1;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return dark >= 24 && dark <= 45;
}
