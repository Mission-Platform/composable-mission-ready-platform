// ZXing-derived one-dimensional reader layer.
//
// Modified from the contracts and algorithms in com.google.zxing.oned. The
// implementation is intentionally flat and POD-oriented: the caller supplies
// a bounded row of binary modules and receives a compact, validated value.
// No encoder or legacy decoder module is linked here.
import "./common.flint" as c;
import "./foundation.flint" as foundation;

fn oned_len(values: Array<i32>) -> i32 { return c.array_len_i32(values); }

fn oned_digit(value: i32) -> string {
  if value == 0 { return "0"; }
  if value == 1 { return "1"; }
  if value == 2 { return "2"; }
  if value == 3 { return "3"; }
  if value == 4 { return "4"; }
  if value == 5 { return "5"; }
  if value == 6 { return "6"; }
  if value == 7 { return "7"; }
  if value == 8 { return "8"; }
  return "9";
}

fn oned_is_digit(value: string, index: i32) -> bool {
  if index < 0 || index >= string_length(value) { return false; }
  let code: i32 = string_byte_at(value, index);
  return code >= 48 && code <= 57;
}

fn oned_digit_at(value: string, index: i32) -> i32 {
  if !oned_is_digit(value, index) { return -1; }
  return string_byte_at(value, index) - 48;
}

// ZXing's recordPattern variance gate, expressed without floating point. A
// run is accepted when its total absolute error is at most 0.42 of its total.
export fn oned_pattern_variance(actual: Array<i32>, expected: Array<i32>, count: i32) -> i32 {
  if count <= 0 || c.array_len_i32(actual) < count || c.array_len_i32(expected) < count { return -1; }
  let mut total: i32 = 0;
  let mut error: i32 = 0;
  let mut index: i32 = 0;
  while index < count {
    if actual[index] <= 0 || expected[index] <= 0 { return -1; }
    total = total + actual[index];
    error = error + c.abs_i32(actual[index] - expected[index]);
    index = index + 1;
  }
  if total <= 0 { return -1; }
  return c.safe_div_i32(error * 1000, total);
}

export fn oned_quiet_zone(row: Array<i32>, start: i32, width: i32, required: i32) -> i32 {
  let length: i32 = oned_len(row);
  if start < 0 || width <= 0 || required < 0 || start + width > length { return -1; }
  let mut left: i32 = start - 1;
  let mut count: i32 = 0;
  while left >= 0 && row[left] == 0 && count < required { left = left - 1; count = count + 1; }
  if count < required { return 0; }
  let mut right: i32 = start + width;
  count = 0;
  while right < length && row[right] == 0 && count < required { right = right + 1; count = count + 1; }
  if count < required { return 0; }
  return 1;
}

// Convert one luminance row to a binary row. The threshold is explicit so a
// reader can retry with a global or local threshold without rebuilding state.
export fn oned_extract_row(
  luma: Array<i32>,
  width: i32,
  height: i32,
  row: i32,
  threshold: i32,
  mut modules: Array<i32>
) -> i32 {
  if foundation.foundation_validate_dimensions(width, height, width) < 0 || row < 0 || row >= height { return -1; }
  if c.array_len_i32(luma) < width * height || c.array_len_i32(modules) < width { return -1; }
  let mut index: i32 = 0;
  while index < width {
    let value: i32 = luma[row * width + index];
    modules[index] = 0;
    if value < threshold { modules[index] = 1; }
    index = index + 1;
  }
  return 1;
}

fn oned_ean8_check(value: string) -> i32 {
  let mut sum: i32 = 0;
  let mut index: i32 = 0;
  while index < 7 {
    let digit: i32 = oned_digit_at(value, index);
    if digit < 0 { return -1; }
    if index % 2 == 0 { sum = sum + digit * 3; }
    if index % 2 == 1 { sum = sum + digit; }
    index = index + 1;
  }
  let mut remainder: i32 = sum;
  while remainder >= 10 { remainder = remainder - 10; }
  let mut check: i32 = 10 - remainder;
  if check == 10 { check = 0; }
  return check;
}

fn oned_ean13_check(value: string) -> i32 {
  let mut sum: i32 = 0;
  let mut index: i32 = 0;
  while index < 12 {
    let digit: i32 = oned_digit_at(value, index);
    if digit < 0 { return -1; }
    if index % 2 == 0 { sum = sum + digit; }
    if index % 2 == 1 { sum = sum + digit * 3; }
    index = index + 1;
  }
  let mut remainder: i32 = sum;
  while remainder >= 10 { remainder = remainder - 10; }
  let mut check: i32 = 10 - remainder;
  if check == 10 { check = 0; }
  return check;
}

fn oned_ean8_check_digits(a: i32, b: i32, d: i32, e: i32, f: i32, g: i32, h: i32) -> i32 {
  let sum: i32 = a * 3 + b + d * 3 + e + f * 3 + g + h * 3;
  let mut remainder: i32 = sum;
  while remainder >= 10 { remainder = remainder - 10; }
  let mut check: i32 = 10 - remainder;
  if check == 10 { check = 0; }
  return check;
}

fn oned_ean13_check_row(row: Array<i32>, leading: i32) -> i32 {
  let mut sum: i32 = leading;
  let mut index: i32 = 0;
  while index < 6 {
    let offset: i32 = 3 + index * 7;
    let left: i32 = oned_ean_l_digit(row, offset);
    let mut digit: i32 = left;
    if digit < 0 { digit = oned_ean_g_digit(row, offset); }
    if digit < 0 { return -1; }
    let position: i32 = index + 1;
    if position == 1 || position == 3 || position == 5 { sum = sum + digit * 3; }
    if position == 2 || position == 4 || position == 6 { sum = sum + digit; }
    index = index + 1;
  }
  index = 0;
  while index < 5 {
    let digit: i32 = oned_ean_r_digit(row, 50 + index * 7);
    if digit < 0 { return -1; }
    let position: i32 = index + 7;
    if position == 7 || position == 9 || position == 11 { sum = sum + digit * 3; }
    if position == 8 || position == 10 || position == 12 { sum = sum + digit; }
    index = index + 1;
  }
  let mut remainder: i32 = sum;
  while remainder >= 10 { remainder = remainder - 10; }
  let mut check: i32 = 10 - remainder;
  if check == 10 { check = 0; }
  return check;
}

// Record a run from the binary row without assuming one pixel per module.
// Returning a non-positive value is the fail-closed equivalent of ZXing's
// NotFoundException for an incomplete counter sequence.
fn oned_run(row: Array<i32>, start: i32, color: i32) -> i32 {
  let length: i32 = oned_len(row);
  if start < 0 || start >= length || row[start] != color { return -1; }
  let mut end: i32 = start;
  while end < length && row[end] == color { end = end + 1; }
  return end - start;
}

fn oned_pattern_color(pattern: string, index: i32) -> i32 {
  let length: i32 = string_length(pattern);
  if index < 0 || index >= length { return -1; }
  return string_byte_at(pattern, index) - 48;
}

fn oned_pattern_width(row: Array<i32>, start: i32, pattern: string) -> i32 {
  let length: i32 = string_length(pattern);
  if start < 0 || length <= 0 { return -1; }
  let mut position: i32 = start;
  let mut pattern_index: i32 = 0;
  let mut width: i32 = 0;
  while pattern_index < length {
    let color: i32 = oned_pattern_color(pattern, pattern_index);
    if color < 0 { return -1; }
    let run: i32 = oned_run(row, position, color);
    if run <= 0 { return -1; }
    width = width + run;
    position = position + run;
    while pattern_index < length && oned_pattern_color(pattern, pattern_index) == color {
      pattern_index = pattern_index + 1;
    }
  }
  return width;
}

// Compare recorded counters with a module pattern after normalizing by the
// observed total width. This is the integer form of ZXing's patternMatchVariance
// average-variance gate and remains valid when modules rasterize to 2+ pixels.
fn oned_pattern_variance_row(row: Array<i32>, start: i32, pattern: string) -> i32 {
  let pattern_length: i32 = string_length(pattern);
  let total: i32 = oned_pattern_width(row, start, pattern);
  if pattern_length <= 0 || total <= 0 { return -1; }
  let mut position: i32 = start;
  let mut pattern_index: i32 = 0;
  let mut error: i32 = 0;
  while pattern_index < pattern_length {
    let color: i32 = oned_pattern_color(pattern, pattern_index);
    if color < 0 { return -1; }
    let mut expected_modules: i32 = 0;
    while pattern_index < pattern_length && oned_pattern_color(pattern, pattern_index) == color {
      expected_modules = expected_modules + 1;
      pattern_index = pattern_index + 1;
    }
    let actual: i32 = oned_run(row, position, color);
    if actual <= 0 { return -1; }
    error = error + c.abs_i32(actual * pattern_length - expected_modules * total);
    position = position + actual;
  }
  return c.safe_div_i32(error * 1000, total * pattern_length);
}

fn oned_pattern_match(row: Array<i32>, start: i32, pattern: string) -> bool {
  let variance: i32 = oned_pattern_variance_row(row, start, pattern);
  return variance >= 0 && variance <= 480;
}

fn oned_ean_l_digit(row: Array<i32>, start: i32) -> i32 {
  let mut best: i32 = 10000; let mut digit: i32 = -1; let mut score: i32 = 0;
  score = oned_pattern_variance_row(row, start, "0001101"); if score >= 0 && score < best { best = score; digit = 0; }
  score = oned_pattern_variance_row(row, start, "0011001"); if score >= 0 && score < best { best = score; digit = 1; }
  score = oned_pattern_variance_row(row, start, "0010011"); if score >= 0 && score < best { best = score; digit = 2; }
  score = oned_pattern_variance_row(row, start, "0111101"); if score >= 0 && score < best { best = score; digit = 3; }
  score = oned_pattern_variance_row(row, start, "0100011"); if score >= 0 && score < best { best = score; digit = 4; }
  score = oned_pattern_variance_row(row, start, "0110001"); if score >= 0 && score < best { best = score; digit = 5; }
  score = oned_pattern_variance_row(row, start, "0101111"); if score >= 0 && score < best { best = score; digit = 6; }
  score = oned_pattern_variance_row(row, start, "0111011"); if score >= 0 && score < best { best = score; digit = 7; }
  score = oned_pattern_variance_row(row, start, "0110111"); if score >= 0 && score < best { best = score; digit = 8; }
  score = oned_pattern_variance_row(row, start, "0001011"); if score >= 0 && score < best { best = score; digit = 9; }
  if best > 480 { return -1; }
  return digit;
}

fn oned_ean_g_digit(row: Array<i32>, start: i32) -> i32 {
  let mut best: i32 = 10000; let mut digit: i32 = -1; let mut score: i32 = 0;
  score = oned_pattern_variance_row(row, start, "0100111"); if score >= 0 && score < best { best = score; digit = 0; }
  score = oned_pattern_variance_row(row, start, "0110011"); if score >= 0 && score < best { best = score; digit = 1; }
  score = oned_pattern_variance_row(row, start, "0011011"); if score >= 0 && score < best { best = score; digit = 2; }
  score = oned_pattern_variance_row(row, start, "0100001"); if score >= 0 && score < best { best = score; digit = 3; }
  score = oned_pattern_variance_row(row, start, "0011101"); if score >= 0 && score < best { best = score; digit = 4; }
  score = oned_pattern_variance_row(row, start, "0111001"); if score >= 0 && score < best { best = score; digit = 5; }
  score = oned_pattern_variance_row(row, start, "0000101"); if score >= 0 && score < best { best = score; digit = 6; }
  score = oned_pattern_variance_row(row, start, "0010001"); if score >= 0 && score < best { best = score; digit = 7; }
  score = oned_pattern_variance_row(row, start, "0001001"); if score >= 0 && score < best { best = score; digit = 8; }
  score = oned_pattern_variance_row(row, start, "0010111"); if score >= 0 && score < best { best = score; digit = 9; }
  if best > 480 { return -1; }
  return digit;
}

fn oned_ean_r_digit(row: Array<i32>, start: i32) -> i32 {
  let mut best: i32 = 10000; let mut digit: i32 = -1; let mut score: i32 = 0;
  score = oned_pattern_variance_row(row, start, "1110010"); if score >= 0 && score < best { best = score; digit = 0; }
  score = oned_pattern_variance_row(row, start, "1100110"); if score >= 0 && score < best { best = score; digit = 1; }
  score = oned_pattern_variance_row(row, start, "1101100"); if score >= 0 && score < best { best = score; digit = 2; }
  score = oned_pattern_variance_row(row, start, "1000010"); if score >= 0 && score < best { best = score; digit = 3; }
  score = oned_pattern_variance_row(row, start, "1011100"); if score >= 0 && score < best { best = score; digit = 4; }
  score = oned_pattern_variance_row(row, start, "1001110"); if score >= 0 && score < best { best = score; digit = 5; }
  score = oned_pattern_variance_row(row, start, "1010000"); if score >= 0 && score < best { best = score; digit = 6; }
  score = oned_pattern_variance_row(row, start, "1000100"); if score >= 0 && score < best { best = score; digit = 7; }
  score = oned_pattern_variance_row(row, start, "1001000"); if score >= 0 && score < best { best = score; digit = 8; }
  score = oned_pattern_variance_row(row, start, "1110100"); if score >= 0 && score < best { best = score; digit = 9; }
  if best > 480 { return -1; }
  return digit;
}

// ZXing's UPCEANReader compares L and G patterns in one table. A family-first
// fallback can select an ambiguous wrong-family digit, so retain the best
// candidate across both families and encode G as 10 through 19.
fn oned_ean_best_digit(row: Array<i32>, start: i32) -> i32 {
  let mut best: i32 = 10000; let mut result: i32 = -1; let mut score: i32 = 0;
  score = oned_pattern_variance_row(row, start, "0001101"); if score >= 0 && score < best { best = score; result = 0; }
  score = oned_pattern_variance_row(row, start, "0011001"); if score >= 0 && score < best { best = score; result = 1; }
  score = oned_pattern_variance_row(row, start, "0010011"); if score >= 0 && score < best { best = score; result = 2; }
  score = oned_pattern_variance_row(row, start, "0111101"); if score >= 0 && score < best { best = score; result = 3; }
  score = oned_pattern_variance_row(row, start, "0100011"); if score >= 0 && score < best { best = score; result = 4; }
  score = oned_pattern_variance_row(row, start, "0110001"); if score >= 0 && score < best { best = score; result = 5; }
  score = oned_pattern_variance_row(row, start, "0101111"); if score >= 0 && score < best { best = score; result = 6; }
  score = oned_pattern_variance_row(row, start, "0111011"); if score >= 0 && score < best { best = score; result = 7; }
  score = oned_pattern_variance_row(row, start, "0110111"); if score >= 0 && score < best { best = score; result = 8; }
  score = oned_pattern_variance_row(row, start, "0001011"); if score >= 0 && score < best { best = score; result = 9; }
  score = oned_pattern_variance_row(row, start, "0100111"); if score >= 0 && score < best { best = score; result = 10; }
  score = oned_pattern_variance_row(row, start, "0110011"); if score >= 0 && score < best { best = score; result = 11; }
  score = oned_pattern_variance_row(row, start, "0011011"); if score >= 0 && score < best { best = score; result = 12; }
  score = oned_pattern_variance_row(row, start, "0100001"); if score >= 0 && score < best { best = score; result = 13; }
  score = oned_pattern_variance_row(row, start, "0011101"); if score >= 0 && score < best { best = score; result = 14; }
  score = oned_pattern_variance_row(row, start, "0111001"); if score >= 0 && score < best { best = score; result = 15; }
  score = oned_pattern_variance_row(row, start, "0000101"); if score >= 0 && score < best { best = score; result = 16; }
  score = oned_pattern_variance_row(row, start, "0010001"); if score >= 0 && score < best { best = score; result = 17; }
  score = oned_pattern_variance_row(row, start, "0001001"); if score >= 0 && score < best { best = score; result = 18; }
  score = oned_pattern_variance_row(row, start, "0010111"); if score >= 0 && score < best { best = score; result = 19; }
  if best > 480 { return -1; }
  return result;
}

fn oned_find_guard(row: Array<i32>, pattern: string) -> i32 {
  let length: i32 = oned_len(row);
  let mut index: i32 = 0;
  while index < length {
    if row[index] == 1 {
      let mut edge: bool = index == 0;
      if index > 0 { edge = row[index - 1] == 0; }
      if edge {
        if oned_pattern_match(row, index, pattern) { return index; }
      }
    }
    index = index + 1;
  }
  return -1;
}

fn oned_parity(value: string) -> i32 {
  if value == "LLLLLL" { return 0; }
  if value == "LLGLGG" { return 1; }
  if value == "LLGGLG" { return 2; }
  if value == "LLGGGL" { return 3; }
  if value == "LGLLGG" { return 4; }
  if value == "LGGLLG" { return 5; }
  if value == "LGGGLL" { return 6; }
  if value == "LGLGLG" { return 7; }
  if value == "LGLGGL" { return 8; }
  if value == "LGLLGL" { return 9; }
  return -1;
}

fn oned_parity_code(value: i32) -> i32 {
  if value == 0 { return 0; }
  if value == 11 { return 1; }
  if value == 13 { return 2; }
  if value == 14 { return 3; }
  if value == 19 { return 4; }
  if value == 25 { return 5; }
  if value == 28 { return 6; }
  if value == 21 { return 7; }
  if value == 22 { return 8; }
  if value == 18 { return 9; }
  return -1;
}

fn oned_l_pattern(digit: i32) -> string {
  if digit == 0 { return "0001101"; } if digit == 1 { return "0011001"; }
  if digit == 2 { return "0010011"; } if digit == 3 { return "0111101"; }
  if digit == 4 { return "0100011"; } if digit == 5 { return "0110001"; }
  if digit == 6 { return "0101111"; } if digit == 7 { return "0111011"; }
  if digit == 8 { return "0110111"; } return "0001011";
}

fn oned_g_pattern(digit: i32) -> string {
  if digit == 0 { return "0100111"; } if digit == 1 { return "0110011"; }
  if digit == 2 { return "0011011"; } if digit == 3 { return "0100001"; }
  if digit == 4 { return "0011101"; } if digit == 5 { return "0111001"; }
  if digit == 6 { return "0000101"; } if digit == 7 { return "0010001"; }
  if digit == 8 { return "0001001"; } return "0010111";
}

fn oned_r_pattern(digit: i32) -> string {
  if digit == 0 { return "1110010"; } if digit == 1 { return "1100110"; }
  if digit == 2 { return "1101100"; } if digit == 3 { return "1000010"; }
  if digit == 4 { return "1011100"; } if digit == 5 { return "1001110"; }
  if digit == 6 { return "1010000"; } if digit == 7 { return "1000100"; }
  if digit == 8 { return "1001000"; } return "1110100";
}

fn oned_ean_width(row: Array<i32>, start: i32, digit: i32, kind: i32) -> i32 {
  if digit < 0 || digit > 9 { return -1; }
  if kind == 0 { return oned_pattern_width(row, start, oned_l_pattern(digit)); }
  if kind == 1 { return oned_pattern_width(row, start, oned_g_pattern(digit)); }
  return oned_pattern_width(row, start, oned_r_pattern(digit));
}

fn oned_quiet_symbol(row: Array<i32>, start: i32, end: i32, guard_width: i32) -> bool {
  let length: i32 = oned_len(row);
  if start < 0 || end <= start || end > length { return false; }
  // A caller may pass a tightly cropped direct row. When either exterior side
  // exists, however, apply the same quiet-zone check used by ZXing's reader.
  if start > 0 || end < length {
    return oned_quiet_zone(row, start, end - start, guard_width * 2) == 1;
  }
  return true;
}

export fn oned_decode_ean8(row: Array<i32>) -> string {
  let start: i32 = oned_find_guard(row, "101");
  if start < 0 { return ""; }
  let mut position: i32 = start + oned_pattern_width(row, start, "101");
  if position <= start { return ""; }
  let mut value: string = "";
  let mut index: i32 = 0;
  while index < 4 {
    let digit: i32 = oned_ean_l_digit(row, position);
    if digit < 0 { return ""; }
    let width: i32 = oned_ean_width(row, position, digit, 0);
    if width <= 0 { return ""; }
    value = string_concat(value, oned_digit(digit)); position = position + width; index = index + 1;
  }
  if !oned_pattern_match(row, position, "01010") { return ""; }
  position = position + oned_pattern_width(row, position, "01010");
  index = 0;
  while index < 4 {
    let digit: i32 = oned_ean_r_digit(row, position);
    if digit < 0 { return ""; }
    let width: i32 = oned_ean_width(row, position, digit, 2);
    if width <= 0 { return ""; }
    value = string_concat(value, oned_digit(digit)); position = position + width; index = index + 1;
  }
  if !oned_pattern_match(row, position, "101") { return ""; }
  let end: i32 = position + oned_pattern_width(row, position, "101");
  if !oned_quiet_symbol(row, start, end, oned_pattern_width(row, start, "101")) { return ""; }
  if string_length(value) != 8 || oned_digit_at(value, 7) != oned_ean8_check(value) { return ""; }
  return string_concat("", value);
}

export fn oned_decode_ean13(row: Array<i32>) -> string {
  let start: i32 = oned_find_guard(row, "101");
  if start < 0 { return ""; }
  let mut position: i32 = start + oned_pattern_width(row, start, "101");
  if position <= start { return ""; }
  let mut parity: i32 = 0;
  let mut digits: string = "";
  let mut index: i32 = 0;
  while index < 6 {
    let encoded: i32 = oned_ean_best_digit(row, position);
    if encoded < 0 { return ""; }
    let mut digit: i32 = encoded;
    let mut kind: i32 = 0;
    if encoded >= 10 { digit = encoded - 10; kind = 1; }
    digits = string_concat(digits, oned_digit(digit)); parity = parity * 2 + kind;
    let width: i32 = oned_ean_width(row, position, digit, kind);
    if width <= 0 { return ""; }
    position = position + width; index = index + 1;
  }
  let leading: i32 = oned_parity_code(parity);
  if leading < 0 || !oned_pattern_match(row, position, "01010") { return ""; }
  position = position + oned_pattern_width(row, position, "01010");
  let mut right: string = "";
  index = 0;
  while index < 6 {
    let digit: i32 = oned_ean_r_digit(row, position);
    if digit < 0 { return ""; }
    right = string_concat(right, oned_digit(digit));
    let width: i32 = oned_ean_width(row, position, digit, 2);
    if width <= 0 { return ""; }
    position = position + width; index = index + 1;
  }
  if !oned_pattern_match(row, position, "101") { return ""; }
  let end: i32 = position + oned_pattern_width(row, position, "101");
  if !oned_quiet_symbol(row, start, end, oned_pattern_width(row, start, "101")) { return ""; }
  let value: string = string_concat(string_concat(oned_digit(leading), digits), right);
  if string_length(value) != 13 || oned_digit_at(value, 12) != oned_ean13_check(value) { return ""; }
  return string_concat("", value);
}

export fn oned_decode_upca(row: Array<i32>) -> string {
  let ean: string = oned_decode_ean13(row);
  if string_length(ean) != 13 || string_byte_at(ean, 0) != 48 { return ""; }
  return string_slice(ean, 1, 13);
}

fn oned_upce_check(mask: i32, number_system: i32) -> i32 {
  if number_system == 0 {
    if mask == 56 { return 0; } if mask == 52 { return 1; }
    if mask == 50 { return 2; } if mask == 49 { return 3; }
    if mask == 44 { return 4; } if mask == 38 { return 5; }
    if mask == 35 { return 6; } if mask == 42 { return 7; }
    if mask == 41 { return 8; } if mask == 37 { return 9; }
  }
  if number_system == 1 {
    if mask == 7 { return 0; } if mask == 11 { return 1; }
    if mask == 13 { return 2; } if mask == 14 { return 3; }
    if mask == 19 { return 4; } if mask == 25 { return 5; }
    if mask == 28 { return 6; } if mask == 21 { return 7; }
    if mask == 22 { return 8; } if mask == 26 { return 9; }
  }
  return -1;
}

fn oned_upce_expand(value: string) -> string {
  if string_length(value) < 7 { return ""; }
  let number_system: i32 = oned_digit_at(value, 0);
  let first: i32 = oned_digit_at(value, 1); let second: i32 = oned_digit_at(value, 2);
  let third: i32 = oned_digit_at(value, 3); let fourth: i32 = oned_digit_at(value, 4);
  let fifth: i32 = oned_digit_at(value, 5); let last: i32 = oned_digit_at(value, 6);
  if number_system < 0 || first < 0 || second < 0 || third < 0 || fourth < 0 || fifth < 0 || last < 0 { return ""; }
  let prefix: string = oned_digit(number_system);
  if last <= 2 {
    return string_concat(string_concat(string_concat(string_concat(string_concat(string_concat(prefix, oned_digit(first)), oned_digit(second)), oned_digit(last)), "0000"), oned_digit(third)), string_concat(oned_digit(fourth), oned_digit(fifth)));
  }
  if last == 3 {
    return string_concat(string_concat(string_concat(string_concat(prefix, oned_digit(first)), oned_digit(second)), oned_digit(third)), string_concat("00000", string_concat(oned_digit(fourth), oned_digit(fifth))));
  }
  if last == 4 {
    return string_concat(string_concat(string_concat(string_concat(string_concat(prefix, oned_digit(first)), oned_digit(second)), oned_digit(third)), oned_digit(fourth)), string_concat("00000", oned_digit(fifth)));
  }
  return string_concat(string_concat(string_concat(string_concat(string_concat(string_concat(prefix, oned_digit(first)), oned_digit(second)), oned_digit(third)), oned_digit(fourth)), oned_digit(fifth)), string_concat("0000", oned_digit(last)));
}

export fn oned_decode_upce(row: Array<i32>) -> string {
  let start: i32 = oned_find_guard(row, "101");
  if start < 0 { return ""; }
  let guard_width: i32 = oned_pattern_width(row, start, "101");
  if guard_width < 3 || guard_width / 3 < 1 { return ""; }
  let scale: i32 = guard_width / 3;
  let mut position: i32 = start + guard_width;
  let mut mask: i32 = 0;
  let mut digits: string = "";
  let mut index: i32 = 0;
  while index < 6 {
    let encoded: i32 = oned_ean_best_digit(row, position);
    if encoded < 0 { return ""; }
    let mut digit: i32 = encoded;
    let mut kind: i32 = 0;
    if encoded >= 10 { digit = encoded - 10; kind = 1; }
    if kind == 1 {
      if index == 0 { mask = mask + 32; }
      if index == 1 { mask = mask + 16; }
      if index == 2 { mask = mask + 8; }
      if index == 3 { mask = mask + 4; }
      if index == 4 { mask = mask + 2; }
      if index == 5 { mask = mask + 1; }
    }
    digits = string_concat(digits, oned_digit(digit));
    position = position + 7 * scale; index = index + 1;
  }
  if !oned_pattern_match(row, position, "010101") { return ""; }
  let end: i32 = position + oned_pattern_width(row, position, "010101");
  if !oned_quiet_symbol(row, start, end, oned_pattern_width(row, start, "101")) { return ""; }
  let mut number_system: i32 = 0;
  let mut check_digit: i32 = oned_upce_check(mask, number_system);
  if check_digit < 0 { number_system = 1; check_digit = oned_upce_check(mask, number_system); }
  if check_digit < 0 { return ""; }
  let value: string = string_concat(string_concat(oned_digit(number_system), digits), oned_digit(check_digit));
  let expanded: string = oned_upce_expand(value);
  if string_length(expanded) != 11 || oned_ean13_check(string_concat("0", expanded)) != check_digit { return ""; }
  return string_concat("", value);
}

fn oned_extension_check(mask: i32) -> i32 {
  if mask == 24 { return 0; } if mask == 20 { return 1; }
  if mask == 18 { return 2; } if mask == 17 { return 3; }
  if mask == 12 { return 4; } if mask == 6 { return 5; }
  if mask == 3 { return 6; } if mask == 10 { return 7; }
  if mask == 9 { return 8; } if mask == 5 { return 9; }
  return -1;
}

fn oned_extension_digit(row: Array<i32>, position: i32, mut mask: i32, bit: i32) -> i32 {
  let left: i32 = oned_ean_l_digit(row, position);
  if left >= 0 { return left; }
  let right: i32 = oned_ean_g_digit(row, position);
  if right >= 0 { mask = mask + bit; }
  return right;
}

export fn oned_decode_extension2(row: Array<i32>) -> string {
  let start: i32 = oned_find_guard(row, "1011");
  if start < 0 { return ""; }
  let guard_width: i32 = oned_pattern_width(row, start, "1011");
  if guard_width < 4 || guard_width / 4 < 1 { return ""; }
  let scale: i32 = guard_width / 4;
  let mut position: i32 = start + guard_width;
  let mut mask: i32 = 0; let mut value: string = ""; let mut index: i32 = 0;
  while index < 2 {
    if index > 0 {
      let offset: i32 = index - 1;
      let separator: i32 = start + guard_width + offset * 9 * scale + 7 * scale;
      if !oned_pattern_match(row, separator, "01") { return ""; }
      position = start + guard_width + index * 9 * scale;
    }
    let encoded: i32 = oned_ean_best_digit(row, position);
    if encoded < 0 { return ""; }
    let mut digit: i32 = encoded; let mut kind: i32 = 0;
    if encoded >= 10 { digit = encoded - 10; kind = 1; }
    if kind == 1 {
      if index == 0 { mask = mask + 2; }
      if index == 1 { mask = mask + 1; }
    }
    value = string_concat(value, oned_digit(digit));
    index = index + 1;
  }
  let number: i32 = oned_digit_at(value, 0) * 10 + oned_digit_at(value, 1);
  let mut remainder: i32 = number;
  while remainder >= 4 { remainder = remainder - 4; }
  if remainder != mask { return ""; }
  return string_concat("", value);
}

export fn oned_decode_extension5(row: Array<i32>) -> string {
  let start: i32 = oned_find_guard(row, "1011");
  if start < 0 { return ""; }
  let guard_width: i32 = oned_pattern_width(row, start, "1011");
  if guard_width < 4 || guard_width / 4 < 1 { return ""; }
  let scale: i32 = guard_width / 4;
  let mut position: i32 = start + guard_width;
  let mut mask: i32 = 0; let mut value: string = ""; let mut index: i32 = 0;
  while index < 5 {
    if index > 0 {
      let offset: i32 = index - 1;
      let separator: i32 = start + guard_width + offset * 9 * scale + 7 * scale;
      if !oned_pattern_match(row, separator, "01") { return ""; }
      position = start + guard_width + index * 9 * scale;
    }
    let encoded: i32 = oned_ean_best_digit(row, position);
    if encoded < 0 { return ""; }
    let mut digit: i32 = encoded; let mut kind: i32 = 0;
    if encoded >= 10 { digit = encoded - 10; kind = 1; }
    if kind == 1 {
      if index == 0 { mask = mask + 16; }
      if index == 1 { mask = mask + 8; }
      if index == 2 { mask = mask + 4; }
      if index == 3 { mask = mask + 2; }
      if index == 4 { mask = mask + 1; }
    }
    value = string_concat(value, oned_digit(digit));
    index = index + 1;
  }
  let check_digit: i32 = oned_extension_check(mask);
  if check_digit < 0 { return ""; }
  let mut sum: i32 = oned_digit_at(value, 3) + oned_digit_at(value, 1);
  sum = sum * 3 + oned_digit_at(value, 4) + oned_digit_at(value, 2) + oned_digit_at(value, 0);
  sum = sum * 3;
  let mut remainder: i32 = sum;
  while remainder >= 10 { remainder = remainder - 10; }
  if remainder != check_digit { return ""; }
  return string_concat("", value);
}

export fn oned_decode_extension(row: Array<i32>) -> string {
  let five: string = oned_decode_extension5(row);
  if string_length(five) == 5 { return string_concat("", five); }
  return string_concat("", oned_decode_extension2(row));
}

// Shared run-counter helpers for Code 39 / ITF. Counters are recorded as
// consecutive color runs so scaled modules stay valid without literal bit
// matching. Pattern classification follows ZXing's OneDReader contracts.
fn oned_white_range(row: Array<i32>, start: i32, end: i32) -> bool {
  if start < 0 || end < start || end > oned_len(row) { return false; }
  let mut index: i32 = start;
  while index < end {
    if row[index] != 0 { return false; }
    index = index + 1;
  }
  return true;
}

fn oned_next_set(row: Array<i32>, start: i32) -> i32 {
  let length: i32 = oned_len(row);
  if start < 0 { return -1; }
  let mut index: i32 = start;
  while index < length {
    if row[index] == 1 { return index; }
    index = index + 1;
  }
  return length;
}

fn oned_last_one_end(row: Array<i32>) -> i32 {
  let mut index: i32 = oned_len(row) - 1;
  while index >= 0 {
    if row[index] == 1 { return index + 1; }
    index = index - 1;
  }
  return -1;
}

fn oned_run_back(row: Array<i32>, end: i32, color: i32) -> i32 {
  if end <= 0 || end > oned_len(row) { return -1; }
  if row[end - 1] != color { return -1; }
  let mut index: i32 = end - 1;
  while index >= 0 && row[index] == color { index = index - 1; }
  return end - 1 - index;
}

// Integer form of ZXing patternMatchVariance for five counters.
// max_indiv_milli and max_avg_milli are thousandths (0.50 -> 500).
fn oned_variance5(
  c0: i32, c1: i32, c2: i32, c3: i32, c4: i32,
  p0: i32, p1: i32, p2: i32, p3: i32, p4: i32,
  max_indiv_milli: i32, max_avg_milli: i32
) -> i32 {
  if c0 <= 0 || c1 <= 0 || c2 <= 0 || c3 <= 0 || c4 <= 0 { return -1; }
  if p0 <= 0 || p1 <= 0 || p2 <= 0 || p3 <= 0 || p4 <= 0 { return -1; }
  let total: i32 = c0 + c1 + c2 + c3 + c4;
  let plen: i32 = p0 + p1 + p2 + p3 + p4;
  if total < plen || plen <= 0 { return -1; }
  let e0: i32 = c.abs_i32(c0 * plen - p0 * total);
  let e1: i32 = c.abs_i32(c1 * plen - p1 * total);
  let e2: i32 = c.abs_i32(c2 * plen - p2 * total);
  let e3: i32 = c.abs_i32(c3 * plen - p3 * total);
  let e4: i32 = c.abs_i32(c4 * plen - p4 * total);
  if e0 * 1000 > max_indiv_milli * total { return -1; }
  if e1 * 1000 > max_indiv_milli * total { return -1; }
  if e2 * 1000 > max_indiv_milli * total { return -1; }
  if e3 * 1000 > max_indiv_milli * total { return -1; }
  if e4 * 1000 > max_indiv_milli * total { return -1; }
  let error: i32 = e0 + e1 + e2 + e3 + e4;
  let avg: i32 = c.safe_div_i32(error * 1000, total * plen);
  if avg < 0 || avg > max_avg_milli { return -1; }
  return avg;
}

fn oned_variance4(
  c0: i32, c1: i32, c2: i32, c3: i32,
  p0: i32, p1: i32, p2: i32, p3: i32,
  max_indiv_milli: i32, max_avg_milli: i32
) -> i32 {
  if c0 <= 0 || c1 <= 0 || c2 <= 0 || c3 <= 0 { return -1; }
  if p0 <= 0 || p1 <= 0 || p2 <= 0 || p3 <= 0 { return -1; }
  let total: i32 = c0 + c1 + c2 + c3;
  let plen: i32 = p0 + p1 + p2 + p3;
  if total < plen || plen <= 0 { return -1; }
  let e0: i32 = c.abs_i32(c0 * plen - p0 * total);
  let e1: i32 = c.abs_i32(c1 * plen - p1 * total);
  let e2: i32 = c.abs_i32(c2 * plen - p2 * total);
  let e3: i32 = c.abs_i32(c3 * plen - p3 * total);
  if e0 * 1000 > max_indiv_milli * total { return -1; }
  if e1 * 1000 > max_indiv_milli * total { return -1; }
  if e2 * 1000 > max_indiv_milli * total { return -1; }
  if e3 * 1000 > max_indiv_milli * total { return -1; }
  let error: i32 = e0 + e1 + e2 + e3;
  let avg: i32 = c.safe_div_i32(error * 1000, total * plen);
  if avg < 0 || avg > max_avg_milli { return -1; }
  return avg;
}

fn oned_variance3(
  c0: i32, c1: i32, c2: i32,
  p0: i32, p1: i32, p2: i32,
  max_indiv_milli: i32, max_avg_milli: i32
) -> i32 {
  if c0 <= 0 || c1 <= 0 || c2 <= 0 { return -1; }
  if p0 <= 0 || p1 <= 0 || p2 <= 0 { return -1; }
  let total: i32 = c0 + c1 + c2;
  let plen: i32 = p0 + p1 + p2;
  if total < plen || plen <= 0 { return -1; }
  let e0: i32 = c.abs_i32(c0 * plen - p0 * total);
  let e1: i32 = c.abs_i32(c1 * plen - p1 * total);
  let e2: i32 = c.abs_i32(c2 * plen - p2 * total);
  if e0 * 1000 > max_indiv_milli * total { return -1; }
  if e1 * 1000 > max_indiv_milli * total { return -1; }
  if e2 * 1000 > max_indiv_milli * total { return -1; }
  let error: i32 = e0 + e1 + e2;
  let avg: i32 = c.safe_div_i32(error * 1000, total * plen);
  if avg < 0 || avg > max_avg_milli { return -1; }
  return avg;
}

// ZXing Code39Reader.toNarrowWidePattern over nine counters.
fn oned_c39_to_pattern(
  c0: i32, c1: i32, c2: i32, c3: i32, c4: i32,
  c5: i32, c6: i32, c7: i32, c8: i32
) -> i32 {
  if c0 <= 0 || c1 <= 0 || c2 <= 0 || c3 <= 0 || c4 <= 0 { return -1; }
  if c5 <= 0 || c6 <= 0 || c7 <= 0 || c8 <= 0 { return -1; }
  let mut max_narrow: i32 = 0;
  let mut attempts: i32 = 0;
  let mut result: i32 = -1;
  let mut done: bool = false;
  while attempts < 9 && !done {
    let mut min_counter: i32 = 0;
    if c0 > max_narrow { min_counter = c0; }
    if c1 > max_narrow {
      if min_counter == 0 || c1 < min_counter { min_counter = c1; }
    }
    if c2 > max_narrow {
      if min_counter == 0 || c2 < min_counter { min_counter = c2; }
    }
    if c3 > max_narrow {
      if min_counter == 0 || c3 < min_counter { min_counter = c3; }
    }
    if c4 > max_narrow {
      if min_counter == 0 || c4 < min_counter { min_counter = c4; }
    }
    if c5 > max_narrow {
      if min_counter == 0 || c5 < min_counter { min_counter = c5; }
    }
    if c6 > max_narrow {
      if min_counter == 0 || c6 < min_counter { min_counter = c6; }
    }
    if c7 > max_narrow {
      if min_counter == 0 || c7 < min_counter { min_counter = c7; }
    }
    if c8 > max_narrow {
      if min_counter == 0 || c8 < min_counter { min_counter = c8; }
    }
    if min_counter <= 0 {
      done = true;
    }
    if !done {
      max_narrow = min_counter;
      let mut wide: i32 = 0;
      let mut total_wide: i32 = 0;
      let mut pattern: i32 = 0;
      if c0 > max_narrow { pattern = pattern + 256; wide = wide + 1; total_wide = total_wide + c0; }
      if c1 > max_narrow { pattern = pattern + 128; wide = wide + 1; total_wide = total_wide + c1; }
      if c2 > max_narrow { pattern = pattern + 64; wide = wide + 1; total_wide = total_wide + c2; }
      if c3 > max_narrow { pattern = pattern + 32; wide = wide + 1; total_wide = total_wide + c3; }
      if c4 > max_narrow { pattern = pattern + 16; wide = wide + 1; total_wide = total_wide + c4; }
      if c5 > max_narrow { pattern = pattern + 8; wide = wide + 1; total_wide = total_wide + c5; }
      if c6 > max_narrow { pattern = pattern + 4; wide = wide + 1; total_wide = total_wide + c6; }
      if c7 > max_narrow { pattern = pattern + 2; wide = wide + 1; total_wide = total_wide + c7; }
      if c8 > max_narrow { pattern = pattern + 1; wide = wide + 1; total_wide = total_wide + c8; }
      if wide == 3 {
        let mut ok: bool = true;
        if c0 > max_narrow {
          if c0 * 2 >= total_wide { ok = false; }
        }
        if c1 > max_narrow {
          if c1 * 2 >= total_wide { ok = false; }
        }
        if c2 > max_narrow {
          if c2 * 2 >= total_wide { ok = false; }
        }
        if c3 > max_narrow {
          if c3 * 2 >= total_wide { ok = false; }
        }
        if c4 > max_narrow {
          if c4 * 2 >= total_wide { ok = false; }
        }
        if c5 > max_narrow {
          if c5 * 2 >= total_wide { ok = false; }
        }
        if c6 > max_narrow {
          if c6 * 2 >= total_wide { ok = false; }
        }
        if c7 > max_narrow {
          if c7 * 2 >= total_wide { ok = false; }
        }
        if c8 > max_narrow {
          if c8 * 2 >= total_wide { ok = false; }
        }
        if ok { result = pattern; }
        done = true;
      }
      if wide < 3 { done = true; }
    }
    attempts = attempts + 1;
  }
  return result;
}

fn oned_c39_record9(row: Array<i32>, start: i32) -> i32 {
  if start < 0 || start >= oned_len(row) { return -1; }
  if row[start] != 1 { return -1; }
  let c0: i32 = oned_run(row, start, 1); if c0 <= 0 { return -1; }
  let p1: i32 = start + c0; let c1: i32 = oned_run(row, p1, 0); if c1 <= 0 { return -1; }
  let p2: i32 = p1 + c1; let c2: i32 = oned_run(row, p2, 1); if c2 <= 0 { return -1; }
  let p3: i32 = p2 + c2; let c3: i32 = oned_run(row, p3, 0); if c3 <= 0 { return -1; }
  let p4: i32 = p3 + c3; let c4: i32 = oned_run(row, p4, 1); if c4 <= 0 { return -1; }
  let p5: i32 = p4 + c4; let c5: i32 = oned_run(row, p5, 0); if c5 <= 0 { return -1; }
  let p6: i32 = p5 + c5; let c6: i32 = oned_run(row, p6, 1); if c6 <= 0 { return -1; }
  let p7: i32 = p6 + c6; let c7: i32 = oned_run(row, p7, 0); if c7 <= 0 { return -1; }
  let p8: i32 = p7 + c7; let c8: i32 = oned_run(row, p8, 1); if c8 <= 0 { return -1; }
  return c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8;
}

fn oned_c39_pattern_at(row: Array<i32>, start: i32) -> i32 {
  if start < 0 || start >= oned_len(row) { return -1; }
  if row[start] != 1 { return -1; }
  let c0: i32 = oned_run(row, start, 1); if c0 <= 0 { return -1; }
  let p1: i32 = start + c0; let c1: i32 = oned_run(row, p1, 0); if c1 <= 0 { return -1; }
  let p2: i32 = p1 + c1; let c2: i32 = oned_run(row, p2, 1); if c2 <= 0 { return -1; }
  let p3: i32 = p2 + c2; let c3: i32 = oned_run(row, p3, 0); if c3 <= 0 { return -1; }
  let p4: i32 = p3 + c3; let c4: i32 = oned_run(row, p4, 1); if c4 <= 0 { return -1; }
  let p5: i32 = p4 + c4; let c5: i32 = oned_run(row, p5, 0); if c5 <= 0 { return -1; }
  let p6: i32 = p5 + c5; let c6: i32 = oned_run(row, p6, 1); if c6 <= 0 { return -1; }
  let p7: i32 = p6 + c6; let c7: i32 = oned_run(row, p7, 0); if c7 <= 0 { return -1; }
  let p8: i32 = p7 + c7; let c8: i32 = oned_run(row, p8, 1); if c8 <= 0 { return -1; }
  return oned_c39_to_pattern(c0, c1, c2, c3, c4, c5, c6, c7, c8);
}

// ZXing Code39Reader CHARACTER_ENCODINGS / ASTERISK_ENCODING (0x094 = 148).
fn oned_c39_char_from_pattern_a(pattern: i32) -> string {
  if pattern == 52 { return "0"; } if pattern == 289 { return "1"; }
  if pattern == 97 { return "2"; } if pattern == 352 { return "3"; }
  if pattern == 49 { return "4"; } if pattern == 304 { return "5"; }
  if pattern == 112 { return "6"; } if pattern == 37 { return "7"; }
  if pattern == 292 { return "8"; } if pattern == 100 { return "9"; }
  return "";
}

fn oned_c39_char_from_pattern_b(pattern: i32) -> string {
  if pattern == 265 { return "A"; } if pattern == 73 { return "B"; }
  if pattern == 328 { return "C"; } if pattern == 25 { return "D"; }
  if pattern == 280 { return "E"; } if pattern == 88 { return "F"; }
  if pattern == 13 { return "G"; } if pattern == 268 { return "H"; }
  if pattern == 76 { return "I"; } if pattern == 28 { return "J"; }
  return "";
}

fn oned_c39_char_from_pattern_c(pattern: i32) -> string {
  if pattern == 259 { return "K"; } if pattern == 67 { return "L"; }
  if pattern == 322 { return "M"; } if pattern == 19 { return "N"; }
  if pattern == 274 { return "O"; } if pattern == 82 { return "P"; }
  if pattern == 7 { return "Q"; } if pattern == 262 { return "R"; }
  if pattern == 70 { return "S"; } if pattern == 22 { return "T"; }
  return "";
}

fn oned_c39_char_from_pattern_d(pattern: i32) -> string {
  if pattern == 385 { return "U"; } if pattern == 193 { return "V"; }
  if pattern == 448 { return "W"; } if pattern == 145 { return "X"; }
  if pattern == 400 { return "Y"; } if pattern == 208 { return "Z"; }
  if pattern == 133 { return "-"; } if pattern == 388 { return "."; }
  if pattern == 196 { return " "; } if pattern == 168 { return "$"; }
  if pattern == 162 { return "/"; } if pattern == 138 { return "+"; }
  if pattern == 42 { return "%"; } if pattern == 148 { return "*"; }
  return "";
}

fn oned_c39_char_from_pattern(pattern: i32) -> string {
  let a: string = oned_c39_char_from_pattern_a(pattern);
  if string_length(a) > 0 { return string_concat("", a); }
  let b: string = oned_c39_char_from_pattern_b(pattern);
  if string_length(b) > 0 { return string_concat("", b); }
  let cpart: string = oned_c39_char_from_pattern_c(pattern);
  if string_length(cpart) > 0 { return string_concat("", cpart); }
  return string_concat("", oned_c39_char_from_pattern_d(pattern));
}

fn oned_c39_find_asterisk(row: Array<i32>) -> i32 {
  let length: i32 = oned_len(row);
  let mut index: i32 = 0;
  while index < length {
    if row[index] == 1 {
      let mut edge: bool = index == 0;
      if index > 0 {
        if row[index - 1] == 0 { edge = true; }
      }
      if edge {
        let pattern: i32 = oned_c39_pattern_at(row, index);
        if pattern == 148 {
          let width: i32 = oned_c39_record9(row, index);
          if width > 0 {
            let quiet_start: i32 = index - width / 2;
            let mut from: i32 = 0;
            if quiet_start > 0 { from = quiet_start; }
            if oned_white_range(row, from, index) { return index; }
          }
        }
      }
    }
    index = index + 1;
  }
  return -1;
}

fn oned_decode_code39_impl(row: Array<i32>) -> string {
  let start: i32 = oned_c39_find_asterisk(row);
  if start < 0 { return ""; }
  let start_width: i32 = oned_c39_record9(row, start);
  if start_width <= 0 { return ""; }
  let length: i32 = oned_len(row);
  let mut position: i32 = oned_next_set(row, start + start_width);
  if position < 0 || position >= length { return ""; }
  let mut result: string = "";
  let mut symbols: i32 = 0;
  while symbols < 64 {
    if position >= length { return ""; }
    if row[position] != 1 { return ""; }
    let pattern: i32 = oned_c39_pattern_at(row, position);
    let width: i32 = oned_c39_record9(row, position);
    if pattern < 0 || width <= 0 { return ""; }
    let symbol: string = oned_c39_char_from_pattern(pattern);
    if string_length(symbol) == 0 { return ""; }
    let next: i32 = position + width;
    let after: i32 = oned_next_set(row, next);
    // Stop asterisk: validate trailing quiet zone and return payload.
    if pattern == 148 {
      if symbols == 0 { return ""; }
      if after != length {
        let white_after: i32 = after - position - width;
        if white_after * 2 < width { return ""; }
      }
      return string_concat("", result);
    }
    result = string_concat(result, symbol);
    position = after;
    symbols = symbols + 1;
  }
  return "";
}

// Returns a packed diagnostic for the first decode step after the start asterisk:
// >=0 pattern of first data symbol; negative codes indicate failure stage.
export fn oned_decode_code39(row: Array<i32>) -> string {
  if oned_len(row) < 15 { return ""; }
  return string_concat("", oned_decode_code39_impl(row));
}

fn oned_counter7(index: i32, c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32) -> i32 {
  if index == 0 { return c0; }
  if index == 1 { return c1; }
  if index == 2 { return c2; }
  if index == 3 { return c3; }
  if index == 4 { return c4; }
  if index == 5 { return c5; }
  if index == 6 { return c6; }
  return -1;
}

fn oned_variance7_pattern(
  c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32,
  pattern: string
) -> i32 {
  if string_length(pattern) != 7 { return -1; }
  let mut total: i32 = 0;
  let mut expected_total: i32 = 0;
  let mut index: i32 = 0;
  while index < 7 {
    let actual: i32 = oned_counter7(index, c0, c1, c2, c3, c4, c5, c6);
    if actual <= 0 { return -1; }
    let bit: i32 = string_byte_at(pattern, index) - 48;
    if bit < 0 || bit > 1 { return -1; }
    total = total + actual;
    expected_total = expected_total + 1 + bit;
    index = index + 1;
  }
  let mut error: i32 = 0;
  index = 0;
  while index < 7 {
    let actual: i32 = oned_counter7(index, c0, c1, c2, c3, c4, c5, c6);
    let expected: i32 = 1 + string_byte_at(pattern, index) - 48;
    error = error + c.abs_i32(actual * expected_total - expected * total);
    index = index + 1;
  }
  return c.safe_div_i32(error * 1000, total * expected_total);
}

fn oned_codabar_pattern(value: i32) -> string {
  if value < 0 || value >= 20 { return ""; }
  let all: string = "00000110000110000100111000000010010100001001000010100100011000010010000001100001100010001011010001101010000101010011010010100100010110001110";
  return string_slice(all, value * 7, value * 7 + 7);
}

fn oned_codabar_char(value: i32) -> string {
  if value < 0 || value >= 20 { return ""; }
  return string_slice("0123456789-$:/.+ABCD", value, value + 1);
}

fn oned_codabar_value(row: Array<i32>, position: i32, end: i32) -> i32 {
  if position < 0 || position >= end || row[position] != 1 { return -1; }
  let c0: i32 = oned_run(row, position, 1); if c0 <= 0 { return -1; }
  let p1: i32 = position + c0; let c1: i32 = oned_run(row, p1, 0); if c1 <= 0 { return -1; }
  let p2: i32 = p1 + c1; let c2: i32 = oned_run(row, p2, 1); if c2 <= 0 { return -1; }
  let p3: i32 = p2 + c2; let c3: i32 = oned_run(row, p3, 0); if c3 <= 0 { return -1; }
  let p4: i32 = p3 + c3; let c4: i32 = oned_run(row, p4, 1); if c4 <= 0 { return -1; }
  let p5: i32 = p4 + c4; let c5: i32 = oned_run(row, p5, 0); if c5 <= 0 { return -1; }
  let p6: i32 = p5 + c5; let c6: i32 = oned_run(row, p6, 1); if c6 <= 0 { return -1; }
  let width: i32 = c0 + c1 + c2 + c3 + c4 + c5 + c6;
  if position + width > end { return -1; }
  let mut best: i32 = 1000;
  let mut match_value: i32 = -1;
  let mut value: i32 = 0;
  while value < 20 {
    let score: i32 = oned_variance7_pattern(c0, c1, c2, c3, c4, c5, c6, oned_codabar_pattern(value));
    if score >= 0 && score < best { best = score; match_value = value; }
    value = value + 1;
  }
  if best > 420 { return -1; }
  return match_value;
}

fn oned_codabar_width(row: Array<i32>, position: i32, end: i32) -> i32 {
  if position < 0 || position >= end || row[position] != 1 { return -1; }
  let mut width: i32 = 0;
  let mut color: i32 = 1;
  let mut count: i32 = 0;
  while count < 7 {
    let run: i32 = oned_run(row, position + width, color);
    if run <= 0 { return -1; }
    width = width + run;
    color = 1 - color;
    count = count + 1;
  }
  if position + width > end { return -1; }
  return width;
}

export fn oned_decode_codabar(row: Array<i32>) -> string {
  let length: i32 = oned_len(row);
  if length < 30 { return ""; }
  let mut position: i32 = oned_next_set(row, 0);
  let mut start_value: i32 = -1;
  let mut guard: i32 = 0;
  while position < length && guard < length && start_value < 0 {
    let value: i32 = oned_codabar_value(row, position, length);
    if value >= 16 && value <= 19 {
      if position == 0 || oned_white_range(row, 0, position) {
        start_value = value;
      }
    }
    if start_value < 0 {
      position = oned_next_set(row, position + 1);
      guard = guard + 1;
    }
  }
  if start_value < 0 || position >= length { return ""; }
  let mut result: string = "";
  let mut symbols: i32 = 0;
  while symbols < 64 {
    let value: i32 = oned_codabar_value(row, position, length);
    let width: i32 = oned_codabar_width(row, position, length);
    if value < 0 || width <= 0 { return ""; }
    if symbols == 0 && value != start_value { return ""; }
    result = string_concat(result, oned_codabar_char(value));
    let next: i32 = oned_next_set(row, position + width);
    if value >= 16 && value <= 19 && symbols > 0 {
      if symbols < 2 || next < length { return ""; }
      return string_slice(result, 1, string_length(result) - 1);
    }
    if next >= length { return ""; }
    position = next;
    symbols = symbols + 1;
  }
  return "";
}

fn oned_code93_pattern(value: i32) -> string {
  if value < 0 || value >= 48 { return ""; }
  let all: string = "";
  return string_slice(all, value * 9, value * 9 + 9);
}

fn oned_code93_char(value: i32) -> string {
  if value < 0 || value > 47 { return ""; }
  return string_slice("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-. $/+%abcd*", value, value + 1);
}

fn oned_code93_value(row: Array<i32>, position: i32, end: i32) -> i32 {
  if position < 0 || position >= end || row[position] != 1 { return -1; }
  let mut best: i32 = 1000;
  let mut match_value: i32 = -1;
  let mut value: i32 = 0;
  while value < 48 {
    let score: i32 = oned_pattern_variance_row(row, position, oned_code93_pattern(value));
    if score >= 0 && score < best { best = score; match_value = value; }
    value = value + 1;
  }
  if best > 420 { return -1; }
  return match_value;
}

fn oned_code93_find_start(row: Array<i32>) -> i32 {
  let length: i32 = oned_len(row);
  let mut position: i32 = oned_next_set(row, 0);
  let mut guard: i32 = 0;
  while position < length && guard < length {
    let score: i32 = oned_pattern_variance_row(row, position, oned_code93_pattern(47));
    if score >= 0 && score <= 420 {
      if position == 0 || oned_white_range(row, 0, position) { return position; }
    }
    position = oned_next_set(row, position + 1);
    guard = guard + 1;
  }
  return -1;
}

fn oned_code93_mod47(value: i32) -> i32 {
  let mut result: i32 = value;
  while result >= 47 { result = result - 47; }
  while result < 0 { result = result + 47; }
  return result;
}

fn oned_code93_validate_checks(value: string) -> bool {
  let length: i32 = string_length(value);
  if length < 3 { return false; }
  let c_index: i32 = length - 2;
  let c_value: i32 = string_byte_at(value, c_index);
  let k_value: i32 = string_byte_at(value, length - 1);
  let mut sum: i32 = 0;
  let mut weight: i32 = 1;
  let mut index: i32 = c_index - 1;
  while index >= 0 {
    let code: i32 = string_byte_at(value, index);
    let mut current: i32 = -1;
    if code >= 48 && code <= 57 { current = code - 48; }
    if code >= 65 && code <= 90 { current = code - 55; }
    if code == 45 { current = 36; }
    if code == 46 { current = 37; }
    if code == 32 { current = 38; }
    if code == 36 { current = 39; }
    if code == 47 { current = 40; }
    if code == 43 { current = 41; }
    if code == 37 { current = 42; }
    if code == 97 { current = 43; }
    if code == 98 { current = 44; }
    if code == 99 { current = 45; }
    if code == 100 { current = 46; }
    if current < 0 { return false; }
    sum = sum + current * weight;
    weight = weight + 1;
    if weight > 20 { weight = 1; }
    index = index - 1;
  }
  let expected_c: i32 = oned_code93_mod47(sum);
  let mut encoded_c: i32 = -1;
  if c_value >= 48 && c_value <= 57 { encoded_c = c_value - 48; }
  if c_value >= 65 && c_value <= 90 { encoded_c = c_value - 55; }
  if c_value == 45 { encoded_c = 36; }
  if c_value == 46 { encoded_c = 37; }
  if c_value == 32 { encoded_c = 38; }
  if c_value == 36 { encoded_c = 39; }
  if c_value == 47 { encoded_c = 40; }
  if c_value == 43 { encoded_c = 41; }
  if c_value == 37 { encoded_c = 42; }
  if c_value == 97 { encoded_c = 43; }
  if c_value == 98 { encoded_c = 44; }
  if c_value == 99 { encoded_c = 45; }
  if c_value == 100 { encoded_c = 46; }
  if encoded_c != expected_c { return false; }
  sum = 0;
  weight = 1;
  index = length - 2;
  while index >= 0 {
    let code: i32 = string_byte_at(value, index);
    let mut current: i32 = -1;
    if code >= 48 && code <= 57 { current = code - 48; }
    if code >= 65 && code <= 90 { current = code - 55; }
    if code == 45 { current = 36; }
    if code == 46 { current = 37; }
    if code == 32 { current = 38; }
    if code == 36 { current = 39; }
    if code == 47 { current = 40; }
    if code == 43 { current = 41; }
    if code == 37 { current = 42; }
    if code == 97 { current = 43; }
    if code == 98 { current = 44; }
    if code == 99 { current = 45; }
    if code == 100 { current = 46; }
    if current < 0 { return false; }
    sum = sum + current * weight;
    weight = weight + 1;
    if weight > 15 { weight = 1; }
    index = index - 1;
  }
  let expected_k: i32 = oned_code93_mod47(sum);
  let mut encoded_k: i32 = -1;
  if k_value >= 48 && k_value <= 57 { encoded_k = k_value - 48; }
  if k_value >= 65 && k_value <= 90 { encoded_k = k_value - 55; }
  if k_value == 45 { encoded_k = 36; }
  if k_value == 46 { encoded_k = 37; }
  if k_value == 32 { encoded_k = 38; }
  if k_value == 36 { encoded_k = 39; }
  if k_value == 47 { encoded_k = 40; }
  if k_value == 43 { encoded_k = 41; }
  if k_value == 37 { encoded_k = 42; }
  if k_value == 97 { encoded_k = 43; }
  if k_value == 98 { encoded_k = 44; }
  if k_value == 99 { encoded_k = 45; }
  if k_value == 100 { encoded_k = 46; }
  return encoded_k == expected_k;
}

export fn oned_decode_code93(row: Array<i32>) -> string {
  if oned_len(row) < 30 { return ""; }
  let start: i32 = oned_code93_find_start(row);
  if start < 0 { return ""; }
  let start_width: i32 = oned_pattern_width(row, start, oned_code93_pattern(47));
  if start_width <= 0 { return ""; }
  let mut position: i32 = oned_next_set(row, start + start_width);
  let length: i32 = oned_len(row);
  let mut encoded: string = "";
  let mut symbols: i32 = 0;
  while position < length && symbols < 64 {
    let value: i32 = oned_code93_value(row, position, length);
    let pattern: string = oned_code93_pattern(value);
    let width: i32 = oned_pattern_width(row, position, pattern);
    if value < 0 || width <= 0 { return ""; }
    if value == 47 {
      if string_length(encoded) < 3 || !oned_code93_validate_checks(encoded) { return ""; }
      let after: i32 = oned_next_set(row, position + width);
      if after >= length || row[after] != 1 { return ""; }
      return string_slice(encoded, 0, string_length(encoded) - 2);
    }
    let character: string = oned_code93_char(value);
    if string_length(character) == 0 { return ""; }
    encoded = string_concat(encoded, character);
    position = oned_next_set(row, position + width);
    symbols = symbols + 1;
  }
  return "";
}
fn oned_code128_pattern(value: i32) -> string {
  if value < 0 || value > 106 { return ""; }
  if value == 106 { return "1100011101011"; }
  let all: string = "";
  return string_slice(all, value * 11, value * 11 + 11);
}

fn oned_code128_mod103(value: i32) -> i32 {
  let mut result: i32 = value;
  while result >= 103 { result = result - 103; }
  while result < 0 { result = result + 103; }
  return result;
}

fn oned_code128_ascii(value: i32, mode: i32) -> string {
  if mode == 1 {
    if value >= 0 && value <= 95 {
      return string_slice(" !\u0022#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~\u007f", value, value + 1);
    }
  }
  if mode == 0 {
    if value >= 0 && value <= 63 { return string_slice(" !\u0022#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[", value, value + 1); }
    if value >= 64 && value <= 95 { return string_slice("\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\u0008\u0009\u000a\u000b\u000c\u000d\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f", value - 64, value - 63); }
  }
  return "";
}

fn oned_code128_value(row: Array<i32>, position: i32, end: i32) -> i32 {
  if position < 0 || position >= end || row[position] != 1 { return -1; }
  let mut best: i32 = 1000;
  let mut match_value: i32 = -1;
  let mut value: i32 = 0;
  while value <= 106 {
    let pattern: string = oned_code128_pattern(value);
    let score: i32 = oned_pattern_variance_row(row, position, pattern);
    if score >= 0 && score < best { best = score; match_value = value; }
    value = value + 1;
  }
  if best > 420 { return -1; }
  return match_value;
}

fn oned_code128_find_start(row: Array<i32>) -> i32 {
  let length: i32 = oned_len(row);
  let mut position: i32 = oned_next_set(row, 0);
  let mut guard: i32 = 0;
  while position < length && guard < length {
    let mut value: i32 = 103;
    while value <= 105 {
      let score: i32 = oned_pattern_variance_row(row, position, oned_code128_pattern(value));
      if score >= 0 && score <= 420 {
        if position == 0 || oned_white_range(row, 0, position) { return position; }
      }
      value = value + 1;
    }
    position = oned_next_set(row, position + 1);
    guard = guard + 1;
  }
  return -1;
}

fn oned_code128_start_value(row: Array<i32>, position: i32) -> i32 {
  let mut best: i32 = 1000;
  let mut match_value: i32 = -1;
  let mut value: i32 = 103;
  while value <= 105 {
    let score: i32 = oned_pattern_variance_row(row, position, oned_code128_pattern(value));
    if score >= 0 && score < best { best = score; match_value = value; }
    value = value + 1;
  }
  if best > 420 { return -1; }
  return match_value;
}

fn oned_code128_append(result: string, value: i32, mode: i32) -> string {
  if mode == 2 {
    if value < 0 || value > 99 { return ""; }
    let tens: i32 = value / 10;
    let ones: i32 = value - tens * 10;
    let tens_text: string = oned_digit(tens);
    let ones_text: string = oned_digit(ones);
    return string_concat(result, string_concat(tens_text, ones_text));
  }
  let character: string = oned_code128_ascii(value, mode);
  if string_length(character) == 0 { return ""; }
  return string_concat(result, character);
}

export fn oned_decode_code128(row: Array<i32>) -> string {
  if oned_len(row) < 35 { return ""; }
  let start: i32 = oned_code128_find_start(row);
  if start < 0 { return ""; }
  let start_value: i32 = oned_code128_start_value(row, start);
  if start_value < 0 { return ""; }
  let mut mode: i32 = 1;
  if start_value == 103 { mode = 0; }
  if start_value == 105 { mode = 2; }
  let start_width: i32 = oned_pattern_width(row, start, oned_code128_pattern(start_value));
  if start_width <= 0 { return ""; }
  let mut position: i32 = oned_next_set(row, start + start_width);
  let length: i32 = oned_len(row);
  let mut result: string = "";
  let mut pending: i32 = -1;
  let mut pending_mode: i32 = mode;
  let mut weighted: i32 = start_value;
  let mut weight: i32 = 1;
  let mut data_count: i32 = 0;
  let mut symbols: i32 = 0;
  while position < length && symbols < 96 {
    let value: i32 = oned_code128_value(row, position, length);
    let pattern: string = oned_code128_pattern(value);
    let width: i32 = oned_pattern_width(row, position, pattern);
    if value < 0 || width <= 0 { return ""; }
    if value == 106 {
      if pending < 0 || data_count <= 0 || oned_code128_mod103(weighted) != pending { return ""; }
      let after: i32 = oned_next_set(row, position + width);
      if after < length && after - position - width < width / 2 { return ""; }
      return string_concat("", result);
    }
    if pending >= 0 {
      if pending == 99 { mode = 2; }
      if pending == 100 { mode = 1; }
      if pending == 101 { mode = 0; }
      if pending == 98 { return ""; }
      if pending != 99 && pending != 100 && pending != 101 && pending != 102 {
        let before: i32 = string_length(result);
        result = oned_code128_append(result, pending, pending_mode);
        if string_length(result) <= before { return ""; }
      }
      weighted = weighted + pending * weight;
      weight = weight + 1;
      data_count = data_count + 1;
    }
    pending = value;
    pending_mode = mode;
    position = oned_next_set(row, position + width);
    symbols = symbols + 1;
  }
  return "";
}

// ---------------------------------------------------------------------------
// RSS-14 / GS1 DataBar Omnidirectional and RSS Expanded, ported from ZXing's
// com.google.zxing.oned.rss.{RSS14Reader,RSSUtils,AbstractRSSReader} and
// oned.rss.expanded.{RSSExpandedReader,BitArrayBuilder,decoders.*}. Scratch
// counters use bounded linear-memory scratch (c.mem_alloc_bytes) because FWS
// arrays are ABI-owned caller values and cannot be constructed inside the
// graph. Row/finder helpers are scale-invariant counter recordings (never a
// fixed-pixel offset), matching ZXing's recordPattern/recordPatternInReverse.

fn oned_rss_bit(row: Array<i32>, length: i32, index: i32, reversed: bool) -> bool {
  if index < 0 || index >= length { return false; }
  if reversed { return row[length - index - 1] != 0; }
  return row[index] != 0;
}

fn oned_rss_parity(value: i32) -> i32 {
  return value - c.safe_div_i32(value, 2) * 2;
}

fn oned_rss_pow2(power: i32) -> i32 {
  let mut value: i32 = 1;
  let mut index: i32 = 0;
  while index < power { value = value * 2; index = index + 1; }
  return value;
}

// ISO/IEC 24724 Annex combinatorics, ported from RSSUtils.combins().
// RSS groups have four elements, so `r` is at most two and `n` stays small;
// the numerator/denominator products therefore remain well within i32. A
// single final division keeps the arithmetic parser-safe and avoids the
// interleaved divide-as-you-go accumulation that mis-compiled here.
fn oned_rss_combins(n: i32, r: i32) -> i32 {
  if r < 0 || n < 0 || r > n { return 0; }
  let mut smaller: i32 = r;
  if n - r < smaller { smaller = n - r; }
  let mut numerator: i32 = 1;
  let mut denominator: i32 = 1;
  let mut index: i32 = 0;
  while index < smaller {
    let factor: i32 = n - index;
    let divisor: i32 = index + 1;
    numerator = numerator * factor;
    denominator = denominator * divisor;
    index = index + 1;
  }
  return c.safe_div_i32(numerator, denominator);
}

// RSSUtils.getRSSvalue(): the combinatorial index of one 4-run odd/even
// group. `stuck_count` tracks how many earlier runs stayed at width 1 for
// the whole group (RSSUtils' `narrowMask` bit, which Flint has no bitwise-AND
// to clear idempotently, so it is modeled as an explicit counter instead of
// a shared bitmask).
fn oned_rss_group_value(counts: u32, parity_offset: i32, max_width: i32, no_narrow: bool) -> i32 {
  let mut remaining: i32 = 0;
  let mut index: i32 = 0;
  while index < 4 { remaining = remaining + c.mem_get_u8(counts, index * 2 + parity_offset); index = index + 1; }
  let mut value: i32 = 0;
  let mut stuck_count: i32 = 0;
  let mut bar: i32 = 0;
  while bar < 3 {
    let width: i32 = c.mem_get_u8(counts, bar * 2 + parity_offset);
    let elements_left: i32 = 4 - bar - 1;
    let mut element_width: i32 = 1;
    while element_width < width {
      let mut sub_value: i32 = oned_rss_combins(remaining - element_width - 1, elements_left - 1);
      let cond1: bool = element_width > 1;
      let cond2: bool = stuck_count == 0;
      let cond3: bool = remaining - element_width - elements_left >= elements_left;
      let apply_no_narrow: bool = no_narrow && cond1 && cond2 && cond3;
      if apply_no_narrow {
        sub_value = sub_value - oned_rss_combins(remaining - element_width - 4 + bar, elements_left - 1);
      }
      if elements_left > 1 {
        let mut less_value: i32 = 0;
        let mut widest: i32 = remaining - element_width - 2 + bar;
        while widest > max_width {
          less_value = less_value + oned_rss_combins(remaining - element_width - widest - 1, elements_left - 2);
          widest = widest - 1;
        }
        let multiplier: i32 = 3 - bar;
        sub_value = sub_value - less_value * multiplier;
      }
      if elements_left <= 1 {
        if remaining - element_width > max_width { sub_value = sub_value - 1; }
      }
      value = value + sub_value;
      element_width = element_width + 1;
    }
    if width == 1 { stuck_count = stuck_count + 1; }
    remaining = remaining - width;
    bar = bar + 1;
  }
  return value;
}

// OneDReader.recordPattern(): fills `count` consecutive run widths starting
// at `start`, auto-detecting the initial color. Scale-invariant.
fn oned_rss_record_pattern(
  row: Array<i32>, length: i32, reversed: bool, start: i32, count: i32, counters: u32
) -> bool {
  let mut clear: i32 = 0;
  while clear < count { c.mem_set_u8(counters, clear, 0); clear = clear + 1; }
  if start < 0 || start >= length { return false; }
  // Record exactly `count` consecutive maximal-color runs forward from `start`,
  // auto-detecting the initial color. The count-th run absorbs same-colour
  // pixels up to the next transition or the row end, matching ZXing's
  // recordPattern acceptance of a trailing (numCounters-1, i==end) run. The
  // explicit run-span form fills every counter, including the last, avoiding
  // the previous state-machine off-by-one that left counters[count-1] at 0.
  let mut index: i32 = start;
  let mut run: i32 = 0;
  let mut color: bool = oned_rss_bit(row, length, start, reversed);
  while run < count {
    let mut width: i32 = 0;
    while index < length && oned_rss_bit(row, length, index, reversed) == color {
      width = width + 1;
      index = index + 1;
    }
    if width <= 0 { return false; }
    c.mem_set_u8(counters, run, width);
    run = run + 1;
    color = !color;
  }
  return true;
}

// OneDReader.recordPatternInReverse(): scans backward from `start` counting
// `count` transitions, then records forward from the discovered boundary.
fn oned_rss_record_pattern_reverse(
  row: Array<i32>, length: i32, reversed: bool, start: i32, count: i32, counters: u32
) -> bool {
  if start <= 0 || start > length { return false; }
  let mut index: i32 = start - 1;
  let mut run: i32 = 0;
  let mut color: bool = oned_rss_bit(row, length, index, reversed);
  while run < count {
    let mut width: i32 = 0;
    while index >= 0 && oned_rss_bit(row, length, index, reversed) == color {
      width = width + 1;
      index = index - 1;
    }
    if width <= 0 { return false; }
    c.mem_set_u8(counters, run, width);
    run = run + 1;
    color = !color;
  }
  let mut left: i32 = 0;
  let mut right: i32 = count - 1;
  while left < right {
    let a: i32 = c.mem_get_u8(counters, left);
    let b: i32 = c.mem_get_u8(counters, right);
    c.mem_set_u8(counters, left, b);
    c.mem_set_u8(counters, right, a);
    left = left + 1;
    right = right - 1;
  }
  return true;
}


// AbstractRSSReader.isFinderPattern(): shared ratio/uniformity gate reused by
// both RSS-14's 4-counter finder search and RSS Expanded's finder search.
fn oned_rss_finder_ratio(counters: u32) -> bool {
  let mut minimum: i32 = c.mem_get_u8(counters, 0);
  let mut maximum: i32 = minimum;
  let mut index: i32 = 1;
  while index < 4 {
    let value: i32 = c.mem_get_u8(counters, index);
    if value < minimum { minimum = value; }
    if value > maximum { maximum = value; }
    index = index + 1;
  }
  return minimum > 0 && maximum < 10 * minimum;
}

// AbstractRSSReader.parseFinderValue(): shared normalized 4-counter variance
// matcher for both RSS-14's 9-entry and RSS Expanded's 6-entry finder tables.
fn oned_rss_finder_matches(a: i32, b: i32, d: i32, e: i32, pa: i32, pb: i32, pd: i32, pe: i32) -> bool {
  let total: i32 = a + b + d + e;
  let pattern_total: i32 = pa + pb + pd + pe;
  let variance_a: i32 = c.abs_i32(a * pattern_total - pa * total);
  let variance_b: i32 = c.abs_i32(b * pattern_total - pb * total);
  let variance_d: i32 = c.abs_i32(d * pattern_total - pd * total);
  let variance_e: i32 = c.abs_i32(e * pattern_total - pe * total);
  if variance_a * 20 > total * 9 || variance_b * 20 > total * 9
    || variance_d * 20 > total * 9 || variance_e * 20 > total * 9 { return false; }
  let variance: i32 = variance_a + variance_b + variance_d + variance_e;
  return variance * 5 < total * pattern_total;
}

fn oned_rss14_finder_pattern_value(a: i32, b: i32, d: i32, e: i32) -> i32 {
  if oned_rss_finder_matches(a, b, d, e, 3, 8, 2, 1) { return 0; }
  if oned_rss_finder_matches(a, b, d, e, 3, 5, 5, 1) { return 1; }
  if oned_rss_finder_matches(a, b, d, e, 3, 3, 7, 1) { return 2; }
  if oned_rss_finder_matches(a, b, d, e, 3, 1, 9, 1) { return 3; }
  if oned_rss_finder_matches(a, b, d, e, 2, 7, 4, 1) { return 4; }
  if oned_rss_finder_matches(a, b, d, e, 2, 5, 6, 1) { return 5; }
  if oned_rss_finder_matches(a, b, d, e, 2, 3, 8, 1) { return 6; }
  if oned_rss_finder_matches(a, b, d, e, 1, 5, 7, 1) { return 7; }
  if oned_rss_finder_matches(a, b, d, e, 1, 3, 9, 1) { return 8; }
  return -1;
}

// RSS14Reader.findFinderPattern(): packs (patternStart * 65536 + end).
fn oned_rss14_find_finder(row: Array<i32>, length: i32, reversed: bool, right: bool, counters: u32) -> i32 {
  c.mem_set_u8(counters, 0, 0);
  c.mem_set_u8(counters, 1, 0);
  c.mem_set_u8(counters, 2, 0);
  c.mem_set_u8(counters, 3, 0);
  let mut offset: i32 = 0;
  let mut is_white: bool = false;
  let mut found: bool = false;
  while offset < length && !found {
    is_white = !oned_rss_bit(row, length, offset, reversed);
    if !is_white { found = true; }
    if is_white { offset = offset + 1; }
  }
  if offset >= length { return -1; }
  let mut position: i32 = 0;
  let mut pattern_start: i32 = offset;
  let mut x: i32 = offset;
  while x < length {
    let bit: bool = oned_rss_bit(row, length, x, reversed);
    if bit != is_white {
      c.mem_set_u8(counters, position, c.mem_get_u8(counters, position) + 1);
    }
    if bit == is_white {
      let was_full: bool = position == 3;
      if was_full {
        let finder_value: i32 = oned_rss14_finder_pattern_value(
          c.mem_get_u8(counters, 0), c.mem_get_u8(counters, 1),
          c.mem_get_u8(counters, 2), c.mem_get_u8(counters, 3)
        );
        if finder_value >= 0 { return pattern_start * 65536 + x; }
        pattern_start = pattern_start + c.mem_get_u8(counters, 0) + c.mem_get_u8(counters, 1);
        c.mem_set_u8(counters, 0, c.mem_get_u8(counters, 2));
        c.mem_set_u8(counters, 1, c.mem_get_u8(counters, 3));
        c.mem_set_u8(counters, 2, 0);
        c.mem_set_u8(counters, 3, 0);
        position = position - 1;
      }
      if !was_full { position = position + 1; }
      c.mem_set_u8(counters, position, 1);
      is_white = !is_white;
    }
    x = x + 1;
  }
  return -1;
}

// RSS14Reader.parseFoundFinderPattern(): validates the four-run finder window
// returned by the rolling search. The flat reader keeps the matched window as
// the finder bounds, so character decoding can use the same boundaries on
// both orientations without reconstructing an adjacent data run.
fn oned_rss14_parse_finder(row: Array<i32>, length: i32, reversed: bool, packed: i32, counters: u32) -> i32 {
  let start: i32 = c.safe_div_i32(packed, 65536);
  let end: i32 = packed - start * 65536;
  let value: i32 = oned_rss14_finder_pattern_value(
    c.mem_get_u8(counters, 0), c.mem_get_u8(counters, 1),
    c.mem_get_u8(counters, 2), c.mem_get_u8(counters, 3)
  );
  if value < 0 { return -1; }
  if end <= start { return -1; }
  return start * 16 + value;
}

fn oned_rss_error_at(errors: u32, index: i32) -> i32 {
  return c.mem_get_u8(errors, index) - 128;
}

fn oned_rss_nudge(counts: u32, errors: u32, parity_offset: i32, increment: bool) -> unit {
  let mut selected: i32 = parity_offset;
  let mut selected_error: i32 = oned_rss_error_at(errors, parity_offset);
  let mut index: i32 = parity_offset + 2;
  while index < 8 {
    let error: i32 = oned_rss_error_at(errors, index);
    if increment && error > selected_error { selected = index; selected_error = error; }
    if !increment && error < selected_error { selected = index; selected_error = error; }
    index = index + 2;
  }
  let mut delta: i32 = -1;
  if increment { delta = 1; }
  c.mem_set_u8(counts, selected, c.mem_get_u8(counts, selected) + delta);
}

// RSS14Reader.adjustOddEvenCounts(): outside characters allow a 4..12 sum
// range, inside characters 5..11/4..10 (see below); Flint has no `else`, so
// each mutually-exclusive branch is captured with an explicit paired `if`.
fn oned_rss14_adjust_counts(outside: bool, counts: u32, errors: u32, modules: i32) -> bool {
  let mut odd_sum: i32 = 0;
  let mut even_sum: i32 = 0;
  let mut index: i32 = 0;
  while index < 8 {
    if oned_rss_parity(index) == 0 { odd_sum = odd_sum + c.mem_get_u8(counts, index); }
    if oned_rss_parity(index) == 1 { even_sum = even_sum + c.mem_get_u8(counts, index); }
    index = index + 1;
  }
  let mut inc_odd: bool = false;
  let mut dec_odd: bool = false;
  let mut inc_even: bool = false;
  let mut dec_even: bool = false;
  if outside {
    if odd_sum > 12 { dec_odd = true; }
    if odd_sum < 4 { inc_odd = true; }
    if even_sum > 12 { dec_even = true; }
    if even_sum < 4 { inc_even = true; }
  }
  if !outside {
    if odd_sum > 11 { dec_odd = true; }
    if odd_sum < 5 { inc_odd = true; }
    if even_sum > 10 { dec_even = true; }
    if even_sum < 4 { inc_even = true; }
  }
  let mismatch: i32 = odd_sum + even_sum - modules;
  let mut odd_bad: bool = oned_rss_parity(odd_sum) == 1;
  if !outside { odd_bad = oned_rss_parity(odd_sum) == 0; }
  let even_bad: bool = oned_rss_parity(even_sum) == 1;

  if mismatch != 1 && mismatch != -1 && mismatch != 0 { return false; }
  if mismatch == 1 {
    if odd_bad && even_bad { return false; }
    if odd_bad && !even_bad { dec_odd = true; }
    if !odd_bad && !even_bad { return false; }
    if !odd_bad && even_bad { dec_even = true; }
  }
  if mismatch == -1 {
    if odd_bad && even_bad { return false; }
    if odd_bad && !even_bad { inc_odd = true; }
    if !odd_bad && !even_bad { return false; }
    if !odd_bad && even_bad { inc_even = true; }
  }
  if mismatch == 0 {
    if odd_bad && !even_bad { return false; }
    if odd_bad && even_bad {
      if odd_sum < even_sum { inc_odd = true; dec_even = true; }
      if odd_sum >= even_sum { dec_odd = true; inc_even = true; }
    }
    if !odd_bad && even_bad { return false; }
  }

  if inc_odd && dec_odd { return false; }
  if inc_even && dec_even { return false; }
  if inc_odd { oned_rss_nudge(counts, errors, 0, true); }
  if dec_odd { oned_rss_nudge(counts, errors, 0, false); }
  if inc_even { oned_rss_nudge(counts, errors, 1, true); }
  if dec_even { oned_rss_nudge(counts, errors, 1, false); }
  return true;
}

fn oned_rss14_outside_even_total(group: i32) -> i32 {
  if group == 0 { return 1; } if group == 1 { return 10; }
  if group == 2 { return 34; } if group == 3 { return 70; } return 126;
}
fn oned_rss14_outside_gsum(group: i32) -> i32 {
  if group == 0 { return 0; } if group == 1 { return 161; }
  if group == 2 { return 961; } if group == 3 { return 2015; } return 2715;
}
fn oned_rss14_outside_odd_widest(group: i32) -> i32 {
  if group == 0 { return 8; } if group == 1 { return 6; }
  if group == 2 { return 4; } if group == 3 { return 3; } return 1;
}
fn oned_rss14_inside_odd_total(group: i32) -> i32 {
  if group == 0 { return 4; } if group == 1 { return 20; }
  if group == 2 { return 48; } return 81;
}
fn oned_rss14_inside_gsum(group: i32) -> i32 {
  if group == 0 { return 0; } if group == 1 { return 336; }
  if group == 2 { return 1036; } return 1516;
}
fn oned_rss14_inside_odd_widest(group: i32) -> i32 {
  if group == 0 { return 2; } if group == 1 { return 4; }
  if group == 2 { return 6; } return 8;
}

// RSS14Reader.decodeDataCharacter(): field 0 = character value, field 1 =
// checksum portion, -1 = not-found. The outside branch uses a proper
// scale-invariant backward scan (recordPatternInReverse), not a fixed pixel
// offset, so this remains correct under 2x/3x rasterization.
fn oned_rss14_decode_character(
  row: Array<i32>, length: i32, reversed: bool, start: i32, end: i32, outside: bool, field: i32
) -> i32 {
  let raw: u32 = c.mem_alloc_bytes(8);
  if outside {
    if !oned_rss_record_pattern_reverse(row, length, reversed, start, 8, raw) { return -1; }
  }
  if !outside {
    if !oned_rss_record_pattern(row, length, reversed, end, 8, raw) { return -1; }
    let mut swap: i32 = 0;
    while swap < 4 {
      let left: i32 = c.mem_get_u8(raw, swap);
      c.mem_set_u8(raw, swap, c.mem_get_u8(raw, 7 - swap));
      c.mem_set_u8(raw, 7 - swap, left);
      swap = swap + 1;
    }
  }
  let mut num_modules: i32 = 15;
  if outside { num_modules = 16; }
  let mut sum: i32 = 0;
  let mut index: i32 = 0;
  while index < 8 { sum = sum + c.mem_get_u8(raw, index); index = index + 1; }
  if sum <= 0 { return -1; }
  let counts: u32 = c.mem_alloc_bytes(8);
  let errors: u32 = c.mem_alloc_bytes(8);
  index = 0;
  while index < 8 {
    let scaled: i32 = c.mem_get_u8(raw, index) * num_modules;
    let rounded: i32 = scaled + c.safe_div_i32(sum, 2);
    let mut count: i32 = c.safe_div_i32(rounded, sum);
    count = c.clamp_i32(count, 1, 8);
    c.mem_set_u8(counts, index, count);
    c.mem_set_u8(errors, index, c.clamp_i32(scaled - count * sum + 128, 0, 255));
    index = index + 1;
  }
  if !oned_rss14_adjust_counts(outside, counts, errors, num_modules) { return -1; }
  let mut odd_sum: i32 = 0;
  let mut even_sum: i32 = 0;
  let mut odd_checksum: i32 = 0;
  let mut even_checksum: i32 = 0;
  index = 3;
  while index >= 0 {
    let odd: i32 = c.mem_get_u8(counts, index * 2);
    let even: i32 = c.mem_get_u8(counts, index * 2 + 1);
    odd_checksum = odd_checksum * 9 + odd;
    even_checksum = even_checksum * 9 + even;
    odd_sum = odd_sum + odd;
    even_sum = even_sum + even;
    index = index - 1;
  }
  if field == 1 { return odd_checksum + 3 * even_checksum; }
  if outside {
    if oned_rss_parity(odd_sum) != 0 || odd_sum > 12 || odd_sum < 4 { return -1; }
    let group: i32 = c.safe_div_i32(12 - odd_sum, 2);
    let odd_widest: i32 = oned_rss14_outside_odd_widest(group);
    return oned_rss_group_value(counts, 0, odd_widest, false) * oned_rss14_outside_even_total(group)
      + oned_rss_group_value(counts, 1, 9 - odd_widest, true) + oned_rss14_outside_gsum(group);
  }
  if oned_rss_parity(even_sum) != 0 || even_sum > 10 || even_sum < 4 { return -1; }
  let group2: i32 = c.safe_div_i32(10 - even_sum, 2);
  let odd_widest2: i32 = oned_rss14_inside_odd_widest(group2);
  return oned_rss_group_value(counts, 1, 9 - odd_widest2, false) * oned_rss14_inside_odd_total(group2)
    + oned_rss_group_value(counts, 0, odd_widest2, true) + oned_rss14_inside_gsum(group2);
}

// field 0 = value, 1 = checksum, 2 = finder value.
export fn oned_rss14_decode_pair(row: Array<i32>, length: i32, reversed: bool, right: bool, field: i32) -> i32 {
  let counters: u32 = c.mem_alloc_bytes(8);
  let packed: i32 = oned_rss14_find_finder(row, length, reversed, right, counters);
  if packed < 0 { return -1; }
  let parsed: i32 = oned_rss14_parse_finder(row, length, reversed, packed, counters);
  if parsed < 0 { return -1; }
  let first_start: i32 = c.safe_div_i32(parsed, 16);
  let finder: i32 = parsed - first_start * 16;
  if field == 2 { return finder; }
  let end: i32 = packed - c.safe_div_i32(packed, 65536) * 65536;
  if field == 3 { return oned_rss14_decode_character(row, length, reversed, first_start, end, true, 0); }
  if field == 4 { return oned_rss14_decode_character(row, length, reversed, first_start, end, false, 0); }
  if field == 5 { return first_start; }
  if field == 6 { return end; }
  let outside_value: i32 = oned_rss14_decode_character(row, length, reversed, first_start, end, true, field);
  let inside_value: i32 = oned_rss14_decode_character(row, length, reversed, first_start, end, false, field);
  if outside_value < 0 || inside_value < 0 { return -1; }
  if field == 1 { return outside_value + 4 * inside_value; }
  return 1597 * outside_value + inside_value;
}

// Compute `4537077 * left + right`, padded to 13 digits, plus a mod-10 check
// digit, using base-100 chunks so every intermediate stays within i32.
fn oned_rss14_construct_result(left: i32, right: i32) -> string {
  let left0: i32 = left - c.safe_div_i32(left, 100) * 100;
  let left1: i32 = c.safe_div_i32(left, 100) - c.safe_div_i32(left, 10000) * 100;
  let left2: i32 = c.safe_div_i32(left, 10000) - c.safe_div_i32(left, 1000000) * 100;
  let left3: i32 = c.safe_div_i32(left, 1000000);
  let right0: i32 = right - c.safe_div_i32(right, 100) * 100;
  let right1: i32 = c.safe_div_i32(right, 100) - c.safe_div_i32(right, 10000) * 100;
  let right2: i32 = c.safe_div_i32(right, 10000) - c.safe_div_i32(right, 1000000) * 100;
  let right3: i32 = c.safe_div_i32(right, 1000000);

  let mut value: i32 = left0 * 77 + right0;
  let chunk0: i32 = value - c.safe_div_i32(value, 100) * 100;
  let mut carry: i32 = c.safe_div_i32(value, 100);
  value = left0 * 70 + left1 * 77 + right1 + carry;
  let chunk1: i32 = value - c.safe_div_i32(value, 100) * 100;
  carry = c.safe_div_i32(value, 100);
  value = left0 * 53 + left1 * 70 + left2 * 77 + right2 + carry;
  let chunk2: i32 = value - c.safe_div_i32(value, 100) * 100;
  carry = c.safe_div_i32(value, 100);
  value = left0 * 4 + left1 * 53 + left2 * 70 + left3 * 77 + right3 + carry;
  let chunk3: i32 = value - c.safe_div_i32(value, 100) * 100;
  carry = c.safe_div_i32(value, 100);
  value = left1 * 4 + left2 * 53 + left3 * 70 + carry;
  let chunk4: i32 = value - c.safe_div_i32(value, 100) * 100;
  carry = c.safe_div_i32(value, 100);
  value = left2 * 4 + left3 * 53 + carry;
  let chunk5: i32 = value - c.safe_div_i32(value, 100) * 100;
  let chunk6: i32 = left3 * 4 + c.safe_div_i32(value, 100);

  let chunk5_tens: i32 = c.safe_div_i32(chunk5, 10);
  let chunk4_tens: i32 = c.safe_div_i32(chunk4, 10);
  let chunk3_tens: i32 = c.safe_div_i32(chunk3, 10);
  let chunk2_tens: i32 = c.safe_div_i32(chunk2, 10);
  let chunk1_tens: i32 = c.safe_div_i32(chunk1, 10);
  let chunk0_tens: i32 = c.safe_div_i32(chunk0, 10);
  let pair5: string = string_concat(c.digit_char(chunk5_tens), c.digit_char(chunk5 - chunk5_tens * 10));
  let pair4: string = string_concat(c.digit_char(chunk4_tens), c.digit_char(chunk4 - chunk4_tens * 10));
  let pair3: string = string_concat(c.digit_char(chunk3_tens), c.digit_char(chunk3 - chunk3_tens * 10));
  let pair2: string = string_concat(c.digit_char(chunk2_tens), c.digit_char(chunk2 - chunk2_tens * 10));
  let pair1: string = string_concat(c.digit_char(chunk1_tens), c.digit_char(chunk1 - chunk1_tens * 10));
  let pair0: string = string_concat(c.digit_char(chunk0_tens), c.digit_char(chunk0 - chunk0_tens * 10));
  let high: string = string_concat(c.digit_char(chunk6), pair5);
  let upper: string = string_concat(pair4, pair3);
  let lower: string = string_concat(pair2, pair1);
  let text: string = string_concat(string_concat(high, upper), string_concat(lower, pair0));
  let mut checksum: i32 = 0;
  let mut index: i32 = 0;
  while index < 13 {
    let digit: i32 = string_byte_at(text, index) - 48;
    if oned_rss_parity(index) == 0 { checksum = checksum + digit * 3; }
    if oned_rss_parity(index) == 1 { checksum = checksum + digit; }
    index = index + 1;
  }
  let checksum_remainder: i32 = checksum - c.safe_div_i32(checksum, 10) * 10;
  let mut check_digit: i32 = 10 - checksum_remainder;
  if check_digit == 10 { check_digit = 0; }
  return string_concat(text, c.digit_char(check_digit));
}


export fn oned_decode_rss14(row: Array<i32>) -> string {
  let length: i32 = oned_len(row);
  if length < 30 { return ""; }
  let left: i32 = oned_rss14_decode_pair(row, length, false, false, 0);
  let right: i32 = oned_rss14_decode_pair(row, length, true, true, 0);
  let left_checksum: i32 = oned_rss14_decode_pair(row, length, false, false, 1);
  let right_checksum: i32 = oned_rss14_decode_pair(row, length, true, true, 1);
  let left_finder: i32 = oned_rss14_decode_pair(row, length, false, false, 2);
  let right_finder: i32 = oned_rss14_decode_pair(row, length, true, true, 2);
  if left < 0 || right < 0 || left_checksum < 0 || right_checksum < 0
    || left_finder < 0 || right_finder < 0 { return ""; }
  let mut check_value: i32 = left_checksum + 16 * right_checksum;
  check_value = check_value - c.safe_div_i32(check_value, 79) * 79;
  let mut target: i32 = 9 * left_finder + right_finder;
  if target > 72 { target = target - 1; }
  if target > 8 { target = target - 1; }
  if check_value != target { return ""; }
  return string_concat("", oned_rss14_construct_result(left, right));
}

// ---------------------------------------------------------------------------
// RSS Expanded, bounded to the shortest ISO/IEC 24724 finder sequence
// (FINDER_PATTERN_SEQUENCES[0] = {A, A}, i.e. exactly two pairs / three data
// characters plus one checksum character) decoded through ZXing's
// AnyAIDecoder general-numeric field only. Longer finder sequences, the
// fixed-AI decoders (AI01AndOtherAIs, AI013103, ...), and alpha/ISO-646
// compaction blocks are out of scope for this pass and fail closed rather
// than emit a fabricated payload.

fn oned_rss_exp_reverse4(counters: u32) -> unit {
  let a: i32 = c.mem_get_u8(counters, 0);
  let b: i32 = c.mem_get_u8(counters, 1);
  let d: i32 = c.mem_get_u8(counters, 2);
  let e: i32 = c.mem_get_u8(counters, 3);
  c.mem_set_u8(counters, 0, e);
  c.mem_set_u8(counters, 1, d);
  c.mem_set_u8(counters, 2, b);
  c.mem_set_u8(counters, 3, a);
}

fn oned_rss_exp_finder_pattern_value(a: i32, b: i32, d: i32, e: i32) -> i32 {
  if oned_rss_finder_matches(a, b, d, e, 1, 8, 4, 1) { return 0; }
  if oned_rss_finder_matches(a, b, d, e, 3, 6, 4, 1) { return 1; }
  if oned_rss_finder_matches(a, b, d, e, 3, 4, 6, 1) { return 2; }
  if oned_rss_finder_matches(a, b, d, e, 3, 2, 8, 1) { return 3; }
  if oned_rss_finder_matches(a, b, d, e, 2, 6, 5, 1) { return 4; }
  if oned_rss_finder_matches(a, b, d, e, 2, 2, 9, 1) { return 5; }
  return -1;
}

// RSSExpandedReader.findNextPair(): packs (patternStart * 65536 + end).
// `searching_even` mirrors ZXing's per-pair counter reversal for mirrored
// (even-index) pairs; on a match the counters are intentionally left in
// that (possibly reversed) orientation for the parse step, exactly as
// ZXing's shared `decodeFinderCounters` field is left after a match.
export fn oned_rss_exp_find_pair(row: Array<i32>, length: i32, row_offset: i32, searching_even: bool, counters: u32) -> i32 {
  c.mem_set_u8(counters, 0, 0);
  c.mem_set_u8(counters, 1, 0);
  c.mem_set_u8(counters, 2, 0);
  c.mem_set_u8(counters, 3, 0);
  let mut offset: i32 = row_offset;
  while offset < length && row[offset] == 0 { offset = offset + 1; }
  if offset >= length { return -1; }
  let mut is_white: bool = false;
  let mut position: i32 = 0;
  let mut pattern_start: i32 = offset;
  let mut x: i32 = offset;
  while x < length {
    let bit: bool = oned_rss_bit(row, length, x, false);
    if bit != is_white {
      c.mem_set_u8(counters, position, c.mem_get_u8(counters, position) + 1);
    }
    if bit == is_white {
      let was_full: bool = position == 3;
      if was_full {
        if searching_even { oned_rss_exp_reverse4(counters); }
        let finder_value: i32 = oned_rss_exp_finder_pattern_value(
          c.mem_get_u8(counters, 0), c.mem_get_u8(counters, 1),
          c.mem_get_u8(counters, 2), c.mem_get_u8(counters, 3)
        );
        if finder_value >= 0 { return pattern_start * 65536 + x; }
        if searching_even { oned_rss_exp_reverse4(counters); }
        pattern_start = pattern_start + c.mem_get_u8(counters, 0) + c.mem_get_u8(counters, 1);
        c.mem_set_u8(counters, 0, c.mem_get_u8(counters, 2));
        c.mem_set_u8(counters, 1, c.mem_get_u8(counters, 3));
        c.mem_set_u8(counters, 2, 0);
        c.mem_set_u8(counters, 3, 0);
        position = position - 1;
      }
      if !was_full { position = position + 1; }
      c.mem_set_u8(counters, position, 1);
      is_white = !is_white;
    }
    x = x + 1;
  }
  return -1;
}

// RSSExpandedReader.parseFoundFinderPattern(): field 0 returns the adjusted
// (start*65536+end) pair, field 1 returns the finder value.
export fn oned_rss_exp_parse_finder(
  row: Array<i32>, length: i32, packed: i32, odd_pattern: bool, counters: u32, field: i32
) -> i32 {
  let start0: i32 = c.safe_div_i32(packed, 65536);
  let end0: i32 = packed - start0 * 65536;
  if field == 0 { return start0 * 65536 + end0; }
  return oned_rss_exp_finder_pattern_value(
    c.mem_get_u8(counters, 0), c.mem_get_u8(counters, 1),
    c.mem_get_u8(counters, 2), c.mem_get_u8(counters, 3)
  );
}

// Locates and validates one pair's finder pattern; returns the packed
// (start*65536+end) or -1. Bounded to finder value A (0), the only value
// used by the supported two-pair {A, A} sequence.
fn oned_rss_exp_pair_start(
  row: Array<i32>, length: i32, row_offset: i32, odd_pattern: bool, searching_even: bool, counters: u32
) -> i32 {
  let packed: i32 = oned_rss_exp_find_pair(row, length, row_offset, searching_even, counters);
  if packed < 0 { return -1; }
  let value: i32 = oned_rss_exp_parse_finder(row, length, packed, odd_pattern, counters, 1);
  if value != 0 { return -1; }
  return oned_rss_exp_parse_finder(row, length, packed, odd_pattern, counters, 0);
}

fn oned_rss_exp_weight(weight_row: i32, index: i32) -> i32 {
  if weight_row == 0 {
    if index == 0 { return 1; } if index == 1 { return 3; } if index == 2 { return 9; } if index == 3 { return 27; }
    if index == 4 { return 81; } if index == 5 { return 32; } if index == 6 { return 96; } return 77;
  }
  if weight_row == 1 {
    if index == 0 { return 20; } if index == 1 { return 60; } if index == 2 { return 180; } if index == 3 { return 118; }
    if index == 4 { return 143; } if index == 5 { return 7; } if index == 6 { return 21; } return 63;
  }
  if index == 0 { return 189; } if index == 1 { return 145; } if index == 2 { return 13; } if index == 3 { return 39; }
  if index == 4 { return 117; } if index == 5 { return 140; } if index == 6 { return 209; } return 205;
}

fn oned_rss_exp_symbol_widest(group: i32) -> i32 {
  if group == 0 { return 7; } if group == 1 { return 5; }
  if group == 2 { return 4; } if group == 3 { return 3; } return 1;
}
fn oned_rss_exp_even_total(group: i32) -> i32 {
  if group == 0 { return 4; } if group == 1 { return 20; }
  if group == 2 { return 52; } if group == 3 { return 104; } return 204;
}
fn oned_rss_exp_gsum(group: i32) -> i32 {
  if group == 0 { return 0; } if group == 1 { return 348; }
  if group == 2 { return 1388; } if group == 3 { return 2948; } return 3988;
}

fn oned_rss_exp_adjust_counts(counts: u32, errors: u32, modules: i32) -> bool {
  let mut odd_sum: i32 = 0;
  let mut even_sum: i32 = 0;
  let mut index: i32 = 0;
  while index < 8 {
    if oned_rss_parity(index) == 0 { odd_sum = odd_sum + c.mem_get_u8(counts, index); }
    if oned_rss_parity(index) == 1 { even_sum = even_sum + c.mem_get_u8(counts, index); }
    index = index + 1;
  }
  let mut inc_odd: bool = false;
  let mut dec_odd: bool = false;
  let mut inc_even: bool = false;
  let mut dec_even: bool = false;
  if odd_sum > 13 { dec_odd = true; }
  if odd_sum < 4 { inc_odd = true; }
  if even_sum > 13 { dec_even = true; }
  if even_sum < 4 { inc_even = true; }
  let mismatch: i32 = odd_sum + even_sum - modules;
  let odd_bad: bool = oned_rss_parity(odd_sum) == 1;
  let even_bad: bool = oned_rss_parity(even_sum) == 0;

  if mismatch != 1 && mismatch != -1 && mismatch != 0 { return false; }
  if mismatch == 1 {
    if odd_bad && even_bad { return false; }
    if odd_bad && !even_bad { dec_odd = true; }
    if !odd_bad && !even_bad { return false; }
    if !odd_bad && even_bad { dec_even = true; }
  }
  if mismatch == -1 {
    if odd_bad && even_bad { return false; }
    if odd_bad && !even_bad { inc_odd = true; }
    if !odd_bad && !even_bad { return false; }
    if !odd_bad && even_bad { inc_even = true; }
  }
  if mismatch == 0 {
    if odd_bad && !even_bad { return false; }
    if odd_bad && even_bad {
      if odd_sum < even_sum { inc_odd = true; dec_even = true; }
      if odd_sum >= even_sum { dec_odd = true; inc_even = true; }
    }
    if !odd_bad && even_bad { return false; }
  }

  if inc_odd && dec_odd { return false; }
  if inc_even && dec_even { return false; }
  if inc_odd { oned_rss_nudge(counts, errors, 0, true); }
  if dec_odd { oned_rss_nudge(counts, errors, 0, false); }
  if inc_even { oned_rss_nudge(counts, errors, 1, true); }
  if dec_even { oned_rss_nudge(counts, errors, 1, false); }
  return true;
}

// RSSExpandedReader.decodeDataCharacter(): field 0 = value, field 1 =
// checksum portion. `weight_row` selects the WEIGHTS row for the bounded
// {A, A} two-pair sequence (0 = pair0.right, 1 = pair1.left, 2 =
// pair1.right); pass -1 for the pair-0 left/check character, which ZXing's
// isNotA1left() excludes from the checksum weighting entirely.
fn oned_rss_exp_decode_char(
  row: Array<i32>, length: i32, start: i32, end: i32, left_char: bool, weight_row: i32, field: i32
) -> i32 {
  let raw: u32 = c.mem_alloc_bytes(8);
  if left_char {
    if !oned_rss_record_pattern_reverse(row, length, false, start, 8, raw) { return -1; }
  }
  if !left_char {
    if !oned_rss_record_pattern(row, length, false, end, 8, raw) { return -1; }
    let mut swap: i32 = 0;
    while swap < 4 {
      let left: i32 = c.mem_get_u8(raw, swap);
      c.mem_set_u8(raw, swap, c.mem_get_u8(raw, 7 - swap));
      c.mem_set_u8(raw, 7 - swap, left);
      swap = swap + 1;
    }
  }
  let num_modules: i32 = 17;
  let mut sum: i32 = 0;
  let mut index: i32 = 0;
  while index < 8 { sum = sum + c.mem_get_u8(raw, index); index = index + 1; }
  if sum <= 0 { return -1; }
  let counts: u32 = c.mem_alloc_bytes(8);
  let errors: u32 = c.mem_alloc_bytes(8);
  index = 0;
  while index < 8 {
    let scaled: i32 = c.mem_get_u8(raw, index) * num_modules;
    let rounded: i32 = scaled + c.safe_div_i32(sum, 2);
    let mut count: i32 = c.safe_div_i32(rounded, sum);
    count = c.clamp_i32(count, 1, 8);
    c.mem_set_u8(counts, index, count);
    c.mem_set_u8(errors, index, c.clamp_i32(scaled - count * sum + 128, 0, 255));
    index = index + 1;
  }
  if !oned_rss_exp_adjust_counts(counts, errors, num_modules) { return -1; }
  let mut odd_sum: i32 = 0;
  let mut odd_checksum: i32 = 0;
  let mut even_checksum: i32 = 0;
  index = 3;
  while index >= 0 {
    let odd: i32 = c.mem_get_u8(counts, index * 2);
    let even: i32 = c.mem_get_u8(counts, index * 2 + 1);
    if weight_row >= 0 {
      odd_checksum = odd_checksum + odd * oned_rss_exp_weight(weight_row, index * 2);
      even_checksum = even_checksum + even * oned_rss_exp_weight(weight_row, index * 2 + 1);
    }
    odd_sum = odd_sum + odd;
    index = index - 1;
  }
  if oned_rss_parity(odd_sum) != 0 || odd_sum > 13 || odd_sum < 4 { return -1; }
  if field == 1 { return odd_checksum + even_checksum; }
  let group: i32 = c.safe_div_i32(13 - odd_sum, 2);
  let odd_widest: i32 = oned_rss_exp_symbol_widest(group);
  let even_widest: i32 = 9 - odd_widest;
  let v_odd: i32 = oned_rss_group_value(counts, 0, odd_widest, true);
  let v_even: i32 = oned_rss_group_value(counts, 1, even_widest, false);
  return v_odd * oned_rss_exp_even_total(group) + v_even + oned_rss_exp_gsum(group);
}

// GeneralAppIdDecoder bit access, implemented with pure integer division
// (FWS has no bitwise shift/AND) over the three 12-bit data-character
// values produced by the bounded {A, A} sequence (BitArrayBuilder equivalent
// without ever materializing a bit array).
fn oned_rss_exp_bit_value(v0: i32, v1: i32, v2: i32, pos: i32) -> i32 {
  let char_index: i32 = c.safe_div_i32(pos, 12);
  if char_index < 0 || char_index > 2 { return 0; }
  let bit_index: i32 = pos - char_index * 12;
  let mut value: i32 = v0;
  if char_index == 1 { value = v1; }
  if char_index == 2 { value = v2; }
  let shift: i32 = 11 - bit_index;
  let high: i32 = c.safe_div_i32(value, oned_rss_pow2(shift));
  return high - c.safe_div_i32(high, 2) * 2;
}

fn oned_rss_exp_extract(v0: i32, v1: i32, v2: i32, pos: i32, bits: i32) -> i32 {
  let mut value: i32 = 0;
  let mut index: i32 = 0;
  while index < bits {
    value = value * 2 + oned_rss_exp_bit_value(v0, v1, v2, pos + index);
    index = index + 1;
  }
  return value;
}

fn oned_rss_exp_is_still_numeric(v0: i32, v1: i32, v2: i32, total_bits: i32, pos: i32) -> bool {
  if pos + 7 > total_bits { return pos + 4 <= total_bits; }
  let mut i: i32 = pos;
  while i < pos + 3 {
    if oned_rss_exp_bit_value(v0, v1, v2, i) == 1 { return true; }
    i = i + 1;
  }
  return oned_rss_exp_bit_value(v0, v1, v2, pos + 3) == 1;
}

// GeneralAppIdDecoder.decodeNumeric(): packed as
// ((new_position * 100 + digit1) * 100 + digit2); digit value 10 marks the
// FNC1 sentinel (ZXing's DecodedNumeric.FNC1).
fn oned_rss_exp_decode_numeric(v0: i32, v1: i32, v2: i32, total_bits: i32, pos: i32) -> i32 {
  if pos + 7 > total_bits {
    let numeric4: i32 = oned_rss_exp_extract(v0, v1, v2, pos, 4);
    if numeric4 == 0 {
      let chunk1: i32 = total_bits * 100 + 10;
      return chunk1 * 100 + 10;
    }
    let digit_val: i32 = numeric4 - 1;
    let chunk2: i32 = total_bits * 100 + digit_val;
    return chunk2 * 100 + 10;
  }
  let numeric: i32 = oned_rss_exp_extract(v0, v1, v2, pos, 7);
  let digit1: i32 = c.safe_div_i32(numeric - 8, 11);
  let digit2: i32 = numeric - 8 - digit1 * 11;
  let chunk3: i32 = pos + 7;
  let chunk4: i32 = chunk3 * 100 + digit1;
  return chunk4 * 100 + digit2;
}

// GeneralAppIdDecoder numeric block only (AnyAIDecoder header = 5 bits).
// Alpha and ISO-646 compaction blocks are out of scope; encountering the
// numeric-to-alphanumeric latch simply ends the field early (matches the
// structural end-of-data signal without attempting to decode the latch).
fn oned_rss_exp_general_numeric(v0: i32, v1: i32, v2: i32, total_bits: i32) -> string {
  let mut pos: i32 = 5;
  let mut text: string = "";
  let mut guard: i32 = 0;
  while oned_rss_exp_is_still_numeric(v0, v1, v2, total_bits, pos) && guard < 16 {
    guard = guard + 1;
    let packed: i32 = oned_rss_exp_decode_numeric(v0, v1, v2, total_bits, pos);
    let new_pos: i32 = c.safe_div_i32(packed, 10000);
    let remainder: i32 = packed - new_pos * 10000;
    let digit1: i32 = c.safe_div_i32(remainder, 100);
    let digit2: i32 = remainder - digit1 * 100;
    pos = new_pos;
    if digit1 == 10 { return string_concat("", text); }
    text = string_concat(text, c.digit_char(digit1));
    if digit2 == 10 { return string_concat("", text); }
    text = string_concat(text, c.digit_char(digit2));
  }
  if string_length(text) == 0 { return ""; }
  return string_concat("", text);
}

// AbstractExpandedDecoder.createDecoder() dispatch, bounded to the
// AnyAIDecoder branch (leading bits "00"); AI01AndOtherAIs and the fixed-AI
// decoders require more capacity than the two-pair sequence provides and
// are explicitly unsupported (fail closed).
fn oned_rss_exp_decode(v0: i32, v1: i32, v2: i32, total_bits: i32) -> string {
  if total_bits < 5 { return ""; }
  if oned_rss_exp_bit_value(v0, v1, v2, 1) == 1 { return ""; }
  if oned_rss_exp_bit_value(v0, v1, v2, 2) == 1 { return ""; }
  return string_concat("", oned_rss_exp_general_numeric(v0, v1, v2, total_bits));
}

export fn oned_decode_rss_expanded(row: Array<i32>) -> string {
  let length: i32 = oned_len(row);
  if length < 90 { return ""; }
  let counters: u32 = c.mem_alloc_bytes(8);
  let packed0: i32 = oned_rss_exp_pair_start(row, length, 0, true, false, counters);
  if packed0 < 0 { return ""; }
  let start0: i32 = c.safe_div_i32(packed0, 65536);
  let end0: i32 = packed0 - start0 * 65536;
  let check_char: i32 = oned_rss_exp_decode_char(row, length, start0, end0, true, -1, 0);
  if check_char < 0 { return ""; }
  let first_value: i32 = oned_rss_exp_decode_char(row, length, start0, end0, false, 0, 0);
  if first_value < 0 { return ""; }
  let first_checksum: i32 = oned_rss_exp_decode_char(row, length, start0, end0, false, 0, 1);
  if first_checksum < 0 { return ""; }
  let packed1: i32 = oned_rss_exp_pair_start(row, length, end0, false, true, counters);
  if packed1 < 0 { return ""; }
  let start1: i32 = c.safe_div_i32(packed1, 65536);
  let end1: i32 = packed1 - start1 * 65536;
  let second_left: i32 = oned_rss_exp_decode_char(row, length, start1, end1, true, 1, 0);
  if second_left < 0 { return ""; }
  let second_left_checksum: i32 = oned_rss_exp_decode_char(row, length, start1, end1, true, 1, 1);
  if second_left_checksum < 0 { return ""; }
  let second_right: i32 = oned_rss_exp_decode_char(row, length, start1, end1, false, 2, 0);
  if second_right < 0 { return ""; }
  let second_right_checksum: i32 = oned_rss_exp_decode_char(row, length, start1, end1, false, 2, 1);
  if second_right_checksum < 0 { return ""; }
  let mut checksum: i32 = first_checksum + second_left_checksum + second_right_checksum;
  checksum = checksum - c.safe_div_i32(checksum, 211) * 211;
  if check_char != checksum { return ""; }
  return string_concat("", oned_rss_exp_decode(first_value, second_left, second_right, 36));
}

// ITF digit patterns: indices 0-9 are 2x-wide variants, 10-19 are 3x-wide.
fn oned_itf_digit_from_counters(c0: i32, c1: i32, c2: i32, c3: i32, c4: i32) -> i32 {
  let mut best: i32 = 381;
  let mut match_index: i32 = -1;
  let mut score: i32 = 0;
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 1, 2, 2, 1, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 0; }
  score = oned_variance5(c0, c1, c2, c3, c4, 2, 1, 1, 1, 2, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 1; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 2, 1, 1, 2, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 2; }
  score = oned_variance5(c0, c1, c2, c3, c4, 2, 2, 1, 1, 1, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 3; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 1, 2, 1, 2, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 4; }
  score = oned_variance5(c0, c1, c2, c3, c4, 2, 1, 2, 1, 1, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 5; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 2, 2, 1, 1, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 6; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 1, 1, 2, 2, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 7; }
  score = oned_variance5(c0, c1, c2, c3, c4, 2, 1, 1, 2, 1, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 8; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 2, 1, 2, 1, 500, 380);
  if score >= 0 && score < best { best = score; match_index = 9; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 1, 3, 3, 1, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 0; }
  score = oned_variance5(c0, c1, c2, c3, c4, 3, 1, 1, 1, 3, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 1; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 3, 1, 1, 3, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 2; }
  score = oned_variance5(c0, c1, c2, c3, c4, 3, 3, 1, 1, 1, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 3; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 1, 3, 1, 3, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 4; }
  score = oned_variance5(c0, c1, c2, c3, c4, 3, 1, 3, 1, 1, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 5; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 3, 3, 1, 1, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 6; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 1, 1, 3, 3, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 7; }
  score = oned_variance5(c0, c1, c2, c3, c4, 3, 1, 1, 3, 1, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 8; }
  score = oned_variance5(c0, c1, c2, c3, c4, 1, 3, 1, 3, 1, 750, 380);
  if score >= 0 && score < best { best = score; match_index = 9; }
  return match_index;
}

fn oned_itf_find_start(row: Array<i32>) -> i32 {
  let length: i32 = oned_len(row);
  let mut index: i32 = oned_next_set(row, 0);
  let mut guard: i32 = 0;
  while index >= 0 && index < length && guard < length {
    guard = guard + 1;
    let c0: i32 = oned_run(row, index, 1);
    if c0 <= 0 {
      index = oned_next_set(row, index + 1);
    }
    if c0 > 0 {
      let p1: i32 = index + c0;
      let c1: i32 = oned_run(row, p1, 0);
      if c1 <= 0 {
        index = oned_next_set(row, index + 1);
      }
      if c1 > 0 {
        let p2: i32 = p1 + c1;
        let c2: i32 = oned_run(row, p2, 1);
        if c2 <= 0 {
          index = oned_next_set(row, index + 1);
        }
        if c2 > 0 {
          let p3: i32 = p2 + c2;
          let c3: i32 = oned_run(row, p3, 0);
          if c3 <= 0 {
            index = oned_next_set(row, index + 1);
          }
          if c3 > 0 {
            let score: i32 = oned_variance4(c0, c1, c2, c3, 1, 1, 1, 1, 500, 380);
            let mut found: i32 = -1;
            if score >= 0 {
              let width: i32 = c0 + c1 + c2 + c3;
              let narrow: i32 = width / 4;
              if narrow > 0 {
                let mut quiet_need: i32 = narrow * 10;
                if quiet_need > index { quiet_need = index; }
                if oned_white_range(row, index - quiet_need, index) { found = index; }
              }
            }
            if found >= 0 { return found; }
            index = oned_next_set(row, index + c0 + c1);
          }
        }
      }
    }
  }
  return -1;
}

fn oned_itf_start_width(row: Array<i32>, start: i32) -> i32 {
  if start < 0 || start >= oned_len(row) { return -1; }
  let c0: i32 = oned_run(row, start, 1); if c0 <= 0 { return -1; }
  let p1: i32 = start + c0; let c1: i32 = oned_run(row, p1, 0); if c1 <= 0 { return -1; }
  let p2: i32 = p1 + c1; let c2: i32 = oned_run(row, p2, 1); if c2 <= 0 { return -1; }
  let p3: i32 = p2 + c2; let c3: i32 = oned_run(row, p3, 0); if c3 <= 0 { return -1; }
  return c0 + c1 + c2 + c3;
}

fn oned_itf_find_end(row: Array<i32>, narrow: i32) -> i32 {
  let end: i32 = oned_last_one_end(row);
  if end <= 0 || narrow <= 0 { return -1; }
  let c2: i32 = oned_run_back(row, end, 1); if c2 <= 0 { return -1; }
  let p1: i32 = end - c2; let c1: i32 = oned_run_back(row, p1, 0); if c1 <= 0 { return -1; }
  let p0: i32 = p1 - c1; let c0: i32 = oned_run_back(row, p0, 1); if c0 <= 0 { return -1; }
  let start: i32 = p0 - c0;
  let score2: i32 = oned_variance3(c0, c1, c2, 2, 1, 1, 500, 380);
  let score3: i32 = oned_variance3(c0, c1, c2, 3, 1, 1, 500, 380);
  if score2 < 0 && score3 < 0 { return -1; }
  let length: i32 = oned_len(row);
  let mut quiet_need: i32 = narrow * 10;
  let available: i32 = length - end;
  if quiet_need > available { quiet_need = available; }
  if !oned_white_range(row, end, end + quiet_need) { return -1; }
  return start;
}

fn oned_itf_length_ok(length: i32) -> bool {
  if length == 6 { return true; }
  if length == 8 { return true; }
  if length == 10 { return true; }
  if length == 12 { return true; }
  if length == 14 { return true; }
  if length > 14 { return true; }
  return false;
}
fn oned_itf_pair_text(row: Array<i32>, position: i32, end_start: i32) -> string {
  if position < 0 || position >= end_start { return ""; }
  if row[position] != 1 { return ""; }
  let b0: i32 = oned_run(row, position, 1); if b0 <= 0 { return ""; }
  let s0p: i32 = position + b0; let s0: i32 = oned_run(row, s0p, 0); if s0 <= 0 { return ""; }
  let b1p: i32 = s0p + s0; let b1: i32 = oned_run(row, b1p, 1); if b1 <= 0 { return ""; }
  let s1p: i32 = b1p + b1; let s1: i32 = oned_run(row, s1p, 0); if s1 <= 0 { return ""; }
  let b2p: i32 = s1p + s1; let b2: i32 = oned_run(row, b2p, 1); if b2 <= 0 { return ""; }
  let s2p: i32 = b2p + b2; let s2: i32 = oned_run(row, s2p, 0); if s2 <= 0 { return ""; }
  let b3p: i32 = s2p + s2; let b3: i32 = oned_run(row, b3p, 1); if b3 <= 0 { return ""; }
  let s3p: i32 = b3p + b3; let s3: i32 = oned_run(row, s3p, 0); if s3 <= 0 { return ""; }
  let b4p: i32 = s3p + s3; let b4: i32 = oned_run(row, b4p, 1); if b4 <= 0 { return ""; }
  let s4p: i32 = b4p + b4; let s4: i32 = oned_run(row, s4p, 0); if s4 <= 0 { return ""; }
  let width: i32 = b0 + s0 + b1 + s1 + b2 + s2 + b3 + s3 + b4 + s4;
  if width <= 0 { return ""; }
  if position + width > end_start { return ""; }
  let d0: i32 = oned_itf_digit_from_counters(b0, b1, b2, b3, b4);
  let d1: i32 = oned_itf_digit_from_counters(s0, s1, s2, s3, s4);
  if d0 < 0 { return ""; }
  if d1 < 0 { return ""; }
  return string_concat(oned_digit(d0), oned_digit(d1));
}

fn oned_itf_pair_advance(row: Array<i32>, position: i32, end_start: i32) -> i32 {
  if position < 0 || position >= end_start { return -1; }
  if row[position] != 1 { return -1; }
  let b0: i32 = oned_run(row, position, 1); if b0 <= 0 { return -1; }
  let s0p: i32 = position + b0; let s0: i32 = oned_run(row, s0p, 0); if s0 <= 0 { return -1; }
  let b1p: i32 = s0p + s0; let b1: i32 = oned_run(row, b1p, 1); if b1 <= 0 { return -1; }
  let s1p: i32 = b1p + b1; let s1: i32 = oned_run(row, s1p, 0); if s1 <= 0 { return -1; }
  let b2p: i32 = s1p + s1; let b2: i32 = oned_run(row, b2p, 1); if b2 <= 0 { return -1; }
  let s2p: i32 = b2p + b2; let s2: i32 = oned_run(row, s2p, 0); if s2 <= 0 { return -1; }
  let b3p: i32 = s2p + s2; let b3: i32 = oned_run(row, b3p, 1); if b3 <= 0 { return -1; }
  let s3p: i32 = b3p + b3; let s3: i32 = oned_run(row, s3p, 0); if s3 <= 0 { return -1; }
  let b4p: i32 = s3p + s3; let b4: i32 = oned_run(row, b4p, 1); if b4 <= 0 { return -1; }
  let s4p: i32 = b4p + b4; let s4: i32 = oned_run(row, s4p, 0); if s4 <= 0 { return -1; }
  let width: i32 = b0 + s0 + b1 + s1 + b2 + s2 + b3 + s3 + b4 + s4;
  if width <= 0 { return -1; }
  if position + width > end_start { return -1; }
  return width;
}

export fn oned_decode_itf(row: Array<i32>) -> string {
  if oned_len(row) < 18 { return ""; }
  let start: i32 = oned_itf_find_start(row);
  if start < 0 { return ""; }
  let start_width: i32 = oned_itf_start_width(row, start);
  if start_width <= 0 { return ""; }
  let narrow: i32 = start_width / 4;
  if narrow <= 0 { return ""; }
  let end_start: i32 = oned_itf_find_end(row, narrow);
  if end_start <= start + start_width { return ""; }
  let mut position: i32 = start + start_width;
  let mut result: string = "";
  let mut pairs: i32 = 0;
  while position < end_start && pairs < 32 {
    let chunk: string = oned_itf_pair_text(row, position, end_start);
    let width: i32 = oned_itf_pair_advance(row, position, end_start);
    if string_length(chunk) != 2 { return ""; }
    if width <= 0 { return ""; }
    result = string_concat(result, chunk);
    position = position + width;
    pairs = pairs + 1;
  }
  if pairs <= 0 { return ""; }
  if position != end_start { return ""; }
  if !oned_itf_length_ok(pairs * 2) { return ""; }
  return string_concat("", result);
}
// Reader precedence follows MultiFormatOneDReader: retail families first,
// then dedicated industrial readers. The hint is a stable foundation format
// id; -1 enables the default order.
export fn oned_decode_with_hint(row: Array<i32>, possible_format: i32) -> string {
  if possible_format == foundation.FORMAT_EAN_8() { return string_concat("", oned_decode_ean8(row)); }
  if possible_format == foundation.FORMAT_EAN_13() { return string_concat("", oned_decode_ean13(row)); }
  if possible_format == foundation.FORMAT_UPC_A() { return string_concat("", oned_decode_upca(row)); }
  if possible_format == foundation.FORMAT_UPC_E() { return string_concat("", oned_decode_upce(row)); }
  if possible_format == foundation.FORMAT_CODE_39() { return string_concat("", oned_decode_code39(row)); }
  if possible_format == foundation.FORMAT_ITF() { return string_concat("", oned_decode_itf(row)); }
  if possible_format == foundation.FORMAT_CODABAR() { return string_concat("", oned_decode_codabar(row)); }
  if possible_format == foundation.FORMAT_CODE_93() { return string_concat("", oned_decode_code93(row)); }
  if possible_format == foundation.FORMAT_CODE_128() { return string_concat("", oned_decode_code128(row)); }
  if possible_format == foundation.FORMAT_RSS_14() { return string_concat("", oned_decode_rss14(row)); }
  if possible_format == foundation.FORMAT_RSS_EXPANDED() { return string_concat("", oned_decode_rss_expanded(row)); }
  let mut value: string = string_concat("", oned_decode_ean13(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_ean8(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_upca(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_upce(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_code39(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_itf(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_codabar(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_code93(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_code128(row)); if string_length(value) > 0 { return string_concat("", value); }
  value = string_concat("", oned_decode_rss14(row)); if string_length(value) > 0 { return string_concat("", value); }
  return string_concat("", oned_decode_rss_expanded(row));
}