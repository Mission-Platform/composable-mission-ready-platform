// Codabar encoder graph with automatic A start and stop framing.

fn codabar_u32_to_i32_len(value: u32) -> i32 {
  let mut remaining: u32 = value;
  let mut place: i32 = 1;
  let mut result: i32 = 0;
  while remaining > 0 {
    let mut bit: u32 = remaining - remaining / 2 * 2;
    if bit == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place * 2;
  }
  return result;
}

fn codabar_modules_len(modules: Array<i32>) -> i32 {
  return codabar_u32_to_i32_len(modules.length());
}

fn codabar_pattern(value: i32) -> string {
  if value == 48 { return "0000011"; }
  if value == 49 { return "0000110"; }
  if value == 50 { return "0001001"; }
  if value == 51 { return "1100000"; }
  if value == 52 { return "0010010"; }
  if value == 53 { return "1000010"; }
  if value == 54 { return "0100001"; }
  if value == 55 { return "0100100"; }
  if value == 56 { return "0110000"; }
  if value == 57 { return "1000100"; }
  if value == 45 { return "0001100"; }
  if value == 36 { return "0011000"; }
  if value == 58 { return "1000101"; }
  if value == 47 { return "1010001"; }
  if value == 46 { return "1010100"; }
  if value == 43 { return "0010011"; }
  if value == 65 { return "0011010"; }
  if value == 66 { return "0101001"; }
  if value == 67 { return "0001011"; }
  if value == 68 { return "0001110"; }
  return "";
}

// Decoder-side rendering is used to compare sampled modules with the
// canonical Codabar symbol patterns. It is shared logic, not an encoder ABI.
fn codabar_render(value: string, index: i32) -> string {
  if index >= string_length(value) { return ""; }
  let mut bit: i32 = 0;
  if index % 2 == 0 { bit = 1; }
  let mut width: i32 = 1;
  if string_byte_at(value, index) == 49 { width = 3; }
  let mut run: string = "0";
  if bit == 1 {
    run = "1";
    if width == 3 { run = "111"; }
  } else {
    if width == 3 { run = "000"; }
  }
  return string_concat(run, codabar_render(value, index + 1));
}











fn codabar_bits_match(modules: Array<i32>, end: i32, start: i32, expected: string, index: i32) -> bool {
  if index >= string_length(expected) { return true; }
  if start + index >= end || start + index >= codabar_modules_len(modules) { return false; }
  if modules[start + index] + 48 != string_byte_at(expected, index) { return false; }
  return codabar_bits_match(modules, end, start, expected, index + 1);
}

fn codabar_decode_symbol(modules: Array<i32>, end: i32, start: i32) -> string {
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(58), 0), 0) { return ":"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(47), 0), 0) { return "/"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(46), 0), 0) { return "."; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(43), 0), 0) { return "+"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(65), 0), 0) { return "A"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(66), 0), 0) { return "B"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(67), 0), 0) { return "C"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(68), 0), 0) { return "D"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(48), 0), 0) { return "0"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(49), 0), 0) { return "1"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(50), 0), 0) { return "2"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(51), 0), 0) { return "3"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(52), 0), 0) { return "4"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(53), 0), 0) { return "5"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(54), 0), 0) { return "6"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(55), 0), 0) { return "7"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(56), 0), 0) { return "8"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(57), 0), 0) { return "9"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(45), 0), 0) { return "-"; }
  if codabar_bits_match(modules, end, start, codabar_render(codabar_pattern(36), 0), 0) { return "$"; }
  return "";
}

fn codabar_symbol_width(symbol: string) -> i32 {
  let code: i32 = string_byte_at(symbol, 0);
  if code == 58 || code == 47 || code == 46 || code == 43 { return 13; }
  if code == 65 || code == 66 || code == 67 || code == 68 { return 13; }
  return 11;
}

fn codabar_decode_symbols(modules: Array<i32>, end: i32, start: i32, result: string) -> string {
  if start + 11 > end || end > codabar_modules_len(modules) { return ""; }
  let symbol: string = codabar_decode_symbol(modules, end, start);
  if string_length(symbol) == 0 { return ""; }
  let next: i32 = start + codabar_symbol_width(symbol);
  if next == end { return string_concat(result, symbol); }
  if next >= end { return ""; }
  if modules[next] != 0 { return ""; }
  return string_concat(codabar_decode_symbols(modules, end, next + 1, string_concat(result, symbol)), "");
}

fn codabar_decode_codabar_frame(modules: Array<i32>, length: i32) -> string {
  if length > codabar_modules_len(modules) { return ""; }
  if length < 27 { return ""; }
  let framed: string = string_concat(codabar_decode_symbols(modules, length, 0, ""), "");
  if string_length(framed) < 2 { return ""; }
  if string_byte_at(framed, 0) != 65 { return ""; }
  if string_byte_at(framed, string_length(framed) - 1) != 65 { return ""; }
  return string_slice(framed, 1, string_length(framed) - 1);
}

export fn codabar_decode_codabar(modules: Array<i32>) -> string {
  return string_concat(codabar_decode_codabar_frame(modules, codabar_modules_len(modules)), "");
}

export fn codabar_decode_codabar_row(modules: Array<i32>, count: i32) -> string {
  return string_concat(codabar_decode_codabar_frame(modules, count), "");
}
