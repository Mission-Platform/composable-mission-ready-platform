import "./barcode-encoder.flint" as ean;
fn upce_upca_body(value: string, number_system: i32) -> string {
  let last: i32 = ean.digit_at(value, 5);
  if last <= 2 {
    let prefix: string = string_concat(string_concat(ean.digit_char(number_system), string_slice(value, 0, 2)), ean.digit_char(last));
    return string_concat(string_concat(string_concat(prefix, "000"), string_slice(value, 2, 5)), "0");
  }
  if last == 3 {
    let prefix: string = string_concat(ean.digit_char(number_system), string_slice(value, 0, 3));
    return string_concat(string_concat(string_concat(prefix, "0000"), string_slice(value, 3, 5)), "0");
  }
  if last == 4 {
    let prefix: string = string_concat(ean.digit_char(number_system), string_slice(value, 0, 4));
    return string_concat(string_concat(string_concat(prefix, "0000"), string_slice(value, 4, 5)), "0");
  }
  let prefix: string = string_concat(ean.digit_char(number_system), string_slice(value, 0, 5));
  return string_concat(string_concat(prefix, "0000"), ean.digit_char(last));
}

fn upce_parity(value: i32) -> string {
  if value == 0 { return "GGGLLL"; }
  if value == 1 { return "GGLGLL"; }
  if value == 2 { return "GGLLGL"; }
  if value == 3 { return "GGLLLG"; }
  if value == 4 { return "GLGGLL"; }
  if value == 5 { return "GLLGGL"; }
  if value == 6 { return "GLLLGG"; }
  if value == 7 { return "GLGLGL"; }
  if value == 8 { return "GLGLLG"; }
  return "GLLGLG";
}

fn upce_pattern(value: i32, index: i32, check: i32, number_system: i32) -> string {
  let parity: string = upce_parity(check);
  let mut use_g: bool = string_byte_at(parity, index) == 71;
  if number_system == 1 { use_g = !use_g; }
  if use_g { return string_concat(ean.ean13_g_pattern(value), ""); }
  return string_concat(ean.left_pattern(value), "");
}

fn upce_half(value: string, check: i32, number_system: i32) -> string {
  let first: string = upce_pattern(ean.digit_at(value, 0), 0, check, number_system);
  let second: string = upce_pattern(ean.digit_at(value, 1), 1, check, number_system);
  let third: string = upce_pattern(ean.digit_at(value, 2), 2, check, number_system);
  let fourth: string = upce_pattern(ean.digit_at(value, 3), 3, check, number_system);
  let fifth: string = upce_pattern(ean.digit_at(value, 4), 4, check, number_system);
  let sixth: string = upce_pattern(ean.digit_at(value, 5), 5, check, number_system);
  return string_concat(string_concat(string_concat(first, second), string_concat(third, fourth)), string_concat(fifth, sixth));
}

export fn encode_upce(value: string) -> string {
  let length: i32 = string_length(value);
  let mut number_system: i32 = 0;
  let mut payload: string = value;
  let mut supplied_check: i32 = -1;
  if length != 6 && length != 7 && length != 8 { return ""; }
  if length == 6 {
    if !ean.has_six_digits(value) { return ""; }
  }
  if length == 7 {
    if !ean.has_seven_digits(value) { return ""; }
    number_system = ean.digit_at(value, 0);
    if number_system > 1 { return ""; }
    payload = string_slice(value, 1, 7);
  }
  if length == 8 {
    if !ean.has_eight_digits(value) { return ""; }
    number_system = ean.digit_at(value, 0);
    if number_system > 1 { return ""; }
    payload = string_slice(value, 1, 7);
    supplied_check = ean.digit_at(value, 7);
  }
  let body: string = upce_upca_body(payload, number_system);
  let check: i32 = ean.ean13_check(string_concat("0", body));
  if supplied_check >= 0 && supplied_check != check { return ""; }
  let middle: string = upce_half(payload, check, number_system);
  return string_concat(string_concat("101", middle), "010101");
}
