/**
 * Styling for the write-once `ForgeMatrixCode`.
 *
 * `ForgeMatrixCode` owns this co-located CSS Module: it side-effect-imports the
 * stylesheet so its appearance ships in the built package CSS (the two-stage
 * compiler carries the import onto both the React and Vue builds).
 *
 * The rules live in the package-owned `mp.matrix-code` cascade layer.
 */
/**
 * Registered inherited custom properties for forge-matrix-code overrides.
 *
 * Kept in a dedicated partial so the component module can stay focused on
 * selectors while @property initial values remain token-backed defaults.
 */
@property --forge-matrix-code-spacing-3 {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-spacing-3);
}
@property --forge-matrix-code-spacing-2 {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-spacing-2);
}
@layer mp.matrix-code {
  .forge-matrix-code {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .forge-matrix-code-figure {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--forge-matrix-code-spacing-3, var(--mp-spacing-3));
  }
  .forge-matrix-code__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--forge-matrix-code-spacing-2, var(--mp-spacing-2));
  }
  .forge-matrix-code__logo-plate,
  .forge-matrix-code__logo {
    pointer-events: none;
  }
}
