// Precomputed ECC200 Utah placement map (small squares).
// Values are 3-digit decimals matching the encoder tables; 999 denotes an
// unused mapping cell. Split from matrix-decoder-datamatrix.fws to keep every
// linked module under the self-hosted lex-stage bootstrap size limit.

export fn square_map_a(rows: i32, cols: i32) -> string {
  if rows == 8 {
    if cols == 8 { return "008009021022023026027028010011012032033029030031013014015034035036000001004040041037038039002003007042043044056057005006049045046047058059060048051052016017061062063050054055018019020024025053"; }
  }
  if rows == 10 {
    if cols == 10 { return ""; }
  }
  if rows == 12 {
    if cols == 12 { return ""; }
  }
  if rows == 14 {
    if cols == 14 { return ""; }
  }
  if rows == 16 {
    if cols == 16 { return ""; }
  }
  return "";
}
