// Precomputed ECC200 Utah placement map (rectangles).
// Values are 3-digit decimals matching the encoder tables; 999 denotes an
// unused mapping cell. Split from matrix-decoder-datamatrix.fws to keep every
// linked module under the self-hosted lex-stage bootstrap size limit.

export fn rect_map(rows: i32, cols: i32) -> string {
  if rows == 6 {
    if cols == 16 { return "008009021022023026027028064065077078079050051052010011012032033029030031066067068080081053054055013014015034035036056057069070071082083084000001004040041037038039058059060088089085086087002003007042043044016017061062063090091092072073005006048045046047018019020024025093094095074075076049"; }
    if cols == 28 { return ""; }
  }
  if rows == 10 {
    if cols == 24 { return ""; }
    if cols == 32 { return ""; }
  }
  if rows == 14 {
    if cols == 32 { return ""; }
    if cols == 44 { return ""; }
  }
  return "";
}
