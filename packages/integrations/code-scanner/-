/**
 * Styling for the write-once `ForgeCodeScanner`.
 *
 * `ForgeCodeScanner` owns this co-located CSS Module: it side-effect-imports the
 * stylesheet so its appearance ships in the built package CSS (the two-stage
 * compiler carries the import onto both the React and Vue builds).
 *
 * The rules live in the package-owned `mp.code-scanner` cascade layer.
 */
/**
 * Registered inherited custom properties for forge-code-scanner overrides.
 *
 * Kept in a dedicated partial so the component module can stay focused on
 * selectors while @property initial values remain token-backed defaults.
 */
@property --forge-code-scanner-gap-root {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-code-scanner-gap-root);
}
@property --forge-code-scanner-viewport-surface {
  syntax: "*";
  inherits: true;
