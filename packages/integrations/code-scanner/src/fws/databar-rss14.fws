// RSS-14 row decoder, ported from crates/gs1-databar-decode/src/rss14.rs.
// The decoder keeps its small counter arrays in linear memory because FWS
// arrays are ABI-owned values and cannot be allocated inside the graph.
import "./common.fws" as c;

fn row_bit(row: Array<i32>, length: i32, index: i32, reversed: bool) -> bool {
  if index < 0 || index >= length { return false; }
  if reversed { return row[length - index - 1] != 0; }
  return row[index] != 0;
}

fn parity(value: i32) -> i32 {
  return value - value / 2 * 2;
}

fn combins(n: i32, r: i32) -> i32 {
  if r < 0 || n < 0 || r > n { return 0; }
  let mut min_denom: i32 = r;
  let mut max_denom: i32 = n - r;
  if n - r <= r {
    min_denom = n - r;
    max_denom = r;
  }
  let mut value: i32 = 1;
  let mut denominator: i32 = 1;
  let mut numerator: i32 = n;
  while numerator > max_denom {
    value = value * numerator;
    if denominator <= min_denom {
      value = c.safe_div_i32(value, denominator);
      denominator = denominator + 1;
    }
    numerator = numerator - 1;
  }
  while denominator <= min_denom {
    value = c.safe_div_i32(value, denominator);
    denominator = denominator + 1;
  }
  return value;
}

fn rss_value(counts: u32, parity_offset: i32, max_width: i32, no_narrow: bool) -> i32 {
  let mut remaining: i32 = 0;
  let mut i: i32 = 0;
  while i < 4 {
    remaining = remaining + c.mem_get_u8(counts, i * 2 + parity_offset);
    i = i + 1;
  }
  let mut value: i32 = 0;
  let mut narrow_mask: i32 = 0;
  let mut bar: i32 = 0;
  while bar < 3 {
    let width: i32 = c.mem_get_u8(counts, bar * 2 + parity_offset);
    let mut element_width: i32 = 1;
    narrow_mask = narrow_mask + pow2(bar);
    while element_width < width {
      let elements_left: i32 = 4 - bar - 1;
      let mut sub_value: i32 = combins(remaining - element_width - 1, 4 - bar - 2);
      let enough_for_no_narrow: bool = remaining - element_width - elements_left >= elements_left;
      if no_narrow && narrow_mask == 0 && enough_for_no_narrow {
        let no_narrow_remaining: i32 = remaining - element_width - 4 + bar;
        sub_value = sub_value - combins(no_narrow_remaining, 4 - bar - 2);
      }
      if elements_left > 1 {
        let mut less_value: i32 = 0;
        let mut widest: i32 = remaining - element_width - 4 + bar + 2;
        while widest > max_width {
          less_value = less_value + combins(remaining - element_width - widest - 1, 4 - bar - 3);
          widest = widest - 1;
        }
        let remaining_bars: i32 = 3 - bar;
        sub_value = sub_value - less_value * remaining_bars;
      } else {
        if remaining - element_width > max_width { sub_value = sub_value - 1; }
      }
      value = value + sub_value;
      element_width = element_width + 1;
      narrow_mask = narrow_mask - pow2(bar);
    }
    remaining = remaining - element_width;
    bar = bar + 1;
  }
  return value;
}

fn pow2(power: i32) -> i32 {
  let mut value: i32 = 1;
  let mut i: i32 = 0;
  while i < power {
    value = value * 2;
    i = i + 1;
  }
  return value;
}

fn record_pattern(
  row: Array<i32>,
  length: i32,
  reversed: bool,
  start: i32,
  count: i32,
  counters: u32
) -> bool {
  let mut clear: i32 = 0;
  while clear < count {
    c.mem_set_u8(counters, clear, 0);
    clear = clear + 1;
  }
  if start < 0 || start >= length { return false; }
  let mut is_white: bool = !row_bit(row, length, start, reversed);
  let mut position: i32 = 0;
  let mut index: i32 = start;
  while index < length {
    if row_bit(row, length, index, reversed) != is_white {
      c.mem_set_u8(counters, position, c.mem_get_u8(counters, position) + 1);
    } else {
      position = position + 1;
      if position == count { return true; }
      c.mem_set_u8(counters, position, 1);
      is_white = !is_white;
    }
    index = index + 1;
  }
  return position == count - 1;
}

fn record_pattern_reverse(
  row: Array<i32>,
  length: i32,
  reversed: bool,
  start: i32,
  count: i32,
  counters: u32
) -> bool {
  if start < 0 || start >= length { return false; }
  let mut transitions: i32 = count;
  let mut last: bool = row_bit(row, length, start, reversed);
  let mut position: i32 = start;
  while position > 0 && transitions >= 0 {
    position = position - 1;
    if row_bit(row, length, position, reversed) != last {
      transitions = transitions - 1;
      last = !last;
    }
  }
  if transitions >= 0 { return false; }
  return record_pattern(row, length, reversed, position + 1, count, counters);
}

fn finder_ratio(counters: u32) -> bool {
  let first_two: i32 = c.mem_get_u8(counters, 0) + c.mem_get_u8(counters, 1);
  let total: i32 = first_two + c.mem_get_u8(counters, 2) + c.mem_get_u8(counters, 3);
  // 19/24 <= first_two/total <= 25/28, compared without floats.
  if first_two * 24 < total * 19 || first_two * 28 > total * 25 { return false; }
  let mut minimum: i32 = c.mem_get_u8(counters, 0);
  let mut maximum: i32 = minimum;
  let mut i: i32 = 1;
  while i < 4 {
    let value: i32 = c.mem_get_u8(counters, i);
    if value < minimum { minimum = value; }
    if value > maximum { maximum = value; }
    i = i + 1;
  }
  return minimum > 0 && maximum < 10 * minimum;
}

// Packed finder bounds: start * 65536 + end, or -1.
fn find_finder(row: Array<i32>, length: i32, reversed: bool, right: bool, counters: u32) -> i32 {
  let mut is_white: bool = false;
  let mut offset: i32 = 0;
  let mut offset_found: bool = false;
  while offset < length && !offset_found {
    is_white = !row_bit(row, length, offset, reversed);
    if is_white == right { offset_found = true; }
    else { offset = offset + 1; }
  }
  if offset >= length { return -1; }
  let mut position: i32 = 0;
  let mut pattern_start: i32 = offset;
  let mut x: i32 = offset;
  while x < length {
    if row_bit(row, length, x, reversed) != is_white {
      c.mem_set_u8(counters, position, c.mem_get_u8(counters, position) + 1);
    } else {
      if position == 3 {
        if finder_ratio(counters) { return pattern_start * 65536 + x; }
        pattern_start = pattern_start + c.mem_get_u8(counters, 0) + c.mem_get_u8(counters, 1);
        c.mem_set_u8(counters, 0, c.mem_get_u8(counters, 2));
        c.mem_set_u8(counters, 1, c.mem_get_u8(counters, 3));
        c.mem_set_u8(counters, 2, 0);
        c.mem_set_u8(counters, 3, 0);
        position = position - 1;
      } else {
        position = position + 1;
      }
      c.mem_set_u8(counters, position, 1);
      is_white = !is_white;
    }
    x = x + 1;
  }
  return -1;
}

fn finder_pattern_value(a: i32, b: i32, d: i32, e: i32) -> i32 {
  if finder_matches(a, b, d, e, 3, 8, 2, 1) { return 0; }
  if finder_matches(a, b, d, e, 3, 5, 5, 1) { return 1; }
  if finder_matches(a, b, d, e, 3, 3, 7, 1) { return 2; }
  if finder_matches(a, b, d, e, 3, 1, 9, 1) { return 3; }
  if finder_matches(a, b, d, e, 2, 7, 4, 1) { return 4; }
  if finder_matches(a, b, d, e, 2, 5, 6, 1) { return 5; }
  if finder_matches(a, b, d, e, 2, 3, 8, 1) { return 6; }
  if finder_matches(a, b, d, e, 1, 5, 7, 1) { return 7; }
  if finder_matches(a, b, d, e, 1, 3, 9, 1) { return 8; }
  return -1;
}

fn finder_matches(a: i32, b: i32, d: i32, e: i32, pa: i32, pb: i32, pd: i32, pe: i32) -> bool {
  let total: i32 = a + b + d + e;
  let pattern_total: i32 = pa + pb + pd + pe;
  let variance_a: i32 = c.abs_i32(a * pattern_total - pa * total);
  let variance_b: i32 = c.abs_i32(b * pattern_total - pb * total);
  let variance_d: i32 = c.abs_i32(d * pattern_total - pd * total);
  let variance_e: i32 = c.abs_i32(e * pattern_total - pe * total);
  if variance_a * 20 > total * 9 || variance_b * 20 > total * 9
    || variance_d * 20 > total * 9 || variance_e * 20 > total * 9 { return false; }
  let variance: i32 = variance_a + variance_b + variance_d + variance_e;
  return variance * 5 < total * pattern_total;
}

// Returns first-element start * 16 + finder value, or -1.
fn parse_finder(
  row: Array<i32>,
  length: i32,
  reversed: bool,
  packed: i32,
  counters: u32
) -> i32 {
  let start: i32 = packed / 65536;
  let end: i32 = packed - start * 65536;
  if !record_pattern(row, length, reversed, start, 4, counters) { return -1; }
  let first_black: bool = row_bit(row, length, start, reversed);
  let mut first_start: i32 = start - 1;
  while first_start >= 0 && first_black != row_bit(row, length, first_start, reversed) {
    first_start = first_start - 1;
  }
  first_start = first_start + 1;
  let first: i32 = start - first_start;
  let value: i32 = finder_pattern_value(
    first,
    c.mem_get_u8(counters, 0),
    c.mem_get_u8(counters, 1),
    c.mem_get_u8(counters, 2)
  );
  if value < 0 || end <= first_start { return -1; }
  return first_start * 16 + value;
}

fn error_at(errors: u32, index: i32) -> i32 {
  return c.mem_get_u8(errors, index) - 128;
}

fn nudge(counts: u32, errors: u32, parity_offset: i32, increment: bool) -> unit {
  let mut selected: i32 = parity_offset;
  let mut selected_error: i32 = error_at(errors, parity_offset);
  let mut i: i32 = parity_offset + 2;
  while i < 8 {
    let error: i32 = error_at(errors, i);
    if increment && error > selected_error {
      selected = i;
      selected_error = error;
    }
    if !increment && error < selected_error {
      selected = i;
      selected_error = error;
    }
    i = i + 2;
  }
  let mut delta: i32 = -1;
  if increment { delta = 1; }
  c.mem_set_u8(counts, selected, c.mem_get_u8(counts, selected) + delta);
}

fn adjust_counts(outside: bool, counts: u32, errors: u32, modules: i32) -> bool {
  let mut odd_sum: i32 = 0;
  let mut even_sum: i32 = 0;
  let mut i: i32 = 0;
  while i < 8 {
    if parity(i) == 0 { odd_sum = odd_sum + c.mem_get_u8(counts, i); }
    else { even_sum = even_sum + c.mem_get_u8(counts, i); }
    i = i + 1;
  }
  let mut inc_odd: bool = false;
  let mut dec_odd: bool = false;
  let mut inc_even: bool = false;
  let mut dec_even: bool = false;
  if outside {
    if odd_sum > 12 { dec_odd = true; }
    if odd_sum < 4 { inc_odd = true; }
    if even_sum > 12 { dec_even = true; }
    if even_sum < 4 { inc_even = true; }
  } else {
    if odd_sum > 11 { dec_odd = true; }
    if odd_sum < 5 { inc_odd = true; }
    if even_sum > 10 { dec_even = true; }
    if even_sum < 4 { inc_even = true; }
  }
  let mismatch: i32 = odd_sum + even_sum - modules;
  let mut odd_bad: bool = parity(odd_sum) == 1;
  if !outside { odd_bad = parity(odd_sum) == 0; }
  let mut even_bad: bool = parity(even_sum) == 1;
  if mismatch == 1 {
    if odd_bad {
      if even_bad { return false; }
      dec_odd = true;
    } else {
      if !even_bad { return false; }
      dec_even = true;
    }
  } else {
    if mismatch == -1 {
    if odd_bad {
      if even_bad { return false; }
      inc_odd = true;
    } else {
      if !even_bad { return false; }
      inc_even = true;
    }
    } else {
      if mismatch == 0 {
        if odd_bad {
          if !even_bad { return false; }
          if odd_sum < even_sum { inc_odd = true; dec_even = true; }
          else { dec_odd = true; inc_even = true; }
        } else {
          if even_bad { return false; }
        }
      } else { return false; }
    }
  }
  if inc_odd && dec_odd { return false; }
  if inc_even && dec_even { return false; }
  if inc_odd { nudge(counts, errors, 0, true); }
  if dec_odd { nudge(counts, errors, 0, false); }
  if inc_even { nudge(counts, errors, 1, true); }
  if dec_even { nudge(counts, errors, 1, false); }
  return true;
}

// field 0 = character value, field 1 = checksum portion, -1 = failure.
fn decode_character(
  row: Array<i32>, length: i32, reversed: bool, start: i32, end: i32,
  outside: bool, field: i32
) -> i32 {
  let raw: u32 = c.mem_alloc_bytes(8);
  if outside {
    if !record_pattern_reverse(row, length, reversed, start, 8, raw) { return -1; }
  } else {
    if !record_pattern(row, length, reversed, end, 8, raw) { return -1; }
    let mut swap: i32 = 0;
    while swap < 4 {
      let left: i32 = c.mem_get_u8(raw, swap);
      c.mem_set_u8(raw, swap, c.mem_get_u8(raw, 7 - swap));
      c.mem_set_u8(raw, 7 - swap, left);
      swap = swap + 1;
    }
  }
  let mut num_modules: i32 = 15;
  if outside { num_modules = 16; }
  let mut sum: i32 = 0;
  let mut i: i32 = 0;
  while i < 8 { sum = sum + c.mem_get_u8(raw, i); i = i + 1; }
  if sum <= 0 { return -1; }
  let counts: u32 = c.mem_alloc_bytes(8);
  let errors: u32 = c.mem_alloc_bytes(8);
  i = 0;
  while i < 8 {
    let scaled: i32 = c.mem_get_u8(raw, i) * num_modules;
    let rounded: i32 = scaled + sum / 2;
    let mut count: i32 = c.safe_div_i32(rounded, sum);
    count = c.clamp_i32(count, 1, 8);
    c.mem_set_u8(counts, i, count);
    c.mem_set_u8(errors, i, c.clamp_i32(scaled - count * sum + 128, 0, 255));
    i = i + 1;
  }
  if !adjust_counts(outside, counts, errors, num_modules) { return -1; }
  let mut odd_sum: i32 = 0;
  let mut even_sum: i32 = 0;
  let mut odd_checksum: i32 = 0;
  let mut even_checksum: i32 = 0;
  i = 3;
  while i >= 0 {
    let odd: i32 = c.mem_get_u8(counts, i * 2);
    let even: i32 = c.mem_get_u8(counts, i * 2 + 1);
    odd_checksum = odd_checksum * 9 + odd;
    even_checksum = even_checksum * 9 + even;
    odd_sum = odd_sum + odd;
    even_sum = even_sum + even;
    i = i - 1;
  }
  if field == 1 { return odd_checksum + 3 * even_checksum; }
  if outside {
    if parity(odd_sum) != 0 || odd_sum > 12 || odd_sum < 4 { return -1; }
    let group_numerator: i32 = 12 - odd_sum;
    let group: i32 = group_numerator / 2;
    let odd_widest: i32 = outside_odd_widest(group);
    return rss_value(counts, 0, odd_widest, false) * outside_even_total(group)
      + rss_value(counts, 1, 9 - odd_widest, true) + outside_gsum(group);
  }
  if parity(even_sum) != 0 || even_sum > 10 || even_sum < 4 { return -1; }
  let group_numerator: i32 = 10 - even_sum;
  let group: i32 = group_numerator / 2;
  let odd_widest: i32 = inside_odd_widest(group);
  return rss_value(counts, 1, 9 - odd_widest, false) * inside_odd_total(group)
    + rss_value(counts, 0, odd_widest, true) + inside_gsum(group);
}

fn outside_even_total(group: i32) -> i32 {
  if group == 0 { return 1; } if group == 1 { return 10; }
  if group == 2 { return 34; } if group == 3 { return 70; } return 126;
}
fn outside_gsum(group: i32) -> i32 {
  if group == 0 { return 0; } if group == 1 { return 161; }
  if group == 2 { return 961; } if group == 3 { return 2015; } return 2715;
}
fn outside_odd_widest(group: i32) -> i32 {
  if group == 0 { return 8; } if group == 1 { return 6; }
  if group == 2 { return 4; } if group == 3 { return 3; } return 1;
}
fn inside_odd_total(group: i32) -> i32 {
  if group == 0 { return 4; } if group == 1 { return 20; }
  if group == 2 { return 48; } return 81;
}
fn inside_gsum(group: i32) -> i32 {
  if group == 0 { return 0; } if group == 1 { return 336; }
  if group == 2 { return 1036; } return 1516;
}
fn inside_odd_widest(group: i32) -> i32 {
  if group == 0 { return 2; } if group == 1 { return 4; }
  if group == 2 { return 6; } return 8;
}

// field 0=value, 1=checksum, 2=finder value.
fn decode_pair(row: Array<i32>, length: i32, reversed: bool, right: bool, field: i32) -> i32 {
  let counters: u32 = c.mem_alloc_bytes(8);
  let packed: i32 = find_finder(row, length, reversed, right, counters);
  if packed < 0 { return -1; }
  let parsed: i32 = parse_finder(row, length, reversed, packed, counters);
  if parsed < 0 { return -1; }
  let first_start: i32 = c.safe_div_i32(parsed, 16);
  let finder: i32 = parsed - first_start * 16;
  if field == 2 { return finder; }
  let packed_rows: i32 = packed / 65536;
  let end: i32 = packed - packed_rows * 65536;
  let outside_value: i32 = decode_character(row, length, reversed, first_start, end, true, field);
  let inside_value: i32 = decode_character(row, length, reversed, first_start, end, false, field);
  if outside_value < 0 || inside_value < 0 { return -1; }
  if field == 1 { return outside_value + 4 * inside_value; }
  return 1597 * outside_value + inside_value;
}

fn two_digits(value: i32) -> string {
  return string_concat(c.digit_char(value / 10), c.digit_char(value - value / 10 * 10));
}

fn construct_result(left: i32, right: i32) -> string {
  // Compute 4_537_077 * left + right in base 100 so every intermediate fits i32.
  let mut value: i32 = left * 77 + right - right / 100 * 100;
  let chunk0: i32 = value - value / 100 * 100;
  let mut carry: i32 = value / 100;
  let right_chunk1: i32 = right / 100 - right / 10000 * 100;
  value = left * 70 + right_chunk1 + carry;
  let chunk1: i32 = value - value / 100 * 100;
  carry = value / 100;
  let right_chunk2: i32 = right / 10000 - right / 1000000 * 100;
  value = left * 53 + right_chunk2 + carry;
  let chunk2: i32 = value - value / 100 * 100;
  carry = value / 100;
  value = left * 4 + right / 1000000 + carry;
  let chunk3: i32 = value - value / 100 * 100;
  carry = value / 100;
  let chunk4: i32 = carry - carry / 100 * 100;
  carry = carry / 100;
  let chunk5: i32 = carry - carry / 100 * 100;
  let chunk6: i32 = carry / 100;
  let mut text: string = string_concat(c.digit_char(chunk6), two_digits(chunk5));
  text = string_concat(text, two_digits(chunk4));
  text = string_concat(text, two_digits(chunk3));
  text = string_concat(text, two_digits(chunk2));
  text = string_concat(text, two_digits(chunk1));
  text = string_concat(text, two_digits(chunk0));
  let mut checksum: i32 = 0;
  let mut index: i32 = 0;
  while index < 13 {
    let digit: i32 = string_byte_at(text, index) - 48;
    if parity(index) == 0 { checksum = checksum + digit * 3; }
    else { checksum = checksum + digit; }
    index = index + 1;
  }
  let checksum_remainder: i32 = checksum - checksum / 10 * 10;
  let mut check_digit: i32 = 10 - checksum_remainder;
  if check_digit == 10 { check_digit = 0; }
  return string_concat(text, c.digit_char(check_digit));
}

export fn decode_databar_row(row: Array<i32>, length: i32) -> string {
  if length > c.array_len_i32(row) { return ""; }
  if length < 30 { return ""; }
  let left: i32 = decode_pair(row, length, false, false, 0);
  let right: i32 = decode_pair(row, length, true, true, 0);
  let left_checksum: i32 = decode_pair(row, length, false, false, 1);
  let right_checksum: i32 = decode_pair(row, length, true, true, 1);
  let left_finder: i32 = decode_pair(row, length, false, false, 2);
  let right_finder: i32 = decode_pair(row, length, true, true, 2);
  if left < 0 || right < 0 || left_checksum < 0 || right_checksum < 0
    || left_finder < 0 || right_finder < 0 { return ""; }
  let mut check_value: i32 = left_checksum + 16 * right_checksum;
  check_value = check_value - check_value / 79 * 79;
  let mut target: i32 = 9 * left_finder + right_finder;
  if target > 72 { target = target - 1; }
  if target > 8 { target = target - 1; }
  if check_value != target { return ""; }
  return string_concat("", construct_result(left, right));
}