// Precomputed ECC200 Utah placement map (large squares).
// Values are 3-digit decimals matching the encoder tables; 999 denotes an
// unused mapping cell. Split from matrix-decoder-datamatrix.fws to keep every
// linked module under the self-hosted lex-stage bootstrap size limit.

export fn square_map_b(rows: i32, cols: i32) -> string {
  if rows == 18 {
    if cols == 18 { return ""; }
  }
  if rows == 20 {
    if cols == 20 { return ""; }
  }
  if rows == 22 {
    if cols == 22 { return ""; }
  }
  if rows == 24 {
    if cols == 24 { return ""; }
  }
  return "";
}
