
fn barcode_u32_to_i32_len(value: u32) -> i32 {
  let mut remaining: u32 = value;
  let mut place: i32 = 1;
  let mut result: i32 = 0;
  while remaining > 0 {
    let mut bit: u32 = remaining - remaining / 2 * 2;
    if bit == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place * 2;
  }
  return result;
}

fn barcode_modules_len(modules: Array<i32>) -> i32 {
  return barcode_u32_to_i32_len(modules.length());
}
fn barcode_is_digit_at(value: string, index: i32) -> bool {
  let code: i32 = string_byte_at(value, index);
  return code >= 48 && code <= 57;
}

fn barcode_has_seven_digits(value: string) -> bool {
  return barcode_is_digit_at(value, 0) && barcode_is_digit_at(value, 1) && barcode_is_digit_at(value, 2) && barcode_is_digit_at(value, 3) && barcode_is_digit_at(value, 4) && barcode_is_digit_at(value, 5) && barcode_is_digit_at(value, 6);
}

fn barcode_has_eight_digits(value: string) -> bool {
  return barcode_has_seven_digits(value) && barcode_is_digit_at(value, 7);
}

fn barcode_digit_at(value: string, index: i32) -> i32 {
  return string_byte_at(value, index) - 48;
}

fn barcode_ean8_check(value: string) -> i32 {
  let sum: i32 = barcode_digit_at(value, 0) * 3 + barcode_digit_at(value, 1) + barcode_digit_at(value, 2) * 3 + barcode_digit_at(value, 3) + barcode_digit_at(value, 4) * 3 + barcode_digit_at(value, 5) + barcode_digit_at(value, 6) * 3;
  let remainder: i32 = sum % 10;
  if remainder == 0 { return 0; }
  if remainder == 1 { return 9; }
  if remainder == 2 { return 8; }
  if remainder == 3 { return 7; }
  if remainder == 4 { return 6; }
  if remainder == 5 { return 5; }
  if remainder == 6 { return 4; }
  if remainder == 7 { return 3; }
  if remainder == 8 { return 2; }
  return 1;
}

// EAN-8, EAN-13, UPC-A, and EAN decoder/encoder graph.

fn barcode_digit_char(value: i32) -> string {
  if value == 0 { return "0"; }
  if value == 1 { return "1"; }
  if value == 2 { return "2"; }
  if value == 3 { return "3"; }
  if value == 4 { return "4"; }
  if value == 5 { return "5"; }
  if value == 6 { return "6"; }
  if value == 7 { return "7"; }
  if value == 8 { return "8"; }
  return "9";
}

fn barcode_valid_ean8(value: string) -> bool {
  let length: i32 = string_length(value);
  if length == 7 {
    return barcode_has_seven_digits(value);
  }
  if length == 8 {
    if !barcode_has_eight_digits(value) { return false; }
    return barcode_digit_at(value, 7) == barcode_ean8_check(value);
  }
  return false;
}



fn barcode_has_eleven_digits(value: string) -> bool {
  return barcode_has_seven_digits(value) && barcode_is_digit_at(value, 7) && barcode_is_digit_at(value, 8) && barcode_is_digit_at(value, 9) && barcode_is_digit_at(value, 10);
}

fn barcode_has_twelve_digits(value: string) -> bool {
  return barcode_has_eleven_digits(value) && barcode_is_digit_at(value, 11);
}

fn barcode_has_thirteen_digits(value: string) -> bool {
  return barcode_has_twelve_digits(value) && barcode_is_digit_at(value, 12);
}

fn barcode_ean13_check(value: string) -> i32 {
  let sum: i32 = barcode_digit_at(value, 0) + barcode_digit_at(value, 1) * 3 + barcode_digit_at(value, 2) + barcode_digit_at(value, 3) * 3 + barcode_digit_at(value, 4) + barcode_digit_at(value, 5) * 3 + barcode_digit_at(value, 6) + barcode_digit_at(value, 7) * 3 + barcode_digit_at(value, 8) + barcode_digit_at(value, 9) * 3 + barcode_digit_at(value, 10) + barcode_digit_at(value, 11) * 3;
  let remainder: i32 = sum % 10;
  if remainder == 0 { return 0; }
  if remainder == 1 { return 9; }
  if remainder == 2 { return 8; }
  if remainder == 3 { return 7; }
  if remainder == 4 { return 6; }
  if remainder == 5 { return 5; }
  if remainder == 6 { return 4; }
  if remainder == 7 { return 3; }
  if remainder == 8 { return 2; }
  return 1;
}

fn barcode_valid_ean13(value: string) -> bool {
  let length: i32 = string_length(value);
  if length == 12 { return barcode_has_twelve_digits(value); }
  if length == 13 {
    if !barcode_has_thirteen_digits(value) { return false; }
    return barcode_digit_at(value, 12) == barcode_ean13_check(value);
  }
  return false;
}



fn barcode_ean13_g_pattern(value: i32) -> string {
  if value == 0 { return "0100111"; }
  if value == 1 { return "0110011"; }
  if value == 2 { return "0011011"; }
  if value == 3 { return "0100001"; }
  if value == 4 { return "0011101"; }
  if value == 5 { return "0111001"; }
  if value == 6 { return "0000101"; }
  if value == 7 { return "0010001"; }
  if value == 8 { return "0001001"; }
  return "0010111";
}

fn barcode_ean13_parity(value: i32) -> string {
  if value == 0 { return "LLLLLL"; }
  if value == 1 { return "LLGLGG"; }
  if value == 2 { return "LLGGLG"; }
  if value == 3 { return "LLGGGL"; }
  if value == 4 { return "LGLLGG"; }
  if value == 5 { return "LGGLLG"; }
  if value == 6 { return "LGGGLL"; }
  if value == 7 { return "LGLGLG"; }
  if value == 8 { return "LGLGGL"; }
  return "LGLLGL";
}











fn barcode_bits_match(modules: Array<i32>, start: i32, pattern: string) -> bool {
  return modules[start] + 48 == string_byte_at(pattern, 0) && modules[start + 1] + 48 == string_byte_at(pattern, 1) && modules[start + 2] + 48 == string_byte_at(pattern, 2) && modules[start + 3] + 48 == string_byte_at(pattern, 3) && modules[start + 4] + 48 == string_byte_at(pattern, 4) && modules[start + 5] + 48 == string_byte_at(pattern, 5) && modules[start + 6] + 48 == string_byte_at(pattern, 6);
}

fn barcode_left_digit_from_bits(modules: Array<i32>, start: i32) -> i32 {
  if barcode_bits_match(modules, start, "0001101") { return 0; }
  if barcode_bits_match(modules, start, "0011001") { return 1; }
  if barcode_bits_match(modules, start, "0010011") { return 2; }
  if barcode_bits_match(modules, start, "0111101") { return 3; }
  if barcode_bits_match(modules, start, "0100011") { return 4; }
  if barcode_bits_match(modules, start, "0110001") { return 5; }
  if barcode_bits_match(modules, start, "0101111") { return 6; }
  if barcode_bits_match(modules, start, "0111011") { return 7; }
  if barcode_bits_match(modules, start, "0110111") { return 8; }
  if barcode_bits_match(modules, start, "0001011") { return 9; }
  return -1;
}

fn barcode_right_digit_from_bits(modules: Array<i32>, start: i32) -> i32 {
  if barcode_bits_match(modules, start, "1110010") { return 0; }
  if barcode_bits_match(modules, start, "1100110") { return 1; }
  if barcode_bits_match(modules, start, "1101100") { return 2; }
  if barcode_bits_match(modules, start, "1000010") { return 3; }
  if barcode_bits_match(modules, start, "1011100") { return 4; }
  if barcode_bits_match(modules, start, "1001110") { return 5; }
  if barcode_bits_match(modules, start, "1010000") { return 6; }
  if barcode_bits_match(modules, start, "1000100") { return 7; }
  if barcode_bits_match(modules, start, "1001000") { return 8; }
  if barcode_bits_match(modules, start, "1110100") { return 9; }
  return -1;
}

fn barcode_g_digit_from_bits(modules: Array<i32>, start: i32) -> i32 {
  if barcode_bits_match(modules, start, "0100111") { return 0; }
  if barcode_bits_match(modules, start, "0110011") { return 1; }
  if barcode_bits_match(modules, start, "0011011") { return 2; }
  if barcode_bits_match(modules, start, "0100001") { return 3; }
  if barcode_bits_match(modules, start, "0011101") { return 4; }
  if barcode_bits_match(modules, start, "0111001") { return 5; }
  if barcode_bits_match(modules, start, "0000101") { return 6; }
  if barcode_bits_match(modules, start, "0010001") { return 7; }
  if barcode_bits_match(modules, start, "0001001") { return 8; }
  if barcode_bits_match(modules, start, "0010111") { return 9; }
  return -1;
}

export fn barcode_decode_ean8(modules: Array<i32>) -> string {
  return string_concat(barcode_decode_ean8_row(modules, barcode_modules_len(modules)), "");
}

// Length-aware variant: decode the first `count` sampled modules of an array
// that may be larger than the symbol (the scanner shares one oversized scratch
// buffer across formats). Only the fixed guard/data indices below are read.
export fn barcode_decode_ean8_row(modules: Array<i32>, count: i32) -> string {
  if count != 67 { return ""; }
  if barcode_modules_len(modules) < 67 { return ""; }
  if modules[0] != 1 || modules[1] != 0 || modules[2] != 1 { return ""; }
  if modules[31] != 0 || modules[32] != 1 || modules[33] != 0 || modules[34] != 1 || modules[35] != 0 { return ""; }
  if modules[64] != 1 || modules[65] != 0 || modules[66] != 1 { return ""; }
  let first: i32 = barcode_left_digit_from_bits(modules, 3);
  let second: i32 = barcode_left_digit_from_bits(modules, 10);
  let third: i32 = barcode_left_digit_from_bits(modules, 17);
  let fourth: i32 = barcode_left_digit_from_bits(modules, 24);
  let fifth: i32 = barcode_right_digit_from_bits(modules, 36);
  let sixth: i32 = barcode_right_digit_from_bits(modules, 43);
  let seventh: i32 = barcode_right_digit_from_bits(modules, 50);
  let eighth: i32 = barcode_right_digit_from_bits(modules, 57);
  if first < 0 || second < 0 || third < 0 || fourth < 0 || fifth < 0 || sixth < 0 || seventh < 0 || eighth < 0 { return ""; }
  let result: string = string_concat(string_concat(string_concat(barcode_digit_char(first), barcode_digit_char(second)), string_concat(barcode_digit_char(third), barcode_digit_char(fourth))), string_concat(string_concat(barcode_digit_char(fifth), barcode_digit_char(sixth)), string_concat(barcode_digit_char(seventh), barcode_digit_char(eighth))));
  if !barcode_valid_ean8(result) { return ""; }
  return string_concat(result, "");
}

fn barcode_parity_matches(value: string, pattern: string) -> bool {
  return string_byte_at(value, 0) == string_byte_at(pattern, 0) && string_byte_at(value, 1) == string_byte_at(pattern, 1) && string_byte_at(value, 2) == string_byte_at(pattern, 2) && string_byte_at(value, 3) == string_byte_at(pattern, 3) && string_byte_at(value, 4) == string_byte_at(pattern, 4) && string_byte_at(value, 5) == string_byte_at(pattern, 5);
}

fn barcode_parity_digit(value: string) -> i32 {
  if barcode_parity_matches(value, "LLLLLL") { return 0; }
  if barcode_parity_matches(value, "LLGLGG") { return 1; }
  if barcode_parity_matches(value, "LLGGLG") { return 2; }
  if barcode_parity_matches(value, "LLGGGL") { return 3; }
  if barcode_parity_matches(value, "LGLLGG") { return 4; }
  if barcode_parity_matches(value, "LGGLLG") { return 5; }
  if barcode_parity_matches(value, "LGGGLL") { return 6; }
  if barcode_parity_matches(value, "LGLGLG") { return 7; }
  if barcode_parity_matches(value, "LGLGGL") { return 8; }
  if barcode_parity_matches(value, "LGLLGL") { return 9; }
  return -1;
}

export fn barcode_decode_ean13(modules: Array<i32>) -> string {
  return string_concat(barcode_decode_ean13_row(modules, barcode_modules_len(modules)), "");
}

// Length-aware EAN-13 decode over the first `count` modules of an oversized array.
export fn barcode_decode_ean13_row(modules: Array<i32>, count: i32) -> string {
  if count != 95 { return ""; }
  if barcode_modules_len(modules) < 95 { return ""; }
  if modules[0] != 1 || modules[1] != 0 || modules[2] != 1 { return ""; }
  if modules[45] != 0 || modules[46] != 1 || modules[47] != 0 || modules[48] != 1 || modules[49] != 0 { return ""; }
  if modules[92] != 1 || modules[93] != 0 || modules[94] != 1 { return ""; }
  let mut first: i32 = barcode_left_digit_from_bits(modules, 3);
  let mut first_parity: string = "L";
  if first < 0 { first = barcode_g_digit_from_bits(modules, 3); first_parity = "G"; }
  let mut second: i32 = barcode_left_digit_from_bits(modules, 10);
  let mut second_parity: string = "L";
  if second < 0 { second = barcode_g_digit_from_bits(modules, 10); second_parity = "G"; }
  let mut third: i32 = barcode_left_digit_from_bits(modules, 17);
  let mut third_parity: string = "L";
  if third < 0 { third = barcode_g_digit_from_bits(modules, 17); third_parity = "G"; }
  let mut fourth: i32 = barcode_left_digit_from_bits(modules, 24);
  let mut fourth_parity: string = "L";
  if fourth < 0 { fourth = barcode_g_digit_from_bits(modules, 24); fourth_parity = "G"; }
  let mut fifth: i32 = barcode_left_digit_from_bits(modules, 31);
  let mut fifth_parity: string = "L";
  if fifth < 0 { fifth = barcode_g_digit_from_bits(modules, 31); fifth_parity = "G"; }
  let mut sixth: i32 = barcode_left_digit_from_bits(modules, 38);
  let mut sixth_parity: string = "L";
  if sixth < 0 { sixth = barcode_g_digit_from_bits(modules, 38); sixth_parity = "G"; }
  let parity: string = string_concat(string_concat(string_concat(first_parity, second_parity), string_concat(third_parity, fourth_parity)), string_concat(fifth_parity, sixth_parity));
  let leading: i32 = barcode_parity_digit(parity);
  let seventh: i32 = barcode_right_digit_from_bits(modules, 50);
  let eighth: i32 = barcode_right_digit_from_bits(modules, 57);
  let ninth: i32 = barcode_right_digit_from_bits(modules, 64);
  let tenth: i32 = barcode_right_digit_from_bits(modules, 71);
  let eleventh: i32 = barcode_right_digit_from_bits(modules, 78);
  let twelfth: i32 = barcode_right_digit_from_bits(modules, 85);
  if leading < 0 || first < 0 || second < 0 || third < 0 || fourth < 0 || fifth < 0 || sixth < 0 || seventh < 0 || eighth < 0 || ninth < 0 || tenth < 0 || eleventh < 0 || twelfth < 0 { return ""; }
  let result: string = string_concat(string_concat(string_concat(string_concat(barcode_digit_char(leading), barcode_digit_char(first)), string_concat(barcode_digit_char(second), barcode_digit_char(third))), string_concat(string_concat(barcode_digit_char(fourth), barcode_digit_char(fifth)), barcode_digit_char(sixth))), string_concat(string_concat(string_concat(barcode_digit_char(seventh), barcode_digit_char(eighth)), string_concat(barcode_digit_char(ninth), barcode_digit_char(tenth))), string_concat(barcode_digit_char(eleventh), barcode_digit_char(twelfth))));
  if !barcode_valid_ean13(result) { return ""; }
  return string_concat(result, "");
}

export fn barcode_decode_upca(modules: Array<i32>) -> string {
  return string_concat(barcode_decode_upca_row(modules, barcode_modules_len(modules)), "");
}

// Length-aware UPC-A decode over the first `count` modules of an oversized array.
export fn barcode_decode_upca_row(modules: Array<i32>, count: i32) -> string {
  if count != 95 { return ""; }
  if barcode_modules_len(modules) < 95 { return ""; }
  if modules[0] != 1 || modules[1] != 0 || modules[2] != 1 { return ""; }
  if modules[45] != 0 || modules[46] != 1 || modules[47] != 0 || modules[48] != 1 || modules[49] != 0 { return ""; }
  if modules[92] != 1 || modules[93] != 0 || modules[94] != 1 { return ""; }
  let first: i32 = barcode_left_digit_from_bits(modules, 3);
  let second: i32 = barcode_left_digit_from_bits(modules, 10);
  let third: i32 = barcode_left_digit_from_bits(modules, 17);
  let fourth: i32 = barcode_left_digit_from_bits(modules, 24);
  let fifth: i32 = barcode_left_digit_from_bits(modules, 31);
  let sixth: i32 = barcode_left_digit_from_bits(modules, 38);
  let seventh: i32 = barcode_right_digit_from_bits(modules, 50);
  let eighth: i32 = barcode_right_digit_from_bits(modules, 57);
  let ninth: i32 = barcode_right_digit_from_bits(modules, 64);
  let tenth: i32 = barcode_right_digit_from_bits(modules, 71);
  let eleventh: i32 = barcode_right_digit_from_bits(modules, 78);
  let twelfth: i32 = barcode_right_digit_from_bits(modules, 85);
  if first < 0 || second < 0 || third < 0 || fourth < 0 || fifth < 0 || sixth < 0 || seventh < 0 || eighth < 0 || ninth < 0 || tenth < 0 || eleventh < 0 || twelfth < 0 { return ""; }
  let left_first: string = string_concat(barcode_digit_char(first), barcode_digit_char(second));
  let left_second: string = string_concat(barcode_digit_char(third), barcode_digit_char(fourth));
  let right_first: string = string_concat(barcode_digit_char(fifth), barcode_digit_char(sixth));
  let right_second: string = string_concat(barcode_digit_char(seventh), barcode_digit_char(eighth));
  let tail_first: string = string_concat(barcode_digit_char(ninth), barcode_digit_char(tenth));
  let tail_second: string = string_concat(barcode_digit_char(eleventh), barcode_digit_char(twelfth));
  let result: string = string_concat(string_concat(string_concat(left_first, left_second), string_concat(right_first, right_second)), string_concat(tail_first, tail_second));
  if !barcode_valid_ean13(string_concat("0", result)) { return ""; }
  return string_concat(result, "");
}

fn barcode_invert_upce_parity(value: string) -> string {
  let mut first: string = "L";
  if string_byte_at(value, 0) == 76 { first = "G"; }
  let mut second: string = "L";
  if string_byte_at(value, 1) == 76 { second = "G"; }
  let mut third: string = "L";
  if string_byte_at(value, 2) == 76 { third = "G"; }
  let mut fourth: string = "L";
  if string_byte_at(value, 3) == 76 { fourth = "G"; }
  let mut fifth: string = "L";
  if string_byte_at(value, 4) == 76 { fifth = "G"; }
  let mut sixth: string = "L";
  if string_byte_at(value, 5) == 76 { sixth = "G"; }
  return string_concat(string_concat(string_concat(string_concat(string_concat(first, second), third), fourth), fifth), sixth);
}

fn barcode_upce_check_from_parity(value: string) -> i32 {
  if barcode_parity_matches(value, "GGGLLL") { return 0; }
  if barcode_parity_matches(value, "GGLGLL") { return 1; }
  if barcode_parity_matches(value, "GGLLGL") { return 2; }
  if barcode_parity_matches(value, "GGLLLG") { return 3; }
  if barcode_parity_matches(value, "GLGGLL") { return 4; }
  if barcode_parity_matches(value, "GLLGGL") { return 5; }
  if barcode_parity_matches(value, "GLLLGG") { return 6; }
  if barcode_parity_matches(value, "GLGLGL") { return 7; }
  if barcode_parity_matches(value, "GLGLLG") { return 8; }
  if barcode_parity_matches(value, "GLLGLG") { return 9; }
  return -1;
}

fn barcode_upce_upca_body(value: string, number_system: i32) -> string {
  let last: i32 = barcode_digit_at(value, 5);
  if last <= 2 {
    let prefix: string = string_concat(string_concat(barcode_digit_char(number_system), string_slice(value, 0, 2)), barcode_digit_char(last));
    return string_concat(string_concat(string_concat(prefix, "000"), string_slice(value, 2, 5)), "0");
  }
  if last == 3 {
    let prefix: string = string_concat(barcode_digit_char(number_system), string_slice(value, 0, 3));
    return string_concat(string_concat(string_concat(prefix, "0000"), string_slice(value, 3, 5)), "0");
  }
  if last == 4 {
    let prefix: string = string_concat(barcode_digit_char(number_system), string_slice(value, 0, 4));
    return string_concat(string_concat(string_concat(prefix, "0000"), string_slice(value, 4, 5)), "0");
  }
  let prefix: string = string_concat(barcode_digit_char(number_system), string_slice(value, 0, 5));
  return string_concat(string_concat(prefix, "0000"), barcode_digit_char(last));
}









// UPC-E accepts a six-digit payload, an optional number system, and an optional verified check digit.


export fn barcode_decode_upce(modules: Array<i32>) -> string {
  return string_concat(barcode_decode_upce_row(modules, barcode_modules_len(modules)), "");
}

// Length-aware UPC-E decode over the first `count` modules of an oversized array.
export fn barcode_decode_upce_row(modules: Array<i32>, count: i32) -> string {
  if count != 51 { return ""; }
  if barcode_modules_len(modules) < 51 { return ""; }
  if modules[0] != 1 || modules[1] != 0 || modules[2] != 1 { return ""; }
  if modules[45] != 0 || modules[46] != 1 || modules[47] != 0 || modules[48] != 1 || modules[49] != 0 || modules[50] != 1 { return ""; }

  let mut first: i32 = barcode_left_digit_from_bits(modules, 3);
  let mut first_parity: string = "L";
  if first < 0 { first = barcode_g_digit_from_bits(modules, 3); first_parity = "G"; }
  let mut second: i32 = barcode_left_digit_from_bits(modules, 10);
  let mut second_parity: string = "L";
  if second < 0 { second = barcode_g_digit_from_bits(modules, 10); second_parity = "G"; }
  let mut third: i32 = barcode_left_digit_from_bits(modules, 17);
  let mut third_parity: string = "L";
  if third < 0 { third = barcode_g_digit_from_bits(modules, 17); third_parity = "G"; }
  let mut fourth: i32 = barcode_left_digit_from_bits(modules, 24);
  let mut fourth_parity: string = "L";
  if fourth < 0 { fourth = barcode_g_digit_from_bits(modules, 24); fourth_parity = "G"; }
  let mut fifth: i32 = barcode_left_digit_from_bits(modules, 31);
  let mut fifth_parity: string = "L";
  if fifth < 0 { fifth = barcode_g_digit_from_bits(modules, 31); fifth_parity = "G"; }
  let mut sixth: i32 = barcode_left_digit_from_bits(modules, 38);
  let mut sixth_parity: string = "L";
  if sixth < 0 { sixth = barcode_g_digit_from_bits(modules, 38); sixth_parity = "G"; }
  if first < 0 || second < 0 || third < 0 || fourth < 0 || fifth < 0 || sixth < 0 { return ""; }

  let digits: string = string_concat(string_concat(string_concat(string_concat(string_concat(barcode_digit_char(first), barcode_digit_char(second)), barcode_digit_char(third)), barcode_digit_char(fourth)), barcode_digit_char(fifth)), barcode_digit_char(sixth));
  let parity: string = string_concat(string_concat(string_concat(string_concat(string_concat(first_parity, second_parity), third_parity), fourth_parity), fifth_parity), sixth_parity);
  let mut check: i32 = barcode_upce_check_from_parity(parity);
  let mut number_system: i32 = 0;
  if check < 0 {
    check = barcode_upce_check_from_parity(barcode_invert_upce_parity(parity));
    number_system = 1;
  }
  if check < 0 { return ""; }
  let body: string = barcode_upce_upca_body(digits, number_system);
  if barcode_ean13_check(string_concat("0", body)) != check { return ""; }
  return string_concat(string_concat(barcode_digit_char(number_system), digits), barcode_digit_char(check));
}