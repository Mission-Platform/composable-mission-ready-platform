// Code 39 standard and full-ASCII encoder graph.

fn u32_to_i32_len(value: u32) -> i32 {
  let mut remaining: u32 = value;
  let mut place: i32 = 1;
  let mut result: i32 = 0;
  while remaining > 0 {
    let mut bit: u32 = remaining - remaining / 2 * 2;
    if bit == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place * 2;
  }
  return result;
}

fn modules_len(modules: Array<i32>) -> i32 {
  return u32_to_i32_len(modules.length());
}

fn letter(value: i32) -> string {
  if value == 0 { return "A"; }
  if value == 1 { return "B"; }
  if value == 2 { return "C"; }
  if value == 3 { return "D"; }
  if value == 4 { return "E"; }
  if value == 5 { return "F"; }
  if value == 6 { return "G"; }
  if value == 7 { return "H"; }
  if value == 8 { return "I"; }
  if value == 9 { return "J"; }
  if value == 10 { return "K"; }
  if value == 11 { return "L"; }
  if value == 12 { return "M"; }
  if value == 13 { return "N"; }
  if value == 14 { return "O"; }
  if value == 15 { return "P"; }
  if value == 16 { return "Q"; }
  if value == 17 { return "R"; }
  if value == 18 { return "S"; }
  if value == 19 { return "T"; }
  if value == 20 { return "U"; }
  if value == 21 { return "V"; }
  if value == 22 { return "W"; }
  if value == 23 { return "X"; }
  if value == 24 { return "Y"; }
  return "Z";
}

fn digit(value: i32) -> string {
  if value == 0 { return "0"; }
  if value == 1 { return "1"; }
  if value == 2 { return "2"; }
  if value == 3 { return "3"; }
  if value == 4 { return "4"; }
  if value == 5 { return "5"; }
  if value == 6 { return "6"; }
  if value == 7 { return "7"; }
  if value == 8 { return "8"; }
  return "9";
}

fn pattern(value: i32) -> string {
  if value == 48 { return "nnnwwnwnn"; }
  if value == 49 { return "wnnwnnnnw"; }
  if value == 50 { return "nnwwnnnnw"; }
  if value == 51 { return "wnwwnnnnn"; }
  if value == 52 { return "nnnwwnnnw"; }
  if value == 53 { return "wnnwwnnnn"; }
  if value == 54 { return "nnwwwnnnn"; }
  if value == 55 { return "nnnwnnwnw"; }
  if value == 56 { return "wnnwnnwnn"; }
  if value == 57 { return "nnwwnnwnn"; }
  if value == 65 { return "wnnnnwnnw"; }
  if value == 66 { return "nnwnnwnnw"; }
  if value == 67 { return "wnwnnwnnn"; }
  if value == 68 { return "nnnnwwnnw"; }
  if value == 69 { return "wnnnwwnnn"; }
  if value == 70 { return "nnwnwwnnn"; }
  if value == 71 { return "nnnnnwwnw"; }
  if value == 72 { return "wnnnnwwnn"; }
  if value == 73 { return "nnwnnwwnn"; }
  if value == 74 { return "nnnnwwwnn"; }
  if value == 75 { return "wnnnnnnww"; }
  if value == 76 { return "nnwnnnnww"; }
  if value == 77 { return "wnwnnnnwn"; }
  if value == 78 { return "nnnnwnnww"; }
  if value == 79 { return "wnnnwnnwn"; }
  if value == 80 { return "nnwnwnnwn"; }
  if value == 81 { return "nnnnnnwww"; }
  if value == 82 { return "wnnnnnwwn"; }
  if value == 83 { return "nnwnnnwwn"; }
  if value == 84 { return "nnnnwnwwn"; }
  if value == 85 { return "wwnnnnnnw"; }
  if value == 86 { return "nwwnnnnnw"; }
  if value == 87 { return "wwwnnnnnn"; }
  if value == 88 { return "nwnnwnnnw"; }
  if value == 89 { return "wwnnwnnnn"; }
  if value == 90 { return "nwwnwnnnn"; }
  if value == 45 { return "nwnnnnwnw"; }
  if value == 46 { return "wwnnnnwnn"; }
  if value == 32 { return "nwwnnnwnn"; }
  if value == 36 { return "nwnwnwnnn"; }
  if value == 47 { return "nwnwnnnwn"; }
  if value == 43 { return "nwnnnwnwn"; }
  if value == 37 { return "nnnwnwnwn"; }
  if value == 42 { return "nwnnwnwnn"; }
  return "";
}

fn run(bit: i32, width: i32) -> string {
  if bit == 1 {
    if width == 1 { return "1"; }
    return "111";
  }
  if width == 1 { return "0"; }
  return "000";
}

fn render(value: string, index: i32) -> string {
  if index >= string_length(value) { return ""; }
  let mut bit: i32 = 0;
  if index % 2 == 0 { bit = 1; }
  let mut width: i32 = 1;
  if string_byte_at(value, index) == 119 { width = 3; }
  return string_concat(run(bit, width), render(value, index + 1));
}

fn append_symbol(result: string, value: i32) -> string {
  let symbol: string = pattern(value);
  if string_length(symbol) == 0 { return ""; }
  return string_concat(result, render(symbol, 0));
}

fn append_sequence(result: string, sequence: string, index: i32) -> string {
  if index >= string_length(sequence) { return string_concat(result, ""); }
  let mut separator: string = "";
  if index > 0 { separator = "0"; }
  let next: string = append_symbol(string_concat(result, separator), string_byte_at(sequence, index));
  if string_length(next) == 0 { return ""; }
  return string_concat(append_sequence(next, sequence, index + 1), "");
}

fn extended_sequence(value: i32) -> string {
  if value == 0 { return "%U"; }
  if value >= 1 && value <= 26 { return string_concat("$", letter(value - 1)); }
  if value >= 27 && value <= 31 { return string_concat("%", letter(value - 27)); }
  if value == 32 { return " "; }
  if value >= 33 && value <= 44 { return string_concat("/", letter(value - 33)); }
  if value == 45 { return "-"; }
  if value == 46 { return "."; }
  if value == 47 { return "/O"; }
  if value >= 48 && value <= 57 { return string_concat(digit(value - 48), ""); }
  if value == 58 { return "/Z"; }
  if value >= 59 && value <= 63 { return string_concat("%", letter(value - 54)); }
  if value == 64 { return "%V"; }
  if value >= 65 && value <= 90 { return string_concat(letter(value - 65), ""); }
  if value >= 91 && value <= 95 { return string_concat("%", letter(value - 81)); }
  if value == 96 { return "%W"; }
  if value >= 97 && value <= 122 { return string_concat("+", letter(value - 97)); }
  if value >= 123 && value <= 127 { return string_concat("%", letter(value - 108)); }
  return "";
}

fn encode_standard(value: string, index: i32, result: string) -> string {
  if index >= string_length(value) {
    return string_concat(string_concat(result, "0"), render(pattern(42), 0));
  }
  let mut code: i32 = string_byte_at(value, index);
  if code >= 97 && code <= 122 { code = code - 32; }
  if code == 42 { return ""; }
  let next: string = append_symbol(string_concat(result, "0"), code);
  if string_length(next) == 0 { return ""; }
  return string_concat(encode_standard(value, index + 1, next), "");
}

fn encode_extended(value: string, index: i32, result: string) -> string {
  if index >= string_length(value) {
    return string_concat(string_concat(result, "0"), render(pattern(42), 0));
  }
  let sequence: string = extended_sequence(string_byte_at(value, index));
  if string_length(sequence) == 0 { return ""; }
  let next: string = append_sequence(string_concat(result, "0"), sequence, 0);
  if string_length(next) == 0 { return ""; }
  return string_concat(encode_extended(value, index + 1, next), "");
}

export fn encode_code39(value: string) -> string {
  return string_concat(encode_standard(value, 0, render(pattern(42), 0)), "");
}

export fn encode_code39_extended(value: string) -> string {
  if string_length(value) == 0 { return ""; }
  return string_concat(encode_extended(value, 0, render(pattern(42), 0)), "");
}
