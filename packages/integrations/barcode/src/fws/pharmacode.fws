// Pharmacode encoder graph for values from 3 through 131070.

fn u32_to_i32_len(value: u32) -> i32 {
  let mut remaining: u32 = value;
  let mut place: i32 = 1;
  let mut result: i32 = 0;
  while remaining > 0 {
    let mut bit: u32 = remaining - remaining / 2 * 2;
    if bit == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place * 2;
  }
  return result;
}

fn modules_len(modules: Array<i32>) -> i32 {
  return u32_to_i32_len(modules.length());
}


fn is_digit_at(value: string, index: i32) -> bool {
  let code: i32 = string_byte_at(value, index);
  return code >= 48 && code <= 57;
}

fn parse_value(value: string, index: i32, result: i32) -> i32 {
  if index >= string_length(value) {
    if result < 3 || result > 131070 { return -1; }
    return result;
  }
  if !is_digit_at(value, index) { return -1; }
  let digit: i32 = string_byte_at(value, index) - 48;
  if result > 13107 { return -1; }
  if result == 13107 && digit > 0 { return -1; }
  return parse_value(value, index + 1, result * 10 + digit);
}

fn bar_widths(value: i32) -> string {
  if value == 0 { return ""; }
  if value % 2 == 0 {
    let next: i32 = value - 2;
    return string_concat(bar_widths(next / 2), "w");
  }
  let next: i32 = value - 1;
  return string_concat(bar_widths(next / 2), "n");
}

fn render_bars(value: string, index: i32) -> string {
  if index >= string_length(value) { return ""; }
  let mut separator: string = "";
  if index > 0 { separator = "0"; }
  let mut bar: string = "1";
  if string_byte_at(value, index) == 119 { bar = "111"; }
  return string_concat(string_concat(separator, bar), render_bars(value, index + 1));
}

export fn encode_pharmacode(value: string) -> string {
  if string_length(value) == 0 { return ""; }
  let parsed: i32 = parse_value(value, 0, 0);
  if parsed < 0 { return ""; }
  return string_concat(render_bars(bar_widths(parsed), 0), "");
}
