{
  "name": "@mission-platform/map",
  "version": "0.1.6",
  "description": "MapLibre GL Vue 3 wrapper with full reactivity support for Mission Platform",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "**/*.vue"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/map.js"
    },
    "./styles": "./node_modules/maplibre-gl/dist/maplibre-gl.css"
  },
  "main": "./dist/map.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.{vue,scss}\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "peerDependencies": {
    "maplibre-gl": "^5.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@mission-platform/components": "workspace:*",
    "@mission-platform/i18n": "workspace:*",
    "@mission-platform/icons": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "@turf/turf": "catalog:map",
    "maplibre-gl": "catalog:map"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@storybook/vue3-vite": "catalog:storybook",
    "@types/geojson": "catalog:map",
    "@types/node": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/test-utils": "catalog:vue",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
