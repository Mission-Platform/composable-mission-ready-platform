{
  "name": "@mission-platform/map",
  "version": "0.4.0",
  "license": "BSD-4-Clause",
  "description": "MapLibre GL map components and composables authored with @mission-platform/forge and shipped as both Vue 3 and React builds",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "mp:vue": { "types": "./dist/vue/index.d.ts", "import": "./dist/vue/index.js" },
      "mp:react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
      "mp:solid": { "types": "./dist/solid/index.d.ts", "import": "./dist/solid/index.js" },
      "mp:svelte": { "types": "./dist/svelte/index.d.ts", "import": "./dist/svelte/index.js" },
      "mp:web-component": { "types": "./dist/web-components/index.d.ts", "import": "./dist/web-components/index.js" },
      "types": "./dist/components/index.d.ts",
      "import": "./src/components/index.ts"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./styles": "./node_modules/maplibre-gl/dist/maplibre-gl.css"
  },
  "files": [
    "dist",
    "src/components",
    "src/composables",
    "src/utils"
  ],
  "scripts": {
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "build:vue": "vite build --mode vue",
    "build:react": "vite build --mode react",
    "build:solid": "vite build --mode solid",
    "build:svelte": "vite build --mode svelte",
    "build:web-components": "vite build --mode web-components",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "maplibre-gl": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@mission-platform/forge": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "@turf/turf": "catalog:map",
    "maplibre-gl": "catalog:map"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/components": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@storybook/vue3-vite": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@types/geojson": "catalog:map",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-vue-jsx": "catalog:vue",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "lit": "catalog:webcomponents",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "solid-js": "catalog:solid",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "svelte": "catalog:svelte",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
