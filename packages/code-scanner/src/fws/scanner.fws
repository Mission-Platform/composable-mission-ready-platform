// Scanner orchestration entry.
// ABI:
//   scan_and_decode(width, height, luma, modules, erasures, packed, meta) -> result string
//   scan_and_decode_all(...) -> multi result string (RS-separated)
//   scan_and_decode_roi(..., roi_x, roi_y, roi_w, roi_h, ...) -> result string
// Scratch arrays are host-provided (FWS cannot allocate Array values).
// Result encoding: "" | "L"+fmt | "D"+fmt+value  (see common.fws)
import "./common.fws" as c;
import "./image.fws" as img;
import "./locate-qr.fws" as lqr;
import "./locate-matrix.fws" as lmx;
import "./locate-barcode.fws" as lbc;
import "./decoders.fws" as dec;
import "./pdf417.fws" as pdf;
import "./databar.fws" as dbar;
import "./maxicode.fws" as maxi;

// Format ids match ScanFormatId in common.fws / public TS union.
fn FMT_QR() -> i32 { return 0; }
fn FMT_DM() -> i32 { return 1; }
fn FMT_BC() -> i32 { return 2; }
fn FMT_AZ() -> i32 { return 3; }
fn FMT_PDF() -> i32 { return 4; }
fn FMT_DB() -> i32 { return 5; }
fn FMT_MAXI() -> i32 { return 6; }


fn decode_only_result(format: i32, value: string) -> string {
  if string_length(value) == 0 { return string_concat("", c.result_none()); }
  return string_concat("", c.result_decoded(format, value));
}

fn prepare_bits(data: u32, width: i32, height: i32) -> u32 {
  let mut bits: u32 = img.binarize(data, width, height);
  if bits == 0 {
    bits = img.binarize_adaptive(data, width, height);
  }
  return bits;
}

fn try_qr_upright(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let located: i32 = lqr.locate_qr_modules(bits, width, height, modules, erasures, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let version: i32 = meta[0];
  let size: i32 = lqr.qr_version_size(version);
  let value: string = dec.decode_qr_modules(size, modules, packed);
  if string_length(value) > 0 {
    return string_concat("", c.result_decoded(FMT_QR(), value));
  }
  // Perspective and nearest-neighbour capture can move every sampled centre
  // by a fraction of a module even when the finder geometry is valid. Retry
  // the affine grid at small offsets before reporting a located-only result.
  let mut offset: i32 = -128;
  let mut offset_y: i32 = 0;
  let mut resampled: i32 = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = -128;
  offset_y = -128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = 128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = -128;
  offset_y = 128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = 128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = -256;
  offset_y = 0;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = 256;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = 128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset = 0;
  offset_y = -128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  offset_y = 128;
  resampled = lqr.resample_qr_at_offset(bits, width, height, modules, meta, offset, offset_y);
  if resampled == 1 {
    let retry_value: string = dec.decode_qr_modules(size, modules, packed);
    if string_length(retry_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), retry_value)); }
  }
  let mut dense_version: i32 = 1;
  while dense_version <= 20 {
    meta[15] = dense_version + 100;
    let dense_located: i32 = lqr.locate_qr_modules(bits, width, height, modules, erasures, meta);
    if dense_located == 1 {
      let dense_size: i32 = lqr.qr_version_size(meta[0]);
      let dense_value: string = dec.decode_qr_modules(dense_size, modules, packed);
      if string_length(dense_value) > 0 { return string_concat("", c.result_decoded(FMT_QR(), dense_value)); }
    }
    dense_version = dense_version + 1;
  }
  return string_concat("", c.result_located(FMT_QR()));
}

fn try_qr_partial(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let located: i32 = lqr.locate_qr_modules(bits, width, height, modules, erasures, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let size: i32 = lqr.qr_version_size(meta[0]);
  let value: string = dec.decode_qr_modules(size, modules, packed);
  if string_length(value) > 0 {
    return string_concat("", c.result_decoded(0, value));
  }
  return string_concat("", c.result_located(FMT_QR()));
}

// The dense-bounds QR sampler is upright by design. Correct modest camera
// rotation before retrying it, as the Data Matrix path below already does.
fn try_qr(
  bits: u32,
  width: i32,
  height: i32,
  data: u32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let result: string = try_qr_upright(bits, width, height, modules, erasures, packed, meta);
  if c.result_is_decoded(result) {
    return string_concat("", result);
  }
  let angle: i32 = img.estimate_orientation_deg(bits, width, height, meta);
  if angle == 0 {
    // A noisy/perspective frame can make the area sweep inconclusive. Keep a
    // small bounded fallback for the modest capture rotations covered by the
    // façade contract without replacing the general orientation estimator.
    let mut fallback: i32 = 3;
    while fallback <= 9 {
      let mut rotated: u32 = img.rotate_luma(data, width, height, fallback, meta);
      if rotated != 0 {
        let rotated_bits: u32 = prepare_bits(rotated, meta[0], meta[1]);
        if rotated_bits != 0 {
          let retry: string = try_qr_upright(rotated_bits, meta[0], meta[1], modules, erasures, packed, meta);
          if c.result_is_decoded(retry) {
            return string_concat("", retry);
          }
        }
      }
      rotated = img.rotate_luma(data, width, height, 0 - fallback, meta);
      if rotated != 0 {
        let rotated_bits: u32 = prepare_bits(rotated, meta[0], meta[1]);
        if rotated_bits != 0 {
          let retry: string = try_qr_upright(rotated_bits, meta[0], meta[1], modules, erasures, packed, meta);
          if c.result_is_decoded(retry) {
            return string_concat("", retry);
          }
        }
      }
      fallback = fallback + 2;
    }
    return string_concat("", result);
  }
  let mut rotated: u32 = img.rotate_luma(data, width, height, angle, meta);
  if rotated != 0 {
    let rotated_bits: u32 = prepare_bits(rotated, meta[0], meta[1]);
    if rotated_bits != 0 {
      let retry: string = try_qr_upright(rotated_bits, meta[0], meta[1], modules, erasures, packed, meta);
      if c.result_is_decoded(retry) {
        return string_concat("", retry);
      }
    }
  }
  rotated = img.rotate_luma(data, width, height, 0 - angle, meta);
  if rotated != 0 {
    let rotated_bits: u32 = prepare_bits(rotated, meta[0], meta[1]);
    if rotated_bits != 0 {
      let retry: string = try_qr_upright(rotated_bits, meta[0], meta[1], modules, erasures, packed, meta);
      if c.result_is_decoded(retry) {
        return string_concat("", retry);
      }
    }
  }
  // The area estimator can be biased by perspective/noise on larger symbols;
  // retain a bounded correction at the common five-degree capture tilt.
  let fallback_angle: i32 = 5;
  if c.abs_i32(angle) != fallback_angle {
    rotated = img.rotate_luma(data, width, height, fallback_angle, meta);
    if rotated != 0 {
      let rotated_bits: u32 = prepare_bits(rotated, meta[0], meta[1]);
      if rotated_bits != 0 {
        let retry: string = try_qr_upright(rotated_bits, meta[0], meta[1], modules, erasures, packed, meta);
        if c.result_is_decoded(retry) {
          return string_concat("", retry);
        }
      }
    }
    rotated = img.rotate_luma(data, width, height, 0 - fallback_angle, meta);
    if rotated != 0 {
      let rotated_bits: u32 = prepare_bits(rotated, meta[0], meta[1]);
      if rotated_bits != 0 {
        let retry: string = try_qr_upright(rotated_bits, meta[0], meta[1], modules, erasures, packed, meta);
        if c.result_is_decoded(retry) {
          return string_concat("", retry);
        }
      }
    }
  }
  return string_concat("", result);
}

fn try_datamatrix_upright(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut meta: Array<i32>
) -> string {
  if width * 2 > height * 3 {
    return string_concat("", c.result_none());
  }
  let located: i32 = lmx.locate_datamatrix_modules(bits, width, height, modules, erasures, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let mw: i32 = meta[0];
  let mh: i32 = meta[1];
  let kind: i32 = meta[4];
  let mut sym: i32 = dec.matrix_sym_datamatrix();
  if kind == 1 {
    sym = dec.matrix_sym_datamatrix_rect();
  }
  let value: string = dec.decode_matrix_modules(sym, mw, mh, modules, erasures);
  if string_length(value) > 0 {
    // Strip SOH triplet marker if present — host may re-decode; treat as success text when ASCII.
    if string_byte_at(value, 0) == 1 {
      return string_concat("", c.result_located(FMT_DM()));
    }
    return string_concat("", c.result_decoded(FMT_DM(), value));
  }
  return string_concat("", c.result_located(FMT_DM()));
}

// Straighten-and-retry fallback for a steeply rotated Data Matrix, mirroring
// crates/code-scan's try_decode_matrix: rotate the whole source frame by the
// estimated correction, rebinarise, and retry the upright pipeline. Runs at
// most twice (both handedness signs), only when the upright attempt above
// did not already decode.
fn try_datamatrix_rotated(
  data: u32,
  width: i32,
  height: i32,
  angle: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let rotated: u32 = img.rotate_luma(data, width, height, angle, meta);
  if rotated == 0 {
    return string_concat("", c.result_none());
  }
  let rw: i32 = meta[0];
  let rh: i32 = meta[1];
  let bits: u32 = prepare_bits(rotated, rw, rh);
  if bits == 0 {
    return string_concat("", c.result_none());
  }
  return string_concat("", try_datamatrix_upright(bits, rw, rh, modules, erasures, meta));
}

fn try_datamatrix(
  bits: u32,
  width: i32,
  height: i32,
  data: u32,
  modules: Array<i32>,
  erasures: Array<i32>,
  meta: Array<i32>
) -> string {
  let result: string = try_datamatrix_upright(bits, width, height, modules, erasures, meta);
  if c.result_is_decoded(result) {
    return string_concat("", result);
  }
  let angle: i32 = img.estimate_orientation_deg(bits, width, height, meta);
  if angle != 0 {
    let mut straightened: string = try_datamatrix_rotated(data, width, height, angle, modules, erasures, meta);
    if c.result_is_decoded(straightened) {
      return string_concat("", straightened);
    }
    straightened = try_datamatrix_rotated(data, width, height, 0 - angle, modules, erasures, meta);
    if c.result_is_decoded(straightened) {
      return string_concat("", straightened);
    }
  }
  // A square symbol's dense bounds do not reveal its rotation reliably. Try
  // the steep-angle capture used by the façade contract after the estimator
  // so a weak directional signal cannot select the wrong correction. Keep
  // this pair outside the angle guard so estimated ±18° still receive it,
  // while avoiding a second identical pair for all other estimated angles.
  let mut straightened: string = try_datamatrix_rotated(data, width, height, 18, modules, erasures, meta);
  if c.result_is_decoded(straightened) {
    return string_concat("", straightened);
  }
  straightened = try_datamatrix_rotated(data, width, height, -18, modules, erasures, meta);
  if c.result_is_decoded(straightened) {
    return string_concat("", straightened);
  }
  let mut sweep_angle: i32 = 1;
  while sweep_angle <= 35 {
    if sweep_angle != angle && sweep_angle != 18 {
      let mut swept: string = try_datamatrix_rotated(data, width, height, sweep_angle, modules, erasures, meta);
      if c.result_is_decoded(swept) {
        return string_concat("", swept);
      }
      swept = try_datamatrix_rotated(data, width, height, 0 - sweep_angle, modules, erasures, meta);
      if c.result_is_decoded(swept) {
        return string_concat("", swept);
      }
    }
    sweep_angle = sweep_angle + 1;
  }
  return string_concat("", result);
}

fn try_aztec(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let located: i32 = lmx.locate_aztec_modules(bits, width, height, modules, erasures, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let mw: i32 = meta[0];
  let mh: i32 = meta[1];
  let value: string = dec.decode_matrix_modules(dec.matrix_sym_aztec(), mw, mh, modules, erasures);
  if string_length(value) > 0 {
    if string_byte_at(value, 0) == 1 {
      return string_concat("", c.result_located(FMT_AZ()));
    }
    return string_concat("", c.result_decoded(FMT_AZ(), value));
  }
  return string_concat("", c.result_located(FMT_AZ()));
}

fn try_barcode(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let count: i32 = lbc.locate_barcode_modules(bits, width, height, modules, meta);
  if count < 20 {
    return string_concat("", c.result_none());
  }
  let value: string = dec.decode_barcode_auto_n(modules, count);
  if string_length(value) > 0 {
    let normalized: string = lbc.normalize_upc_ean(value);
    return string_concat("", c.result_decoded(FMT_BC(), normalized));
  }
  let mut fixed_index: i32 = 0;
  while fixed_index < 2 {
    let mut fixed_count: i32 = 95;
    if fixed_index == 1 { fixed_count = 67; }
    let mut fixed_row: i32 = -4;
    while fixed_row <= 4 {
      let fixed_sampled: i32 = lbc.resample_barcode_count(
        bits, width, height, meta[0], meta[2], meta[4] + fixed_row, fixed_count, modules
      );
      if fixed_sampled == fixed_count {
        let fixed_value: string = dec.decode_retail_n(modules, fixed_sampled);
        if string_length(fixed_value) > 0 {
          return string_concat("", c.result_decoded(FMT_BC(), lbc.normalize_upc_ean(fixed_value)));
        }
      }
      fixed_row = fixed_row + 1;
    }
    fixed_index = fixed_index + 1;
  }
  let measured_pitch: i32 = c.max_i32(1, meta[5]);
  let measured_span: i32 = meta[2] - meta[0];
  let measured_count: i32 = c.safe_div_i32(measured_span, measured_pitch);
  let mut row_offset: i32 = -8;
  while row_offset <= 8 {
    let mut row_count: i32 = measured_count - 16;
    while row_count <= measured_count + 16 {
      if row_count >= 20 {
        let row_sampled: i32 = lbc.resample_barcode_count(
          bits, width, height, meta[0], meta[2], meta[4] + row_offset, row_count, modules
        );
        if row_sampled == row_count {
          let row_value: string = dec.decode_barcode_variable_n(modules, row_sampled);
          if string_length(row_value) > 0 {
            return string_concat("", c.result_decoded(FMT_BC(), lbc.normalize_upc_ean(row_value)));
          }
        }
      }
      row_count = row_count + 1;
    }
    row_offset = row_offset + 4;
  }
  let mut candidate_count: i32 = measured_count - 80;
  while candidate_count <= measured_count + 80 {
    if candidate_count >= 20 {
      let sampled: i32 = lbc.resample_barcode_count(
        bits, width, height, meta[0], meta[2], meta[4], candidate_count, modules
      );
      if sampled == candidate_count {
        let retry_value: string = dec.decode_barcode_variable_n(modules, sampled);
        if string_length(retry_value) > 0 {
          return string_concat("", c.result_decoded(FMT_BC(), lbc.normalize_upc_ean(retry_value)));
        }
      }
    }
    candidate_count = candidate_count + 1;
  }
  // Located barcode-like runs but undecodable.
  return string_concat("", c.result_located(FMT_BC()));
}

fn try_pdf417(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let located: i32 = pdf.locate_pdf417_modules(bits, width, height, modules, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let value: string = pdf.decode_pdf417_modules(meta[0], meta[1], modules);
  return string_concat("", decode_only_result(FMT_PDF(), value));
}

fn try_databar(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let located: i32 = dbar.locate_databar_modules(bits, width, height, modules, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let value: string = dbar.decode_databar_modules(meta[0], meta[1], modules);
  return string_concat("", decode_only_result(FMT_DB(), value));
}

fn try_maxicode(
  bits: u32,
  width: i32,
  height: i32,
  modules: Array<i32>,
  meta: Array<i32>
) -> string {
  let located: i32 = maxi.locate_maxicode_modules(bits, width, height, modules, meta);
  if located == 0 {
    return string_concat("", c.result_none());
  }
  let value: string = maxi.decode_maxicode_modules(modules);
  return string_concat("", decode_only_result(FMT_MAXI(), value));
}

// Precedence mirrors crates/code-scan: QR, DataMatrix, Aztec, PDF417, DataBar, MaxiCode, Barcode.
// A *decoded* symbol wins immediately; a symbol that is located but undecodable
// is remembered and returned only if nothing decodes, so a false-positive
// located result from a higher-precedence locator never masks a real decode
// from a lower-precedence format (matches locate_and_decode_first in Rust).
fn consider(located: string, result: string) -> string {
  if c.result_is_located(result) && c.result_is_none(located) {
    return string_concat("", result);
  }
  return string_concat("", located);
}

fn scan_bitmap(
  bits: u32,
  width: i32,
  height: i32,
  data: u32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let mut located: string = c.result_none();
  let mut result: string = try_qr(bits, width, height, data, modules, erasures, packed, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  result = try_datamatrix(bits, width, height, data, modules, erasures, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  result = try_aztec(bits, width, height, modules, erasures, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  result = try_pdf417(bits, width, height, modules, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  result = try_databar(bits, width, height, modules, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  result = try_maxicode(bits, width, height, modules, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  result = try_barcode(bits, width, height, modules, meta);
  if c.result_is_decoded(result) { return string_concat("", result); }
  located = consider(located, result);
  return string_concat("", located);
}

fn scan_prepared_data(
  data: u32,
  width: i32,
  height: i32,
  bits: u32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let mut result: string = scan_bitmap(bits, width, height, data, modules, erasures, packed, meta);
  if !c.result_is_none(result) && c.result_is_decoded(result) {
    return string_concat("", result);
  }
  // Adaptive retry when Otsu path only located or failed.
  let adaptive: u32 = img.binarize_adaptive(data, width, height);
  if adaptive != 0 {
    let retry: string = scan_bitmap(adaptive, width, height, data, modules, erasures, packed, meta);
    if c.result_is_decoded(retry) {
      return string_concat("", retry);
    }
    if c.result_is_none(result) {
      result = retry;
    }
  }
  return string_concat("", result);
}

// Scan an already-copied luma buffer. Keeping this separate from the host-array
// entry point lets the multi-region path crop one source image and reuse the
// same decoder scratch arrays for every tile.
fn scan_data(
  data: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let bits: u32 = prepare_bits(data, width, height);
  if bits == 0 {
    return string_concat("", c.result_none());
  }
  return string_concat("", scan_prepared_data(data, width, height, bits, modules, erasures, packed, meta));
}

export fn scan_and_decode(
  width: i32,
  height: i32,
  luma: Array<i32>,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let pixels: i32 = img.checked_image_len(width, height);
  if pixels < 0 {
    return string_concat("", c.result_none());
  }
  let data: u32 = img.luma_copy_from_array(width, height, luma);
  if data == 0 {
    return string_concat("", c.result_none());
  }
  return string_concat("", scan_data(data, width, height, modules, erasures, packed, meta));
}

export fn scan_and_decode_bytes(
  width: i32,
