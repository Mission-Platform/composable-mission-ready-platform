  let ch: i32 = meta[1];
  let bits: u32 = prepare_bits(cropped, cw, ch);
  if bits == 0 {
    return string_concat("", c.result_none());
  }
  return string_concat("", scan_bitmap(bits, cw, ch, cropped, modules, erasures, packed, meta));
}

fn scan_region(
  data: u32,
  width: i32,
  height: i32,
  x: i32,
  y: i32,
  region_width: i32,
  region_height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let cropped: u32 = img.crop_luma(data, width, height, x, y, region_width, region_height, meta);
  if cropped == 0 {
    return string_concat("", c.result_none());
  }
  let cropped_width: i32 = meta[0];
  let cropped_height: i32 = meta[1];
  // Do not send a tile whose dense ink touches its crop boundary to a decoder:
  // the tile contains a clipped symbol, not a complete candidate. This keeps
  // malformed partial grids from reaching decoder implementations while still
  // allowing valid symbols with their quiet zone inside a tile.
  let preview: u32 = prepare_bits(cropped, cropped_width, cropped_height);
  if preview == 0 {
    return string_concat("", c.result_none());
  }
  let bounds_ok: i32 = img.dense_dark_bounds(preview, cropped_width, cropped_height, meta);
  if bounds_ok == 0 || meta[0] <= 0 || meta[1] <= 0 || meta[2] >= cropped_width - 1 || meta[3] >= cropped_height - 1 {
    // A neighbouring symbol may be clipped by the overlapping crop. The QR
    // locator can still select a complete symbol farther inside the tile, but
    // running every decoder on a known partial tile is needlessly expensive.
    let partial: string = try_qr_partial(preview, cropped_width, cropped_height, modules, erasures, packed, meta);
    if c.result_is_decoded(partial) {
      return string_concat("", partial);
    }
    return string_concat("", c.result_none());
  }
  return string_concat("", scan_prepared_data(cropped, cropped_width, cropped_height, preview, modules, erasures, packed, meta));
}

// Multi-scan regions mirror the native scanner: whole frame, overlapping
// half-splits, then overlapping quadrants, all in coarsest-first order.
fn scan_all_data(
  data: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let pixels: i32 = img.checked_image_len(width, height);
  if pixels < 0 {
    return string_concat("", c.result_none());
  }
  if data == 0 {
    return string_concat("", c.result_none());
  }

  // The generated region set processes less than five frame areas. Reject a
  // request before allocating crops when its aggregate work can exceed the
  // same 32M-pixel budget as the native implementation.
  let mut work: i32 = pixels;
  let half_width: i32 = width / 2;
  let half_height: i32 = height / 2;
  let overlap_x: i32 = width * 15 / 100;
  let overlap_y: i32 = height * 15 / 100;
  let split_x: bool = width >= 32;
  let split_y: bool = height >= 32;
  let left_width: i32 = half_width + overlap_x;
  let right_width: i32 = width - half_width + overlap_x;
  let top_height: i32 = half_height + overlap_y;
  let bottom_height: i32 = height - half_height + overlap_y;
  if split_x {
    work = work + left_width * height;
    work = work + right_width * height;
  }
  if split_y {
    work = work + width * top_height;
    work = work + width * bottom_height;
  }
  if split_x && split_y {
    work = work + left_width * top_height;
    work = work + left_width * bottom_height;
    work = work + right_width * top_height;
    work = work + right_width * bottom_height;
  }
  if work > 32000000 {
    return string_concat("", c.result_none());
  }

  let mut results: string = "";
  let mut result: string = scan_data(data, width, height, modules, erasures, packed, meta);
  if c.result_is_decoded(result) && !c.multi_contains(results, result) {
    results = c.multi_append(results, result);
  }
  if split_x {
    result = scan_region(data, width, height, 0, 0, half_width + overlap_x, height, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
    result = scan_region(data, width, height, half_width - overlap_x, 0, width - half_width + overlap_x, height, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
    // The overlapping halves above preserve symbols that straddle the split,
    // but a locator can choose the first complete symbol in an overlap. Scan
    // the exact halves as a bounded fallback so adjacent symbols on either
    // side of the split are independently discoverable as well.
    result = scan_region(data, width, height, half_width, 0, width - half_width, height, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
  }
  if split_y {
    result = scan_region(data, width, height, 0, 0, width, half_height + overlap_y, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
    result = scan_region(data, width, height, 0, half_height - overlap_y, width, height - half_height + overlap_y, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
  }
  if split_x && split_y {
    result = scan_region(data, width, height, 0, 0, half_width + overlap_x, half_height + overlap_y, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
    result = scan_region(data, width, height, 0, half_height - overlap_y, half_width + overlap_x, height - half_height + overlap_y, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
    result = scan_region(data, width, height, half_width - overlap_x, 0, width - half_width + overlap_x, half_height + overlap_y, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
    result = scan_region(data, width, height, half_width - overlap_x, half_height - overlap_y, width - half_width + overlap_x, height - half_height + overlap_y, modules, erasures, packed, meta);
    if c.result_is_decoded(result) && !c.multi_contains(results, result) { results = c.multi_append(results, result); }
  }
  return string_concat("", results);
}

export fn scan_and_decode_all(
  width: i32,
  height: i32,
  luma: Array<i32>,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let pixels: i32 = img.checked_image_len(width, height);
  if pixels < 0 {
    return string_concat("", c.result_none());
  }
  let data: u32 = img.luma_copy_from_array(width, height, luma);
  if data == 0 {
    return string_concat("", c.result_none());
  }
  return string_concat("", scan_all_data(data, width, height, modules, erasures, packed, meta));
}

export fn scan_and_decode_all_bytes(
  width: i32,
  height: i32,
  luma: u32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut packed: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let data: u32 = img.luma_from_bytes(width, height, luma);
  if data == 0 {
    return string_concat("", c.result_none());
  }
  return string_concat("", scan_all_data(data, width, height, modules, erasures, packed, meta));
}

// Test/helper exports for unit specs (unique names to avoid static-link collisions).
export fn sc_result_none() -> string { return string_concat("", c.result_none()); }
export fn sc_result_decoded(format: i32, value: string) -> string { return string_concat("", c.result_decoded(format, value)); }
export fn sc_result_located(format: i32) -> string { return string_concat("", c.result_located(format)); }
export fn sc_decode_databar_modules(modules: Array<i32>) -> string {
  return string_concat("", dbar.decode_databar_modules(c.array_len_i32(modules), 1, modules));
}
export fn sc_decode_maxicode_modules(modules: Array<i32>) -> string {
  return string_concat("", maxi.decode_maxicode_modules(modules));
}
export fn sc_decode_pdf417_modules(cols_total: i32, rows: i32, modules: Array<i32>) -> string {
  return string_concat("", pdf.decode_pdf417_modules(cols_total, rows, modules));
}
export fn sc_decode_only_result(format: i32, value: string) -> string {
  return string_concat("", decode_only_result(format, value));
}
export fn sc_try_databar(
  width: i32,
  height: i32,
  luma: Array<i32>,
  mut modules: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let data: u32 = img.luma_copy_from_array(width, height, luma);
  if data == 0 { return string_concat("", c.result_none()); }
  let bits: u32 = prepare_bits(data, width, height);
  if bits == 0 { return string_concat("", c.result_none()); }
  return string_concat("", try_databar(bits, width, height, modules, meta));
}
export fn sc_try_pdf417(
  width: i32,
  height: i32,
  luma: Array<i32>,
  mut modules: Array<i32>,
  mut meta: Array<i32>
) -> string {
  let data: u32 = img.luma_copy_from_array(width, height, luma);
  if data == 0 { return string_concat("", c.result_none()); }
  let bits: u32 = prepare_bits(data, width, height);
  if bits == 0 { return string_concat("", c.result_none()); }
  return string_concat("", try_pdf417(bits, width, height, modules, meta));
}
export fn sc_result_is_decoded(result: string) -> bool { return c.result_is_decoded(result); }
export fn sc_result_is_located(result: string) -> bool { return c.result_is_located(result); }
export fn sc_result_format(result: string) -> i32 { return c.result_format(result); }
export fn sc_result_value(result: string) -> string { return string_concat("", c.result_value(result)); }
export fn sc_checked_image_len(width: i32, height: i32) -> i32 { return img.checked_image_len(width, height); }
export fn sc_binarize_luma(width: i32, height: i32, luma: Array<i32>) -> u32 {
  let data: u32 = img.luma_copy_from_array(width, height, luma);
  if data == 0 { return 0; }
  return img.binarize(data, width, height);
}
export fn sc_dense_bounds(bits: u32, width: i32, height: i32, mut meta: Array<i32>) -> i32 {
  return img.dense_dark_bounds(bits, width, height, meta);
}
export fn sc_locate_qr_modules(
  bits: u32,
  width: i32,
  height: i32,
  mut modules: Array<i32>,
  mut erasures: Array<i32>,
  mut meta: Array<i32>
) -> i32 {
  return lqr.locate_qr_modules(bits, width, height, modules, erasures, meta);
}
export fn sc_sample_square_grid(
  bits: u32,
  width: i32,
  height: i32,
  origin_x_fx: i32,
  origin_y_fx: i32,
  module_fx: i32,
  size: i32,
  mut modules: Array<i32>
) -> i32 {
  return img.sample_module_grid(
    bits,
    width,
    height,
    origin_x_fx,
    origin_y_fx,
    module_fx,
    0,
    0,
    module_fx,
    size,
    size,
    modules
  );
}
