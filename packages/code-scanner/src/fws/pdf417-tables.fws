// PDF417 symbol/codeword tables (ported from crates/pdf417-common tables.rs,
// itself a verbatim port of the ZXing reference, Apache-2.0).
//
// SYMBOL digits: 2787 sorted 17-bit symbol patterns, 6 zero-padded decimal digits each.
// CODEWORD digits: parallel raw CODEWORD_TABLE values, 4 zero-padded decimal digits each.
// get_codeword(symbol) binary-searches the symbol digits and returns
// (raw - 1) mod 929, matching PDF417Common.getCodeword.

export fn pdf_table_len() -> i32 {
  return 2787;
}

fn pdf_symbol_digits() -> string {
  return "";
}

fn pdf_codeword_digits() -> string {
  return "";
}

fn digit_val(s: string, offset: i32) -> i32 {
  return string_byte_at(s, offset) - 48;
}

fn symbol_at(syms: string, index: i32) -> i32 {
  let o: i32 = index * 6;
  let d0: i32 = digit_val(syms, o);
  let d1: i32 = digit_val(syms, o + 1);
  let d2: i32 = digit_val(syms, o + 2);
  let d3: i32 = digit_val(syms, o + 3);
  let d4: i32 = digit_val(syms, o + 4);
  let d5: i32 = digit_val(syms, o + 5);
  return d0 * 100000 + d1 * 10000 + d2 * 1000 + d3 * 100 + d4 * 10 + d5;
}

fn codeword_at(cws: string, index: i32) -> i32 {
  let o: i32 = index * 4;
  let d0: i32 = digit_val(cws, o);
  let d1: i32 = digit_val(cws, o + 1);
  let d2: i32 = digit_val(cws, o + 2);
  let d3: i32 = digit_val(cws, o + 3);
  return d0 * 1000 + d1 * 100 + d2 * 10 + d3;
}

// Translate a 17-bit symbol to its codeword value (0..928), or -1 when absent.
export fn get_codeword(symbol: i32) -> i32 {
  let key: i32 = symbol - symbol / 262144 * 262144;
  let syms: string = pdf_symbol_digits();
  let lo: i32 = 0;
  let hi: i32 = pdf_table_len() - 1;
  while lo <= hi {
    let distance: i32 = hi - lo;
    let mid: i32 = lo + distance / 2;
    let value: i32 = symbol_at(syms, mid);
    if value == key {
      let raw: i32 = codeword_at(pdf_codeword_digits(), mid);
      let reduced: i32 = raw - 1;
      let m: i32 = reduced - reduced / 929 * 929;
      if m < 0 { m = m + 929; }
      return m;
    }
    if value < key {
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return -1;
}
