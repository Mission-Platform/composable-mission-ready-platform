  if a == 86 { return 255; }
  if a == 87 { return 256; }
  if a == 88 { return 256; }
  if a == 89 { return 256; }
  return 256;
}

// Estimate the in-plane rotation (in whole degrees, range [-45, 45]) that
// straightens the bitmap's dense ink, mirroring the native scanner's
// `Bitmap::orientation`: sweep candidate angles and keep the one whose
// axis-aligned bounding box over sampled dark points is smallest. Returns 0
// when there is no meaningful ink, or when the box is already minimal at 0.
fn orientation_sample_stride(min_x: i32, min_y: i32, max_x: i32, max_y: i32) -> i32 {
  let span_x: i32 = max_x - min_x + 1;
  let span_y: i32 = max_y - min_y + 1;
  let span: i32 = span_x;
  if span_y > span {
    span = span_y;
  }
  let stride: i32 = span / 128;
  if stride < 1 {
    stride = 1;
  }
  return stride;
}

fn orientation_point_count(bits: u32, width: i32, height: i32, min_x: i32, min_y: i32, max_x: i32, max_y: i32, stride: i32) -> i32 {
  let count: i32 = 0;
  let y: i32 = min_y;
  while y <= max_y {
    let x: i32 = min_x;
    while x <= max_x {
      if bitmap_get(bits, width, height, x, y) {
        count = count + 1;
      }
      x = x + stride;
    }
    y = y + stride;
  }
  return count;
}

fn orientation_area_for_angle(bits: u32, width: i32, height: i32, min_x: i32, min_y: i32, max_x: i32, max_y: i32, stride: i32, angle: i32) -> i32 {
  let cos_fx: i32 = cos_deg_fx(angle);
  let sin_fx: i32 = sin_deg_fx(angle);
  let min_u: i32 = 1000000000;
  let max_u: i32 = -1000000000;
  let min_v: i32 = 1000000000;
  let max_v: i32 = -1000000000;
  let y: i32 = min_y;
  while y <= max_y {
    let x: i32 = min_x;
    while x <= max_x {
      if bitmap_get(bits, width, height, x, y) {
        let u_fx: i32 = c.fx_mul(c.fx_from_i32(x), cos_fx) + c.fx_mul(c.fx_from_i32(y), sin_fx);
        let v_fx: i32 = 0 - c.fx_mul(c.fx_from_i32(x), sin_fx) + c.fx_mul(c.fx_from_i32(y), cos_fx);
        if u_fx < min_u { min_u = u_fx; }
        if u_fx > max_u { max_u = u_fx; }
        if v_fx < min_v { min_v = v_fx; }
        if v_fx > max_v { max_v = v_fx; }
      }
      x = x + stride;
    }
    y = y + stride;
  }
  let du: i32 = c.fx_to_i32(max_u - min_u);
  let dv: i32 = c.fx_to_i32(max_v - min_v);
  return du * dv;
}

export fn estimate_orientation_deg(bits: u32, width: i32, height: i32, meta: Array<i32>) -> i32 {
  let bounds_ok: i32 = dense_dark_bounds(bits, width, height, meta);
  if bounds_ok == 0 {
    return 0;
  }
  let min_x: i32 = meta[0];
  let min_y: i32 = meta[1];
  let max_x: i32 = meta[2] - 1;
  let max_y: i32 = meta[3] - 1;
  let stride: i32 = orientation_sample_stride(min_x, min_y, max_x, max_y);
  let count: i32 = orientation_point_count(bits, width, height, min_x, min_y, max_x, max_y, stride);
  if count < 16 {
    return 0;
  }
  let best_angle: i32 = 0;
  let best_area: i32 = 2147483647;
  let angle: i32 = 0;
  while angle < 90 {
    let area: i32 = orientation_area_for_angle(bits, width, height, min_x, min_y, max_x, max_y, stride, angle);
    if area < best_area {
      best_area = area;
      best_angle = angle;
    }
    angle = angle + 1;
  }
  let result: i32 = best_angle;
  if result > 45 {
    result = result - 90;
  }
  // Matches the native approximately 3 degree "meaningfully rotated" threshold.
  if c.abs_i32(result) < 3 {
    return 0;
  }
  return result;
}

export fn fill_modules_from_bitmap(
  bits: u32,
  width: i32,
  height: i32,
  modules: Array<i32>
) -> i32 {
  let total: i32 = width * height;
  if c.array_len_i32(modules) < total {
    return -1;
  }
  let y: i32 = 0;
  while y < height {
    let x: i32 = 0;
    while x < width {
      let value: i32 = 0;
      if bitmap_get(bits, width, height, x, y) {
        value = 1;
      }
      modules[y * width + x] = value;
      x = x + 1;
    }
    y = y + 1;
  }
  return total;
}

export fn clear_array(values: Array<i32>, length: i32) -> unit {
  let index: i32 = 0;
  let limit: i32 = length;
  if c.array_len_i32(values) < limit {
    limit = c.array_len_i32(values);
  }
  while index < limit {
    values[index] = 0;
    index = index + 1;
  }
}

// Sample a module grid from a bitmap into modules[]. Returns filled count or -1.
export fn sample_module_grid(
  bits: u32,
  width: i32,
  height: i32,
  origin_x_fx: i32,
  origin_y_fx: i32,
  axis_x_x_fx: i32,
  axis_x_y_fx: i32,
  axis_y_x_fx: i32,
  axis_y_y_fx: i32,
  modules_w: i32,
  modules_h: i32,
  modules: Array<i32>
) -> i32 {
  let total: i32 = modules_w * modules_h;
  if c.array_len_i32(modules) < total {
    return -1;
  }
  let my: i32 = 0;
  while my < modules_h {
    let mx: i32 = 0;
    while mx < modules_w {
      let center_x_fx: i32 = c.fx_mul(axis_x_x_fx, 128) + c.fx_mul(axis_y_x_fx, 128);
      let center_y_fx: i32 = c.fx_mul(axis_x_y_fx, 128) + c.fx_mul(axis_y_y_fx, 128);
      let px_fx: i32 = origin_x_fx
        + c.fx_mul(c.fx_from_i32(mx), axis_x_x_fx)
        + c.fx_mul(c.fx_from_i32(my), axis_y_x_fx)
        + center_x_fx;
      let py_fx: i32 = origin_y_fx
        + c.fx_mul(c.fx_from_i32(mx), axis_x_y_fx)
        + c.fx_mul(c.fx_from_i32(my), axis_y_y_fx)
        + center_y_fx;
      let px: i32 = c.fx_to_i32(px_fx);
      let py: i32 = c.fx_to_i32(py_fx);
      let value: i32 = 0;
      if bitmap_get(bits, width, height, px, py) {
        value = 1;
      }
      modules[my * modules_w + mx] = value;
      mx = mx + 1;
    }
    my = my + 1;
  }
  return total;
}
