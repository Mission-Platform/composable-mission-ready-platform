  if a == 34 { return 143; }
  if a == 35 { return 147; }
  if a == 36 { return 150; }
  if a == 37 { return 154; }
  if a == 38 { return 158; }
  if a == 39 { return 161; }
  if a == 40 { return 165; }
  if a == 41 { return 168; }
  if a == 42 { return 171; }
  if a == 43 { return 175; }
  if a == 44 { return 178; }
  if a == 45 { return 181; }
  if a == 46 { return 184; }
  if a == 47 { return 187; }
  if a == 48 { return 190; }
  if a == 49 { return 193; }
  if a == 50 { return 196; }
  if a == 51 { return 199; }
  if a == 52 { return 202; }
  if a == 53 { return 204; }
  if a == 54 { return 207; }
  if a == 55 { return 210; }
  if a == 56 { return 212; }
  if a == 57 { return 215; }
  if a == 58 { return 217; }
  if a == 59 { return 219; }
  if a == 60 { return 222; }
  if a == 61 { return 224; }
  if a == 62 { return 226; }
  if a == 63 { return 228; }
  if a == 64 { return 230; }
  if a == 65 { return 232; }
  if a == 66 { return 234; }
  if a == 67 { return 236; }
