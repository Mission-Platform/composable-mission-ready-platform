// MaxiCode locator/decoder retained in the scanner graph (fixed 30x33 hex grid).
import "./common.fws" as c;
import "./image.fws" as img;
import "../../../matrix-code/src/fws/matrix-decoder-core.fws" as dec;
import "../../../matrix-code/src/fws/matrix-decoder-rs.fws" as rs;

// MaxiCode is always 30 columns x 33 rows. Odd rows are shifted half a module.
// meta: [30, 33, origin_x, origin_y, module_px]
export fn locate_maxicode_modules(
  bits: u32,
  width: i32,
  height: i32,
  modules: Array<i32>,
  meta: Array<i32>
) -> i32 {
  if c.array_len_i32(meta) < 5 {
    return 0;
  }
  if c.array_len_i32(modules) < 30 * 33 {
    return 0;
  }
  let bound_ok: i32 = img.dense_dark_bounds(bits, width, height, meta);
  if bound_ok == 0 {
    return 0;
  }
  let x0: i32 = meta[0];
  let y0: i32 = meta[1];
  let x1: i32 = meta[2];
  let y1: i32 = meta[3];
  let bw: i32 = x1 - x0;
  let bh: i32 = y1 - y0;
  if bw < 30 || bh < 33 {
    return 0;
  }

  let pad: i32 = 0;
  while pad <= 4 {
    let ew: i32 = bw - pad * 2;
    let eh: i32 = bh - pad * 2;
    if ew >= 30 && eh >= 33 {
      let module_x_fx: i32 = c.fx_div(c.fx_from_i32(ew), c.fx_from_i32(30));
      let module_y_fx: i32 = c.fx_div(c.fx_from_i32(eh), c.fx_from_i32(33));
      if module_x_fx >= c.FX_SCALE() && module_y_fx >= c.FX_SCALE() {
        let filled: i32 = sample_maxicode_grid(bits, width, height, x0 + pad, y0 + pad, module_x_fx, module_y_fx, modules);
        if filled == 30 * 33 {
          meta[0] = 30;
          meta[1] = 33;
          meta[2] = x0 + pad;
          meta[3] = y0 + pad;
          meta[4] = c.fx_to_i32(module_x_fx);
          return 1;
        }
      }
    }
    pad = pad + 1;
  }
  return 0;
}

fn sample_maxicode_grid(
  bits: u32,
  width: i32,
  height: i32,
  origin_x: i32,
  origin_y: i32,
  module_x_fx: i32,
  module_y_fx: i32,
  modules: Array<i32>
) -> i32 {
  let row: i32 = 0;
  while row < 33 {
    let odd: i32 = row - row / 2 * 2;
    let shift_x_fx: i32 = 0;
    if odd == 1 { shift_x_fx = module_x_fx / 2; }
    let column: i32 = 0;
    while column < 30 {
      let x_fx: i32 = c.fx_from_i32(origin_x) + c.fx_mul(c.fx_from_i32(column), module_x_fx) + module_x_fx / 2 + shift_x_fx;
      let y_fx: i32 = c.fx_from_i32(origin_y) + c.fx_mul(c.fx_from_i32(row), module_y_fx) + module_y_fx / 2;
      let value: i32 = 0;
      if img.bitmap_get(bits, width, height, c.fx_to_i32(x_fx), c.fx_to_i32(y_fx)) { value = 1; }
      modules[row * 30 + column] = value;
      column = column + 1;
    }
    row = row + 1;
  }
  return 30 * 33;
}

fn bit_number(row: i32, column: i32) -> i32 {
  // ISO/IEC 16023 module-to-codeword map. 999 marks orientation/finder cells.
  let map: string = "";
  let index: i32 = row * 30 + column;
  // The packed literal omits the central structural cell at row 13, column 17.
  if index == 407 { return 999; }
  if index > 407 { index = index - 1; }
  return dec.dget(map, index);
}

fn extract_codewords(modules: Array<i32>) -> string {
  let codewords: string = dec.dzeros(144);
  let row: i32 = 0;
  while row < 33 {
    let column: i32 = 0;
    while column < 30 {
      let bit: i32 = bit_number(row, column);
      if bit < 864 && modules[row * 30 + column] != 0 {
        let codeword: i32 = bit / 6;
        let bit_in_codeword: i32 = bit - codeword * 6;
        codewords = dec.dset(codewords, codeword, dec.dget(codewords, codeword) + dec.pow2(5 - bit_in_codeword));
      }
      column = column + 1;
    }
    row = row + 1;
  }
  return codewords;
}

fn correct_codewords(codewords: string) -> string {
  let primary: string = string_slice(codewords, 0, 20 * 3);
  primary = rs.rs_correct(primary, 10, 67, 64, dec.dzeros(20));
  if string_length(primary) == 0 { return ""; }
  let mode: i32 = dec.dget(primary, 0) - dec.dget(primary, 0) / 16 * 16;
  let secondary_data: i32 = 0;
  let secondary_ecc: i32 = 0;
  if mode == 4 {
    secondary_data = 84;
    secondary_ecc = 40;
  } else {
    if mode == 5 {
      secondary_data = 68;
      secondary_ecc = 56;
    } else {
      return "";
    }
  }
  let even: string = "";
  let odd: string = "";
  let index: i32 = 0;
  while index < secondary_data + secondary_ecc {
    let value: string = dec.decoder_digits(dec.dget(codewords, 20 + index));
    if index - index / 2 * 2 == 0 {
      even = string_concat(even, value);
    } else {
      odd = string_concat(odd, value);
    }
    index = index + 1;
  }
  let interleave_ecc: i32 = secondary_ecc / 2;
  even = rs.rs_correct(even, interleave_ecc, 67, 64, dec.dzeros(62));
  odd = rs.rs_correct(odd, interleave_ecc, 67, 64, dec.dzeros(62));
  if string_length(even) == 0 || string_length(odd) == 0 { return ""; }
  let datawords: string = string_slice(primary, 0, 10 * 3);
  let secondary_index: i32 = 0;
  while secondary_index < secondary_data {
    let source: string = even;
    if secondary_index - secondary_index / 2 * 2 == 1 { source = odd; }
    datawords = string_concat(datawords, dec.decoder_digits(dec.dget(source, secondary_index / 2)));
    secondary_index = secondary_index + 1;
  }
  return datawords;
}

fn set_a_triplet(value: i32) -> string {
  if value == 0 { return dec.byte_char3(13); }
  if value >= 1 && value <= 26 { return dec.byte_char3(64 + value); }
  if value == 32 { return dec.byte_char3(32); }
  if value >= 34 && value <= 58 { return dec.byte_char3(value); }
  return "";
}

fn set_b_triplet(value: i32) -> string {
  if value == 0 { return dec.byte_char3(96); }
  if value >= 1 && value <= 26 { return dec.byte_char3(96 + value); }
  if value == 32 { return dec.byte_char3(123); }
  if value == 34 { return dec.byte_char3(125); }
  if value == 35 { return dec.byte_char3(126); }
  if value == 47 { return dec.byte_char3(32); }
  return "";
}

fn decode_mode_4_5(datawords: string) -> string {
  let count: i32 = string_length(datawords) / 3;
  let active_set: i32 = 0;
  let shift_set: i32 = -1;
  let triplets: string = "";
  let index: i32 = 1;
  while index < count {
    let value: i32 = dec.dget(datawords, index);
    if active_set == 0 && value == 33 { return c.ascii_from_triplets(triplets); }
    if active_set == 1 && value == 55 { return c.ascii_from_triplets(triplets); }
    if active_set == 1 && value == 58 { return c.ascii_from_triplets(triplets); }
    if value == 63 {
      if active_set == 0 { active_set = 1; } else { active_set = 0; }
      shift_set = -1;
    } else {
      if active_set == 0 && value >= 59 && value <= 62 {
        shift_set = value - 58;
      } else {
        if active_set == 1 && value >= 59 && value <= 62 {
          shift_set = value - 59;
          if value > 59 { shift_set = value - 58; }
        } else {
        let character_set: i32 = active_set;
        if shift_set >= 0 { character_set = shift_set; }
        let character: string = "";
        if character_set == 0 { character = set_a_triplet(value); }
        if character_set == 1 { character = set_b_triplet(value); }
        if string_length(character) == 0 { return ""; }
        triplets = string_concat(triplets, character);
        shift_set = -1;
        }
      }
    }
    index = index + 1;
  }
  return c.ascii_from_triplets(triplets);
}

export fn decode_maxicode_modules(modules: Array<i32>) -> string {
  if c.array_len_i32(modules) < 30 * 33 {
    return "";
  }
  let corrected: string = correct_codewords(extract_codewords(modules));
  if string_length(corrected) == 0 { return ""; }
  return decode_mode_4_5(corrected);
}
