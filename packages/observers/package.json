{
  "name": "@mission-platform/observers",
  "version": "0.1.0",
  "license": "BSD-4-Clause",
  "description": "Framework-neutral browser observer composables for Mission Platform — write-once IntersectionObserver, MutationObserver, and PerformanceObserver hooks (authored against @mission-platform/forge hooks and compiled to React, Vue, Solid, Svelte, and Web Components)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "mp:vue": {
        "types": "./dist/vue/index.d.ts",
        "import": "./dist/vue/index.js"
      },
      "mp:react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "mp:solid": {
        "types": "./dist/solid/index.d.ts",
        "import": "./dist/solid/index.js"
      },
      "mp:svelte": {
        "types": "./dist/svelte/index.d.ts",
        "import": "./dist/svelte/index.js"
      },
      "mp:web-component": {
        "types": "./dist/web-components/index.d.ts",
        "import": "./dist/web-components/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/forge": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "lit": "catalog:webcomponents",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "solid-js": "catalog:solid",
    "svelte": "catalog:svelte",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
