@charset "UTF-8";
/**
 * Styling for the write-once `ForgeToastContainer`.
 *
 * `ForgeToastContainer` owns this co-located CSS Module: it side-effect-imports
 * the stylesheet so its appearance ships in the built package CSS (the
 * two-stage compiler carries the import onto both the React and Vue builds).
 *
 * The rules live in the shared `mp.components` cascade layer, matching the
 * `@mission-platform/components` package's `forge-toast-container.vue`.
 */
/**
 * Registered inherited custom properties for forge-toast-container overrides.
 *
 * Kept in a dedicated partial so the component module can stay focused on
 * selectors while @property initial values remain token-backed defaults.
 */
@property --forge-toast-container-spacing-3 {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-spacing-3);
}
@property --forge-toast-container-spacing-4 {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-spacing-4);
}
@property --forge-toast-container-overlay-transition-duration {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-overlay-transition-duration);
}
@property --forge-toast-container-overlay-transition-easing {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-overlay-transition-easing);
}
@layer mp.components {
  .forge-toast-container {
    position: fixed;
    z-index: 700;
    display: flex;
    flex-direction: column;
    gap: var(--forge-toast-container-spacing-3, var(--mp-spacing-3));
    width: min(24rem, 100vw - 2 * var(--forge-toast-container-spacing-4, var(--mp-spacing-4)));
    padding: 0;
    margin: 0;
    pointer-events: none;
  }
  .forge-toast-container--top-left {
    top: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
    left: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
  }
  .forge-toast-container--top-center {
    top: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
    left: 50%;
    align-items: center;
    transform: translateX(-50%);
  }
  .forge-toast-container--top-right {
    top: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
    right: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
  }
  .forge-toast-container--bottom-left {
    bottom: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
    left: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
  }
  .forge-toast-container--bottom-center {
    bottom: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
    left: 50%;
    align-items: center;
    transform: translateX(-50%);
  }
  .forge-toast-container--bottom-right {
    bottom: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
    right: var(--forge-toast-container-spacing-4, var(--mp-spacing-4));
  }
  /* Enter/leave transitions driven by the neutral `<TransitionGroup>` primitive
     (`name="forge-toast"`). These are plain (non-`:global`) CSS-Module classes:
     `forge-toast-container.tsx` passes their hashed names to the
     `<TransitionGroup>` class props, so the enter/leave styling stays scoped to
     the component — matching the `scoped` `<style>` of the
     `@mission-platform/components` `forge-toast-container.vue` (only these
     phases are styled; the `-move` marker carries no rule, so moves are
     instant, exactly like the original). */
  .forge-toast-enter-active,
  .forge-toast-leave-active {
    transition: opacity var(--forge-toast-container-overlay-transition-duration, var(--mp-overlay-transition-duration)) var(--forge-toast-container-overlay-transition-easing, var(--mp-overlay-transition-easing)), transform var(--forge-toast-container-overlay-transition-duration, var(--mp-overlay-transition-duration)) var(--forge-toast-container-overlay-transition-easing, var(--mp-overlay-transition-easing));
  }
  .forge-toast-enter-from,
  .forge-toast-leave-to {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
  .forge-toast-leave-active {
    position: absolute;
    width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .forge-toast-enter-active,
    .forge-toast-leave-active {
      transition: none;
    }
  }
}
