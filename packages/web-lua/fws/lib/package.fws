export fn package_default_path() -> u32 {
  return 0;
}

export fn package_load_status(status: u32) -> u32 {
  return status;
}

export fn package_default_path_value() -> u32 {
  return package_default_path();
}

export fn package_can_load(status: u32) -> u32 {
  if status == 0 {
    return 1;
  }
  return 0;
}