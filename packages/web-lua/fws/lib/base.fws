import "../string.fws" as string;
import "../value.fws" as value;
import "../table.fws" as table;
import "../memory.fws" as memory;
import "../api.fws" as api;

fn type_name(heap: u32, kind: u32) -> u32 {
  if kind == 0 {
    return string.string_intern(heap, 319, 3);
  }
  if kind == 1 {
    return string.string_intern(heap, 836, 7);
  }
  if kind == 2 || kind == 3 {
    return string.string_intern(heap, 1073, 6);
  }
  if kind == 4 {
    return string.string_intern(heap, 538, 6);
  }
  if kind == 5 {
    return string.string_intern(heap, 651, 5);
  }
  if kind == 6 {
    return string.string_intern(heap, 875, 8);
  }
  if kind == 7 {
    return string.string_intern(heap, 665, 6);
  }
  return string.string_intern(heap, 869, 8);
}

export fn base_type(heap: u32, input: u32) -> u32 {
  return type_name(heap, value.value_kind(input));
}

export fn base_raw_length(input: u32) -> u32 {
  let kind: u32 = value.value_kind(input);
  if kind == 4 {
    return string.lua_string_length(value.value_payload(input));
  }
  return 0;
}

export fn base_boolean(input: u32) -> u32 {
  if input == 0 {
    return 0;
  }
  return 1;
}

export fn base_to_boolean(input: u32) -> u32 {
  return base_truthy(input);
}

export fn base_to_integer(input: u32) -> u32 {
  if value.value_kind(input) != 2 {
    return 0;
  }
  return value.value_payload(input);
}

export fn base_to_float(heap: u32, input: u32) -> f64 {
  let kind: u32 = value.value_kind(input);
  if kind == 2 {
    return f64_from_u32(value.value_payload(input));
  }
  if kind != 3 || memory.heap_owns(heap, value.value_payload(input)) == 0 {
    return f64_from_u32(0);
  }
  return value.value_float_number(input);
}

export fn base_truthy(input: u32) -> u32 {
  let kind: u32 = value.value_kind(input);
  if kind == 0 {
    return 0;
  }
  if kind == 1 && value.value_payload(input) == 0 {
    return 0;
  }
  return 1;
}

export fn base_getmetatable(input: u32) -> u32 {
  if value.value_kind(input) != 5 {
    return value.value_nil();
  }
  let metatable: u32 = table.table_metatable(value.value_payload(input));
  if metatable == 0 {
    return value.value_nil();
  }
  return value.value_table(metatable);
}

export fn base_setmetatable(input: u32, metatable: u32) -> u32 {
  if value.value_kind(input) != 5 {
    return value.value_nil();
  }
  let metatable_kind: u32 = value.value_kind(metatable);
  if metatable_kind != 0 && metatable_kind != 5 {
    return value.value_nil();
  }
  let metatable_handle: u32 = 0;
  if metatable_kind == 5 {
    metatable_handle = value.value_payload(metatable);
  }
  table.table_set_metatable(value.value_payload(input), metatable_handle);
  return input;
}

export fn base_pcall_status(heap: u32, prototype: u32) -> u32 {
  if heap == 0 || prototype == 0 {
    return 2;
  }
  api.api_call(heap, prototype);
  return memory.heap_status(heap);
}

export fn base_pcall_result_count(prototype: u32) -> u32 {
  return api.api_result_count(prototype);
}

export fn base_pcall_result_value(prototype: u32, index: u32) -> u32 {
  return api.api_result_value(prototype, index);
}

export fn base_next_key(input: u32, cursor: u32) -> u32 {
  if value.value_kind(input) != 5 {
    return value.value_nil();
  }
  let key: u32 = table.table_next_key(value.value_payload(input), cursor);
  if key == 0 {
    return value.value_nil();
  }
  return value.value_integer(key);
}

export fn base_next_value(input: u32, cursor: u32) -> u32 {
  if value.value_kind(input) != 5 {
    return value.value_nil();
  }
  return table.table_next_value(value.value_payload(input), cursor);
}

export fn base_ipairs_next(input: u32, index: u32) -> u32 {
  if value.value_kind(input) != 5 {
    return value.value_nil();
  }
  let next: u32 = index + 1;
  if table.table_get_raw(value.value_payload(input), value.value_integer(next)) == 0 {
    return value.value_nil();
  }
  return value.value_integer(next);
}