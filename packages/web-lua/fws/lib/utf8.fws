import "../string.fws" as strings;
import "../value.fws" as value;

fn utf8_continuation(byte: u32) -> u32 {
  if byte >= 128 && byte <= 191 {
    return 1;
  }
  return 0;
}

fn utf8_width(first: u32) -> u32 {
  if first <= 127 {
    return 1;
  }
  if first >= 194 && first <= 223 {
    return 2;
  }
  if first >= 224 && first <= 239 {
    return 3;
  }
  if first >= 240 && first <= 244 {
    return 4;
  }
  return 0;
}

fn utf8_sequence_valid(string: u32, index: u32, width: u32) -> u32 {
  if width == 0 || index + width > strings.lua_string_length(string) {
    return 0;
  }
  if width == 1 {
    return 1;
  }
  let second: u32 = strings.string_byte(string, index + 1);
  if utf8_continuation(second) == 0 {
    return 0;
  }
  let first: u32 = strings.string_byte(string, index);
  if first == 224 && second < 160 {
    return 0;
  }
  if first == 237 && second > 159 {
    return 0;
  }
  if first == 240 && second < 144 {
    return 0;
  }
  if first == 244 && second > 143 {
    return 0;
  }
  let continuation: u32 = 2;
  while continuation < width {
    if utf8_continuation(strings.string_byte(string, index + continuation)) == 0 {
      return 0;
    }
    continuation = continuation + 1;
  }
  return 1;
}

fn utf8_codepoint_at(string: u32, index: u32, width: u32) -> u32 {
  let first: u32 = strings.string_byte(string, index);
  if width == 1 {
    return first;
  }
  let codepoint_base: u32 = first % 32;
  let second: u32 = strings.string_byte(string, index + 1);
  if width == 2 {
    let second_payload: u32 = second % 64;
    return codepoint_base * 64 + second_payload;
  }
  let third: u32 = strings.string_byte(string, index + 2);
  if width == 3 {
    let second_payload_three: u32 = second % 64;
    let third_payload_three: u32 = third % 64;
    return codepoint_base * 4096 + second_payload_three * 64 + third_payload_three;
  }
  let fourth: u32 = strings.string_byte(string, index + 3);
  let four_byte_base: u32 = first % 8;
  let second_payload_four: u32 = second % 64;
  let third_payload_four: u32 = third % 64;
  let fourth_payload: u32 = fourth % 64;
  return four_byte_base * 262144 + second_payload_four * 4096 + third_payload_four * 64 + fourth_payload;
}

fn utf8_scan(input: u32, target: u32) -> u32 {
  if value.value_kind(input) != 4 {
    return 0;
  }
  let string: u32 = value.value_payload(input);
  let index: u32 = 0;
  let count: u32 = 0;
  while index < strings.lua_string_length(string) {
    let width: u32 = utf8_width(strings.string_byte(string, index));
    if utf8_sequence_valid(string, index, width) == 0 {
      return 0;
    }
    if count == target {
      return utf8_codepoint_at(string, index, width) + 1;
    }
    index = index + width;
    count = count + 1;
  }
  if target == 2147483647 {
    return count + 1;
  }
  return 0;
}

export fn utf8_length_value(input: u32) -> u32 {
  let length_scan: u32 = utf8_scan(input, 2147483647);
  if length_scan == 0 {
    return 0;
  }
  return length_scan - 1;
}

export fn utf8_byte_value(input: u32, index: u32) -> u32 {
  if value.value_kind(input) != 4 || index == 0 {
    return 0;
  }
  let string: u32 = value.value_payload(input);
  if index >= strings.lua_string_length(string) {
    return 0;
  }
  return strings.string_byte(string, index);
}

export fn utf8_is_valid_value(input: u32) -> u32 {
  if value.value_kind(input) != 4 {
    return 0;
  }
  let validity_scan: u32 = utf8_scan(input, 2147483647);
  if validity_scan == 0 {
    return 0;
  }
  return 1;
}

export fn utf8_codepoint_value(input: u32, index: u32) -> u32 {
  if index == 0 {
    return 0;
  }
  let codepoint_scan: u32 = utf8_scan(input, index - 1);
  if codepoint_scan == 0 {
    return 0;
  }
  return codepoint_scan - 1;
}