fn os_status(allowed: u32) -> u32 {
  if allowed != 0 {
    return 0;
  }
  return 2;
}

fn os_result(allowed: u32, result: u32) -> u32 {
  if allowed != 0 {
    return result;
  }
  return 0;
}

export fn clock_now_status(allowed: u32) -> u32 {
  return os_status(allowed);
}

export fn clock_now_result(allowed: u32, result: u32) -> u32 {
  return os_result(allowed, result);
}

export fn random_bytes_status(allowed: u32) -> u32 {
  return os_status(allowed);
}

export fn random_bytes_result(allowed: u32, result: u32) -> u32 {
  return os_result(allowed, result);
}

export fn os_command_status(allowed: u32) -> u32 {
  return os_status(allowed);
}

export fn os_command_result(allowed: u32, result: u32) -> u32 {
  return os_result(allowed, result);
}