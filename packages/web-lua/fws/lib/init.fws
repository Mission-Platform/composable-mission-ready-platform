fn startup_hash_byte(
  index: u32,
  a: u32,
  b: u32,
  c: u32,
  d: u32,
  e: u32,
  f: u32,
  g: u32,
  h: u32,
  i: u32,
  j: u32,
  k: u32,
  l: u32,
  m: u32,
  n: u32,
  o: u32,
  p: u32,
) -> u32 {
  if index == 0 { return a; }
  if index == 1 { return b; }
  if index == 2 { return c; }
  if index == 3 { return d; }
  if index == 4 { return e; }
  if index == 5 { return f; }
  if index == 6 { return g; }
  if index == 7 { return h; }
  if index == 8 { return i; }
  if index == 9 { return j; }
  if index == 10 { return k; }
  if index == 11 { return l; }
  if index == 12 { return m; }
  if index == 13 { return n; }
  if index == 14 { return o; }
  return p;
}

fn startup_hash_len(
  a: u32,
  b: u32,
  c: u32,
  d: u32,
  e: u32,
  f: u32,
  g: u32,
  h: u32,
  i: u32,
  j: u32,
  k: u32,
  l: u32,
  m: u32,
  n: u32,
  o: u32,
  p: u32,
) -> u32 {
  if a == 0 { return 0; }
  if b == 0 { return 1; }
  if c == 0 { return 2; }
  if d == 0 { return 3; }
  if e == 0 { return 4; }
  if f == 0 { return 5; }
  if g == 0 { return 6; }
  if h == 0 { return 7; }
  if i == 0 { return 8; }
  if j == 0 { return 9; }
  if k == 0 { return 10; }
  if l == 0 { return 11; }
  if m == 0 { return 12; }
  if n == 0 { return 13; }
  if o == 0 { return 14; }
  if p == 0 { return 15; }
  return 16;
}

fn startup_hash(
  a: u32,
  b: u32,
  c: u32,
  d: u32,
  e: u32,
  f: u32,
  g: u32,
  h: u32,
  i: u32,
  j: u32,
  k: u32,
  l: u32,
  m: u32,
  n: u32,
  o: u32,
  p: u32,
) -> u32 {
  let count: u32 = startup_hash_len(a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p);
  let mut hash: u32 = 216613626;
  let mut index: u32 = 0;
  while index < count {
    let byte: u32 = startup_hash_byte(index, a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p);
    hash = hash * 16777619;
    hash = hash + byte;
    index = index + 1;
  }
  return hash;
}

fn startup_string(
  heap: u32,
  hash: u32,
  length: u32,
  a: u32,
  b: u32,
  c: u32,
  d: u32,
  e: u32,
  f: u32,
  g: u32,
  h: u32,
  i: u32,
  j: u32,
  k: u32,
  l: u32,
) -> u32 {
  let startup_value: u32 = string.string_intern(heap, hash, length);
  if startup_value == 0 {
    return 0;
  }
  if length > 0 {
    memory_store_u32(startup_value + 24, a);
  }
  if length > 1 {
    memory_store_u32(startup_value + 28, b);
  }
  if length > 2 {
    memory_store_u32(startup_value + 32, c);
  }
  if length > 3 {
    memory_store_u32(startup_value + 36, d);
  }
  if length > 4 {
    memory_store_u32(startup_value + 40, e);
  }
  if length > 5 {
    memory_store_u32(startup_value + 44, f);
  }
  if length > 6 {
    memory_store_u32(startup_value + 48, g);
  }
  if length > 7 {
    memory_store_u32(startup_value + 52, h);
  }
  if length > 8 {
    memory_store_u32(startup_value + 56, i);
  }
  if length > 9 {
    memory_store_u32(startup_value + 60, j);
  }
  if length > 10 {
    memory_store_u32(startup_value + 64, k);
  }
  if length > 11 {
    memory_store_u32(startup_value + 68, l);
  }
  return startup_value;
}

fn startup_builtin(heap: u32, name: u32, builtin: u32, arity: u32) -> u32 {
  let function: u32 = memory.heap_alloc(heap, 32, 0);
  if function == 0 {
    return 0;
  }
  memory_store_u32(function, name);
  memory_store_u32(function + 4, 0);
  memory_store_u32(function + 8, 0);
  memory_store_u32(function + 12, 0);
  memory_store_u32(function + 16, arity);
  memory_store_u32(function + 20, 0);
  memory_store_u32(function + 24, 1);
  memory_store_u32(function + 28, builtin);
  return function;
}

fn startup_set(table_handle: u32, key: u32, output: u32) -> unit {
  table.table_set_raw(table_handle, key, output);
}

fn startup_global(heap: u32, key: u32, output: u32) -> unit {
  memory.heap_global_set(heap, key, output);
}

export fn library_init_marker() -> u32 {
  return 1;
}

