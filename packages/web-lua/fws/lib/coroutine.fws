import "../api.fws" as api;
import "../memory.fws" as memory;

export fn coroutine_status_value(status: u32) -> u32 {
  return status;
}

export fn coroutine_can_resume(status: u32) -> u32 {
  if status == 0 || status == 5 {
    return 1;
  }
  return 0;
}

export fn coroutine_resume_status(status: u32) -> u32 {
  if coroutine_can_resume(status) == 1 {
    return 0;
  }
  return status;
}

export fn coroutine_close_status(status: u32) -> u32 {
  if status == 0 || status == 5 {
    return 0;
  }
  return status;
}

export fn coroutine_resume_result(heap: u32, prototype: u32) -> u32 {
  if heap == 0 || prototype == 0 || memory.heap_closed(heap) == 1 {
    return 0;
  }
  let status: u32 = memory.heap_status(heap);
  if status == 0 {
    return api.api_call(heap, prototype);
  }
  if status == 5 {
    return api.api_resume(heap, prototype);
  }
  return 0;
}

export fn coroutine_close_result(heap: u32) -> u32 {
  return api.api_close(heap);
}