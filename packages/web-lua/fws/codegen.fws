import "./memory.fws" as memory;
import "./parser.fws" as parser;

// Instruction stream capacity per top-level chunk. Each instruction is 8 bytes.
// 4096 bytes only held 512 ops and overflowed all.lua's startup block once the
// suite driver script grew past that many top-level statements/expressions.
fn code_buffer_size() -> u32 {
  return 262144;
}

// Instruction stream capacity for a single function body (nested closures and
// named local/global functions). Kept much smaller than the top-level chunk
// buffer: every declared function allocates its own buffer that is never
// freed by this bump allocator, so an oversized per-function buffer
// accumulates across repeated loads/calls and corrupts unrelated guest heap
// state once several functions have been compiled in the same session.
fn function_buffer_size() -> u32 {
  return 16384;
}

export fn emit_table_entries(node: u32, code: u32, index: u32) -> u32 {
  if node == 0 {
    return index;
  }
  let entry_kind: u32 = memory_load_u32(node);
  let mut after_key: u32 = index;
  // Computed/general keys ([expr] = value) evaluate the key expression at
  // runtime; literal keys (positional and name = value) push an immediate.
  if entry_kind == 59 {
    after_key = emit(memory_load_u32(node + 4), code, index, 1);
  } else {
    memory_store_u32(code + index * 8, 1);
    memory_store_u32(code + index * 8 + 4, memory_load_u32(node + 4));
    after_key = index + 1;
  }
  let after_value: u32 = emit(memory_load_u32(node + 8), code, after_key, 1);
  memory_store_u32(code + after_value * 8, 67);
  memory_store_u32(code + after_value * 8 + 4, 0);
  return emit_table_entries(memory_load_u32(node + 12), code, after_value + 1);
}

export fn compile_nested_function(node: u32) -> u32 {
  let function_code: u32 = memory_alloc(function_buffer_size());
  let mut function_count: u32 = emit_list(memory_load_u32(node + 4), function_code, 0);
  memory_store_u32(function_code + function_count * 8, 6);
  memory_store_u32(function_code + function_count * 8 + 4, 0);
  function_count = function_count + 1;
  let function_record: u32 = memory_alloc(32);
  memory_store_u32(function_record, 0);
  memory_store_u32(function_record + 4, function_code);
  memory_store_u32(function_record + 8, function_count);
  memory_store_u32(function_record + 12, memory_load_u32(node + 8));
  memory_store_u32(function_record + 16, memory_load_u32(node + 12));
  memory_store_u32(function_record + 20, 0);
  memory_store_u32(function_record + 24, memory_load_u32(node + 16));
  return function_record;
}

fn emit_nil_padding(code: u32, index: u32, count: u32) -> u32 {
  let mut written: u32 = 0;
  while written < count {
    let destination: u32 = index + written;
    memory_store_u32(code + destination * 8, 1);
    memory_store_u32(code + destination * 8 + 4, 0);
    written = written + 1;
  }
  return index + count;
}

fn emit_result_adjustment(code: u32, index: u32, expected: u32) -> u32 {
  if expected == 255 {
    return index;
  }
  memory_store_u32(code + index * 8, 49);
  memory_store_u32(code + index * 8 + 4, expected);
  return index + 1;
}

fn label_context_new() -> u32 {
  let ctx: u32 = memory_alloc(12);
  memory_store_u32(ctx, 0);
  memory_store_u32(ctx + 4, 0);
  memory_store_u32(ctx + 8, 1);
  return ctx;
}

fn scope_context_new(ctx: u32) -> u32 {
  let scope: u32 = memory_load_u32(ctx + 8);
  memory_store_u32(ctx + 8, scope + 1);
  return scope;
}

fn emit_scope_enter(code: u32, index: u32, scope: u32) -> u32 {
  memory_store_u32(code + index * 8, 75);
  memory_store_u32(code + index * 8 + 4, scope);
  return index + 1;
}

fn emit_scope_exit(code: u32, index: u32) -> u32 {
  memory_store_u32(code + index * 8, 76);
  memory_store_u32(code + index * 8 + 4, 0);
  return index + 1;
}

fn loop_context_new(parent: u32) -> u32 {
  let ctx: u32 = memory_alloc(8);
  memory_store_u32(ctx, parent);
  memory_store_u32(ctx + 4, 0);
  return ctx;
}

fn emit_break(code: u32, index: u32, loop_ctx: u32) -> u32 {
  memory_store_u32(code + index * 8, 22);
  memory_store_u32(code + index * 8 + 4, 0);
  let pending: u32 = memory_alloc(8);
  memory_store_u32(pending, index);
  memory_store_u32(pending + 4, memory_load_u32(loop_ctx + 4));
  memory_store_u32(loop_ctx + 4, pending);
  return index + 1;
}

fn close_loop(code: u32, loop_ctx: u32, end: u32) -> unit {
  let mut pending: u32 = memory_load_u32(loop_ctx + 4);
  while pending != 0 {
    memory_store_u32(code + memory_load_u32(pending) * 8 + 4, end);
    pending = memory_load_u32(pending + 4);
  }
}

fn label_find(labels: u32, hash: u32) -> u32 {
  let mut current: u32 = labels;
  while current != 0 {
    if memory_load_u32(current) == hash {
      return current;
    }
    current = memory_load_u32(current + 8);
  }
  return 0;
}

fn label_define(code: u32, ctx: u32, hash: u32, pc: u32) -> unit {
  let entry: u32 = memory_alloc(12);
  memory_store_u32(entry, hash);
  memory_store_u32(entry + 4, pc);
  memory_store_u32(entry + 8, memory_load_u32(ctx));
  memory_store_u32(ctx, entry);
  let mut pending: u32 = memory_load_u32(ctx + 4);
  let mut remaining: u32 = 0;
  while pending != 0 {
    let next: u32 = memory_load_u32(pending + 8);
    if memory_load_u32(pending) == hash {
      let instruction: u32 = memory_load_u32(pending + 4);
      memory_store_u32(code + instruction * 8 + 4, pc);
    } else {
      memory_store_u32(pending + 8, remaining);
      remaining = pending;
    }
    pending = next;
  }
  memory_store_u32(ctx + 4, remaining);
}

fn emit_goto(code: u32, index: u32, ctx: u32, hash: u32) -> u32 {
  memory_store_u32(code + index * 8, 22);
  let label: u32 = label_find(memory_load_u32(ctx), hash);
  if label != 0 {
    memory_store_u32(code + index * 8 + 4, memory_load_u32(label + 4));
  } else {
    memory_store_u32(code + index * 8 + 4, 0);
    let pending: u32 = memory_alloc(12);
    memory_store_u32(pending, hash);
    memory_store_u32(pending + 4, index);
    memory_store_u32(pending + 8, memory_load_u32(ctx + 4));
    memory_store_u32(ctx + 4, pending);
  }
  return index + 1;
}

export fn emit(node: u32, code: u32, index: u32, expected: u32) -> u32 {
  let kind: u32 = memory_load_u32(node);
  let mut after_expression: u32 = index;
  if kind == 1 {
    memory_store_u32(code + index * 8, 1);
    memory_store_u32(code + index * 8 + 4, memory_load_u32(node + 4));
    after_expression = index + 1;
  } else {
    if kind == 63 {
      memory_store_u32(code + index * 8, 53);
      memory_store_u32(code + index * 8 + 4, memory_load_u32(node + 4));
      after_expression = index + 1;
    } else {
    if kind == 20 {
      memory_store_u32(code + index * 8, 20);
      memory_store_u32(code + index * 8 + 4, memory_load_u32(node + 4));
      after_expression = index + 1;
    } else {
      if kind == 39 {
        let callee: u32 = memory_load_u32(node + 4);
        if memory_load_u32(callee) == 20 {
          let after_arguments: u32 = emit_arguments(memory_load_u32(node + 8), code, index, 255);
          memory_store_u32(code + after_arguments * 8, 47);
          memory_store_u32(code + after_arguments * 8 + 4, memory_load_u32(node + 12));
          let call_instruction: u32 = after_arguments + 1;
          memory_store_u32(code + call_instruction * 8, 25);
          memory_store_u32(code + call_instruction * 8 + 4, memory_load_u32(callee + 4));
          return emit_result_adjustment(code, after_arguments + 2, expected);
        }
        let after_callee: u32 = emit(callee, code, index, 1);
        let after_arguments: u32 = emit_arguments(memory_load_u32(node + 8), code, after_callee, 255);
        memory_store_u32(code + after_arguments * 8, 47);
        memory_store_u32(code + after_arguments * 8 + 4, memory_load_u32(node + 12));
        let call_instruction: u32 = after_arguments + 1;
        memory_store_u32(code + call_instruction * 8, 69);
        memory_store_u32(code + call_instruction * 8 + 4, 0);
        return emit_result_adjustment(code, after_arguments + 2, expected);
      } else {
        if kind == 68 {
          let after_receiver: u32 = emit(memory_load_u32(node + 4), code, index, 1);
          let receiver_name: u32 = memory_alloc(4);
          let receiver_declaration: u32 = parser.node_extra(40, receiver_name, 0, 0);
          memory_store_u32(code + after_receiver * 8, 51);
          memory_store_u32(code + after_receiver * 8 + 4, receiver_declaration);
          let after_receiver_store: u32 = after_receiver + 1;
          memory_store_u32(code + after_receiver_store * 8, 20);
          memory_store_u32(code + after_receiver_store * 8 + 4, receiver_name);
          let method_index: u32 = after_receiver_store + 1;
          memory_store_u32(code + method_index * 8, 1);
          memory_store_u32(code + method_index * 8 + 4, memory_load_u32(node + 8));
          let lookup: u32 = method_index + 1;
          memory_store_u32(code + lookup * 8, 42);
          memory_store_u32(code + lookup * 8 + 4, 0);
          let after_lookup: u32 = lookup + 1;
          memory_store_u32(code + after_lookup * 8, 20);
          memory_store_u32(code + after_lookup * 8 + 4, receiver_name);
          let after_arguments: u32 = emit_arguments(memory_load_u32(node + 12), code, after_lookup + 1, 255);
          memory_store_u32(code + after_arguments * 8, 47);
          memory_store_u32(code + after_arguments * 8 + 4, memory_load_u32(node + 16));
          let call_index: u32 = after_arguments + 1;
          memory_store_u32(code + call_index * 8, 69);
          memory_store_u32(code + call_index * 8 + 4, 0);
          return emit_result_adjustment(code, call_index + 1, expected);
        } else {
        if kind == 51 {
          let function_record: u32 = compile_nested_function(node);
          memory_store_u32(code + index * 8, 46);
          memory_store_u32(code + index * 8 + 4, function_record);
          after_expression = index + 1;
        } else {
          if kind == 52 {
            memory_store_u32(code + index * 8, 48);
            memory_store_u32(code + index * 8 + 4, 0);
            return emit_result_adjustment(code, index + 1, expected);
          } else {
            if kind == 44 {
              memory_store_u32(code + index * 8, 40);
              memory_store_u32(code + index * 8 + 4, 0);
              after_expression = emit_table_entries(memory_load_u32(node + 4), code, index + 1);
            } else {
              if kind == 47 {
                memory_store_u32(code + index * 8, 1);
                memory_store_u32(code + index * 8 + 4, memory_load_u32(node + 4));
                after_expression = index + 1;
              } else {
                if kind == 46 {
                  let after_table: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                  let after_key: u32 = emit(memory_load_u32(node + 8), code, after_table, 1);
                  memory_store_u32(code + after_key * 8, 42);
                  memory_store_u32(code + after_key * 8 + 4, 0);
                  after_expression = after_key + 1;
                } else {
                  if kind == 49 {
                    memory_store_u32(code + index * 8, 44);
                    memory_store_u32(code + index * 8 + 4, memory_load_u32(node + 4));
                    after_expression = index + 1;
                  } else {
                    if kind == 50 {
                      let after_left: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                      let after_right: u32 = emit(memory_load_u32(node + 8), code, after_left, 1);
                      memory_store_u32(code + after_right * 8, 45);
                      memory_store_u32(code + after_right * 8 + 4, 0);
                      after_expression = after_right + 1;
                    } else {
                      if kind == 6 {
                        let after: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                        memory_store_u32(code + after * 8, 7);
                        memory_store_u32(code + after * 8 + 4, 0);
                        after_expression = after + 1;
                      } else {
                        if kind == 9 {
                          let after: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                          memory_store_u32(code + after * 8, 32);
                          memory_store_u32(code + after * 8 + 4, 0);
                          after_expression = after + 1;
                        } else {
                          if kind == 10 {
                            let after: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                            memory_store_u32(code + after * 8, 33);
                            memory_store_u32(code + after * 8 + 4, 0);
                            after_expression = after + 1;
                          } else {
                            if kind == 11 {
                              let after: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                              memory_store_u32(code + after * 8, 34);
                              memory_store_u32(code + after * 8 + 4, 0);
                              after_expression = after + 1;
                            } else {
                            let after_left: u32 = emit(memory_load_u32(node + 4), code, index, 1);
                            let after_right: u32 = emit(memory_load_u32(node + 8), code, after_left, 1);
                            let mut opcode: u32 = kind;
                            if kind == 5 {
                              let right: u32 = memory_load_u32(node + 8);
                              if memory_load_u32(right) == 1 {
                                if memory_load_u32(right + 4) == 0 {
                                  opcode = kind - kind + 8;
                                }
                              }
                            }
                            memory_store_u32(code + after_right * 8, opcode);
                            memory_store_u32(code + after_right * 8 + 4, 0);
                            after_expression = after_right + 1;
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        }
      }
    }
    }
  }
  if expected == 255 {
    return after_expression;
  }
  if expected == 0 {
    memory_store_u32(code + after_expression * 8, 24);
    memory_store_u32(code + after_expression * 8 + 4, 0);
    return after_expression + 1;
  }
  if expected > 1 {
    return emit_nil_padding(code, after_expression, expected - 1);
  }
  return after_expression;
}

export fn emit_arguments(node: u32, code: u32, index: u32, expected: u32) -> u32 {
  if node == 0 {
    if expected == 255 || expected == 0 {
      return index;
    }
    return emit_nil_padding(code, index, expected);
  }
  let next: u32 = memory_load_u32(node + 8);
  let mut current_expected: u32 = 1;
  if next == 0 {
    current_expected = expected;
  }
  let after_argument: u32 = emit(memory_load_u32(node + 4), code, index, current_expected);
  if next == 0 {
    return after_argument;
  }
  let mut remaining_expected: u32 = expected;
  if remaining_expected != 255 {
    if remaining_expected > 0 {
      remaining_expected = remaining_expected - 1;
    }
  }
  return emit_arguments(next, code, after_argument, remaining_expected);
}

fn list_length(node: u32) -> u32 {
  if node == 0 {
    return 0;
  }
  let tail_length: u32 = list_length(memory_load_u32(node + 8));
  return tail_length + 1;
}

export fn emit_stores(names: u32, code: u32, index: u32) -> u32 {
  if names == 0 {
    return index;
  }
  let after_next: u32 = emit_stores(memory_load_u32(names + 8), code, index);
  memory_store_u32(code + after_next * 8, 51);
  memory_store_u32(code + after_next * 8 + 4, names);
  return after_next + 1;
}

fn emit_assignment_stores(names: u32, code: u32, index: u32) -> u32 {
  if names == 0 {
    return index;
  }
  let after_next: u32 = emit_assignment_stores(memory_load_u32(names + 8), code, index);
  let entry_kind: u32 = memory_load_u32(names);
  // Legacy multi-assign entries are declaration_name nodes (kind 40).
  if entry_kind == 40 {
    memory_store_u32(code + after_next * 8, 21);
    memory_store_u32(code + after_next * 8 + 4, memory_load_u32(names + 4));
    return after_next + 1;
  }
  let target: u32 = memory_load_u32(names + 4);
  let target_kind: u32 = memory_load_u32(target);
  if target_kind == 20 {
    memory_store_u32(code + after_next * 8, 21);
    memory_store_u32(code + after_next * 8 + 4, memory_load_u32(target + 4));
    return after_next + 1;
  }
  if target_kind == 46 {
    // RHS value is already on the stack. Push table/key, then opcode 72
    // consumes (value, table, key).
    let after_table: u32 = emit(memory_load_u32(target + 4), code, after_next, 1);
    let after_key: u32 = emit(memory_load_u32(target + 8), code, after_table, 1);
    memory_store_u32(code + after_key * 8, 72);
    memory_store_u32(code + after_key * 8 + 4, 0);
    return after_key + 1;
  }
  return after_next;
}

fn emit_list_ctx(node: u32, code: u32, index: u32, ctx: u32, loop_ctx: u32) -> u32 {
  if node == 0 {
    return index;
  }
  let after_statement: u32 = emit_statement_ctx(memory_load_u32(node + 4), code, index, ctx, loop_ctx);
  return emit_list_ctx(memory_load_u32(node + 8), code, after_statement, ctx, loop_ctx);
}

export fn emit_list(node: u32, code: u32, index: u32) -> u32 {
  let ctx: u32 = label_context_new();
  return emit_list_ctx(node, code, index, ctx, 0);
}

export fn emit_statement(node: u32, code: u32, index: u32) -> u32 {
  let ctx: u32 = label_context_new();
  return emit_statement_ctx(node, code, index, ctx, 0);
}

fn emit_statement_ctx(node: u32, code: u32, index: u32, ctx: u32, loop_ctx: u32) -> u32 {
  let kind: u32 = memory_load_u32(node);
  if kind == 38 {
    return index;
  }
  if kind == 54 {
    label_define(code, ctx, memory_load_u32(node + 4), index);
    return index;
  }
  if kind == 55 {
    return emit_goto(code, index, ctx, memory_load_u32(node + 4));
  }
  if kind == 60 {
    let after_expression: u32 = emit(memory_load_u32(node + 4), code, index, 1);
    memory_store_u32(code + after_expression * 8, 50);
    memory_store_u32(code + after_expression * 8 + 4, 0);
    return after_expression + 1;
  }
  if kind == 65 {
    if loop_ctx == 0 {
      return index;
    }
    return emit_break(code, index, loop_ctx);
  }
  if kind == 64 {
    let scope: u32 = scope_context_new(ctx);
    let after_enter: u32 = emit_scope_enter(code, index, scope);
    let after_body: u32 = emit_list_ctx(memory_load_u32(node + 4), code, after_enter, ctx, loop_ctx);
    return emit_scope_exit(code, after_body);
  }
  if kind == 34 {
    let mut after_expression: u32 = index;
    if memory_load_u32(node + 4) == 0 {
      memory_store_u32(code + after_expression * 8, 1);
      memory_store_u32(code + after_expression * 8 + 4, 0);
      after_expression = after_expression + 1;
    } else {
      let returned: u32 = memory_load_u32(node + 4);
      after_expression = emit_arguments(returned, code, after_expression, 255);
    }
    memory_store_u32(code + after_expression * 8, 6);
    memory_store_u32(code + after_expression * 8 + 4, 0);
    return after_expression + 1;
  }
  if kind == 35 {
    let after_expression: u32 = emit(memory_load_u32(node + 8), code, index, 1);
    let declaration: u32 = parser.node_extra(40, memory_load_u32(node + 4), 0, 0);
    memory_store_u32(code + after_expression * 8, 51);
    memory_store_u32(code + after_expression * 8 + 4, declaration);
    return after_expression + 1;
  }
  if kind == 36 {
    let after_expression: u32 = emit(memory_load_u32(node + 8), code, index, 1);
    memory_store_u32(code + after_expression * 8, 21);
    memory_store_u32(code + after_expression * 8 + 4, memory_load_u32(node + 4));
    return after_expression + 1;
  }
  if kind == 53 {
    let target_count: u32 = list_length(memory_load_u32(node + 4));
    let mut after_expressions: u32 = index;
    if memory_load_u32(node + 8) == 0 {
      after_expressions = emit_nil_padding(code, after_expressions, target_count);
    } else {
      after_expressions = emit_arguments(memory_load_u32(node + 8), code, after_expressions, target_count);
    }
    return emit_stores(memory_load_u32(node + 4), code, after_expressions);
  }
  if kind == 70 {
    let target_count: u32 = list_length(memory_load_u32(node + 4));
    let after_expressions: u32 = emit_arguments(memory_load_u32(node + 8), code, index, target_count);
    return emit_assignment_stores(memory_load_u32(node + 4), code, after_expressions);
  }
  if kind == 61 {
    return index;
  }
  if kind == 48 {
    let target: u32 = memory_load_u32(node + 4);
    let mut after_target: u32 = emit(memory_load_u32(target + 4), code, index, 1);
    after_target = emit(memory_load_u32(target + 8), code, after_target, 1);
    let after_expression: u32 = emit(memory_load_u32(node + 8), code, after_target, 1);
    memory_store_u32(code + after_expression * 8, 41);
    memory_store_u32(code + after_expression * 8 + 4, 0);
    return after_expression + 1;
  }
  if kind == 32 {
    let after_condition: u32 = emit(memory_load_u32(node + 4), code, index, 1);
    let false_jump: u32 = after_condition;
    memory_store_u32(code + false_jump * 8, 23);
    memory_store_u32(code + false_jump * 8 + 4, 0);
    let then_scope: u32 = scope_context_new(ctx);
    let then_start: u32 = emit_scope_enter(code, false_jump + 1, then_scope);
    let after_then_body: u32 = emit_list_ctx(memory_load_u32(node + 8), code, then_start, ctx, loop_ctx);
    let after_then: u32 = emit_scope_exit(code, after_then_body);
    let end_jump: u32 = after_then;
    memory_store_u32(code + end_jump * 8, 22);
    memory_store_u32(code + end_jump * 8 + 4, 0);
    let else_start: u32 = end_jump + 1;
    let else_node: u32 = memory_load_u32(node + 12);
    let mut after_else: u32 = else_start;
    if else_node != 0 {
      if memory_load_u32(else_node) == 32 {
        after_else = emit_statement_ctx(else_node, code, else_start, ctx, loop_ctx);
      } else {
        let else_scope: u32 = scope_context_new(ctx);
        let else_body: u32 = emit_scope_enter(code, else_start, else_scope);
        let after_else_body: u32 = emit_list_ctx(else_node, code, else_body, ctx, loop_ctx);
        after_else = emit_scope_exit(code, after_else_body);
      }
    }
    memory_store_u32(code + false_jump * 8 + 4, else_start);
    memory_store_u32(code + end_jump * 8 + 4, after_else);
    return after_else;
  }
  if kind == 33 {
    let loop_start: u32 = index;
    let mut after_condition: u32 = emit(memory_load_u32(node + 4), code, loop_start, 1);
    let false_jump: u32 = after_condition;
    memory_store_u32(code + false_jump * 8, 23);
    memory_store_u32(code + false_jump * 8 + 4, 0);
    let body_ctx: u32 = loop_context_new(loop_ctx);
    let body_scope: u32 = scope_context_new(ctx);
    let body_start: u32 = emit_scope_enter(code, false_jump + 1, body_scope);
    let after_body_contents: u32 = emit_list_ctx(memory_load_u32(node + 8), code, body_start, ctx, body_ctx);
    let after_body: u32 = emit_scope_exit(code, after_body_contents);
    memory_store_u32(code + after_body * 8, 22);
    memory_store_u32(code + after_body * 8 + 4, loop_start);
    let end: u32 = after_body + 1;
    memory_store_u32(code + false_jump * 8 + 4, end);
    close_loop(code, body_ctx, end);
    return end;
  }
  if kind == 56 {
    let loop_start: u32 = index;
    let body_ctx: u32 = loop_context_new(loop_ctx);
    let body_scope: u32 = scope_context_new(ctx);
    let body_start: u32 = emit_scope_enter(code, loop_start, body_scope);
    let after_body: u32 = emit_list_ctx(memory_load_u32(node + 4), code, body_start, ctx, body_ctx);
    let mut after_condition: u32 = emit(memory_load_u32(node + 8), code, after_body, 1);
    after_condition = emit_scope_exit(code, after_condition);
    memory_store_u32(code + after_condition * 8, 23);
    memory_store_u32(code + after_condition * 8 + 4, loop_start);
    let end: u32 = after_condition + 1;
    close_loop(code, body_ctx, end);
    return end;
  }
  if kind == 58 {
    let header: u32 = memory_load_u32(node + 4);
    let name: u32 = memory_load_u32(header + 4);
    let finish_name: u32 = memory_alloc(4);
    let step_name: u32 = memory_alloc(4);
    let after_start: u32 = emit(memory_load_u32(header + 8), code, index, 1);
    memory_store_u32(code + after_start * 8, 21);
    memory_store_u32(code + after_start * 8 + 4, name);
    let after_finish: u32 = emit(memory_load_u32(header + 12), code, after_start + 1, 1);
    memory_store_u32(code + after_finish * 8, 21);
    memory_store_u32(code + after_finish * 8 + 4, finish_name);
    let after_step: u32 = emit(memory_load_u32(header + 16), code, after_finish + 1, 1);
    memory_store_u32(code + after_step * 8, 21);
    memory_store_u32(code + after_step * 8 + 4, step_name);
    let loop_start: u32 = after_step + 1;
    let finish_load: u32 = loop_start + 1;
    let comparison: u32 = finish_load + 1;
    let false_jump: u32 = comparison + 1;
    memory_store_u32(code + loop_start * 8, 20);
    memory_store_u32(code + loop_start * 8 + 4, name);
    memory_store_u32(code + finish_load * 8, 20);
    memory_store_u32(code + finish_load * 8 + 4, finish_name);
    memory_store_u32(code + comparison * 8, 18);
    memory_store_u32(code + comparison * 8 + 4, 0);
    memory_store_u32(code + false_jump * 8, 23);
    memory_store_u32(code + false_jump * 8 + 4, 0);
    let body_ctx: u32 = loop_context_new(loop_ctx);
    let body_scope: u32 = scope_context_new(ctx);
    let body_start: u32 = emit_scope_enter(code, false_jump + 1, body_scope);
    let after_body_contents: u32 = emit_list_ctx(memory_load_u32(node + 8), code, body_start, ctx, body_ctx);
    let after_body: u32 = emit_scope_exit(code, after_body_contents);
    let step_load: u32 = after_body + 1;
    let increment: u32 = step_load + 1;
    let store: u32 = increment + 1;
    let back_jump: u32 = store + 1;
    memory_store_u32(code + after_body * 8, 20);
    memory_store_u32(code + after_body * 8 + 4, name);
    memory_store_u32(code + step_load * 8, 20);
    memory_store_u32(code + step_load * 8 + 4, step_name);
    memory_store_u32(code + increment * 8, 2);
    memory_store_u32(code + increment * 8 + 4, 0);
    memory_store_u32(code + store * 8, 21);
    memory_store_u32(code + store * 8 + 4, name);
    memory_store_u32(code + back_jump * 8, 22);
    memory_store_u32(code + back_jump * 8 + 4, loop_start);
    let end: u32 = back_jump + 1;
    memory_store_u32(code + false_jump * 8 + 4, end);
    close_loop(code, body_ctx, end);
    return end;
  }
  if kind == 62 {
    let names: u32 = memory_load_u32(node + 4);
    let expressions: u32 = memory_load_u32(node + 8);
    let body: u32 = memory_load_u32(node + 12);
    let name_count: u32 = list_length(names);
    let f_name: u32 = memory_alloc(4);
    let s_name: u32 = memory_alloc(4);
    let var_name: u32 = memory_alloc(4);
    let f_declaration: u32 = parser.node_extra(40, f_name, 0, 0);
    let s_declaration: u32 = parser.node_extra(40, s_name, 0, 0);
    let var_declaration: u32 = parser.node_extra(40, var_name, 0, 0);
    let after_expr: u32 = emit_arguments(expressions, code, index, 3);
    let store_s: u32 = after_expr + 1;
    let store_f: u32 = after_expr + 2;
    memory_store_u32(code + after_expr * 8, 51);
    memory_store_u32(code + after_expr * 8 + 4, var_declaration);
    memory_store_u32(code + store_s * 8, 51);
    memory_store_u32(code + store_s * 8 + 4, s_declaration);
    memory_store_u32(code + store_f * 8, 51);
    memory_store_u32(code + store_f * 8 + 4, f_declaration);
    let loop_start: u32 = after_expr + 3;
    let load_var: u32 = loop_start + 1;
    let arg_count: u32 = loop_start + 2;
    let call_op: u32 = loop_start + 3;
    let adjust_op: u32 = loop_start + 4;
    memory_store_u32(code + loop_start * 8, 20);
    memory_store_u32(code + loop_start * 8 + 4, s_name);
    memory_store_u32(code + load_var * 8, 20);
    memory_store_u32(code + load_var * 8 + 4, var_name);
    memory_store_u32(code + arg_count * 8, 47);
    memory_store_u32(code + arg_count * 8 + 4, 2);
    memory_store_u32(code + call_op * 8, 25);
    memory_store_u32(code + call_op * 8 + 4, f_name);
    memory_store_u32(code + adjust_op * 8, 49);
    memory_store_u32(code + adjust_op * 8 + 4, name_count);
    let after_call: u32 = loop_start + 5;
    let after_stores: u32 = emit_stores(names, code, after_call);
    let first_name: u32 = memory_load_u32(names + 4);
    memory_store_u32(code + after_stores * 8, 20);
    memory_store_u32(code + after_stores * 8 + 4, first_name);
    let false_jump: u32 = after_stores + 1;
    let reload_first: u32 = false_jump + 1;
    let store_control: u32 = false_jump + 2;
    memory_store_u32(code + false_jump * 8, 23);
    memory_store_u32(code + false_jump * 8 + 4, 0);
    memory_store_u32(code + reload_first * 8, 20);
    memory_store_u32(code + reload_first * 8 + 4, first_name);
    memory_store_u32(code + store_control * 8, 21);
    memory_store_u32(code + store_control * 8 + 4, var_name);
    let after_update: u32 = false_jump + 3;
    let body_ctx: u32 = loop_context_new(loop_ctx);
    let after_body: u32 = emit_list_ctx(body, code, after_update, ctx, body_ctx);
    memory_store_u32(code + after_body * 8, 22);
    memory_store_u32(code + after_body * 8 + 4, loop_start);
    let end: u32 = after_body + 1;
    memory_store_u32(code + false_jump * 8 + 4, end);
    close_loop(code, body_ctx, end);
    return end;
  }
  let after_expression: u32 = emit(node, code, index, 0);
  return after_expression;
}

export fn compile_functions(node: u32, head: u32) -> u32 {
  let mut current: u32 = node;
  let mut functions: u32 = head;
  while current != 0 {
    let statement: u32 = memory_load_u32(current + 4);
    if memory_load_u32(statement) == 38 {
      let function_code: u32 = memory_alloc(function_buffer_size());
      let mut function_count: u32 = emit_list(memory_load_u32(statement + 8), function_code, 0);
      memory_store_u32(function_code + function_count * 8, 6);
      memory_store_u32(function_code + function_count * 8 + 4, 0);
      function_count = function_count + 1;
      let function_record: u32 = memory_alloc(32);
      memory_store_u32(function_record, memory_load_u32(statement + 4));
      memory_store_u32(function_record + 4, function_code);
      memory_store_u32(function_record + 8, function_count);
      memory_store_u32(function_record + 12, memory_load_u32(statement + 12));
      memory_store_u32(function_record + 16, parser.parameter_count(memory_load_u32(statement + 12)));
      memory_store_u32(function_record + 20, functions);
      memory_store_u32(function_record + 24, memory_load_u32(statement + 16));
      memory_store_u32(function_record + 28, 0);
      functions = function_record;
    }
    current = memory_load_u32(current + 8);
  }
  return functions;
}

export fn compile_chunk(source: bytes) -> u32 {
  let parsed: u32 = parser.parse_chunk(source);
  let prototype: u32 = memory_alloc(96);
  memory_store_u32(prototype, memory_load_u32(parsed + 8));
  memory_store_u32(prototype + 4, 0);
  memory_store_u32(prototype + 8, 0);
  memory_store_u32(prototype + 12, 0);
  memory_store_u32(prototype + 16, 0);
  memory_store_u32(prototype + 20, 0);
  memory_store_u32(prototype + 24, 0);
  memory_store_u32(prototype + 28, 0);
  memory_store_u32(prototype + 32, 0);
  memory_store_u32(prototype + 36, bytes_length_u32(source));
  memory_store_u32(prototype + 40, 1);
  memory_store_u32(prototype + 44, 0);
  memory_store_u32(prototype + 48, 0);
  memory_store_u32(prototype + 52, 0);
  memory_store_u32(prototype + 56, 0);
  memory_store_u32(prototype + 60, 0);
  memory_store_u32(prototype + 64, 0);
  memory_store_u32(prototype + 68, 0);
  memory_store_u32(prototype + 72, 0);
  memory_store_u32(prototype + 76, 0);
  memory_store_u32(prototype + 80, 0);
  memory_store_u32(prototype + 84, 0);
  if bytes_length_u32(source) != 0 {
    if bytes_byte_at_u32(source, 0) == 27 {
      memory_store_u32(prototype + 40, 2);
      memory_store_u32(prototype, 4);
      if bytes_length_u32(source) < 5 {
        memory_store_u32(prototype + 44, 1);
      } else {
        if bytes_byte_at_u32(source, 1) != 76 || bytes_byte_at_u32(source, 2) != 117 || bytes_byte_at_u32(source, 3) != 97 || bytes_byte_at_u32(source, 4) != 85 {
          memory_store_u32(prototype + 44, 1);
        }
      }
      return prototype;
    }
  }
  if memory_load_u32(parsed + 8) != 0 {
    return prototype;
  }
  if memory_load_u32(parsed + 4) == 0 {
    let empty_code: u32 = memory_alloc(8);
    memory_store_u32(empty_code, 6);
    memory_store_u32(empty_code + 4, 0);
    memory_store_u32(prototype + 4, empty_code);
    memory_store_u32(prototype + 8, 1);
    return prototype;
  }
  memory_store_u32(prototype + 32, compile_functions(memory_load_u32(parsed + 4), 0));
  let code: u32 = memory_alloc(code_buffer_size());
  let count: u32 = emit_list(memory_load_u32(parsed + 4), code, 0);
  memory_store_u32(code + count * 8, 6);
  memory_store_u32(code + count * 8 + 4, 0);
  memory_store_u32(prototype + 4, code);
  memory_store_u32(prototype + 8, count + 1);
  return prototype;
}

export fn chunk_format(prototype: u32) -> u32 {
  if prototype == 0 {
    return 0;
  }
  return memory_load_u32(prototype + 40);
}

export fn chunk_source_length(prototype: u32) -> u32 {
  if prototype == 0 {
    return 0;
  }
  return memory_load_u32(prototype + 36);
}

export fn chunk_error(prototype: u32) -> u32 {
  if prototype == 0 {
    return 2;
  }
  return memory_load_u32(prototype + 44);
}