  return 1003;
}

fn vm_builtin_call(
  prototype: u32,
  builtin: u32,
  heap: u32,
  stack: u32,
  depth: u32,
  argument_count: u32,
) -> u32 {
  let mut actual_count: u32 = argument_count;
  if builtin == 1 {
    actual_count = argument_count - argument_count + 2;
