import "./memory.fws" as memory;
import "./string.fws" as string;
import "./lib/string.fws" as library_string;
import "./table.fws" as table;
import "./closure.fws" as closure;
import "./value.fws" as value;
import "./codegen.fws" as codegen;
import capability "lua.io.write" as io_write(message: u32) -> unit;
import capability "lua.package.load" as package_load(path: u32) -> bytes;
import capability "lua.core.source" as string_to_bytes(string: u32) -> bytes;

export fn vm_stack_error() -> u32 {
  return 2;
}

export fn vm_malformed_chunk() -> u32 {
  return 4;
}

export fn vm_yield_status() -> u32 {
  return 5;
}

// Reports whether a prototype is currently paused at a yield point and can be
// resumed by re-entering `execute`.  The resume flag lives at prototype + 80.
export fn vm_is_yielded(prototype: u32) -> u32 {
  if prototype == 0 {
    return 0;
  }
  return memory_load_u32(prototype + 80);
}

export fn vm_division_error() -> u32 {
  return 3;
}

export fn vm_true() -> u32 {
  return 1;
}

fn vm_hash_name(
  a: u32,
  b: u32,
  c: u32,
  d: u32,
  e: u32,
  f: u32,
  g: u32,
  h: u32,
  i: u32,
  j: u32,
  k: u32,
  l: u32,
) -> u32 {
  let mut hash: u32 = 216613626;
  if a != 0 { hash = hash * 16777619 + a; }
  if b != 0 { hash = hash * 16777619 + b; }
  if c != 0 { hash = hash * 16777619 + c; }
  if d != 0 { hash = hash * 16777619 + d; }
  if e != 0 { hash = hash * 16777619 + e; }
  if f != 0 { hash = hash * 16777619 + f; }
  if g != 0 { hash = hash * 16777619 + g; }
  if h != 0 { hash = hash * 16777619 + h; }
  if i != 0 { hash = hash * 16777619 + i; }
  if j != 0 { hash = hash * 16777619 + j; }
  if k != 0 { hash = hash * 16777619 + k; }
  if l != 0 { hash = hash * 16777619 + l; }
  return hash;
}

fn vm_hash_pairs() -> u32 { return vm_hash_name(112, 97, 105, 114, 115, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_next() -> u32 { return vm_hash_name(110, 101, 120, 116, 0, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_setmetatable() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 115; hash = hash * 16777619 + 101; hash = hash * 16777619 + 116; hash = hash * 16777619 + 109; hash = hash * 16777619 + 101; hash = hash * 16777619 + 116; hash = hash * 16777619 + 97; hash = hash * 16777619 + 116; hash = hash * 16777619 + 97; hash = hash * 16777619 + 98; hash = hash * 16777619 + 108; hash = hash * 16777619 + 101; return hash; }
fn vm_hash_getmetatable() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 103; hash = hash * 16777619 + 101; hash = hash * 16777619 + 116; hash = hash * 16777619 + 109; hash = hash * 16777619 + 101; hash = hash * 16777619 + 116; hash = hash * 16777619 + 97; hash = hash * 16777619 + 116; hash = hash * 16777619 + 97; hash = hash * 16777619 + 98; hash = hash * 16777619 + 108; hash = hash * 16777619 + 101; return hash; }
fn vm_hash_index() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 105; hash = hash * 16777619 + 110; hash = hash * 16777619 + 100; hash = hash * 16777619 + 101; hash = hash * 16777619 + 120; return hash; }
fn vm_hash_newindex() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 110; hash = hash * 16777619 + 101; hash = hash * 16777619 + 119; hash = hash * 16777619 + 105; hash = hash * 16777619 + 110; hash = hash * 16777619 + 100; hash = hash * 16777619 + 101; hash = hash * 16777619 + 120; return hash; }
fn vm_hash_add() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 97; hash = hash * 16777619 + 100; hash = hash * 16777619 + 100; return hash; }
fn vm_hash_sub() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 115; hash = hash * 16777619 + 117; hash = hash * 16777619 + 98; return hash; }
fn vm_hash_mul() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 109; hash = hash * 16777619 + 117; hash = hash * 16777619 + 108; return hash; }
fn vm_hash_div() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 100; hash = hash * 16777619 + 105; hash = hash * 16777619 + 118; return hash; }
fn vm_hash_idiv() -> u32 { return vm_hash_name(95, 95, 105, 100, 105, 118, 0, 0, 0, 0, 0, 0); }
fn vm_hash_pow() -> u32 { return vm_hash_name(95, 95, 112, 111, 119, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_eq() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 101; hash = hash * 16777619 + 113; return hash; }
fn vm_hash_lt() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 108; hash = hash * 16777619 + 116; return hash; }
fn vm_hash_le() -> u32 { let mut hash: u32 = 216613626; hash = hash * 16777619 + 95; hash = hash * 16777619 + 95; hash = hash * 16777619 + 108; hash = hash * 16777619 + 101; return hash; }
fn vm_hash_concat() -> u32 { return vm_hash_name(95, 95, 99, 111, 110, 99, 97, 116, 0, 0, 0, 0); }
fn vm_hash_mod() -> u32 { return vm_hash_name(95, 95, 109, 111, 100, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_band() -> u32 { return vm_hash_name(95, 95, 98, 97, 110, 100, 0, 0, 0, 0, 0, 0); }
fn vm_hash_bor() -> u32 { return vm_hash_name(95, 95, 98, 111, 114, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_bxor() -> u32 { return vm_hash_name(95, 95, 98, 120, 111, 114, 0, 0, 0, 0, 0, 0); }
fn vm_hash_shl() -> u32 { return vm_hash_name(95, 95, 115, 104, 108, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_shr() -> u32 { return vm_hash_name(95, 95, 115, 104, 114, 0, 0, 0, 0, 0, 0, 0); }
fn vm_hash_unm() -> u32 { return vm_hash_name(95, 95, 117, 110, 109, 0, 0, 0, 0, 0, 0, 0); }

fn vm_is_table_value(handle: u32) -> u32 {
  if handle < 1024 {
    return 0;
  }
  if handle >= 1000000 {
    return 0;
  }
  if memory_load_u32(handle) == 1 {
    return 1;
  }
  return 0;
}

fn vm_table_metafield(handle: u32, name: u32) -> u32 {
  if vm_is_table_value(handle) == 0 {
    return 0;
  }
  let metatable: u32 = table.table_metatable(handle);
  if metatable == 0 {
    return 0;
  }
  if vm_is_table_value(metatable) == 0 {
    return 0;
  }
  return table.table_get_raw(metatable, name);
}

export fn vm_negate(value: u32) -> u32 {
  return value - value - value;
}

fn vm_negate_numeric(heap: u32, input: u32) -> u32 {
  if vm_is_float(input) == 1 {
    return value.value_float_new(heap, f64_from_u32(0) - value.value_float_number(input));
  }
  return vm_negate(input);
}

export fn vm_remainder(left: u32, right: u32) -> u32 {
  if right == 0 {
    return 0;
  }
  let quotient: u32 = left / right;
  let product: u32 = quotient * right;
  return left - product;
}

export fn vm_bit_and(left: u32, right: u32) -> u32 {
  let mut left_value: u32 = left;
  let mut right_value: u32 = right;
  let mut and_result: u32 = 0;
  let mut place: u32 = 1;
  let mut index: u32 = 0;
  let two: u32 = 2;
  while index < 32 {
    if left_value % two == 1 && right_value % two == 1 {
      and_result = and_result + place;
    }
    left_value = left_value / two;
    right_value = right_value / two;
    place = place * two;
    index = index + 1;
  }
  return and_result;
}

export fn vm_bit_or(left: u32, right: u32) -> u32 {
  let mut left_value: u32 = left;
  let mut right_value: u32 = right;
  let mut or_result: u32 = 0;
  let mut place: u32 = 1;
  let mut index: u32 = 0;
  let two: u32 = 2;
  while index < 32 {
    if left_value % two == 1 || right_value % two == 1 {
      or_result = or_result + place;
    }
    left_value = left_value / two;
    right_value = right_value / two;
    place = place * two;
    index = index + 1;
  }
  return or_result;
}

export fn vm_bit_xor(left: u32, right: u32) -> u32 {
  let mut left_value: u32 = left;
  let mut right_value: u32 = right;
  let mut xor_result: u32 = 0;
  let mut place: u32 = 1;
  let mut index: u32 = 0;
  let two: u32 = 2;
  while index < 32 {
    if left_value % two != right_value % two {
      xor_result = xor_result + place;
    }
    left_value = left_value / two;
    right_value = right_value / two;
    place = place * two;
    index = index + 1;
  }
  return xor_result;
}

export fn vm_shift_left(value: u32, amount: u32) -> u32 {
  let mut shifted: u32 = value;
  let mut steps: u32 = amount;
  let two: u32 = 2;
  if steps > 31 {
    return 0;
  }
  while steps != 0 {
    shifted = shifted * two;
    steps = steps - 1;
  }
  return shifted;
}

export fn vm_shift_right(value: u32, amount: u32) -> u32 {
  let mut shifted: u32 = value;
  let mut steps: u32 = amount;
  let two: u32 = 2;
  if steps > 31 {
    return 0;
  }
  while steps != 0 {
    shifted = shifted / two;
    steps = steps - 1;
  }
  return shifted;
}

export fn vm_bit_not(value: u32) -> u32 {
  let one: u32 = 1;
  return value - value - value - one;
}

export fn vm_stack_address(stack: u32, index: u32) -> u32 {
  return stack + index * 4;
}

export fn vm_is_running(pc: u32, count: u32, status: u32) -> u32 {
  if pc >= count {
    return 0;
  }
  if status != 0 {
    return 0;
  }
  return 1;
}

export fn vm_is_binary(opcode: u32) -> u32 {
  if opcode == 2 {
    return 1;
  }
  if opcode == 3 {
    return 1;
  }
  if opcode == 4 {
    return 1;
  }
  if opcode == 5 {
    return 1;
  }
  if opcode == 71 {
    return 1;
  }
  if opcode == 77 {
    return 1;
  }
  if opcode >= 14 {
    if opcode <= 19 {
      return 1;
    }
  }
  if opcode == 73 || opcode == 74 {
    return 1;
  }
  return 0;
}

export fn vm_is_table_opcode(opcode: u32) -> u32 {
  if opcode == 67 {
    return 1;
  }
  if opcode == 72 {
    return 1;
  }
  if opcode >= 40 {
    if opcode <= 43 {
      return 1;
    }
  }
  return 0;
}

export fn vm_is_string_opcode(opcode: u32) -> u32 {
  if opcode == 34 {
    return 1;
  }
  if opcode == 44 {
    return 1;
  }
  if opcode == 45 {
    return 1;
  }
  return 0;
}

export fn vm_string_opcode(prototype: u32, opcode: u32, operand: u32, heap: u32, stack: u32, depth: u32) -> u32 {
  if opcode == 34 {
    if depth == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let handle: u32 = memory_load_u32(vm_stack_address(stack, depth - 1));
    let kind: u32 = value.value_kind(handle);
    if kind == 4 {
      memory_store_u32(vm_stack_address(stack, depth - 1), string.lua_string_length(handle));
    } else {
      if kind == 5 {
        memory_store_u32(vm_stack_address(stack, depth - 1), table.table_length(handle));
      } else {
        memory_store_u32(vm_stack_address(stack, depth - 1), 0);
      }
    }
    return depth;
  }
  if opcode == 44 {
    if depth >= 64 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let handle: u32 = string.string_intern_record(heap, operand);
    if handle == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    memory_store_u32(stack + depth * 4, handle);
    return depth + 1;
  }
  if opcode == 45 {
    if depth < 2 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let left_address: u32 = vm_stack_address(stack, depth - 2);
    let right_address: u32 = vm_stack_address(stack, depth - 1);
    let mut left: u32 = memory_load_u32(left_address);
    let mut right: u32 = memory_load_u32(right_address);
    let left_kind: u32 = value.value_kind(left);
    let right_kind: u32 = value.value_kind(right);
    if left_kind == 4 {
      left = value.value_payload(left);
    }
    if right_kind == 4 {
      right = value.value_payload(right);
    }
    if vm_is_string_value(left) == 0 {
      if left_kind == 2 || left_kind == 3 {
        left = vm_concat_numeric_string(heap, left);
      } else {
        if left_kind == 0 && left < 1024 {
          left = vm_concat_numeric_string(heap, left);
        }
      }
    }
    if vm_is_string_value(right) == 0 {
      if right_kind == 2 || right_kind == 3 {
        right = vm_concat_numeric_string(heap, right);
      } else {
        if right_kind == 0 && right < 1024 {
          right = vm_concat_numeric_string(heap, right);
        }
      }
    }
    if left == 0 || right == 0 || vm_is_string_value(left) == 0 || vm_is_string_value(right) == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let handle: u32 = string.lua_string_concat(heap, left, right);
    if handle == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    memory_store_u32(left_address, handle);
    return depth - 1;
  }
  return depth;
}

export fn vm_is_bitwise_opcode(opcode: u32) -> u32 {
  if opcode >= 26 {
    if opcode <= 31 {
      return 1;
    }
  }
  return 0;
}

fn vm_local_slot_address(local_base: u32, index: u32) -> u32 {
  return local_base + index * 12;
}

fn vm_local_vararg_count_address(local_base: u32) -> u32 {
  return local_base + 384;
}

fn vm_local_vararg_value_address(local_base: u32, index: u32) -> u32 {
  return local_base + 388 + index * 4;
}

fn vm_scope_stack_address(local_base: u32, index: u32) -> u32 {
  return local_base + 644 + index * 4;
}

fn vm_scope_contains(local_base: u32, scope_depth: u32, scope: u32) -> u32 {
  let mut index: u32 = 0;
  while index <= scope_depth {
    if memory_load_u32(vm_scope_stack_address(local_base, index)) == scope {
      return 1;
    }
    index = index + 1;
  }
  return 0;
}

fn vm_capture_scope_address(capture: u32, index: u32) -> u32 {
  return capture + 16 + index * 4;
}

fn vm_capture_contains(capture: u32, scope: u32) -> u32 {
  if capture == 0 {
    return 1;
  }
  let mut index: u32 = 0;
  let count: u32 = memory_load_u32(capture + 12);
  while index < count {
    if memory_load_u32(vm_capture_scope_address(capture, index)) == scope {
      return 1;
    }
    index = index + 1;
  }
  return 0;
}

fn vm_slot_scope(address: u32) -> u32 {
  return memory_load_u32(address + 8) / 2;
}

fn vm_slot_is_const(address: u32) -> u32 {
  return memory_load_u32(address + 8) % 2;
}

fn vm_find_local(local_base: u32, name: u32, scope_depth: u32) -> u32 {
  let mut index: u32 = 32;
  while index != 0 {
    index = index - 1;
    let address: u32 = vm_local_slot_address(local_base, index);
    if memory_load_u32(address) == name {
      if vm_scope_contains(local_base, scope_depth, vm_slot_scope(address)) == 1 {
        return address;
      }
    }
  }
  return 0;
}

fn vm_find_local_exact(local_base: u32, name: u32, scope: u32) -> u32 {
  let mut index: u32 = 32;
  while index != 0 {
    index = index - 1;
    let address: u32 = vm_local_slot_address(local_base, index);
    if memory_load_u32(address) == name && vm_slot_scope(address) == scope {
      return address;
    }
  }
  return 0;
}

fn vm_find_captured(upvalue: u32, capture: u32, name: u32) -> u32 {
  let mut current_base: u32 = upvalue;
  let mut current_capture: u32 = capture;
  while current_base != 0 {
    let mut index: u32 = 32;
    while index != 0 {
      index = index - 1;
      let address: u32 = vm_local_slot_address(current_base, index);
      if memory_load_u32(address) == name {
        if vm_capture_contains(current_capture, vm_slot_scope(address)) == 1 {
          return address;
        }
      }
    }
    if current_capture == 0 {
      return 0;
    }
    current_base = memory_load_u32(current_capture + 4);
    current_capture = memory_load_u32(current_capture + 8);
  }
  return 0;
}

fn vm_capture_new(local_base: u32, scope_depth: u32, upvalue: u32, parent: u32) -> u32 {
  let count: u32 = scope_depth + 1;
  let sixteen: u32 = 16;
  let four: u32 = 4;
  let capture_size: u32 = sixteen + count * four;
  let capture: u32 = memory_alloc(capture_size);
  if capture == 0 {
    return 0;
  }
  memory_store_u32(capture, local_base);
  memory_store_u32(capture + 4, upvalue);
  memory_store_u32(capture + 8, parent);
  memory_store_u32(capture + 12, count);
  let mut index: u32 = 0;
  while index < count {
    memory_store_u32(capture + 16 + index * 4, memory_load_u32(vm_scope_stack_address(local_base, index)));
    index = index + 1;
  }
  return capture;
}

export fn vm_const_error() -> u32 {
  return 2;
}

export fn vm_load_local(local_base: u32, name: u32) -> u32 {
  let address: u32 = vm_find_local(local_base, name, 0);
  if address != 0 {
    return memory_load_u32(address + 4);
  }
  return 0;
}

export fn vm_store_local(local_base: u32, name: u32, value: u32) -> u32 {
  let mut address: u32 = vm_find_local(local_base, name, 0);
  if address != 0 {
    memory_store_u32(address + 4, value);
    return 0;
  }
  let mut index: u32 = 0;
  let mut empty: u32 = 32;
  while index < 32 {
    address = vm_local_slot_address(local_base, index);
    if memory_load_u32(address) == 0 {
      if empty == 32 {
        empty = index;
      }
    }
    index = index + 1;
  }
  if empty == 32 {
    return vm_stack_error();
  }
  address = vm_local_slot_address(local_base, empty);
  memory_store_u32(address, name);
  memory_store_u32(address + 4, value);
  memory_store_u32(address + 8, 0);
  return 0;
}

export fn vm_declare_local(local_base: u32, declaration: u32, value: u32) -> u32 {
  return vm_declare_local_at_scope(local_base, declaration, value, 0);
}

fn vm_declare_local_at_scope(local_base: u32, declaration: u32, value: u32, scope_depth: u32) -> u32 {
  if declaration == 0 {
    return vm_stack_error();
  }
  let name: u32 = memory_load_u32(declaration + 4);
  let flags: u32 = memory_load_u32(declaration + 12);
  let scope: u32 = memory_load_u32(vm_scope_stack_address(local_base, scope_depth));
  let existing: u32 = vm_find_local_exact(local_base, name, scope);
  if existing != 0 {
    memory_store_u32(existing + 4, value);
    memory_store_u32(existing + 8, scope * 2 + flags);
    return 0;
  }
  let mut index: u32 = 0;
  let mut empty: u32 = 32;
  let mut address: u32 = 0;
  while index < 32 {
    address = vm_local_slot_address(local_base, index);
    if memory_load_u32(address) == 0 {
      if empty == 32 {
        empty = index;
      }
    }
    index = index + 1;
  }
  if empty == 32 {
    return vm_stack_error();
  }
  address = vm_local_slot_address(local_base, empty);
  memory_store_u32(address, name);
  memory_store_u32(address + 4, value);
  memory_store_u32(address + 8, scope * 2 + flags);
  return 0;
}

export fn vm_load_local_or_global(heap: u32, local_base: u32, name: u32) -> u32 {
  let address: u32 = vm_find_local(local_base, name, 0);
  if address != 0 {
    return memory_load_u32(address + 4);
  }
  return memory.heap_global_get(heap, name);
}

export fn vm_load_captured(local_base: u32, name: u32) -> u32 {
  let address: u32 = vm_find_captured(local_base, 0, name);
  if address != 0 {
    return memory_load_u32(address + 4);
  }
  return 0;
}

fn vm_load_local_or_global_with_capture(heap: u32, local_base: u32, scope_depth: u32, upvalue: u32, capture: u32, name: u32) -> u32 {
  let mut address: u32 = vm_find_local(local_base, name, scope_depth);
  if address != 0 {
    return memory_load_u32(address + 4);
  }
  address = vm_find_captured(upvalue, capture, name);
  if address != 0 {
    return memory_load_u32(address + 4);
  }
  return memory.heap_global_get(heap, name);
}

export fn vm_load_local_or_global_with_upvalue(heap: u32, local_base: u32, upvalue: u32, name: u32) -> u32 {
  return vm_load_local_or_global_with_capture(heap, local_base, 0, upvalue, 0, name);
}

fn vm_store_local_or_global_with_capture(
  heap: u32,
  local_base: u32,
  scope_depth: u32,
  upvalue: u32,
  capture: u32,
  name: u32,
  value: u32,
) -> u32 {
  let mut address: u32 = vm_find_local(local_base, name, scope_depth);
  if address != 0 {
    if vm_slot_is_const(address) != 0 {
      return vm_const_error();
    }
    memory_store_u32(address + 4, value);
    return 0;
  }
  address = vm_find_captured(upvalue, capture, name);
  if address != 0 {
    if vm_slot_is_const(address) != 0 {
      return vm_const_error();
    }
    memory_store_u32(address + 4, value);
    return 0;
  }
  return vm_store_global(heap, name, value);
}

fn vm_store_global(heap: u32, name: u32, value: u32) -> u32 {
  let status: u32 = memory.heap_global_set(heap, name, value);
  if status == 0 {
    let global_table: u32 = memory_load_u32(heap + 40);
    if global_table != 0 {
      table.table_set_raw(global_table, name, value);
    }
  }
  return status;
}

export fn vm_store_local_or_global(heap: u32, local_base: u32, name: u32, value: u32) -> u32 {
  let address: u32 = vm_find_local(local_base, name, 0);
  if address != 0 {
    if vm_slot_is_const(address) != 0 {
      return vm_const_error();
    }
    memory_store_u32(address + 4, value);
    return 0;
  }
  return vm_store_global(heap, name, value);
}

export fn vm_store_local_or_global_with_upvalue(
  heap: u32,
  local_base: u32,
  upvalue: u32,
  name: u32,
  value: u32,
) -> u32 {
  return vm_store_local_or_global_with_capture(heap, local_base, 0, upvalue, 0, name, value);
}

export fn vm_table_opcode(prototype: u32, opcode: u32, heap: u32, stack: u32, depth: u32) -> u32 {
  if opcode == 40 {
    if depth >= 64 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let table_handle: u32 = table.table_new_empty(heap);
    memory_store_u32(stack + depth * 4, table_handle);
    return depth + 1;
  }
  if opcode == 67 {
    if depth < 3 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let table_address: u32 = vm_stack_address(stack, depth - 3);
    let key_address: u32 = vm_stack_address(stack, depth - 2);
    let value_address: u32 = vm_stack_address(stack, depth - 1);
    let table_handle: u32 = memory_load_u32(table_address);
    let key: u32 = memory_load_u32(key_address);
    let value: u32 = memory_load_u32(value_address);
    table.table_set_raw(table_handle, key, value);
    memory_store_u32(table_address, table_handle);
    return depth - 2;
  }
  if opcode == 41 {
    if depth < 3 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let table_address: u32 = vm_stack_address(stack, depth - 3);
    let key_address: u32 = vm_stack_address(stack, depth - 2);
    let value_address: u32 = vm_stack_address(stack, depth - 1);
    let table_handle: u32 = memory_load_u32(table_address);
    let key: u32 = memory_load_u32(key_address);
    let value: u32 = memory_load_u32(value_address);
    if vm_is_table_value(table_handle) == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    if key == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    if table.table_get_raw(table_handle, key) == 0 {
      let metamethod: u32 = vm_table_metafield(table_handle, vm_hash_newindex());
      if vm_is_table_value(metamethod) == 1 {
        table.table_set_raw(metamethod, key, value);
      } else {
        if metamethod != 0 && memory_load_u32(metamethod) == 3 {
          vm_invoke_callable(memory_load_u32(prototype + 48), metamethod, table_handle, key, value, 3, 0);
        } else {
          table.table_set_raw(table_handle, key, value);
        }
      }
    } else {
      table.table_set_raw(table_handle, key, value);
    }
    return depth - 3;
  }
  // Multi-assign indexed store: stack is (value, table, key).
  if opcode == 72 {
    if depth < 3 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let value_address: u32 = vm_stack_address(stack, depth - 3);
    let table_address: u32 = vm_stack_address(stack, depth - 2);
    let key_address: u32 = vm_stack_address(stack, depth - 1);
    let table_handle: u32 = memory_load_u32(table_address);
    let key: u32 = memory_load_u32(key_address);
    let value: u32 = memory_load_u32(value_address);
    if vm_is_table_value(table_handle) == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    if key == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    if table.table_get_raw(table_handle, key) == 0 {
      let metamethod: u32 = vm_table_metafield(table_handle, vm_hash_newindex());
      if vm_is_table_value(metamethod) == 1 {
        table.table_set_raw(metamethod, key, value);
      } else {
        if metamethod != 0 && memory_load_u32(metamethod) == 3 {
          vm_invoke_callable(memory_load_u32(prototype + 48), metamethod, table_handle, key, value, 3, 0);
        } else {
          table.table_set_raw(table_handle, key, value);
        }
      }
    } else {
      table.table_set_raw(table_handle, key, value);
    }
    return depth - 3;
  }
  if opcode == 42 {
    if depth < 2 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let table_address: u32 = vm_stack_address(stack, depth - 2);
    let key_address: u32 = vm_stack_address(stack, depth - 1);
    let table_handle: u32 = memory_load_u32(table_address);
    let key: u32 = memory_load_u32(key_address);
    let mut value: u32 = table.table_get_raw(table_handle, key);
    if value == 0 {
      let metamethod: u32 = vm_table_metafield(table_handle, vm_hash_index());
      if vm_is_table_value(metamethod) == 1 {
        value = table.table_get_raw(metamethod, key);
      } else {
        if metamethod != 0 && memory_load_u32(metamethod) == 3 {
          value = vm_invoke_callable(memory_load_u32(prototype + 48), metamethod, table_handle, key, 0, 2, 0);
        }
      }
    }
    memory_store_u32(table_address, value);
    return depth - 1;
  }
  if opcode == 43 {
    if depth < 3 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let table_address: u32 = vm_stack_address(stack, depth - 3);
    let key_address: u32 = vm_stack_address(stack, depth - 2);
    let value_address: u32 = vm_stack_address(stack, depth - 1);
    let table_handle: u32 = memory_load_u32(table_address);
    let key: u32 = memory_load_u32(key_address);
    let value: u32 = memory_load_u32(value_address);
    if table.table_get_raw(table_handle, key) == 0 {
      let metamethod: u32 = vm_table_metafield(table_handle, vm_hash_newindex());
      if vm_is_table_value(metamethod) == 1 {
        table.table_set_raw(metamethod, key, value);
      } else {
        if metamethod != 0 && memory_load_u32(metamethod) == 3 {
          vm_invoke_callable(memory_load_u32(prototype + 48), metamethod, table_handle, key, value, 3, 0);
        } else {
          table.table_set_raw(table_handle, key, value);
        }
      }
    } else {
      table.table_set_raw(table_handle, key, value);
    }
    return depth - 3;
  }
  return depth;
}

export fn vm_clear_locals(local_base: u32) -> unit {
  let mut index: u32 = 0;
  while index < 32 {
    let address: u32 = vm_local_slot_address(local_base, index);
    memory_store_u32(address, 0);
    memory_store_u32(address + 4, 0);
    memory_store_u32(address + 8, 0);
    index = index + 1;
  }
  memory_store_u32(vm_local_vararg_count_address(local_base), 0);
  memory_store_u32(vm_scope_stack_address(local_base, 0), 0);
}

export fn vm_find_function(head: u32, name: u32) -> u32 {
  let mut current: u32 = head;
  while current != 0 {
    if memory_load_u32(current) == name {
      return current;
    }
    current = memory_load_u32(current + 20);
  }
  if name == vm_hash_setmetatable() || name == vm_hash_getmetatable() {
    let builtin: u32 = memory_alloc(32);
    if builtin == 0 {
      return 0;
    }
    memory_store_u32(builtin, name);
    memory_store_u32(builtin + 4, 0);
    memory_store_u32(builtin + 8, 0);
    memory_store_u32(builtin + 12, 0);
    memory_store_u32(builtin + 16, 2);
    memory_store_u32(builtin + 20, 0);
    memory_store_u32(builtin + 24, 0);
    if name == vm_hash_getmetatable() {
      memory_store_u32(builtin + 16, 1);
      memory_store_u32(builtin + 28, 2);
    }
    if name == vm_hash_setmetatable() {
      memory_store_u32(builtin + 28, 1);
    }
    return builtin;
  }
  return 0;
}

fn vm_publish_dynamic_functions(heap: u32, functions: u32) -> unit {
  let mut function_record: u32 = functions;
  while function_record != 0 {
    let name: u32 = memory_load_u32(function_record);
    if name != 0 {
      let callable: u32 = closure.closure_new(heap, function_record, 0);
      if callable != 0 {
        vm_store_global(heap, name, callable);
        vm_store_global(heap, vm_hash_name(116, 101, 109, 112, 0, 0, 0, 0, 0, 0, 0, 0), callable);
      }
    }
    function_record = memory_load_u32(function_record + 20);
  }
}

fn vm_type_name(heap: u32, input: u32) -> u32 {
  if input == 0 {
    return string.string_intern(heap, 216613949, 3);
  }
  if input == 1 {
    return string.string_intern(heap, 216614362, 7);
  }
  if value.value_kind(input) == 2 || value.value_kind(input) == 3 {
    return string.string_intern(heap, 216614275, 6);
  }
  if input > 1024 && input < 16777216 {
    let record_kind: u32 = memory_load_u32(input);
    if record_kind == 1 {
      return string.string_intern(heap, 216614146, 5);
    }
    if record_kind == 2 {
      return string.string_intern(heap, 216614289, 6);
    }
    if record_kind == 3 {
      return string.string_intern(heap, 2019242568, 8);
    }
  }
  return string.string_intern(heap, 216614275, 6);
}

fn vm_builtin_integer(input: u32) -> u32 {
  if value.value_kind(input) == 2 {
    return value.value_payload(input);
