fn vm_intern_incremental(heap: u32) -> u32 {
  let text: u32 = string.string_intern(heap, 216614796, 11);
  if text != 0 {
    memory_store_u32(text + 24, 105);
    memory_store_u32(text + 28, 110);
    memory_store_u32(text + 32, 99);
    memory_store_u32(text + 36, 114);
    memory_store_u32(text + 40, 101);
    memory_store_u32(text + 44, 109);
    memory_store_u32(text + 48, 101);
    memory_store_u32(text + 52, 110);
    memory_store_u32(text + 56, 116);
    memory_store_u32(text + 60, 97);
    memory_store_u32(text + 64, 108);
  }
  return text;
}

fn vm_gc_state(heap: u32) -> u32 {
  let existing: u32 = memory_load_u32(heap + 44);
  if existing != 0 {
    return existing;
  }
  let state: u32 = memory_alloc(12);
  if state == 0 {
    return 0;
  }
  memory_store_u32(state, 0);
  memory_store_u32(state + 4, 100);
  memory_store_u32(state + 8, 100);
  memory_store_u32(heap + 44, state);
  return state;
}

fn vm_is_string_comparison_value(input: u32) -> u32 {
  if vm_is_string_value(input) == 1 {
    return 1;
  }
  if value.value_kind(input) == 4 {
    return vm_is_string_value(value.value_payload(input));
  }
  return 0;
}

fn vm_is_closure_value(heap: u32, input: u32) -> u32 {
  let mut handle: u32 = input;
  if value.value_kind(input) == 6 {
    handle = value.value_payload(input);
  }
  if handle < 1024 || handle >= 16777216 {
    return 0;
  }
  if memory.heap_owns(heap, handle) == 0 || memory_load_u32(handle) != 3 {
    return 0;
  }
  return 1;
}

