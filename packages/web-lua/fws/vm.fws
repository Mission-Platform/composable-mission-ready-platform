            nested_status_holder,
            builtin_id,
            heap,
            nested_stack,
            nested_depth,
            call_args,
          );
          if memory_load_u32(nested_status_holder + 28) == 0 {
            invoke_ok = invoke_ok + 1;
            memory_store_u32(nested_status_holder + 56, after);
            memory_store_u32(nested_status_holder + 60, nested_status_holder);
            memory_store_u32(nested_status_holder + 20, nested_stack);
          }
        }
      }
    }
    if invoke_ok == 1 {
      memory_store_u32(stack + argument_base * 4, value.value_boolean(1));
      let mut pcall_count: u32 = memory_load_u32(nested_status_holder + 56);
      let pcall_proto: u32 = memory_load_u32(nested_status_holder + 60);
      let mut pcall_stack: u32 = 0;
      if pcall_proto != 0 {
        pcall_stack = memory_load_u32(pcall_proto + 20);
      }
      if pcall_stack == 0 {
        pcall_count = pcall_count - pcall_count;
      }
      let mut pcall_index: u32 = 0;
      while pcall_index < pcall_count {
        let converted: u32 = vm_result_value(memory_load_u32(pcall_stack + pcall_index * 4));
        let dest_slot: u32 = argument_base + 1 + pcall_index;
        memory_store_u32(stack + dest_slot * 4, converted);
        pcall_index = pcall_index + 1;
      }
      // Keep parent status clean after a successful protected call.
      memory_store_u32(prototype + 28, 0);
      return argument_base + 1 + pcall_count;
    }
    memory_store_u32(stack + argument_base * 4, value.value_boolean(0));
    let err_slot: u32 = argument_base + 1;
    memory_store_u32(stack + err_slot * 4, string.string_intern(heap, 216614000, 5));
    let err_handle: u32 = memory_load_u32(stack + err_slot * 4);
    if err_handle != 0 {
      memory_store_u32(err_handle + 24, 101);
      memory_store_u32(err_handle + 28, 114);
      memory_store_u32(err_handle + 32, 114);
      memory_store_u32(err_handle + 36, 111);
      memory_store_u32(err_handle + 40, 114);
    }
    memory_store_u32(prototype + 28, 0);
    return argument_base + 2;
  }
  if builtin == 38 || builtin == 39 {
    if actual_count < 1 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let best_slot: u32 = argument_base;
    let mut best: u32 = memory_load_u32(stack + best_slot * 4);
    let mut candidate_index: u32 = 1;
    while candidate_index < actual_count {
      let candidate_slot: u32 = argument_base + candidate_index;
      let candidate: u32 = memory_load_u32(stack + candidate_slot * 4);
      if builtin == 38 {
        best = vm_numeric_min_value(best, candidate);
      } else {
        best = vm_numeric_max_value(best, candidate);
      }
      candidate_index = candidate_index + 1;
    }
    memory_store_u32(stack + argument_base * 4, best);
    return argument_base + 1;
  }
  if builtin == 40 {
    if actual_count < 2 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let count_slot: u32 = argument_base + 1;
    let mut separator: u32 = 0;
    if actual_count > 2 {
      let separator_slot: u32 = argument_base + 2;
      separator = memory_load_u32(stack + separator_slot * 4);
    }
    let mut output: u32 = library_string.library_string_rep_impl(
      heap,
      memory_load_u32(stack + argument_base * 4),
      memory_load_u32(stack + count_slot * 4),
      separator,
    );
    if value.value_kind(output) == 4 {
      output = value.value_payload(output);
    }
    memory_store_u32(stack + argument_base * 4, output);
    return argument_base + 1;
  }
  if builtin == 42 {
    if actual_count < 3 || argument_base + 2 > 64 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let pattern_slot: u32 = argument_base + 1;
    let replacement_slot: u32 = argument_base + 2;
    let input: u32 = memory_load_u32(stack + argument_base * 4);
    let pattern: u32 = memory_load_u32(stack + pattern_slot * 4);
    let replacement: u32 = memory_load_u32(stack + replacement_slot * 4);
    let count_record: u32 = memory.heap_alloc(heap, 4, 0);
    if count_record == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    let mut output: u32 = library_string.library_string_gsub_impl(
      heap,
      input,
      pattern,
      replacement,
      count_record,
    );
    if value.value_kind(output) == 4 {
      output = value.value_payload(output);
    }
    memory_store_u32(stack + argument_base * 4, output);
    memory_store_u32(stack + pattern_slot * 4, memory_load_u32(count_record));
    return argument_base + 2;
  }
  if depth < 1 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return depth;
  }
  return depth;
}

fn vm_invoke_callable(
  heap: u32,
  callable: u32,
  first: u32,
  second: u32,
  third: u32,
  argument_count: u32,
  status_prototype: u32,
) -> u32 {
  let callable_handle: u32 = vm_callable_handle(callable);
  if callable_handle == 0 || memory_load_u32(callable_handle) != 3 {
    if status_prototype != 0 {
      memory_store_u32(status_prototype + 28, vm_stack_error());
    }
    return 0;
  }
  let function_record: u32 = closure.closure_function(callable_handle);
  if function_record == 0 {
    if status_prototype != 0 {
      memory_store_u32(status_prototype + 28, vm_stack_error());
    }
    return 0;
  }
  let prototype: u32 = memory_alloc(100);
  let stack: u32 = memory_alloc(1024);
  let local_base: u32 = stack + 256;
  if prototype == 0 || stack == 0 {
    if status_prototype != 0 {
      memory_store_u32(status_prototype + 28, vm_stack_error());
    }
    return 0;
  }
  memory_store_u32(prototype, 0);
  memory_store_u32(prototype + 4, memory_load_u32(function_record + 4));
  memory_store_u32(prototype + 8, memory_load_u32(function_record + 8));
  memory_store_u32(prototype + 12, 0);
  memory_store_u32(prototype + 16, argument_count);
  memory_store_u32(prototype + 20, stack);
  memory_store_u32(prototype + 24, 0);
  memory_store_u32(prototype + 28, 0);
  memory_store_u32(prototype + 32, memory_load_u32(function_record + 20));
  memory_store_u32(prototype + 36, 0);
  memory_store_u32(prototype + 40, 1);
  memory_store_u32(prototype + 44, 0);
  memory_store_u32(prototype + 48, heap);
  memory_store_u32(prototype + 52, 0);
  memory_store_u32(prototype + 56, 0);
  memory_store_u32(prototype + 60, 0);
  memory_store_u32(prototype + 64, 0);
  memory_store_u32(prototype + 68, 0);
  memory_store_u32(prototype + 72, 0);
  memory_store_u32(prototype + 76, 0);
  memory_store_u32(prototype + 80, 0);
  memory_store_u32(prototype + 84, 0);
  memory_store_u32(prototype + 88, closure.closure_upvalue(callable_handle));
  memory_store_u32(prototype + 92, memory_load_u32(callable_handle + 20));
  vm_clear_locals(local_base);
  memory_store_u32(stack, first);
  memory_store_u32(stack + 4, second);
  memory_store_u32(stack + 8, third);
  let arity: u32 = memory_load_u32(function_record + 16);
  let mut bind_count: u32 = argument_count;
  if bind_count > arity {
    bind_count = arity;
  }
  if vm_bind_parameters(stack, 0, local_base, memory_load_u32(function_record + 12), bind_count) != 0 {
    if status_prototype != 0 {
      memory_store_u32(status_prototype + 28, vm_stack_error());
    }
    return 0;
  }
  let mut vararg_count: u32 = 0;
  if memory_load_u32(function_record + 24) == 1 && argument_count > arity {
    vararg_count = argument_count - arity;
  }
  vm_store_varargs(stack, arity, vararg_count, local_base);
  if memory_load_u32(function_record + 28) == 2 {
    vm_publish_dynamic_functions(heap, memory_load_u32(function_record + 20));
  }
  execute(prototype);
  let invoke_status: u32 = memory_load_u32(prototype + 28);
  if invoke_status != 0 {
    if status_prototype != 0 {
      memory_store_u32(status_prototype + 28, invoke_status);
    }
    return 0;
  }
  if status_prototype != 0 {
    memory_store_u32(status_prototype + 56, execute_result_count(prototype));
    memory_store_u32(status_prototype + 60, prototype);
  }
  return execute_result(prototype);
}

export fn vm_bind_parameters(stack: u32, argument_base: u32, local_base: u32, parameters: u32, count: u32) -> u32 {
  let mut current: u32 = parameters;
  let mut index: u32 = 0;
  let mut status: u32 = 0;
  while current != 0 && index < count {
    let argument_index: u32 = argument_base + index;
    let argument: u32 = memory_load_u32(stack + argument_index * 4);
    status = vm_store_local(local_base, memory_load_u32(current + 4), argument);
    if status != 0 {
      return status;
    }
    current = memory_load_u32(current + 8);
    index = index + 1;
  }
  return status;
}

export fn vm_store_varargs(stack: u32, argument_base: u32, count: u32, local_base: u32) -> unit {
  memory_store_u32(vm_local_vararg_count_address(local_base), count);
  let mut index: u32 = 0;
  while index < count {
    let argument_index: u32 = argument_base + index;
    let value: u32 = memory_load_u32(stack + argument_index * 4);
    memory_store_u32(vm_local_vararg_value_address(local_base, index), value);
    index = index + 1;
  }
}

export fn vm_push_varargs(prototype: u32, stack: u32, depth: u32, local_base: u32) -> u32 {
  let count: u32 = memory_load_u32(vm_local_vararg_count_address(local_base));
  if depth + count > 64 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return depth;
  }
  let mut index: u32 = 0;
  while index < count {
    let value: u32 = memory_load_u32(vm_local_vararg_value_address(local_base, index));
    let destination: u32 = depth + index;
    memory_store_u32(stack + destination * 4, value);
    index = index + 1;
  }
  return depth + count;
}

export fn vm_adjust_results(prototype: u32, stack: u32, depth: u32, expected_count: u32, actual_count: u32) -> u32 {
  if expected_count == 255 {
    return depth;
  }
  let base: u32 = depth - actual_count;
  let mut index: u32 = actual_count;
  while index < expected_count {
    let destination: u32 = base + index;
    if destination >= 64 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
    memory_store_u32(stack + destination * 4, 0);
    index = index + 1;
  }
  return base + expected_count;
}

fn vm_integer_number(value: u32) -> f64 {
  let number: f64 = f64_from_u32(value);
  let mut boundary: u32 = 2;
  let mut steps: u32 = 30;
  while steps != 0 {
    boundary = boundary + boundary;
    steps = steps - 1;
  }
  if value >= boundary {
    return number - f64_from_u32(boundary) - f64_from_u32(boundary);
  }
  return number;
}

fn vm_integer_is_negative(value: u32) -> u32 {
  let mut boundary: u32 = 2;
  let mut steps: u32 = 30;
  while steps != 0 {
    boundary = boundary + boundary;
    steps = steps - 1;
  }
  if value >= boundary {
    return 1;
  }
  return 0;
}

fn vm_integer_absolute(value: u32) -> u32 {
  if vm_integer_is_negative(value) == 1 {
    let zero: u32 = value - value;
    return zero - value;
  }
  return value;
}

fn vm_integer_floor_division(left: u32, right: u32) -> u32 {
  let left_negative: u32 = vm_integer_is_negative(left);
  let right_negative: u32 = vm_integer_is_negative(right);
  let left_absolute: u32 = vm_integer_absolute(left);
  let right_absolute: u32 = vm_integer_absolute(right);
  let mut quotient: u32 = left_absolute / right_absolute;
  let remainder: u32 = left_absolute % right_absolute;
  if left_negative != right_negative && remainder != 0 {
    quotient = quotient + 1;
  }
  if left_negative != right_negative {
    let zero: u32 = quotient - quotient;
    return zero - quotient;
  }
  return quotient;
}

fn vm_numeric_number(value: u32) -> f64 {
  let kind: u32 = value.value_kind(value);
  if vm_is_float(value) == 1 {
    return value.value_float_number(value);
  }
  if kind == 2 {
    return vm_integer_number(value.value_payload(value));
  }
  return vm_integer_number(value);
}

fn vm_floor_number(input: u32) -> u32 {
  let kind: u32 = value.value_kind(input);
  if kind == 2 {
    return value.value_payload(input);
  }
  if kind != 3 {
    return input;
  }
  let mut number: f64 = vm_numeric_number(input);
  let mut negative: u32 = 0;
  if number < f64_from_u32(0) {
    negative = negative + 1;
    number = f64_from_u32(0) - number;
  }
  let mut whole: u32 = 0;
  while number >= f64_from_u32(1) && whole < 16777216 {
    number = number - f64_from_u32(1);
    whole = whole + 1;
  }
  if negative == 1 && number != f64_from_u32(0) {
    return whole - whole - whole - 1;
  }
  if negative == 1 {
    return whole - whole - whole;
  }
  return whole;
}

fn vm_is_float(value: u32) -> u32 {
  if value.value_kind(value) == 3 {
    return 1;
  }
  return 0;
}

fn vm_float_positive_remainder(left: f64, right: f64) -> f64 {
  let mut remainder: f64 = left;
  let mut multiple: f64 = right;
  let two: f64 = f64_from_u32(2);
  let mut scale_steps: u32 = 64;
  while scale_steps != 0 && multiple + multiple <= remainder {
    multiple = multiple + multiple;
    scale_steps = scale_steps - 1;
  }
  let mut reduce_steps: u32 = 64;
  while reduce_steps != 0 && multiple >= right {
    if multiple <= remainder {
      remainder = remainder - multiple;
    }
    multiple = multiple / two;
    reduce_steps = reduce_steps - 1;
  }
  let mut tolerance: f64 = right;
  let mut tolerance_steps: u32 = 48;
  while tolerance_steps != 0 {
    tolerance = tolerance / two;
    tolerance_steps = tolerance_steps - 1;
  }
  if remainder < tolerance || right - remainder < tolerance {
    return f64_from_u32(0);
  }
  return remainder;
}

fn vm_float_remainder(left: f64, right: f64) -> f64 {
  let mut left_value: f64 = left;
  let mut right_value: f64 = right;
  let mut left_negative: u32 = 0;
  let mut right_negative: u32 = 0;
  if left_value < f64_from_u32(0) {
    left_value = f64_from_u32(0) - left_value;
    left_negative = left_negative + 1;
  }
  if right_value < f64_from_u32(0) {
    right_value = f64_from_u32(0) - right_value;
    right_negative = right_negative + 1;
  }
  let remainder: f64 = vm_float_positive_remainder(left_value, right_value);
  if remainder == f64_from_u32(0) {
    return remainder;
  }
  if right_negative == 1 {
    return f64_from_u32(0) - remainder;
  }
  if left_negative == 1 {
    return right_value - remainder;
  }
  return remainder;
}

fn vm_float_floor_division(left: f64, right: f64) -> f64 {
  let remainder: f64 = vm_float_remainder(left, right);
  let quotient: f64 = left - remainder;
  return quotient / right;
}

fn vm_numeric_min_value(left: u32, right: u32) -> u32 {
  if vm_numeric_number(left) <= vm_numeric_number(right) {
    return left;
  }
  return right;
}

fn vm_numeric_max_value(left: u32, right: u32) -> u32 {
  if vm_numeric_number(left) >= vm_numeric_number(right) {
    return left;
  }
  return right;
}


fn vm_float_arithmetic(opcode: u32, left: f64, right: f64) -> f64 {
  if opcode == 2 {
    return left + right;
  }
  if opcode == 3 {
    return left - right;
  }
  if opcode == 4 {
    return left * right;
  }
  return left / right;
}

fn vm_float_power(left: f64, right: f64) -> f64 {
  let mut remaining: f64 = right;
  let mut reciprocal: u32 = 0;
  let zero: f64 = f64_from_u32(0);
  let one: f64 = f64_from_u32(1);
  if remaining < zero {
    reciprocal = reciprocal + 1;
    remaining = zero - remaining;
  }
  let mut power_result: f64 = one;
  while remaining >= one {
    power_result = power_result * left;
    remaining = remaining - one;
  }
  if reciprocal == 1 {
    return one / power_result;
  }
  return power_result;
}

fn vm_float_comparison(opcode: u32, left: f64, right: f64) -> u32 {
  if opcode == 14 {
    if left < right {
      return vm_true();
    }
  }
  if opcode == 15 {
    if left > right {
      return vm_true();
    }
  }
  if opcode == 16 {
    if left == right {
      return vm_true();
    }
  }
  if opcode == 17 {
    if left != right {
      return vm_true();
    }
  }
  if opcode == 18 {
    if left <= right {
      return vm_true();
    }
  }
  if opcode == 19 {
    if left >= right {
      return vm_true();
    }
  }
  return 0;
}

fn vm_string_comparison(opcode: u32, left: u32, right: u32) -> u32 {
  let mut left_string: u32 = left;
  let mut right_string: u32 = right;
  if value.value_kind(left) == 4 {
    left_string = value.value_payload(left);
  }
  if value.value_kind(right) == 4 {
    right_string = value.value_payload(right);
  }
  let equal: u32 = string.string_equal(left_string, right_string);
  if opcode == 16 {
    return equal;
  }
  if equal == 0 {
    return vm_true();
  }
  return 0;
}

fn vm_binary_metafield(opcode: u32) -> u32 {
  if opcode == 2 {
    return vm_hash_add();
  }
  if opcode == 3 {
    return vm_hash_sub();
  }
  if opcode == 4 {
    return vm_hash_mul();
  }
  if opcode == 5 {
    return vm_hash_div();
  }
  if opcode == 71 {
    return vm_hash_idiv();
  }
  if opcode == 77 {
    return vm_hash_pow();
  }
  if opcode == 14 || opcode == 15 {
    return vm_hash_lt();
  }
  if opcode == 16 || opcode == 17 {
    return vm_hash_eq();
  }
  if opcode == 18 || opcode == 19 {
    return vm_hash_le();
  }
  if opcode == 26 {
    return vm_hash_mod();
  }
  if opcode == 27 {
    return vm_hash_band();
  }
  if opcode == 28 {
    return vm_hash_bor();
  }
  if opcode == 29 {
    return vm_hash_bxor();
  }
  if opcode == 30 {
    return vm_hash_shl();
  }
  if opcode == 31 {
    return vm_hash_shr();
  }
  return 0;
}

export fn vm_binary_opcode(prototype: u32, opcode: u32, stack: u32, depth: u32) -> u32 {
  if depth < 2 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return depth;
  }
  let right: u32 = memory_load_u32(vm_stack_address(stack, depth - 1));
  let left: u32 = memory_load_u32(vm_stack_address(stack, depth - 2));
  let heap: u32 = memory_load_u32(prototype + 48);
  if opcode == 73 {
    if left == 0 {
      memory_store_u32(vm_stack_address(stack, depth - 2), left);
    } else {
      memory_store_u32(vm_stack_address(stack, depth - 2), right);
    }
    return depth - 1;
  }
  if opcode == 74 {
    if left == 0 {
      memory_store_u32(vm_stack_address(stack, depth - 2), right);
    } else {
      memory_store_u32(vm_stack_address(stack, depth - 2), left);
    }
    return depth - 1;
  }
  let mut metamethod: u32 = vm_table_metafield(left, vm_binary_metafield(opcode));
  if metamethod == 0 {
    metamethod = vm_table_metafield(right, vm_binary_metafield(opcode));
  }
  if metamethod != 0 && memory_load_u32(metamethod) == 3 {
    let mut first: u32 = left;
    let mut second: u32 = right;
    if opcode == 15 || opcode == 19 {
      first = right;
      second = left;
    }
    let mut computed: u32 = vm_invoke_callable(heap, metamethod, first, second, 0, 2, 0);
    if opcode == 17 {
      if computed == 0 {
        computed = vm_true();
      } else {
        computed = computed - computed;
      }
    }
    memory_store_u32(vm_stack_address(stack, depth - 2), computed);
    return depth - 1;
  }
  let mut float_operation: u32 = 0;
  if opcode == 5 || opcode == 77 {
    float_operation = float_operation + 1;
  } else {
    if vm_is_float(left) == 1 || vm_is_float(right) == 1 {
      float_operation = float_operation + 1;
    }
  }
  let mut computed: u32 = 0;
  let mut computed_float: f64 = f64_from_u32(0);
  let mut string_operation: u32 = 0;
  if opcode == 16 || opcode == 17 {
    if vm_is_string_comparison_value(left) == 1 {
      if vm_is_string_comparison_value(right) == 1 {
        string_operation = string_operation + 1;
      }
    }
  }
  if string_operation == 1 {
    computed = vm_string_comparison(opcode, left, right);
  } else {
    if float_operation == 1 {
      let left_number: f64 = vm_numeric_number(left);
      let right_number: f64 = vm_numeric_number(right);
      if opcode == 77 {
        computed_float = vm_float_power(left_number, right_number);
      } else {
      if opcode <= 5 {
        if opcode == 5 && right_number == f64_from_u32(0) {
          memory_store_u32(prototype + 28, vm_division_error());
        } else {
          computed_float = vm_float_arithmetic(opcode, left_number, right_number);
        }
      } else {
        if opcode == 71 {
          if right_number == f64_from_u32(0) {
            memory_store_u32(prototype + 28, vm_division_error());
          } else {
            computed_float = vm_float_floor_division(left_number, right_number);
          }
        } else {
          if opcode == 26 {
            if right_number == f64_from_u32(0) {
              memory_store_u32(prototype + 28, vm_division_error());
            } else {
              computed_float = vm_float_remainder(left_number, right_number);
            }
          } else {
            computed = vm_float_comparison(opcode, left_number, right_number);
          }
        }
      }
      }
    } else {
      if opcode == 2 {
        computed = left + right;
      } else {
        if opcode == 3 {
          computed = left - right;
        } else {
          if opcode == 4 {
            computed = left * right;
          } else {
            if opcode == 5 {
              if right == 0 {
                memory_store_u32(prototype + 28, vm_division_error());
              } else {
                computed = left / right;
              }
            } else {
              if opcode == 71 || opcode == 77 {
                let left_integer: u32 = vm_builtin_integer(left);
                let right_integer: u32 = vm_builtin_integer(right);
                if right_integer == 0 {
                  memory_store_u32(prototype + 28, vm_division_error());
                } else {
                  computed = vm_integer_floor_division(left_integer, right_integer);
                }
              } else {
                if opcode == 14 {
                  if left < right {
                    computed = vm_true();
                  }
                } else {
                  if opcode == 15 {
                    if left > right {
                      computed = vm_true();
                    }
                  } else {
                    if opcode == 16 {
                      if left == right {
                        computed = vm_true();
                      }
                    } else {
                      if opcode == 17 {
                        if left != right {
                          computed = vm_true();
                        }
                      } else {
                        if opcode == 18 {
                          if left <= right {
                            computed = vm_true();
                          }
                        } else {
                          if opcode == 19 {
                            if left >= right {
                              computed = vm_true();
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  if float_operation == 0 {
    if computed == 0 {
      let mut should_box_zero: u32 = 0;
      if opcode >= 2 {
        if opcode <= 5 {
          should_box_zero = should_box_zero + 1;
        } else {
          if opcode == 71 || opcode == 77 {
            should_box_zero = should_box_zero + 1;
          }
        }
      }
      if should_box_zero == 1 {
        if value.value_kind(left) == 2 || value.value_kind(right) == 2 {
          computed = value.value_integer(0);
        }
      }
    }
  }
  if memory_load_u32(prototype + 28) != 0 {
    return depth;
  }
  if float_operation == 1 {
    let mut should_box: u32 = 0;
    if opcode >= 2 {
      if opcode <= 5 {
        should_box = should_box + 1;
      } else {
        if opcode == 26 {
          should_box = should_box + 1;
        } else {
          if opcode == 71 || opcode == 77 {
            should_box = should_box + 1;
          }
        }
      }
    }
    if should_box == 1 {
      computed = value.value_float_new(heap, computed_float);
      if computed == 0 {
        memory_store_u32(prototype + 28, vm_stack_error());
        return depth;
      }
    }
  }
  memory_store_u32(vm_stack_address(stack, depth - 2), computed);
  return depth - 1;
}

export fn vm_bitwise_opcode(prototype: u32, opcode: u32, stack: u32, depth: u32) -> u32 {
  if depth < 2 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return depth;
  }
  let right: u32 = memory_load_u32(vm_stack_address(stack, depth - 1));
  let left: u32 = memory_load_u32(vm_stack_address(stack, depth - 2));
  let mut computed: u32 = 0;
  let mut computed_float: f64 = f64_from_u32(0);
  let mut float_operation: u32 = 0;
  if opcode == 26 {
    if vm_is_float(left) == 1 || vm_is_float(right) == 1 {
      float_operation = float_operation + 1;
      let right_number: f64 = vm_numeric_number(right);
      if right_number == f64_from_u32(0) {
        memory_store_u32(prototype + 28, vm_division_error());
      } else {
        computed_float = vm_float_remainder(vm_numeric_number(left), right_number);
      }
    } else {
      if right == 0 {
        memory_store_u32(prototype + 28, vm_division_error());
      } else {
        computed = vm_remainder(left, right);
      }
    }
  } else {
    if opcode == 27 {
      computed = vm_bit_and(left, right);
    } else {
      if opcode == 28 {
        computed = vm_bit_or(left, right);
      } else {
        if opcode == 29 {
          computed = vm_bit_xor(left, right);
        } else {
          if opcode == 30 {
            computed = vm_shift_left(left, right);
          } else {
            computed = vm_shift_right(left, right);
          }
        }
      }
    }
  }
  if memory_load_u32(prototype + 28) != 0 {
    return depth;
  }
  if float_operation == 1 {
    computed = value.value_float_new(memory_load_u32(prototype + 48), computed_float);
    if computed == 0 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return depth;
    }
  }
  memory_store_u32(vm_stack_address(stack, depth - 2), computed);
  return depth - 1;
}

fn vm_execute_stack_opcode(prototype: u32, heap: u32, stack: u32, local_base: u32, upvalue: u32, capture: u32, scope_depth: u32, stack_depth: u32, opcode: u32, operand: u32) -> u32 {
  let mut depth: u32 = stack_depth;
  let mut scope: u32 = scope_depth;
  if opcode == 1 || opcode == 53 {
    if depth < 64 {
      let mut pushed: u32 = operand;
      if opcode == 53 { pushed = value.value_float_new(heap, memory_load_f64(operand)); }
      if opcode != 53 || pushed != 0 { memory_store_u32(stack + depth * 4, pushed); depth = depth + 1; }
      else { memory_store_u32(prototype + 28, vm_stack_error()); }
    } else { memory_store_u32(prototype + 28, vm_stack_error()); }
  }
  if opcode == 20 {
    if depth < 64 { memory_store_u32(stack + depth * 4, vm_load_local_or_global_with_capture(heap, local_base, scope, upvalue, capture, operand)); depth = depth + 1; }
    else { memory_store_u32(prototype + 28, vm_stack_error()); }
  }
  if opcode == 21 {
    if depth == 0 { memory_store_u32(prototype + 28, vm_stack_error()); }
    else { let assigned: u32 = memory_load_u32(vm_stack_address(stack, depth - 1)); depth = depth - 1; memory_store_u32(prototype + 28, vm_store_local_or_global_with_capture(heap, local_base, scope, upvalue, capture, operand, assigned)); }
  }
  if opcode == 51 {
    if depth == 0 { memory_store_u32(prototype + 28, vm_stack_error()); }
    else { let declared: u32 = memory_load_u32(vm_stack_address(stack, depth - 1)); depth = depth - 1; memory_store_u32(prototype + 28, vm_declare_local_at_scope(local_base, operand, declared, scope)); }
  }
  if opcode == 22 { memory_store_u32(prototype + 24, operand - 1); }
  if opcode == 23 {
    if depth == 0 { memory_store_u32(prototype + 28, vm_stack_error()); }
    else { let condition: u32 = memory_load_u32(vm_stack_address(stack, depth - 1)); depth = depth - 1; if condition == 0 { memory_store_u32(prototype + 24, operand - 1); } }
  }
  if opcode == 75 {
    if scope >= 31 { memory_store_u32(prototype + 28, vm_stack_error()); }
    else { scope = scope + 1; memory_store_u32(vm_scope_stack_address(local_base, scope), operand); }
  }
  if opcode == 76 { if scope != 0 { scope = scope - 1; } }
  memory_store_u32(prototype + 16, depth);
  return depth + scope * 1000;
}

fn vm_result_value(input: u32) -> u32 {
  if input < 1024 || input >= 16777216 { return input; }
  let kind: u32 = memory_load_u32(input);
  if kind == 1 { return value.value_table(input); }
  if kind == 2 { return value.value_string(input); }
  if kind == 3 { return value.value_function(input); }
  return input;
}

export fn execute_result(prototype: u32) -> u32 { return memory_load_u32(prototype + 12); }
export fn execute_result_count(prototype: u32) -> u32 {
  if prototype == 0 { return 0; }
  return memory_load_u32(prototype + 88);
}
export fn execute_result_value(prototype: u32, index: u32) -> u32 {
  if prototype == 0 { return 0; }
  let count: u32 = memory_load_u32(prototype + 88);
  if index >= count { return 0; }
  let stack: u32 = memory_load_u32(prototype + 20);
  if stack == 0 { return 0; }
  return vm_result_value(memory_load_u32(stack + index * 4));
}

export fn execute(prototype: u32) -> unit {
  if prototype == 0 {
    return;
  }
  let resuming: u32 = memory_load_u32(prototype + 80);
  if resuming == 0 {
    if memory_load_u32(prototype) != 0 {
      return;
    }
  }
  let heap: u32 = memory_load_u32(prototype + 48);
  let mut code: u32 = memory_load_u32(prototype + 4);
  let mut count: u32 = memory_load_u32(prototype + 8);
  let mut stack: u32 = memory_load_u32(prototype + 20);
  let mut local_base: u32 = stack + 256;
  let mut frame: u32 = 0;
  let mut upvalue: u32 = memory_load_u32(prototype + 88);
  let mut capture: u32 = memory_load_u32(prototype + 92);
  let mut scope_depth: u32 = 0;
  let one: u32 = 1;
  let mut stack_depth: u32 = 0;
  if resuming == 1 {
    code = memory_load_u32(prototype + 60);
    count = memory_load_u32(prototype + 64);
    local_base = memory_load_u32(prototype + 68);
    frame = memory_load_u32(prototype + 72);
    upvalue = memory_load_u32(prototype + 76);
    capture = memory_load_u32(prototype + 92);
    scope_depth = memory_load_u32(prototype + 84);
    stack_depth = memory_load_u32(prototype + 16);
    memory_store_u32(prototype + 80, 0);
    memory_store_u32(prototype + 28, 0);
    memory_store_u32(prototype, 0);
  } else {
    if stack == 0 {
      stack = memory_alloc(1024);
    }
    local_base = stack + 256;
    memory_store_u32(prototype + 20, stack);
    memory_store_u32(prototype + 24, 0);
    memory_store_u32(prototype + 28, 0);
    memory_store_u32(prototype + 52, 0);
    memory_store_u32(prototype + 56, 0);
    memory_store_u32(prototype + 16, stack_depth);
    vm_clear_locals(local_base);
  }
  while true {
    if vm_is_running(memory_load_u32(prototype + 24), count, memory_load_u32(prototype + 28)) != 1 {
      memory_store_u32(prototype, memory_load_u32(prototype + 28));
      return;
    }
    let pc: u32 = memory_load_u32(prototype + 24);
    let instruction_address: u32 = code + pc * 8;
    let opcode: u32 = memory_load_u32(instruction_address);
    let operand: u32 = memory_load_u32(instruction_address + 4);
    let mut advance: u32 = 1;
    if opcode == 47 {
      memory_store_u32(prototype + 52, operand);
    } else {
      if opcode == 6 {
        let mut return_value: u32 = 0;
        if stack_depth != 0 {
          return_value = memory_load_u32(vm_stack_address(stack, stack_depth - 1));
        }
        if frame == 0 {
          memory_store_u32(prototype + 12, return_value);
          memory_store_u32(prototype + 88, stack_depth);
          memory_store_u32(prototype + 24, count);
        } else {
          let mut saved_frame: u32 = frame;
          code = memory_load_u32(saved_frame);
          count = memory_load_u32(saved_frame + 4);
          let return_pc: u32 = memory_load_u32(saved_frame + 8);
          local_base = memory_load_u32(saved_frame + 12);
          let caller_top: u32 = memory_load_u32(saved_frame + 16);
          frame = memory_load_u32(saved_frame + 20);
          upvalue = memory_load_u32(saved_frame + 24);
          capture = memory_load_u32(saved_frame + 28);
          scope_depth = memory_load_u32(saved_frame + 32);
          memory_store_u32(prototype + 56, stack_depth - caller_top);
          memory_store_u32(prototype + 16, stack_depth);
          advance = advance - advance;
          memory_store_u32(prototype + 24, return_pc);
        }
      } else {
        if opcode == 1 || opcode == 53 || opcode == 20 || opcode == 21 || opcode == 51 || opcode == 22 || opcode == 23 || opcode == 75 || opcode == 76 {
          let packed_state: u32 = vm_execute_stack_opcode(prototype, heap, stack, local_base, upvalue, capture, scope_depth, stack_depth, opcode, operand);
          stack_depth = packed_state - packed_state / 1000 * 1000;
          scope_depth = packed_state / 1000;
        } else {
                    if opcode == 24 {
                      if stack_depth == 0 {
                        memory_store_u32(prototype + 28, vm_stack_error());
                      } else {
                        stack_depth = stack_depth - 1;
                        memory_store_u32(prototype + 16, stack_depth);
                      }
                    } else {
                      if opcode == 25 || opcode == 66 || opcode == 69 {
                        let argument_count: u32 = memory_load_u32(prototype + 52);
                        let mut callable: u32 = 0;
                        if opcode == 69 {
                          if stack_depth == 0 || stack_depth <= argument_count {
                            memory_store_u32(prototype + 28, vm_stack_error());
                          } else {
                            let callable_index: u32 = stack_depth - argument_count - 1;
                            callable = memory_load_u32(
                              vm_stack_address(stack, callable_index),
                            );
                            let mut shifting: u32 = callable_index;
                            while shifting + 1 < stack_depth {
                              memory_store_u32(
                                vm_stack_address(stack, shifting),
                                memory_load_u32(vm_stack_address(stack, shifting + 1)),
                              );
                              shifting = shifting + 1;
                            }
                            stack_depth = stack_depth - 1;
                            memory_store_u32(prototype + 16, stack_depth);
                          }
                        } else {
                          callable = vm_load_local_or_global_with_capture(heap, local_base, scope_depth, upvalue, capture, operand);
                        }
                        callable = vm_callable_handle(callable);
                        let mut function_record: u32 = 0;
                        let mut callee_upvalue: u32 = 0;
                        let mut callee_capture: u32 = 0;
                        let mut is_vararg: u32 = 0;
                        if callable != 0 {
                          if memory_load_u32(callable) == 3 {
                            function_record = closure.closure_function(callable);
                            callee_upvalue = closure.closure_upvalue(callable);
                            callee_capture = memory_load_u32(callable + 20);
                            is_vararg = memory_load_u32(function_record + 24);
                          } else {
                            if vm_is_function_record(callable) == 1 {
                              function_record = callable;
                              is_vararg = memory_load_u32(function_record + 24);
                            } else {
                              function_record = vm_find_function(memory_load_u32(prototype + 32), operand);
                              if function_record != 0 {
                                is_vararg = memory_load_u32(function_record + 24);
                              }
                            }
                          }
                        } else {
                          function_record = vm_find_function(memory_load_u32(prototype + 32), operand);
                          if function_record != 0 {
                            is_vararg = memory_load_u32(function_record + 24);
                          }
                        }
                        if function_record == 0 {
                          memory_store_u32(prototype + 28, vm_stack_error());
                        } else {
                          if memory_load_u32(function_record + 28) == 2 {
                            vm_publish_dynamic_functions(heap, memory_load_u32(function_record + 20));
                          }
                          memory_store_u32(prototype + 56, 0);
                          let mut builtin_handled: u32 = 0;
                          if operand == vm_hash_setmetatable() || operand == vm_hash_getmetatable() {
                            builtin_handled = argument_count - argument_count + 1;
                            let mut builtin: u32 = argument_count - argument_count;
                            if operand == vm_hash_setmetatable() {
                              builtin = argument_count - argument_count + 1;
                            }
                            if operand == vm_hash_getmetatable() {
                              builtin = argument_count - argument_count + 2;
                            }
                            let mut builtin_base: u32 = 0;
                            if stack_depth >= argument_count {
                              builtin_base = stack_depth - argument_count;
                            }
                            stack_depth = vm_builtin_call(
                              prototype,
                              builtin,
                              heap,
                              stack,
                              stack_depth,
                              argument_count,
                            );
                            memory_store_u32(prototype + 16, stack_depth);
                            if stack_depth >= builtin_base {
                              memory_store_u32(prototype + 56, stack_depth - builtin_base);
                            }
                          }
                          if memory_load_u32(function_record + 28) >= 3 {
                            builtin_handled = argument_count - argument_count + 1;
                            let mut builtin_base: u32 = 0;
                            if stack_depth >= argument_count {
                              builtin_base = stack_depth - argument_count;
                            }
                            stack_depth = vm_builtin_call(
                              prototype,
                              memory_load_u32(function_record + 28),
                              heap,
                              stack,
                              stack_depth,
                              argument_count,
                            );
                            memory_store_u32(prototype + 16, stack_depth);
                            if stack_depth >= builtin_base {
                              memory_store_u32(prototype + 56, stack_depth - builtin_base);
                            }
                          }
                          if builtin_handled == 0 {
                          if memory_load_u32(prototype + 56) == 0 {
                            let arity: u32 = memory_load_u32(function_record + 16);
                            let argument_base: u32 = stack_depth - argument_count;
                            let callee_local: u32 = memory_alloc(768);
                            if callee_local == 0 {
                              memory_store_u32(prototype + 28, vm_stack_error());
                            } else {
                              vm_clear_locals(callee_local);
                              let mut bind_count: u32 = argument_count;
                              if bind_count > arity {
                                bind_count = arity;
                              }
                              let bind_status: u32 = vm_bind_parameters(stack, argument_base, callee_local, memory_load_u32(function_record + 12), bind_count);
                              if bind_status != 0 {
                                memory_store_u32(prototype + 28, bind_status);
                              } else {
                                let mut vararg_count: u32 = 0;
                                if is_vararg == 1 {
                                  if argument_count > arity {
                                    vararg_count = argument_count - arity;
                                  }
                                }
                                vm_store_varargs(stack, argument_base + arity, vararg_count, callee_local);
                                if opcode == 66 {
                                  code = memory_load_u32(function_record + 4);
                                  count = memory_load_u32(function_record + 8);
                                  local_base = callee_local;
                                  upvalue = callee_upvalue;
                                  capture = callee_capture;
                                  scope_depth = one - one;
                                  stack_depth = argument_base;
                                  memory_store_u32(prototype + 52, 0);
                                  memory_store_u32(prototype + 16, stack_depth);
                                  advance = advance - advance;
                                  memory_store_u32(prototype + 24, 0);
                                } else {
                                  let saved_frame: u32 = memory_alloc(36);
                                  if saved_frame == 0 {
                                    memory_store_u32(prototype + 28, vm_stack_error());
                                  } else {
                                    memory_store_u32(saved_frame, code);
                                    memory_store_u32(saved_frame + 4, count);
                                    memory_store_u32(saved_frame + 8, memory_load_u32(prototype + 24) + 1);
                                    memory_store_u32(saved_frame + 12, local_base);
                                    memory_store_u32(saved_frame + 16, argument_base);
                                    memory_store_u32(saved_frame + 20, frame);
                                    memory_store_u32(saved_frame + 24, upvalue);
                                    memory_store_u32(saved_frame + 28, capture);
                                    memory_store_u32(saved_frame + 32, scope_depth);
                                    frame = saved_frame;
                                    code = memory_load_u32(function_record + 4);
                                    count = memory_load_u32(function_record + 8);
                                    local_base = callee_local;
                                    upvalue = callee_upvalue;
                                    capture = callee_capture;
                                    scope_depth = one - one;
                                    stack_depth = argument_base;
                                    memory_store_u32(prototype + 52, 0);
                                    memory_store_u32(prototype + 16, stack_depth);
                                    advance = advance - advance;
                                    memory_store_u32(prototype + 24, 0);
                                  }
                                }
                              }
                            }
                          }
                          }
                        }
                      } else {
                      if vm_is_binary(opcode) == 1 {
                        if opcode < 26 || opcode == 71 || opcode == 77 {
                          stack_depth = vm_binary_opcode(prototype, opcode, stack, stack_depth);
                          memory_store_u32(prototype + 16, stack_depth);
                        } else {
                          if opcode == 73 {
                            stack_depth = vm_binary_opcode(prototype, opcode, stack, stack_depth);
                            memory_store_u32(prototype + 16, stack_depth);
                          } else {
                            if opcode == 74 {
                              stack_depth = vm_binary_opcode(prototype, opcode, stack, stack_depth);
                              memory_store_u32(prototype + 16, stack_depth);
                            }
                          }
                        }
                      } else {
                        if opcode == 46 {
                          if stack_depth >= 64 {
                            memory_store_u32(prototype + 28, vm_stack_error());
                          } else {
                            let closure_handle: u32 = closure.closure_new(heap, operand, local_base);
                            if closure_handle == 0 {
                              memory_store_u32(prototype + 28, vm_stack_error());
                            } else {
                              let closure_capture: u32 = vm_capture_new(local_base, scope_depth, upvalue, capture);
                              if closure_capture == 0 {
                                memory_store_u32(prototype + 28, vm_stack_error());
                              } else {
                                memory_store_u32(closure_handle + 20, closure_capture);
                              memory_store_u32(vm_stack_address(stack, stack_depth), closure_handle);
                              stack_depth = stack_depth + 1;
                              memory_store_u32(prototype + 16, stack_depth);
                              }
                            }
                          }
                        } else {
                          if vm_is_bitwise_opcode(opcode) == 1 {
                            stack_depth = vm_bitwise_opcode(prototype, opcode, stack, stack_depth);
                            memory_store_u32(prototype + 16, stack_depth);
                          } else {
                            if vm_is_table_opcode(opcode) == 1 {
                              stack_depth = vm_table_opcode(prototype, opcode, heap, stack, stack_depth);
                              memory_store_u32(prototype + 16, stack_depth);
                            } else {
                              if vm_is_string_opcode(opcode) == 1 {
                                stack_depth = vm_string_opcode(prototype, opcode, operand, heap, stack, stack_depth);
                                memory_store_u32(prototype + 16, stack_depth);
                              } else {
                                if opcode == 48 {
                                  let before_varargs: u32 = stack_depth;
                                  stack_depth = vm_push_varargs(prototype, stack, stack_depth, local_base);
                                  memory_store_u32(prototype + 56, stack_depth - before_varargs);
                                  memory_store_u32(prototype + 16, stack_depth);
                                } else {
                                  if opcode == 49 {
                                    let actual_count: u32 = memory_load_u32(prototype + 56);
                                    stack_depth = vm_adjust_results(prototype, stack, stack_depth, operand, actual_count);
                                    if memory_load_u32(prototype + 28) == 0 {
                                      memory_store_u32(prototype + 56, operand);
                                    }
                                    memory_store_u32(prototype + 16, stack_depth);
                                  } else {
                                    if opcode == 7 {
                                      if stack_depth == 0 {
                                        memory_store_u32(prototype + 28, vm_stack_error());
                                      } else {
                                        let value: u32 = memory_load_u32(vm_stack_address(stack, stack_depth - 1));
                                        let negated: u32 = vm_negate_numeric(heap, value);
                                        if negated == 0 && vm_is_float(value) == 1 {
                                          memory_store_u32(prototype + 28, vm_stack_error());
                                        } else {
                                          memory_store_u32(vm_stack_address(stack, stack_depth - 1), negated);
                                        }
                                      }
                                    } else {
                                    if opcode == 33 {
                                      if stack_depth == 0 {
                                        memory_store_u32(prototype + 28, vm_stack_error());
                                      } else {
                                        let value: u32 = memory_load_u32(vm_stack_address(stack, stack_depth - 1));
                                        if value == 0 {
                                          memory_store_u32(vm_stack_address(stack, stack_depth - 1), 1);
                                        } else {
                                          memory_store_u32(vm_stack_address(stack, stack_depth - 1), 0);
                                        }
                                      }
                                    } else {
                                    if opcode == 8 {
                                        memory_store_u32(prototype + 28, vm_division_error());
                                        memory_store_u32(prototype + 24, count);
                                      } else {
                                        if opcode == 32 {
                                          if stack_depth == 0 {
                                            memory_store_u32(prototype + 28, vm_stack_error());
                                          } else {
                                            let value: u32 = memory_load_u32(vm_stack_address(stack, stack_depth - 1));
                                            memory_store_u32(vm_stack_address(stack, stack_depth - 1), vm_bit_not(value));
                                          }
                                        } else {
                                          if opcode == 50 {
                                            let mut yield_value: u32 = 0;
                                            if stack_depth != 0 {
                                              yield_value = memory_load_u32(vm_stack_address(stack, stack_depth - 1));
                                              stack_depth = stack_depth - 1;
                                            }
                                            memory_store_u32(prototype + 84, yield_value);
                                            memory_store_u32(prototype + 12, yield_value);
                                            memory_store_u32(prototype + 60, code);
                                            memory_store_u32(prototype + 64, count);
                                            memory_store_u32(prototype + 68, local_base);
                                            memory_store_u32(prototype + 72, frame);
                                            memory_store_u32(prototype + 76, upvalue);
                                            memory_store_u32(prototype + 84, scope_depth);
                                            memory_store_u32(prototype + 92, capture);
                                            memory_store_u32(prototype + 16, stack_depth);
                                            memory_store_u32(prototype + 24, memory_load_u32(prototype + 24) + 1);
                                            memory_store_u32(prototype + 80, 1);
                                            memory_store_u32(prototype + 28, 0);
                                            memory_store_u32(prototype, 5);
                                            return;
                                          } else {
                                            memory_store_u32(prototype + 28, vm_stack_error());
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                    }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    }
    }
    memory_store_u32(prototype + 24, memory_load_u32(prototype + 24) + advance);
  }
  memory_store_u32(prototype, memory_load_u32(prototype + 28));
  return;
}

