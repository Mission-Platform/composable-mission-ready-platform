fn vm_file_key(kind: u32) -> u32 {
  if kind == 1 {
    return vm_hash_name(119, 114, 105, 116, 101, 0, 0, 0, 0, 0, 0, 0);
  }
  if kind == 2 {
    return vm_hash_name(114, 101, 97, 100, 0, 0, 0, 0, 0, 0, 0, 0);
  }
  if kind == 3 {
    return vm_hash_name(99, 108, 111, 115, 101, 0, 0, 0, 0, 0, 0, 0);
  }
  if kind == 4 {
    return 1001;
  }
  if kind == 5 {
    return 1002;
