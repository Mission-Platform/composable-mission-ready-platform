fn vm_is_function_record(input: u32) -> u32 {
  if input < 1024 || input >= 16777216 {
    return 0;
  }
  let code: u32 = memory_load_u32(input + 4);
  let instruction_count: u32 = memory_load_u32(input + 8);
  if code != 0 && instruction_count != 0 {
    return 1;
  }
  if code == 0 && instruction_count == 0 && memory_load_u32(input + 12) == 0 {
    if memory_load_u32(input + 24) == 1 || memory_load_u32(input + 28) >= 3 {
      return 1;
    }
  }
  return 0;
}

fn vm_format_append(record: u32, count: u32, byte: u32) -> u32 {
  if count >= 256 {
    return count;
  }
  memory_store_u32(record + count * 4 + 4, byte);
  return count + 1;
}

fn vm_format_append_string(record: u32, count: u32, input: u32) -> u32 {
  let mut output_count: u32 = count;
  let mut index: u32 = 0;
  while index < string.lua_string_length(input) {
    output_count = vm_format_append(record, output_count, string.string_byte(input, index));
    index = index + 1;
  }
  return output_count;
}

fn vm_format_append_integer(record: u32, count: u32, input: u32) -> u32 {
  let mut number: u32 = input;
  let mut output_count: u32 = count;
  if number == 0 {
    return vm_format_append(record, output_count, 48);
  }
  let mut divisor: u32 = 1;
  while divisor <= number / 10 {
    divisor = divisor * 10;
  }
  while divisor != 0 {
    let mut byte: u32 = 48;
    byte = byte + number / divisor;
    output_count = vm_format_append(record, output_count, byte);
    number = number % divisor;
    divisor = divisor / 10;
  }
  return output_count;
}

fn vm_format_append_float(record: u32, count: u32, input: f64, fixed: u32) -> u32 {
  let mut number: f64 = input;
  let zero: f64 = f64_from_u32(0);
  let one: f64 = f64_from_u32(1);
  let ten: f64 = f64_from_u32(10);
  let two: f64 = f64_from_u32(2);
  let mut negative: u32 = 0;
  if number < zero {
    negative = negative + 1;
    number = zero - number;
  }
  let mut whole: u32 = 0;
  while number >= one && whole < 1000000 {
    number = number - one;
    whole = whole + 1;
  }
  let mut output_count: u32 = count;
  if negative == 1 {
    output_count = vm_format_append(record, output_count, 45);
  }
  if fixed == 1 {
    let mut rounded: f64 = number * ten + one / two;
    let mut decimal: u32 = 0;
    while rounded >= one {
      rounded = rounded - one;
      decimal = decimal + 1;
    }
    if decimal >= 10 {
      whole = whole + 1;
      decimal = decimal - decimal;
    }
    output_count = vm_format_append_integer(record, output_count, whole);
    output_count = vm_format_append(record, output_count, 46);
    let mut decimal_byte: u32 = 48;
    decimal_byte = decimal_byte + decimal;
    output_count = vm_format_append(record, output_count, decimal_byte);
    return output_count;
  }
  output_count = vm_format_append_integer(record, output_count, whole);
  if number == zero {
    return output_count;
  }
  output_count = vm_format_append(record, output_count, 46);
  let mut digits: u32 = 0;
  while digits < 6 && number != zero {
    number = number * ten;
    let mut decimal: u32 = 0;
    while number >= one {
      number = number - one;
      decimal = decimal + 1;
    }
    let mut decimal_byte: u32 = 48;
    decimal_byte = decimal_byte + decimal;
    output_count = vm_format_append(record, output_count, decimal_byte);
    digits = digits + 1;
  }
  while output_count > count && memory_load_u32(record + output_count * 4) == 48 {
    output_count = output_count - 1;
  }
  if output_count > count && memory_load_u32(record + output_count * 4) == 46 {
    output_count = output_count - 1;
  }
  return output_count;
}

fn vm_concat_numeric_string(heap: u32, input: u32) -> u32 {
  let kind: u32 = value.value_kind(input);
  if kind != 2 && kind != 3 {
    if kind != 0 || input >= 1024 {
      return 0;
    }
  }
  let record: u32 = memory.heap_alloc(heap, 1028, 0);
  if record == 0 {
    return 0;
  }
  let mut count: u32 = 0;
  if kind == 3 {
    count = vm_format_append_float(record, count, value.value_float_number(input), 0);
  } else {
    if kind == 2 {
      count = vm_format_append_integer(record, count, value.value_payload(input));
    } else {
      count = vm_format_append_integer(record, count, input);
    }
  }
  memory_store_u32(record, count);
  return string.string_intern_record(heap, record);
}

fn vm_output_string(heap: u32, input: u32) -> u32 {
  if vm_is_string_value(input) == 1 {
    return input;
  }
  let input_kind: u32 = value.value_kind(input);
  if input_kind == 4 && vm_is_string_value(value.value_payload(input)) == 1 {
    return value.value_payload(input);
  }
  if input_kind == 2 || input_kind == 3 || input_kind == 0 && input < 1024 && input != 0 && input != 1 {
    return vm_concat_numeric_string(heap, input);
  }
  let record: u32 = memory.heap_alloc(heap, 1028, 0);
  if record == 0 {
    return 0;
  }
  let mut count: u32 = 0;
  if input == 0 {
    count = vm_format_append(record, count, 110);
    count = vm_format_append(record, count, 105);
    count = vm_format_append(record, count, 108);
  } else {
    if input == 1 {
      count = vm_format_append(record, count, 116);
      count = vm_format_append(record, count, 114);
      count = vm_format_append(record, count, 117);
      count = vm_format_append(record, count, 101);
    } else {
      return 0;
    }
  }
  memory_store_u32(record, count);
  return string.string_intern_record(heap, record);
}

fn vm_builtin_format(prototype: u32, heap: u32, stack: u32, argument_base: u32, argument_count: u32) -> u32 {
  if argument_count < 1 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let format_value: u32 = memory_load_u32(stack + argument_base * 4);
  if vm_is_string_value(format_value) == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let record: u32 = memory.heap_alloc(heap, 1028, 0);
  if record == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let mut count: u32 = 0;
  let mut index: u32 = 0;
  let mut argument: u32 = argument_base + 1;
  let format: u32 = format_value;
  let length: u32 = string.lua_string_length(format);
  while index < length {
    let current: u32 = string.string_byte(format, index);
    if current != 37 {
      count = vm_format_append(record, count, current);
      index = index + 1;
    } else {
      if index + 1 >= length {
        memory_store_u32(prototype + 28, vm_stack_error());
        return argument_base;
      }
      let mut verb: u32 = string.string_byte(format, index + 1);
      let mut consumed: u32 = 2;
      let mut fixed: u32 = 0;
      if verb == 37 {
        count = vm_format_append(record, count, 37);
      } else {
        if verb == 46 {
          if index + 3 >= length || string.string_byte(format, index + 2) != 49 || string.string_byte(format, index + 3) != 102 {
            memory_store_u32(prototype + 28, vm_stack_error());
            return argument_base;
          }
          verb = verb - verb + 102;
          consumed = consumed + 2;
          fixed = fixed + 1;
        }
        if verb != 100 && verb != 103 && verb != 115 && verb != 102 {
          memory_store_u32(prototype + 28, vm_stack_error());
          return argument_base;
        }
        if argument >= argument_base + argument_count {
          memory_store_u32(prototype + 28, vm_stack_error());
          return argument_base;
        }
        let input: u32 = memory_load_u32(stack + argument * 4);
        if verb == 115 {
          if vm_is_string_value(input) == 1 {
            count = vm_format_append_string(record, count, input);
          } else {
            let input_kind: u32 = value.value_kind(input);
            if input_kind == 4 && vm_is_string_value(value.value_payload(input)) == 1 {
              count = vm_format_append_string(record, count, value.value_payload(input));
            } else {
              if input_kind == 2 {
                count = vm_format_append_integer(record, count, value.value_payload(input));
              } else {
                if input_kind == 3 {
                  count = vm_format_append_float(record, count, vm_numeric_number(input), 0);
                } else {
                  if input_kind == 0 {
                    count = vm_format_append_integer(record, count, input);
                  } else {
                    memory_store_u32(prototype + 28, vm_stack_error());
                    return argument_base;
                  }
                }
              }
            }
          }
        } else {
          if verb == 100 {
            let input_kind: u32 = value.value_kind(input);
            if input_kind != 2 {
              if input_kind != 0 {
                memory_store_u32(prototype + 28, vm_stack_error());
                return argument_base;
              }
            }
            let mut integer: u32 = input;
            if input_kind == 2 {
              integer = value.value_payload(input);
            }
            count = vm_format_append_integer(record, count, integer);
          } else {
            let input_kind: u32 = value.value_kind(input);
            if input_kind != 2 && input_kind != 3 {
              if input_kind != 0 {
                memory_store_u32(prototype + 28, vm_stack_error());
                return argument_base;
              }
            }
            count = vm_format_append_float(record, count, vm_numeric_number(input), fixed);
          }
        }
        argument = argument + 1;
      }
      index = index + consumed;
    }
  }
  memory_store_u32(record, count);
  let output: u32 = string.string_intern_record(heap, record);
  if output == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  memory_store_u32(stack + argument_base * 4, output);
  return argument_base + 1;
}

fn vm_builtin_dump(prototype: u32, heap: u32, stack: u32, argument_base: u32, argument_count: u32) -> u32 {
  if argument_count < 1 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let input: u32 = memory_load_u32(stack + argument_base * 4);
  if vm_is_closure_value(heap, input) == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let handle: u32 = value.value_payload(input);
  let record: u32 = memory.heap_alloc(heap, 36, 0);
  if record == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  memory_store_u32(record, 8);
  memory_store_u32(record + 4, 87);
  memory_store_u32(record + 8, 76);
  memory_store_u32(record + 12, 68);
  memory_store_u32(record + 16, 1);
  memory_store_u32(record + 20, handle % 256);
  let mut second_byte: u32 = handle / 256;
  second_byte = second_byte % 256;
  let mut third_byte: u32 = handle / 65536;
  third_byte = third_byte % 256;
  let mut fourth_byte: u32 = handle / 16777216;
  fourth_byte = fourth_byte % 256;
  memory_store_u32(record + 24, second_byte);
  memory_store_u32(record + 28, third_byte);
  memory_store_u32(record + 32, fourth_byte);
  let output: u32 = string.string_intern_record(heap, record);
  if output == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  memory_store_u32(stack + argument_base * 4, output);
  return argument_base + 1;
}

fn vm_builtin_load(prototype: u32, heap: u32, stack: u32, argument_base: u32, argument_count: u32) -> u32 {
  if argument_count < 1 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let input: u32 = memory_load_u32(stack + argument_base * 4);
  if vm_is_string_value(input) == 0 {
    if value.value_kind(input) != 4 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return argument_base;
    }
  }
  let mut encoded: u32 = input;
  if value.value_kind(input) == 4 {
    encoded = value.value_payload(input);
  }
  if string.lua_string_length(encoded) == 8 && string.string_byte(encoded, 0) == 87 && string.string_byte(encoded, 1) == 76 && string.string_byte(encoded, 2) == 68 && string.string_byte(encoded, 3) == 1 {
    let mut handle: u32 = string.string_byte(encoded, 4);
    handle = handle + string.string_byte(encoded, 5) * 256;
    handle = handle + string.string_byte(encoded, 6) * 65536;
    handle = handle + string.string_byte(encoded, 7) * 16777216;
    if handle < 1024 || handle >= 16777216 || memory.heap_owns(heap, handle) == 0 || memory_load_u32(handle) != 3 {
      memory_store_u32(prototype + 28, vm_stack_error());
      return argument_base;
    }
    memory_store_u32(stack + argument_base * 4, handle);
    return argument_base + 1;
  }
  let source: bytes = string_to_bytes(encoded);
  if bytes_length_u32(source) == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  let loaded: u32 = codegen.compile_chunk(source);
  if loaded == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  if memory_load_u32(loaded + 44) != 0 {
    memory_store_u32(prototype + 28, vm_malformed_chunk());
    return argument_base;
  }
  if memory_load_u32(loaded) != 0 {
    memory_store_u32(prototype + 28, memory_load_u32(loaded));
    return argument_base;
  }
  let function_record: u32 = memory_alloc(32);
  if function_record == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  memory_store_u32(function_record, 0);
  memory_store_u32(function_record + 4, memory_load_u32(loaded + 4));
  memory_store_u32(function_record + 8, memory_load_u32(loaded + 8));
  memory_store_u32(function_record + 12, 0);
  memory_store_u32(function_record + 16, 0);
  memory_store_u32(function_record + 20, memory_load_u32(loaded + 32));
  memory_store_u32(function_record + 24, 0);
  memory_store_u32(function_record + 28, 2);
  let callable: u32 = closure.closure_new(heap, function_record, 0);
  if callable == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return argument_base;
  }
  memory_store_u32(stack + argument_base * 4, callable);
  return argument_base + 1;
}

fn vm_load_callable(prototype: u32, heap: u32, path: u32) -> u32 {
  if vm_is_string_value(path) == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  let source: bytes = package_load(path);
  if bytes_length_u32(source) == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  let loaded: u32 = codegen.compile_chunk(source);
  if loaded == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  if memory_load_u32(loaded + 44) != 0 {
    memory_store_u32(prototype + 28, vm_malformed_chunk());
    return 0;
  }
  if memory_load_u32(loaded) != 0 {
    memory_store_u32(prototype + 28, memory_load_u32(loaded));
    return 0;
  }
  let function_record: u32 = memory_alloc(32);
  if function_record == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  memory_store_u32(function_record, 0);
  memory_store_u32(function_record + 4, memory_load_u32(loaded + 4));
  memory_store_u32(function_record + 8, memory_load_u32(loaded + 8));
  memory_store_u32(function_record + 12, 0);
  memory_store_u32(function_record + 16, 0);
  memory_store_u32(function_record + 20, memory_load_u32(loaded + 32));
  memory_store_u32(function_record + 24, 0);
  memory_store_u32(function_record + 28, 2);
  let callable: u32 = closure.closure_new(heap, function_record, 0);
  if callable == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  return callable;
}

fn vm_nested_result_count(prototype: u32) -> u32 {
  if prototype == 0 {
    return 0;
  }
  return memory_load_u32(prototype + 56);
}

fn vm_copy_nested_results(prototype: u32, stack: u32, destination: u32) -> u32 {
  let count: u32 = vm_nested_result_count(prototype);
  if count == 0 {
    return destination;
  }
  let result_prototype: u32 = memory_load_u32(prototype + 60);
  let mut result_stack: u32 = 0;
  if result_prototype != 0 {
    result_stack = memory_load_u32(result_prototype + 20);
  }
  if result_stack == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return destination;
  }
  let mut index: u32 = 0;
  while index < count {
    let raw: u32 = memory_load_u32(result_stack + index * 4);
    let converted: u32 = vm_result_value(raw);
    let slot: u32 = destination + index;
    let address: u32 = stack + slot * 4;
    memory_store_u32(address, converted);
    index = index + 1;
  }
  return destination + count;
}

fn vm_module_suffix(heap: u32) -> u32 {
  let suffix_hash: u32 = vm_hash_name(46, 108, 117, 97, 0, 0, 0, 0, 0, 0, 0, 0);
  let suffix: u32 = string.string_intern(heap, suffix_hash, 4);
  if suffix != 0 {
    memory_store_u32(suffix + 24, 46);
    memory_store_u32(suffix + 28, 108);
    memory_store_u32(suffix + 32, 117);
    memory_store_u32(suffix + 36, 97);
  }
  return suffix;
}

fn vm_package_loaded(heap: u32) -> u32 {
  let package_table: u32 = memory.heap_global_get(heap, vm_hash_name(112, 97, 99, 107, 97, 103, 101, 0, 0, 0, 0, 0));
  if package_table == 0 {
    return 0;
  }
  return table.table_get_raw(package_table, vm_hash_name(108, 111, 97, 100, 101, 100, 0, 0, 0, 0, 0, 0));
}

fn vm_load_file(prototype: u32, heap: u32, path: u32) -> u32 {
  let callable: u32 = vm_load_callable(prototype, heap, path);
  if memory_load_u32(prototype + 28) != 0 {
    return 0;
  }
  let dofile_result: u32 = vm_invoke_callable(heap, callable, 0, 0, 0, 0, prototype);
  if dofile_result == 0 && memory_load_u32(prototype + 28) != 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  return dofile_result;
}

fn vm_pairs_next(table_handle: u32, cursor: u32) -> u32 {
  return table.table_next_from_key(table_handle, cursor);
}

fn vm_next_apply(stack: u32, argument_base: u32, table_handle: u32, cursor: u32) -> u32 {
  let next: u32 = vm_pairs_next(table_handle, cursor);
  let cursor_slot: u32 = argument_base + 1;
  if next == 0 {
    memory_store_u32(stack + argument_base * 4, 0);
    memory_store_u32(stack + cursor_slot * 4, 0);
  } else {
    let mut key: u32 = next;
    let mut output: u32 = 0;
    if next <= 32 {
      output = table.table_get_raw(table_handle, next);
    } else {
      key = memory_load_u32(next + 12);
      output = memory_load_u32(next + 16);
    }
    memory_store_u32(stack + argument_base * 4, key);
    memory_store_u32(stack + cursor_slot * 4, output);
  }
  return argument_base + 2;
}

fn vm_capability_marker(heap: u32, kind: u32) -> u32 {
  let mut hash: u32 = 410000;
  hash = hash + kind;
  let mut length: u32 = 0;
  if kind == 1 {
    length = length - length + 12;
  } else {
    if kind == 2 {
      length = length - length + 11;
    } else {
      if kind == 3 {
        length = length - length + 10;
      } else {
        if kind == 4 {
          length = length - length + 12;
        } else {
          length = length - length + 13;
        }
      }
    }
  }
  let marker: u32 = string.string_intern(heap, hash, length);
  if marker == 0 {
    return 0;
  }
  if kind == 1 {
    memory_store_u32(marker + 24, 95);
    memory_store_u32(marker + 28, 95);
    memory_store_u32(marker + 32, 119);
    memory_store_u32(marker + 36, 108);
    memory_store_u32(marker + 40, 95);
    memory_store_u32(marker + 44, 111);
    memory_store_u32(marker + 48, 115);
    memory_store_u32(marker + 52, 95);
    memory_store_u32(marker + 56, 101);
    memory_store_u32(marker + 60, 120);
    memory_store_u32(marker + 64, 101);
    memory_store_u32(marker + 68, 99);
  } else {
    if kind == 2 {
      memory_store_u32(marker + 24, 95);
      memory_store_u32(marker + 28, 95);
      memory_store_u32(marker + 32, 119);
      memory_store_u32(marker + 36, 108);
      memory_store_u32(marker + 40, 95);
      memory_store_u32(marker + 44, 111);
      memory_store_u32(marker + 48, 115);
      memory_store_u32(marker + 52, 95);
      memory_store_u32(marker + 56, 116);
      memory_store_u32(marker + 60, 109);
      memory_store_u32(marker + 64, 112);
    } else {
      if kind == 3 {
        memory_store_u32(marker + 24, 95);
        memory_store_u32(marker + 28, 95);
        memory_store_u32(marker + 32, 119);
        memory_store_u32(marker + 36, 108);
        memory_store_u32(marker + 40, 95);
        memory_store_u32(marker + 44, 111);
        memory_store_u32(marker + 48, 115);
        memory_store_u32(marker + 52, 95);
        memory_store_u32(marker + 56, 114);
        memory_store_u32(marker + 60, 109);
      } else {
        if kind == 4 {
          memory_store_u32(marker + 24, 95);
          memory_store_u32(marker + 28, 95);
          memory_store_u32(marker + 32, 119);
          memory_store_u32(marker + 36, 108);
          memory_store_u32(marker + 40, 95);
          memory_store_u32(marker + 44, 105);
          memory_store_u32(marker + 48, 111);
          memory_store_u32(marker + 52, 95);
          memory_store_u32(marker + 56, 114);
          memory_store_u32(marker + 60, 101);
          memory_store_u32(marker + 64, 97);
          memory_store_u32(marker + 68, 100);
        } else {
          memory_store_u32(marker + 24, 95);
          memory_store_u32(marker + 28, 95);
          memory_store_u32(marker + 32, 119);
          memory_store_u32(marker + 36, 108);
          memory_store_u32(marker + 40, 95);
          memory_store_u32(marker + 44, 105);
          memory_store_u32(marker + 48, 111);
          memory_store_u32(marker + 52, 95);
          memory_store_u32(marker + 56, 119);
          memory_store_u32(marker + 60, 114);
          memory_store_u32(marker + 64, 105);
          memory_store_u32(marker + 68, 116);
          memory_store_u32(marker + 72, 101);
        }
      }
    }
  }
  return marker;
}

fn vm_capability_allowed(prototype: u32, heap: u32, kind: u32) -> u32 {
  let marker: u32 = vm_capability_marker(heap, kind);
  let probe: bytes = package_load(marker);
  if marker == 0 || bytes_length_u32(probe) == 0 {
    memory_store_u32(prototype + 28, vm_stack_error());
    return 0;
  }
  return 1;
}

fn vm_builtin_record(heap: u32, name: u32, builtin: u32, arity: u32) -> u32 {
  let function: u32 = memory.heap_alloc(heap, 32, 0);
  if function == 0 {
