// Temporary Step 2 testing hook: recognizes the guest-only `__yield` keyword so
// the VM's yield/resume transition can be exercised before the Step 3 coroutine
// library exists.  This token is expected to be replaced by the coroutine
// library surface and is intentionally namespaced with a leading `__`.
export fn is_yield(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  if position + 7 > length {
    return 0;
  }
  if bytes_byte_at_u32(source, position) != 95 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 1) != 95 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 2) != 121 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 3) != 105 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 4) != 101 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 5) != 108 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 6) != 100 {
    return 0;
  }
  if position + 7 == length {
    return 1;
  }
  if is_identifier_continue(bytes_byte_at_u32(source, position + 7)) == 0 {
    return 1;
  }
  return 0;
}

