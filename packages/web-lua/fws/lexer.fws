    return 0;
  }
  if bytes_byte_at_u32(source, position + 2) != 108 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 3) != 115 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 4) != 101 {
    return 0;
  }
  if position + 5 == length {
    return 1;
  }
  if is_identifier_continue(bytes_byte_at_u32(source, position + 5)) == 1 {
    return 0;
  }
  return 1;
}

