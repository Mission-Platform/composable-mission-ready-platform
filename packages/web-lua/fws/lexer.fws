export fn is_space(value: u32) -> u32 {
  if value == 32 {
    return 1;
  }
  if value == 9 {
    return 1;
  }
  if value == 10 {
    return 1;
  }
  if value == 13 {
    return 1;
  }
  if value == 11 {
    return 1;
  }
  if value == 12 {
    return 1;
  }
  return 0;
}

export fn is_digit(value: u32) -> u32 {
  if value >= 48 {
    if value <= 57 {
      return 1;
    }
  }
  return 0;
}

fn is_hex_digit(value: u32) -> u32 {
  if is_digit(value) == 1 {
    return 1;
  }
  if value >= 97 {
    if value <= 102 {
      return 1;
    }
  }
  if value >= 65 {
    if value <= 70 {
      return 1;
    }
  }
  return 0;
}

fn hex_digit_value(value: u32) -> u32 {
  if is_digit(value) == 1 {
    return value - 48;
  }
  if value >= 97 {
    if value <= 102 {
      return value - 97 + 10;
    }
  }
  if value >= 65 {
    if value <= 70 {
      return value - 65 + 10;
    }
  }
  return 0;
}

fn numeral_is_float(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  let current: u32 = position;
  if current < length {
    if bytes_byte_at_u32(source, current) == 48 {
      if current + 1 < length {
        let next: u32 = bytes_byte_at_u32(source, current + 1);
        if next == 120 {
          let cursor: u32 = current + 2;
          while cursor < length {
            let byte: u32 = bytes_byte_at_u32(source, cursor);
            if is_hex_digit(byte) == 1 {
              cursor = cursor + 1;
            } else {
              if byte == 46 {
                return 1;
              }
              if byte == 112 || byte == 80 {
                return 1;
              }
              return 0;
            }
          }
          return 0;
        }
        if next == 88 {
          let cursor: u32 = current + 2;
          while cursor < length {
            let byte: u32 = bytes_byte_at_u32(source, cursor);
            if is_hex_digit(byte) == 1 {
              cursor = cursor + 1;
            } else {
              if byte == 46 {
                return 1;
              }
              if byte == 112 || byte == 80 {
                return 1;
              }
              return 0;
            }
          }
          return 0;
        }
      }
    }
  }
  let scanning_digits: u32 = 1;
  while scanning_digits == 1 {
    if current >= length {
      scanning_digits = scanning_digits - scanning_digits;
    } else {
      if is_digit(bytes_byte_at_u32(source, current)) == 1 {
        current = current + 1;
      } else {
        scanning_digits = scanning_digits - scanning_digits;
      }
    }
  }
  if current < length {
    if bytes_byte_at_u32(source, current) == 46 {
      return 1;
    }
  }
  if current < length {
    let exponent: u32 = bytes_byte_at_u32(source, current);
    if exponent == 101 {
      return 1;
    }
    if exponent == 69 {
      return 1;
    }
  }
  return 0;
}

fn numeral_scan_end(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  let current: u32 = position;
  let is_hex: u32 = 0;
  if current < length {
    if bytes_byte_at_u32(source, current) == 48 {
      if current + 1 < length {
        let next: u32 = bytes_byte_at_u32(source, current + 1);
        if next == 120 {
          is_hex = is_hex + 1;
        }
        if next == 88 {
          is_hex = is_hex + 1;
        }
      }
    }
  }
  if is_hex == 1 {
    current = current + 2;
    let scanning_hex: u32 = 1;
    while scanning_hex == 1 {
      if current >= length {
        scanning_hex = scanning_hex - scanning_hex;
      } else {
        if is_hex_digit(bytes_byte_at_u32(source, current)) == 1 {
          current = current + 1;
        } else {
          scanning_hex = scanning_hex - scanning_hex;
        }
      }
    }
    if current < length {
      if bytes_byte_at_u32(source, current) == 46 {
        current = current + 1;
        let scanning_fraction: u32 = 1;
        while scanning_fraction == 1 {
          if current >= length {
            scanning_fraction = scanning_fraction - scanning_fraction;
          } else {
            if is_hex_digit(bytes_byte_at_u32(source, current)) == 1 {
              current = current + 1;
            } else {
              scanning_fraction = scanning_fraction - scanning_fraction;
            }
          }
        }
      }
    }
    if current < length {
      let exponent_char: u32 = bytes_byte_at_u32(source, current);
      if exponent_char == 112 || exponent_char == 80 {
        current = current + 1;
        if current < length {
          let sign: u32 = bytes_byte_at_u32(source, current);
          if sign == 43 || sign == 45 {
            current = current + 1;
          }
        }
        let scanning_exponent: u32 = 1;
        while scanning_exponent == 1 {
          if current >= length {
            scanning_exponent = scanning_exponent - scanning_exponent;
          } else {
            if is_digit(bytes_byte_at_u32(source, current)) == 1 {
              current = current + 1;
            } else {
              scanning_exponent = scanning_exponent - scanning_exponent;
            }
          }
        }
      }
    }
    return current;
  }
  let scanning_digits: u32 = 1;
  while scanning_digits == 1 {
    if current >= length {
      scanning_digits = scanning_digits - scanning_digits;
    } else {
      if is_digit(bytes_byte_at_u32(source, current)) == 1 {
        current = current + 1;
      } else {
        scanning_digits = scanning_digits - scanning_digits;
      }
    }
  }
  if current < length {
    if bytes_byte_at_u32(source, current) == 46 {
      current = current + 1;
      let scanning_fraction: u32 = 1;
      while scanning_fraction == 1 {
        if current >= length {
          scanning_fraction = scanning_fraction - scanning_fraction;
        } else {
          if is_digit(bytes_byte_at_u32(source, current)) == 1 {
            current = current + 1;
          } else {
            scanning_fraction = scanning_fraction - scanning_fraction;
          }
        }
      }
    }
  }
  if current < length {
    let exponent_char: u32 = bytes_byte_at_u32(source, current);
    let has_exponent: u32 = 0;
    if exponent_char == 101 {
      has_exponent = has_exponent + 1;
    }
    if exponent_char == 69 {
      has_exponent = has_exponent + 1;
    }
    if has_exponent == 1 {
      let after_e: u32 = current + 1;
      if after_e < length {
        let sign: u32 = bytes_byte_at_u32(source, after_e);
        if sign == 43 {
          after_e = after_e + 1;
        }
        if sign == 45 {
          after_e = after_e + 1;
        }
      }
      if after_e < length {
        if is_digit(bytes_byte_at_u32(source, after_e)) == 1 {
          current = after_e;
          let scanning_exponent: u32 = 1;
          while scanning_exponent == 1 {
            if current >= length {
              scanning_exponent = scanning_exponent - scanning_exponent;
            } else {
              if is_digit(bytes_byte_at_u32(source, current)) == 1 {
                current = current + 1;
              } else {
                scanning_exponent = scanning_exponent - scanning_exponent;
              }
            }
          }
        }
      }
    }
  }
  return current;
}

export fn is_identifier_continue(value: u32) -> u32 {
  if is_digit(value) == 1 {
    return 1;
  }
  if value >= 65 {
    if value <= 90 {
      return 1;
    }
  }
  if value >= 97 {
    if value <= 122 {
      return 1;
    }
  }
  if value == 95 {
    return 1;
  }
  return 0;
}

export fn is_return(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  if position + 6 > length {
    return 0;
  }
  if bytes_byte_at_u32(source, position) != 114 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 1) != 101 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 2) != 116 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 3) != 117 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 4) != 114 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 5) != 110 {
    return 0;
  }
  if position + 6 == length {
    return 1;
  }
  let next: u32 = bytes_byte_at_u32(source, position + 6);
  if is_identifier_continue(next) == 1 {
    return 0;
  }
  return 1;
}

export fn is_word(source: bytes, position: u32, first: u32, second: u32, third: u32, fourth: u32, length: u32) -> u32 {
  let source_length: u32 = bytes_length_u32(source);
  if position + length > source_length {
    return 0;
  }
  if bytes_byte_at_u32(source, position) != first {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 1) != second {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 2) != third {
    return 0;
  }
  if length == 4 {
    if bytes_byte_at_u32(source, position + 3) != fourth {
      return 0;
    }
  }
  if position + length == source_length {
    return 1;
  }
  if is_identifier_continue(bytes_byte_at_u32(source, position + length)) == 1 {
    return 0;
  }
  return 1;
}

export fn is_true(source: bytes, position: u32) -> u32 {
  return is_word(source, position, 116, 114, 117, 101, 4);
}

export fn is_false(source: bytes, position: u32) -> u32 {
