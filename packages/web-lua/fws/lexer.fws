  return current;
}

export fn skip_long_comment(source: bytes, position: u32) -> u32 {
  let level: u32 = long_bracket_open_level(source, position + 2) - 1;
  let start: u32 = position + 2 + level + 2;
  return find_long_bracket_end(source, start, level);
}

export fn lexer_skip(source: bytes, position: u32) -> u32 {
  let current: u32 = position;
  let length: u32 = bytes_length_u32(source);
  let scanning: u32 = 1;
  while scanning == 1 {
    if current >= length {
      scanning = scanning - scanning;
    } else {
      if is_space(bytes_byte_at_u32(source, current)) == 1 {
        current = current + 1;
      } else {
        if is_line_comment(source, current) == 1 {
          if is_long_comment(source, current) == 1 {
            current = skip_long_comment(source, current);
          } else {
            current = skip_line_comment(source, current);
          }
        } else {
          scanning = scanning - scanning;
        }
      }
    }
  }
  return current;
}

export fn lexer_string_token_kind(source: bytes, position: u32, quote: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  let current: u32 = position + 1;
  let scanning: u32 = 1;
  while scanning == 1 {
    if current >= length {
      scanning = scanning - scanning;
    } else {
      if bytes_byte_at_u32(source, current) == 92 && current + 1 < length {
        current = current + 2;
      } else {
        if bytes_byte_at_u32(source, current) == quote {
          return 44;
        }
        current = current + 1;
      }
    }
  }
  return 10;
}

export fn lexer_token_kind(source: bytes, position: u32) -> u32 {
