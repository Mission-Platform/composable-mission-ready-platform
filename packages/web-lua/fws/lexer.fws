export fn lexer_integer(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer_skip(source, position);
  let end: u32 = lexer_token_end(source, current);
  let is_hex: u32 = 0;
  if current < end {
    if bytes_byte_at_u32(source, current) == 48 {
      if current + 1 < end {
        let next: u32 = bytes_byte_at_u32(source, current + 1);
        if next == 120 {
          is_hex = is_hex + 1;
        }
        if next == 88 {
          is_hex = is_hex + 1;
        }
      }
    }
  }
  if is_hex == 1 {
    let cursor: u32 = current + 2;
    let value: u32 = 0;
    while cursor < end {
      value = value * 16 + hex_digit_value(bytes_byte_at_u32(source, cursor));
      cursor = cursor + 1;
    }
    return value;
  }
  let value: u32 = 0;
  while current < end {
    value = value * 10 + bytes_byte_at_u32(source, current) - 48;
    current = current + 1;
  }
  return value;
}

fn decimal_digit_float(value: u32) -> f64 {
  return f64_from_u32(value - 48);
}

export fn lexer_float(source: bytes, position: u32) -> f64 {
  let current: u32 = lexer_skip(source, position);
  let end: u32 = lexer_token_end(source, current);
  if current + 1 < end {
    let prefix: u32 = bytes_byte_at_u32(source, current + 1);
    if bytes_byte_at_u32(source, current) == 48 {
      if prefix == 120 || prefix == 88 {
        current = current + 2;
      let value: f64 = f64_from_u32(0);
      let divisor: f64 = f64_from_u32(1);
      let fraction: u32 = 0;
      let exponent: u32 = 0;
      let negative_exponent: u32 = 0;
      let scanning: u32 = 1;
      while current < end && scanning == 1 {
        let byte: u32 = bytes_byte_at_u32(source, current);
        if byte == 46 {
          fraction = fraction + 1;
          current = current + 1;
        } else {
          if byte == 112 || byte == 80 {
            current = current + 1;
            if current < end {
              let sign: u32 = bytes_byte_at_u32(source, current);
              if sign == 45 {
                negative_exponent = negative_exponent + 1;
                current = current + 1;
              } else {
                if sign == 43 {
                  current = current + 1;
                }
              }
            }
            while current < end {
              exponent = exponent * 10 + bytes_byte_at_u32(source, current) - 48;
              current = current + 1;
            }
            scanning = scanning - scanning;
          } else {
            let digit: f64 = f64_from_u32(hex_digit_value(byte));
            if fraction == 0 {
              value = value * f64_from_u32(16) + digit;
            } else {
              divisor = divisor * f64_from_u32(16);
              value = value + digit / divisor;
            }
            current = current + 1;
          }
        }
      }
      while exponent != 0 {
        if negative_exponent == 1 {
          value = value / f64_from_u32(2);
        } else {
          value = value * f64_from_u32(2);
        }
        exponent = exponent - 1;
      }
        return value;
      }
    }
  }
  let value: f64 = f64_from_u32(0);
  let divisor: f64 = f64_from_u32(1);
  let fraction: u32 = 0;
  let exponent: u32 = 0;
  let negative_exponent: u32 = 0;
  let scanning: u32 = 1;
  while current < end && scanning == 1 {
    let byte: u32 = bytes_byte_at_u32(source, current);
    if byte == 46 {
      fraction = fraction + 1;
      current = current + 1;
    } else {
      if byte == 101 || byte == 69 {
        current = current + 1;
        if current < end {
          let sign: u32 = bytes_byte_at_u32(source, current);
          if sign == 45 {
            negative_exponent = negative_exponent + 1;
            current = current + 1;
          } else {
            if sign == 43 {
              current = current + 1;
            }
          }
        }
        while current < end {
          exponent = exponent * 10 + bytes_byte_at_u32(source, current) - 48;
          current = current + 1;
        }
        scanning = scanning - scanning;
      } else {
        let digit: f64 = decimal_digit_float(byte);
        if fraction == 0 {
          value = value * f64_from_u32(10) + digit;
        } else {
          divisor = divisor * f64_from_u32(10);
          value = value + digit / divisor;
        }
        current = current + 1;
      }
    }
  }
  while exponent != 0 {
    if negative_exponent == 1 {
      value = value / f64_from_u32(10);
    } else {
      value = value * f64_from_u32(10);
    }
    exponent = exponent - 1;
  }
  return value;
}

export fn lexer_string_content_start(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer_skip(source, position);
  return current + 1;
}

export fn lexer_string_content_length(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer_skip(source, position);
  let end: u32 = lexer_token_end(source, current);
  if end <= current + 1 {
    return 0;
  }
  return end - current - 2;
}

export fn lexer_long_string_content_start(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer_skip(source, position);
  let level: u32 = long_bracket_open_level(source, current) - 1;
  let start: u32 = current + level + 2;
  let length: u32 = bytes_length_u32(source);
  if start < length {
    if bytes_byte_at_u32(source, start) == 10 {
      return start + 1;
    }
  }
  return start;
}

export fn lexer_long_string_content_length(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer_skip(source, position);
  let end: u32 = lexer_token_end(source, current);
  let level: u32 = long_bracket_open_level(source, current) - 1;
  let content_start: u32 = lexer_long_string_content_start(source, position);
  let close_length: u32 = level + 2;
  if end <= content_start + close_length {
    return 0;
  }
  return end - content_start - close_length;
}

export fn lexer_count(source: bytes) -> u32 {
  let current: u32 = 0;
  let count: u32 = 0;
  let kind: u32 = lexer_token_kind(source, current);
  while kind != 0 {
    count = count + 1;
    current = lexer_token_end(source, current);
    kind = lexer_token_kind(source, current);
  }
  return count;
}