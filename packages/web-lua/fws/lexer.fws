export fn is_identifier_start(value: u32) -> u32 {
  if value >= 65 {
    if value <= 90 {
      return 1;
    }
  }
  if value >= 97 {
    if value <= 122 {
      return 1;
    }
  }
  if value == 95 {
    return 1;
  }
  return 0;
}

export fn identifier_hash(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer_skip(source, position);
  let end: u32 = lexer_token_end(source, current);
  let hash: u32 = 216613626;
  while current < end {
    hash = hash * 16777619;
    hash = hash + bytes_byte_at_u32(source, current);
    current = current + 1;
  }
  return hash;
}

fn identifier_end_position(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  let current: u32 = position;
  while current < length && is_identifier_continue(bytes_byte_at_u32(source, current)) == 1 {
    current = current + 1;
  }
  return current;
}

export fn is_line_comment(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  if position + 1 >= length {
    return 0;
  }
  if bytes_byte_at_u32(source, position) != 45 {
    return 0;
  }
  if bytes_byte_at_u32(source, position + 1) != 45 {
    return 0;
  }
  return 1;
}

fn long_bracket_open_level(source: bytes, position: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  if position >= length {
    return 0;
  }
  if bytes_byte_at_u32(source, position) != 91 {
    return 0;
  }
  let current: u32 = position + 1;
  let level: u32 = 0;
  let scanning: u32 = 1;
  while scanning == 1 {
    if current >= length {
      scanning = scanning - scanning;
    } else {
      if bytes_byte_at_u32(source, current) == 61 {
        level = level + 1;
        current = current + 1;
      } else {
        scanning = scanning - scanning;
      }
    }
  }
  if current >= length {
    return 0;
  }
  if bytes_byte_at_u32(source, current) != 91 {
    return 0;
  }
  return level + 1;
}

fn is_long_bracket_close(source: bytes, position: u32, level: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  if position >= length {
    return 0;
  }
  if bytes_byte_at_u32(source, position) != 93 {
    return 0;
  }
  let current: u32 = position + 1;
  let count: u32 = 0;
  let scanning: u32 = 1;
  while scanning == 1 {
    if current >= length {
      scanning = scanning - scanning;
    } else {
      if bytes_byte_at_u32(source, current) == 61 {
        count = count + 1;
        current = current + 1;
      } else {
        scanning = scanning - scanning;
      }
    }
  }
  if count != level {
    return 0;
  }
  if current >= length {
    return 0;
  }
  if bytes_byte_at_u32(source, current) != 93 {
    return 0;
  }
  return 1;
}

fn find_long_bracket_end(source: bytes, position: u32, level: u32) -> u32 {
  let length: u32 = bytes_length_u32(source);
  let current: u32 = position;
  let scanning: u32 = 1;
  while scanning == 1 {
    if current >= length {
      scanning = scanning - scanning;
    } else {
      if is_long_bracket_close(source, current, level) == 1 {
        current = current + level + 2;
        scanning = scanning - scanning;
      } else {
        current = current + 1;
      }
    }
  }
  return current;
}

export fn is_long_comment(source: bytes, position: u32) -> u32 {
  if is_line_comment(source, position) == 0 {
    return 0;
  }
  if long_bracket_open_level(source, position + 2) > 0 {
    return 1;
  }
  return 0;
}

export fn skip_line_comment(source: bytes, position: u32) -> u32 {
  let current: u32 = position + 2;
  let length: u32 = bytes_length_u32(source);
  let scanning: u32 = 1;
  while scanning == 1 {
    if current >= length {
      scanning = scanning - scanning;
    } else {
      if bytes_byte_at_u32(source, current) == 10 {
        current = current + 1;
        scanning = scanning - scanning;
      } else {
        current = current + 1;
