export fn library_raw_get(value_input: u32, key: u32) -> u32 {
  if value.value_kind(value_input) != 5 {
    return 0;
  }
  return table.table_get_raw(value.value_payload(value_input), key);
}

export fn library_raw_set(value_input: u32, key: u32, output: u32) -> u32 {
  if value.value_kind(value_input) != 5 {
    return 2;
  }
  table.table_set_raw(value.value_payload(value_input), key, output);
  return 0;
}

export fn library_table_insert(
  value_input: u32,
  position: u32,
