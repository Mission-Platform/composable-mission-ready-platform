export fn create_state() -> u32 {
  let heap: u32 = memory.heap_new();
  if heap != 0 {
    init.library_init(heap);
  }
  return heap;
}

export fn nil_value() -> u32 {
  return value.value_nil();
}

export fn boolean_value(value_input: u32) -> u32 {
  return value.value_boolean(value_input);
}

export fn integer_value(value_input: u32) -> u32 {
  return value.value_integer(value_input);
}

export fn float_value(state: u32, value_input: f64) -> u32 {
  return value.value_float_new(state, value_input);
}

export fn float_number_of(value_input: u32) -> f64 {
  return value.value_float_number(value_input);
}

