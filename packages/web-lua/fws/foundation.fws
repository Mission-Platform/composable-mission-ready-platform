export fn library_string_length(value_input: u32) -> u32 {
  if value.value_kind(value_input) != 4 {
    return 0;
  }
  return string.lua_string_length(value.value_payload(value_input));
}

export fn library_table_length(value_input: u32) -> u32 {
  if value.value_kind(value_input) != 5 {
    return 0;
  }
  return table.table_length(value.value_payload(value_input));
}

export fn library_raw_length(value_input: u32) -> u32 {
  let kind: u32 = value.value_kind(value_input);
  if kind == 4 {
    return string.lua_string_length(value.value_payload(value_input));
  }
  if kind == 5 {
    return table.table_length(value.value_payload(value_input));
  }
  return 0;
}

export fn library_string_byte(value_input: u32, index: u32) -> u32 {
  if value.value_kind(value_input) != 4 {
    return 0;
  }
  return string.string_byte(value.value_payload(value_input), index);
}

export fn library_string_byte_at(value_input: u32, index: u32) -> u32 {
  return library_string.library_string_byte_at_impl(value_input, index);
}

export fn library_string_equal(left: u32, right: u32) -> u32 {
  return library_string.library_string_equal_impl(left, right);
}

export fn library_string_concat(
  state: u32,
  left: u32,
  right: u32,
) -> u32 {
  return library_string.library_string_concat_impl(state, left, right);
}

export fn library_string_sub(
  state: u32,
  value_input: u32,
