export fn capability_package_load_status(allowed: u32) -> u32 {
  if allowed != 0 {
    return 0;
  }
  return 2;
}

export fn capability_package_load_result(allowed: u32, result: u32) -> u32 {
  if allowed != 0 {
    return result;
  }
  return 0;
}

