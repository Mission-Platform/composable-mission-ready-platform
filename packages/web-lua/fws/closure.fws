import "./memory.fws" as memory;

export fn closure_new(heap: u32, function_id: u32, upvalue: u32) -> u32 {
  if memory.heap_open(heap) == 0 {
    return 0;
  }
  let closure: u32 = memory.heap_alloc(heap, 32, 1);
  if closure == 0 {
    return 0;
  }
  memory_store_u32(closure, 3);
  memory_store_u32(closure + 4, 32);
  memory_store_u32(closure + 12, function_id);
  memory_store_u32(closure + 16, upvalue);
  memory_store_u32(closure + 20, 0);
  memory_store_u32(closure + 24, 0);
  memory_store_u32(closure + 28, 0);
  memory.heap_increment_objects(heap);
  return closure;
}

export fn closure_function(closure: u32) -> u32 {
  if closure == 0 {
    return 0;
  }
  return memory_load_u32(closure + 12);
}

export fn closure_upvalue(closure: u32) -> u32 {
  if closure == 0 {
    return 0;
  }
  return memory_load_u32(closure + 16);
}

export fn upvalue_new(heap: u32, value: u32) -> u32 {
  let upvalue: u32 = memory.heap_alloc(heap, 20, 0);
  if upvalue == 0 {
    return 0;
  }
  memory_store_u32(upvalue, 9);
  memory_store_u32(upvalue + 4, 20);
  memory_store_u32(upvalue + 12, value);
  memory_store_u32(upvalue + 16, 1);
  return upvalue;
}

export fn upvalue_get(upvalue: u32) -> u32 {
  if upvalue == 0 {
    return 0;
  }
  return memory_load_u32(upvalue + 12);
}

export fn upvalue_set(upvalue: u32, value: u32) -> u32 {
  if upvalue == 0 {
    return 1;
  }
  memory_store_u32(upvalue + 12, value);
  return 0;
}