import "./memory.fws" as memory;

// Values use a deliberately boring, stable 32-bit ABI.  The top nibble is
// the Lua tag and the remaining 28 bits are either an immediate payload or a
// guest handle.  Object handles are never interpreted by the host.
fn pack(kind: u32, payload: u32) -> u32 {
  return kind * 268435456 + payload;
}

export fn value_nil() -> u32 {
  return pack(0, 0);
}

export fn value_boolean(value: u32) -> u32 {
  if value == 0 {
    return pack(1, 0);
  }
  return pack(1, 1);
}

export fn value_integer(value: u32) -> u32 {
  return pack(2, value);
}

// Floats are represented by a heap number handle until the register VM has
// a native numeric representation.  Keeping the tag now makes the ABI
// forward-compatible without changing table/string/function handles later.
export fn value_float(handle: u32) -> u32 {
  return pack(3, handle);
}

export fn value_float_new(heap: u32, number: f64) -> u32 {
  if memory.heap_open(heap) == 0 {
    return 0;
  }
  let handle: u32 = memory.heap_alloc(heap, 24, 1);
  if handle == 0 {
    return 0;
  }
  memory_store_u32(handle, 10);
  memory_store_u32(handle + 4, 24);
  memory_store_f64(handle + 16, number);
  memory.heap_increment_objects(heap);
  return value_float(handle);
}

export fn value_float_number(value: u32) -> f64 {
  if value_kind(value) != 3 {
    return f64_from_u32(0);
  }
  let handle: u32 = value_payload(value);
  if handle == 0 {
    return f64_from_u32(0);
  }
  return memory_load_f64(handle + 16);
}

export fn value_string(handle: u32) -> u32 {
  return pack(4, handle);
}

export fn value_table(handle: u32) -> u32 {
  return pack(5, handle);
}

export fn value_function(handle: u32) -> u32 {
  return pack(6, handle);
}

export fn value_thread(handle: u32) -> u32 {
  return pack(7, handle);
}

export fn value_userdata(handle: u32) -> u32 {
  return pack(8, handle);
}

export fn value_kind(value: u32) -> u32 {
  return value / 268435456;
}

export fn value_payload(value: u32) -> u32 {
  return value - value_kind(value) * 268435456;
}

export fn value_is_valid(value: u32) -> u32 {
  if value_kind(value) <= 8 {
    return 1;
  }
  return 0;
}

export fn value_is_collectable(value: u32) -> u32 {
  let kind: u32 = value_kind(value);
  if kind >= 3 && kind <= 8 {
    return 1;
  }
  return 0;
}