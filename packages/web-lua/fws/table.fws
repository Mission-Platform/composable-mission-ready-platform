import "./memory.fws" as memory;

fn at(base: u32, offset: u32) -> u32 {
  return base + offset;
}

fn array_capacity() -> u32 {
  return 32;
}

fn integer_key(key: u32) -> u32 {
  let kind: u32 = key / 268435456;
  if kind == 2 {
    return key - kind * 268435456;
  }
  return key;
}

fn is_array_key(key: u32) -> u32 {
  let index: u32 = integer_key(key);
  if index >= 1 && index <= array_capacity() {
    return 1;
  }
  return 0;
}

fn array_address(table: u32, key: u32) -> u32 {
  let index: u32 = integer_key(key) - 1;
  return at(table, index * 4 + 36);
}

fn entry_new(heap: u32, table: u32, key: u32, value: u32, next: u32) -> u32 {
  let entry: u32 = memory.heap_alloc(heap, 20, 0);
  if entry == 0 {
    return 0;
  }
  memory_store_u32(at(entry, 0), 5);
  memory_store_u32(at(entry, 4), 20);
  memory_store_u32(at(entry, 8), next);
  memory_store_u32(at(entry, 12), key);
  memory_store_u32(at(entry, 16), value);
  return entry;
}

export fn table_new_empty(heap: u32) -> u32 {
  if memory.heap_open(heap) == 0 {
    return 0;
  }
  let table: u32 = memory.heap_alloc(heap, array_capacity() * 4 + 40, 1);
  if table == 0 {
    return 0;
  }
  memory_store_u32(at(table, 0), 1);
  memory_store_u32(at(table, 4), array_capacity() * 4 + 40);
  memory_store_u32(at(table, 8), 0);
  memory_store_u32(at(table, 12), array_capacity());
  memory_store_u32(at(table, 16), 0);
  memory_store_u32(at(table, 20), 0);
  memory_store_u32(at(table, 24), 0);
  memory_store_u32(at(table, 28), 0);
  memory_store_u32(at(table, 32), heap);
  let index: u32 = 0;
  while index < array_capacity() {
    memory_store_u32(at(table, index * 4 + 36), 0);
    index = index + 1;
  }
  memory.heap_increment_objects(heap);
  return table;
}

export fn table_new(heap: u32, key: u32, value: u32) -> u32 {
  let table: u32 = table_new_empty(heap);
  if table == 0 {
    return 0;
  }
  table_set(table, key, value);
  return table;
}

fn table_find_entry(table: u32, key: u32) -> u32 {
  let current: u32 = memory_load_u32(at(table, 20));
  let target: u32 = normalized_key(key);
  while current != 0 {
    if normalized_key(memory_load_u32(at(current, 12))) == target {
      return current;
    }
    current = memory_load_u32(at(current, 8));
  }
  return 0;
}

fn normalized_key(key: u32) -> u32 {
  if key > 1024 && key < 16777216 {
    if memory_load_u32(key) == 2 {
      let hash: u32 = 216613626;
      let length: u32 = memory_load_u32(key + 16);
      let index: u32 = 0;
      while index < length {
        hash = hash * 16777619;
        hash = hash + memory_load_u32(key + index * 4 + 24);
        index = index + 1;
      }
      return hash;
    }
  }
  return key;
}

export fn table_get(table: u32, key: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  let normalized: u32 = normalized_key(key);
  if is_array_key(normalized) == 1 {
    return memory_load_u32(array_address(table, normalized));
  }
  let entry: u32 = table_find_entry(table, key);
  if entry != 0 {
    return memory_load_u32(at(entry, 16));
  }
  return 0;
}

export fn table_get_raw(table: u32, key: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  let normalized: u32 = normalized_key(key);
  if is_array_key(normalized) == 1 {
    return memory_load_u32(array_address(table, normalized));
  }
  let entry: u32 = table_find_entry(table, key);
  if entry != 0 {
    return memory_load_u32(at(entry, 16));
  }
  return 0;
}

export fn table_metatable(table: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  return memory_load_u32(at(table, 28));
}

export fn table_set_metatable(table: u32, metatable: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  memory_store_u32(at(table, 28), metatable);
  return table;
}

export fn table_set(table: u32, key: u32, value: u32) -> unit {
  if table == 0 {
    return;
  }
  let normalized: u32 = normalized_key(key);
  if is_array_key(normalized) == 1 {
    let address: u32 = array_address(table, normalized);
    if memory_load_u32(address) == 0 && value != 0 {
      memory_store_u32(at(table, 16), memory_load_u32(at(table, 16)) + 1);
    }
    if memory_load_u32(address) != 0 && value == 0 {
      memory_store_u32(at(table, 16), memory_load_u32(at(table, 16)) - 1);
    }
    memory_store_u32(address, value);
    return;
  }
  let entry: u32 = table_find_entry(table, key);
  if entry != 0 {
    memory_store_u32(at(entry, 16), value);
    return;
  }
  if value == 0 {
    return;
  }
  // Preserve the original key so next()/pairs() can return real string keys.
  let created: u32 = entry_new(memory_load_u32(at(table, 32)), table, key, value, memory_load_u32(at(table, 20)));
  if created != 0 {
    memory_store_u32(at(table, 20), created);
    memory_store_u32(at(table, 24), memory_load_u32(at(table, 24)) + 1);
  }
}

export fn table_set_raw(table: u32, key: u32, value: u32) -> unit {
  table_set(table, key, value);
}

export fn table_hash_count(table: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  return memory_load_u32(at(table, 24));
}

export fn table_length(table: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  return memory_load_u32(at(table, 16));
}

export fn table_next(table: u32, cursor: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  let position: u32 = 1;
  while position <= array_capacity() {
    if position > cursor && memory_load_u32(array_address(table, position)) != 0 {
      return position;
    }
    position = position + 1;
  }
  if cursor > array_capacity() {
    return memory_load_u32(at(cursor, 8));
  }
  return memory_load_u32(at(table, 20));
}

// Lua next()/pairs() cursor is a key (nil/0, array index, or hash key), not an entry pointer.
export fn table_next_from_key(table: u32, key: u32) -> u32 {
  if table == 0 {
    return 0;
  }
  if key == 0 {
    let position: u32 = 1;
    while position <= array_capacity() {
      if memory_load_u32(array_address(table, position)) != 0 {
        return position;
      }
      position = position + 1;
    }
    return memory_load_u32(at(table, 20));
  }
  let normalized: u32 = normalized_key(key);
  if is_array_key(normalized) == 1 {
    let position: u32 = integer_key(normalized) + 1;
    while position <= array_capacity() {
      if memory_load_u32(array_address(table, position)) != 0 {
        return position;
      }
      position = position + 1;
    }
    return memory_load_u32(at(table, 20));
  }
  let current: u32 = memory_load_u32(at(table, 20));
  while current != 0 {
    if normalized_key(memory_load_u32(at(current, 12))) == normalized {
      return memory_load_u32(at(current, 8));
    }
    current = memory_load_u32(at(current, 8));
  }
  return 0;
}

export fn table_next_key(table: u32, cursor: u32) -> u32 {
  let next: u32 = table_next(table, cursor);
  if next == 0 {
    return 0;
  }
  if next <= array_capacity() {
    return next;
  }
  return memory_load_u32(at(next, 12));
}

export fn table_next_value(table: u32, cursor: u32) -> u32 {
  let next: u32 = table_next(table, cursor);
  if next == 0 {
    return 0;
  }
  if next <= array_capacity() {
    return memory_load_u32(array_address(table, next));
  }
  return memory_load_u32(at(next, 16));
}