import "./lexer.fws" as lexer;
import "./memory.fws" as memory;

export fn result(position: u32, node: u32, status: u32) -> u32 {
  let value: u32 = memory_alloc(12);
  memory_store_u32(value, position);
  memory_store_u32(value + 4, node);
  memory_store_u32(value + 8, status);
  return value;
}

fn result_with_count(position: u32, node: u32, count: u32, status: u32) -> u32 {
  let value: u32 = memory_alloc(16);
  memory_store_u32(value, position);
  memory_store_u32(value + 4, node);
  memory_store_u32(value + 8, status);
  memory_store_u32(value + 12, count);
  return value;
}

export fn node(kind: u32, left: u32, right: u32) -> u32 {
  let value: u32 = memory_alloc(20);
  memory_store_u32(value, kind);
  memory_store_u32(value + 4, left);
  memory_store_u32(value + 8, right);
  memory_store_u32(value + 12, 0);
  memory_store_u32(value + 16, 0);
  return value;
}

export fn node_extra(kind: u32, first: u32, second: u32, third: u32) -> u32 {
  let value: u32 = node(kind, first, second);
  memory_store_u32(value + 12, third);
  return value;
}

export fn node_full(kind: u32, first: u32, second: u32, third: u32, fourth: u32) -> u32 {
  let value: u32 = node_extra(kind, first, second, third);
  memory_store_u32(value + 16, fourth);
  return value;
}

fn self_identifier_hash() -> u32 {
  let hash: u32 = 216613626;
  hash = hash * 16777619 + 115;
  hash = hash * 16777619 + 101;
  hash = hash * 16777619 + 108;
  hash = hash * 16777619 + 102;
  return hash;
}

export fn is_term_operator(kind: u32) -> u32 {
  if kind == 5 {
    return 1;
  }
  if kind == 6 {
    return 1;
  }
  if kind == 36 {
    return 1;
  }
  if kind == 31 {
    return 1;
  }
  return 0;
}

export fn is_expression_operator(kind: u32) -> u32 {
  if kind == 3 {
    return 1;
  }
  if kind == 4 {
    return 1;
  }
  return 0;
}

export fn is_concat_operator(kind: u32) -> u32 {
  if kind == 45 {
    return 1;
  }
  return 0;
}

fn is_decimal_escape(byte: u32) -> u32 {
  if byte >= 48 && byte <= 57 {
    return 1;
  }
  return 0;
}

fn hex_escape_digit(byte: u32) -> u32 {
  if byte >= 48 && byte <= 57 {
    return byte - 48;
  }
  if byte >= 97 && byte <= 102 {
    return byte - 97 + 10;
  }
  if byte >= 65 && byte <= 70 {
    return byte - 65 + 10;
  }
  return 0;
}

fn is_escape_space(byte: u32) -> u32 {
  if byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13 || byte == 32 {
    return 1;
  }
  return 0;
}

export fn copy_string_literal(source: bytes, position: u32) -> u32 {
  let start: u32 = lexer.lexer_string_content_start(source, position);
  let length: u32 = lexer.lexer_string_content_length(source, position);
  let record: u32 = memory_alloc(length * 4 + 4);
  let end: u32 = start + length;
  let cursor: u32 = start;
  let output: u32 = 0;
  while cursor < end {
    let byte: u32 = bytes_byte_at_u32(source, cursor);
    cursor = cursor + 1;
    if byte != 92 {
      memory_store_u32(record + output * 4 + 4, byte);
      output = output + 1;
    } else {
      if cursor < end {
        let escaped: u32 = bytes_byte_at_u32(source, cursor);
        cursor = cursor + 1;
        let value: u32 = escaped;
        if escaped == 97 {
          value = value - value + 7;
        } else {
          if escaped == 98 {
            value = value - value + 8;
          } else {
            if escaped == 102 {
              value = value - value + 12;
            } else {
              if escaped == 110 {
                value = value - value + 10;
              } else {
                if escaped == 114 {
                  value = value - value + 13;
                } else {
                  if escaped == 116 {
                    value = value - value + 9;
                  } else {
                    if escaped == 118 {
                      value = value - value + 11;
                    } else {
                      if escaped == 10 || escaped == 13 {
                        value = value - value + 10;
                      } else {
                        if escaped == 120 {
                          value = value - value;
                          if cursor < end {
                            value = hex_escape_digit(bytes_byte_at_u32(source, cursor)) * 16;
                            cursor = cursor + 1;
                          }
                          if cursor < end {
                            value = value + hex_escape_digit(bytes_byte_at_u32(source, cursor));
                            cursor = cursor + 1;
                          }
                        } else {
                          if is_decimal_escape(escaped) == 1 {
                            value = escaped - 48;
                            let digits: u32 = 1;
                            while digits < 3 && cursor < end && is_decimal_escape(bytes_byte_at_u32(source, cursor)) == 1 {
                              value = value * 10 + bytes_byte_at_u32(source, cursor) - 48;
                              cursor = cursor + 1;
                              digits = digits + 1;
                            }
                          } else {
                            if escaped == 122 {
                              value = value - value;
                              while cursor < end && is_escape_space(bytes_byte_at_u32(source, cursor)) == 1 {
                                cursor = cursor + 1;
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
        if escaped != 122 {
          memory_store_u32(record + output * 4 + 4, value);
          output = output + 1;
        }
      }
    }
  }
  memory_store_u32(record, output);
  return record;
}

export fn copy_long_string_literal(source: bytes, position: u32) -> u32 {
  let start: u32 = lexer.lexer_long_string_content_start(source, position);
  let length: u32 = lexer.lexer_long_string_content_length(source, position);
  let record: u32 = memory_alloc(length * 4 + 4);
  memory_store_u32(record, length);
  let index: u32 = 0;
  while index < length {
    memory_store_u32(record + index * 4 + 4, bytes_byte_at_u32(source, start + index));
    index = index + 1;
  }
  return record;
}

// Capture an identifier's raw bytes as a string-literal record so named table
// fields can be stored as real Lua string keys (required by next()/pairs()).
export fn copy_identifier(source: bytes, position: u32) -> u32 {
  let start: u32 = lexer.lexer_skip(source, position);
  let end: u32 = lexer.lexer_token_end(source, start);
  let length: u32 = end - start;
  let record: u32 = memory_alloc(length * 4 + 4);
  memory_store_u32(record, length);
  let index: u32 = 0;
  while index < length {
    memory_store_u32(record + index * 4 + 4, bytes_byte_at_u32(source, start + index));
    index = index + 1;
  }
  return record;
}


export fn is_shift_operator(kind: u32) -> u32 {
  if kind == 37 || kind == 38 {
    return 1;
  }
  return 0;
}

export fn is_bitand_operator(kind: u32) -> u32 {
  if kind == 33 {
    return 1;
  }
  return 0;
}

export fn is_bitxor_operator(kind: u32) -> u32 {
  if kind == 35 {
    return 1;
  }
  return 0;
}

export fn is_bitor_operator(kind: u32) -> u32 {
  if kind == 34 {
    return 1;
  }
  return 0;
}

export fn is_comparison_operator(kind: u32) -> u32 {
  if kind >= 14 {
    if kind <= 19 {
      return 1;
    }
  }
  return 0;
}

export fn is_extended_expression_operator(kind: u32) -> u32 {
  if is_comparison_operator(kind) == 1 {
    return 1;
  }
  if is_shift_operator(kind) == 1 {
    return 1;
  }
  if is_bitand_operator(kind) == 1 {
    return 1;
  }
  if is_bitxor_operator(kind) == 1 {
    return 1;
  }
  if is_bitor_operator(kind) == 1 {
    return 1;
  }
  return 0;
}

fn declaration_name(hash: u32, flags: u32) -> u32 {
  return node_extra(40, hash, 0, flags);
}

fn is_const_attribute_name(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  if lexer.lexer_token_kind(source, current) != 20 {
    return 0;
  }
  if lexer.lexer_token_end(source, current) != current + 5 {
    return 0;
  }
  if bytes_byte_at_u32(source, current) != 99 {
    return 0;
  }
  if bytes_byte_at_u32(source, current + 1) != 111 {
    return 0;
  }
  if bytes_byte_at_u32(source, current + 2) != 110 {
    return 0;
  }
  if bytes_byte_at_u32(source, current + 3) != 115 {
    return 0;
  }
  if bytes_byte_at_u32(source, current + 4) != 116 {
    return 0;
  }
  return 1;
}

fn parse_optional_const_attribute(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  if lexer.lexer_token_kind(source, current) != 14 {
    return result(current, 0, 0);
  }
  let name_position: u32 = lexer.lexer_token_end(source, current);
  if is_const_attribute_name(source, name_position) == 0 {
    return result(name_position, 0, 1);
  }
  let close_position: u32 = lexer.lexer_token_end(source, name_position);
  if lexer.lexer_token_kind(source, close_position) != 15 {
    return result(close_position, 0, 1);
  }
  return result(lexer.lexer_token_end(source, close_position), 1, 0);
}

fn parse_declaration_names_with_flags(source: bytes, position: u32, shared_flags: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let head: u32 = 0;
  let tail: u32 = 0;
  let scanning: u32 = 1;
  while scanning == 1 {
    if lexer.lexer_token_kind(source, current) != 20 {
      return result(current, 0, 1);
    }
    let flags: u32 = shared_flags;
    let entry: u32 = declaration_name(lexer.identifier_hash(source, current), flags);
    current = lexer.lexer_token_end(source, current);
    let postfix: u32 = parse_optional_const_attribute(source, current);
    if memory_load_u32(postfix + 8) != 0 {
      return postfix;
    }
    if memory_load_u32(postfix + 4) != 0 {
      flags = flags + 1;
      memory_store_u32(entry + 12, flags);
    }
    current = memory_load_u32(postfix);
    if head == 0 {
      head = entry;
    } else {
      memory_store_u32(tail + 8, entry);
    }
    tail = entry;
    let separator: u32 = lexer.lexer_token_kind(source, current);
    if separator == 29 {
      current = lexer.lexer_token_end(source, current);
    } else {
      scanning = scanning - scanning;
    }
  }
  return result(current, head, 0);
}

fn parse_declaration_names(source: bytes, position: u32) -> u32 {
  let prefix: u32 = parse_optional_const_attribute(source, position);
  if memory_load_u32(prefix + 8) != 0 {
    return prefix;
  }
  return parse_declaration_names_with_flags(source, memory_load_u32(prefix), memory_load_u32(prefix + 4));
}

fn parse_assignment_names(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let head: u32 = 0;
  let tail: u32 = 0;
  let scanning: u32 = 1;
  while scanning == 1 {
    let target: u32 = parse_factor(source, current);
    if memory_load_u32(target + 8) != 0 {
      return target;
    }
    let target_node: u32 = memory_load_u32(target + 4);
    let target_kind: u32 = memory_load_u32(target_node);
    if target_kind != 20 {
      if target_kind != 46 {
        return result(memory_load_u32(target), 0, 1);
      }
    }
    // Wrap name/index targets so multi-assign can store either form.
    let entry: u32 = node(41, target_node, 0);
    if head == 0 {
      head = entry;
    } else {
      memory_store_u32(tail + 8, entry);
    }
    tail = entry;
    current = lexer.lexer_skip(source, memory_load_u32(target));
    if lexer.lexer_token_kind(source, current) == 29 {
      current = lexer.lexer_token_end(source, current);
    } else {
      scanning = scanning - scanning;
    }
  }
  return result(current, head, 0);
}

export fn parse_parameters(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let head: u32 = 0;
  let tail: u32 = 0;
  if lexer.lexer_token_kind(source, current) == 8 {
    return result(current, 0, 0);
  }
  let scanning: u32 = 1;
  while scanning == 1 {
    if lexer.lexer_token_kind(source, current) == 52 {
      let entry: u32 = node(52, 0, 0);
      if head == 0 {
        head = entry;
      } else {
        memory_store_u32(tail + 8, entry);
      }
      tail = entry;
      current = lexer.lexer_token_end(source, current);
      scanning = scanning - scanning;
    } else {
    if lexer.lexer_token_kind(source, current) != 20 {
      return result(current, 0, 1);
    }
    let entry: u32 = declaration_name(lexer.identifier_hash(source, current), 0);
    if head == 0 {
      head = entry;
    } else {
      memory_store_u32(tail + 8, entry);
    }
    tail = entry;
    current = lexer.lexer_token_end(source, current);
    let separator: u32 = lexer.lexer_token_kind(source, current);
    if separator == 29 {
      current = lexer.lexer_token_end(source, current);
    } else {
      scanning = scanning - scanning;
    }
    }
  }
  return result(current, head, 0);
}

export fn parameter_count(parameters: u32) -> u32 {
  let current: u32 = parameters;
  let count: u32 = 0;
  while current != 0 {
    if memory_load_u32(current) != 52 {
      count = count + 1;
    }
    current = memory_load_u32(current + 8);
  }
  return count;
}

export fn parameters_are_vararg(parameters: u32) -> u32 {
  let current: u32 = parameters;
  while current != 0 {
    if memory_load_u32(current) == 52 {
      return 1;
    }
    current = memory_load_u32(current + 8);
  }
  return 0;
}

export fn parse_function_expression(source: bytes, position: u32) -> u32 {
  let open_position: u32 = lexer.lexer_skip(source, position);
  if lexer.lexer_token_kind(source, open_position) != 7 {
    return result(open_position, 0, 1);
  }
  let parameters: u32 = parse_parameters(source, lexer.lexer_token_end(source, open_position));
  if memory_load_u32(parameters + 8) != 0 {
    return parameters;
  }
  let close_position: u32 = lexer.lexer_skip(source, memory_load_u32(parameters));
  if lexer.lexer_token_kind(source, close_position) != 8 {
    return result(close_position, 0, 1);
  }
  let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, close_position), 0);
  if memory_load_u32(body + 8) != 0 {
    return body;
  }
  let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
  if lexer.lexer_token_kind(source, end_position) != 24 {
    return result(end_position, 0, 1);
  }
  return result(
    lexer.lexer_token_end(source, end_position),
    node_full(51, memory_load_u32(body + 4), memory_load_u32(parameters + 4), parameter_count(memory_load_u32(parameters + 4)), parameters_are_vararg(memory_load_u32(parameters + 4))),
    0,
  );
}

export fn parse_table_entries(source: bytes, position: u32, next_index: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let head: u32 = 0;
  let tail: u32 = 0;
  let index: u32 = next_index;
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while kind != 40 {
    if kind == 0 {
      return result(current, 0, 1);
    }
    let key: u32 = index + 1;
    let value_position: u32 = current;
    let computed_key: u32 = 0;
    let is_computed: u32 = 0;
    let is_positional: u32 = is_computed - is_computed + 1;
    if kind == 20 {
      let name_end: u32 = lexer.lexer_token_end(source, current);
      if lexer.lexer_token_kind(source, name_end) == 30 {
        // Named fields are real string keys: {a = 1} == {["a"] = 1}.
        computed_key = node(49, copy_identifier(source, current), 0);
        is_computed = is_computed - is_computed + 1;
        is_positional = is_positional - is_positional;
        value_position = lexer.lexer_token_end(source, name_end);
      }
    } else {
      if kind == 41 {
        let key_position: u32 = lexer.lexer_token_end(source, current);
        let key_result: u32 = parse_expression(source, key_position);
        if memory_load_u32(key_result + 8) != 0 {
          return key_result;
        }
        let close_position: u32 = lexer.lexer_skip(source, memory_load_u32(key_result));
        if lexer.lexer_token_kind(source, close_position) != 42 {
          return result(close_position, 0, 1);
        }
        let after_bracket: u32 = lexer.lexer_token_end(source, close_position);
        let equals_position: u32 = lexer.lexer_skip(source, after_bracket);
        if lexer.lexer_token_kind(source, equals_position) != 30 {
          return result(equals_position, 0, 1);
        }
        computed_key = memory_load_u32(key_result + 4);
        is_computed = is_computed - is_computed + 1;
        is_positional = is_positional - is_positional;
        value_position = lexer.lexer_token_end(source, equals_position);
      }
    }
    let expression: u32 = parse_expression(source, value_position);
    if memory_load_u32(expression + 8) != 0 {
      return expression;
    }
    let entry: u32 = node_extra(45, key, memory_load_u32(expression + 4), 0);
    if is_computed == 1 {
      entry = node_extra(59, computed_key, memory_load_u32(expression + 4), 0);
    }
    if head == 0 {
      head = entry;
    } else {
      memory_store_u32(tail + 12, entry);
    }
    tail = entry;
    if is_positional == 1 {
      index = index + 1;
    }
    current = lexer.lexer_skip(source, memory_load_u32(expression));
    kind = lexer.lexer_token_kind(source, current);
    // Table-constructor fields may be separated by ',' or ';' interchangeably.
    if kind == 29 || kind == 9 {
      current = lexer.lexer_token_end(source, current);
      kind = lexer.lexer_token_kind(source, current);
      if kind == 40 {
        return result(lexer.lexer_token_end(source, current), head, 0);
      }
    } else {
      if kind != 40 {
        return result(current, 0, 1);
      }
    }
  }
  return result(lexer.lexer_token_end(source, current), head, 0);
}

export fn parse_index_suffix(source: bytes, base: u32, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let kind: u32 = lexer.lexer_token_kind(source, current);
  let value: u32 = base;
  let scanning: u32 = 1;
  while scanning == 1 {
    if kind == 41 {
      let key_position: u32 = lexer.lexer_token_end(source, current);
      let key_result: u32 = parse_expression(source, key_position);
      if memory_load_u32(key_result + 8) != 0 {
        return key_result;
      }
      let close_position: u32 = lexer.lexer_skip(source, memory_load_u32(key_result));
      if lexer.lexer_token_kind(source, close_position) != 42 {
        return result(close_position, 0, 1);
      }
      value = node(46, value, memory_load_u32(key_result + 4));
      current = lexer.lexer_token_end(source, close_position);
      current = lexer.lexer_skip(source, current);
      kind = lexer.lexer_token_kind(source, current);
    } else {
      if kind == 43 {
        let field_position: u32 = lexer.lexer_token_end(source, current);
        if lexer.lexer_token_kind(source, field_position) != 20 {
          return result(field_position, 0, 1);
        }
        value = node(46, value, node(47, lexer.identifier_hash(source, field_position), 0));
        current = lexer.lexer_token_end(source, field_position);
        current = lexer.lexer_skip(source, current);
        kind = lexer.lexer_token_kind(source, current);
      } else {
        if kind == 7 {
          let arguments: u32 = parse_call_arguments(source, current);
          if memory_load_u32(arguments + 8) != 0 {
            return arguments;
          }
          value = node_extra(39, value, memory_load_u32(arguments + 4), memory_load_u32(arguments + 12));
          current = lexer.lexer_skip(source, memory_load_u32(arguments));
          kind = lexer.lexer_token_kind(source, current);
        } else {
        if kind == 44 || kind == 55 || kind == 39 {
          let argument: u32 = parse_factor(source, current);
          if memory_load_u32(argument + 8) != 0 {
            return argument;
          }
          let entry: u32 = node(41, memory_load_u32(argument + 4), 0);
          value = node_extra(39, value, entry, 1);
          current = lexer.lexer_skip(source, memory_load_u32(argument));
          kind = lexer.lexer_token_kind(source, current);
        } else {
        if kind == 65 {
            let method_position: u32 = lexer.lexer_token_end(source, current);
            if lexer.lexer_token_kind(source, method_position) != 20 {
              return result(method_position, 0, 1);
            }
            let arguments: u32 = parse_call_arguments(
              source,
              lexer.lexer_token_end(source, method_position),
            );
            if memory_load_u32(arguments + 8) != 0 {
              return arguments;
            }
            value = node_full(
              68,
              value,
              lexer.identifier_hash(source, method_position),
              memory_load_u32(arguments + 4),
              memory_load_u32(arguments + 12) + 1,
            );
            current = lexer.lexer_skip(source, memory_load_u32(arguments));
            kind = lexer.lexer_token_kind(source, current);
          } else {
            if kind == 44 || kind == 55 || kind == 39 {
              let argument: u32 = parse_factor(source, current);
              if memory_load_u32(argument + 8) != 0 {
                return argument;
              }
              let entry: u32 = node(41, memory_load_u32(argument + 4), 0);
              value = node_extra(39, value, entry, 1);
              current = lexer.lexer_skip(source, memory_load_u32(argument));
              kind = lexer.lexer_token_kind(source, current);
            } else {
              scanning = scanning - scanning;
            }
          }
          }
        }
      }
    }
  }
  return result(current, value, 0);
}

fn parse_call_arguments(source: bytes, position: u32) -> u32 {
  let open_position: u32 = lexer.lexer_skip(source, position);
  if lexer.lexer_token_kind(source, open_position) != 7 {
    let argument_kind: u32 = lexer.lexer_token_kind(source, open_position);
    if argument_kind == 44 || argument_kind == 55 || argument_kind == 39 {
      let argument: u32 = parse_factor(source, open_position);
      if memory_load_u32(argument + 8) != 0 {
        return argument;
      }
      let entry: u32 = node(41, memory_load_u32(argument + 4), 0);
      return result_with_count(memory_load_u32(argument), entry, 1, 0);
    }
    return result_with_count(open_position, 0, 0, 1);
  }
  let argument_position: u32 = lexer.lexer_token_end(source, open_position);
  let arguments: u32 = 0;
  let tail: u32 = 0;
  let count: u32 = 0;
  let argument_kind: u32 = lexer.lexer_token_kind(source, argument_position);
  if argument_kind != 8 {
    let scanning_arguments: u32 = 1;
    let current_argument: u32 = argument_position;
    while scanning_arguments == 1 {
      let argument: u32 = parse_expression(source, current_argument);
      if memory_load_u32(argument + 8) != 0 {
        return argument;
      }
      let entry: u32 = node(41, memory_load_u32(argument + 4), 0);
      if arguments == 0 {
        arguments = entry;
      } else {
        memory_store_u32(tail + 8, entry);
      }
      tail = entry;
      count = count + 1;
      current_argument = lexer.lexer_skip(source, memory_load_u32(argument));
      let separator: u32 = lexer.lexer_token_kind(source, current_argument);
      if separator == 29 {
        current_argument = lexer.lexer_token_end(source, current_argument);
        if lexer.lexer_token_kind(source, current_argument) == 8 {
          return result_with_count(current_argument, arguments, count, 1);
        }
      } else {
        if separator != 8 {
          return result_with_count(current_argument, 0, 0, 1);
        }
        scanning_arguments = scanning_arguments - scanning_arguments;
      }
    }
    argument_position = current_argument;
  }
  if lexer.lexer_token_kind(source, argument_position) != 8 {
    return result_with_count(argument_position, 0, 0, 1);
  }
  return result_with_count(
    lexer.lexer_token_end(source, argument_position),
    arguments,
    count,
    0,
  );
}

fn parse_power_suffix(source: bytes, left: u32, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  if lexer.lexer_token_kind(source, current) != 32 {
    return result(position, left, 0);
  }
  let right: u32 = parse_factor(source, lexer.lexer_token_end(source, current));
  if memory_load_u32(right + 8) != 0 {
    return right;
  }
  return result(memory_load_u32(right), node(77, left, memory_load_u32(right + 4)), 0);
}

export fn parse_factor(source: bytes, position: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let kind: u32 = lexer.lexer_token_kind(source, current);
  if kind == 2 {
    return parse_power_suffix(source, node(1, lexer.lexer_integer(source, current), 0), lexer.lexer_token_end(source, current));
  }
  if kind == 56 {
    let literal: u32 = memory_alloc(8);
    memory_store_f64(literal, lexer.lexer_float(source, current));
    return parse_power_suffix(source, node(63, literal, 0), lexer.lexer_token_end(source, current));
  }
  if kind == 44 {
    return parse_power_suffix(source, node(49, copy_string_literal(source, current), 0), lexer.lexer_token_end(source, current));
  }
  if kind == 55 {
    return parse_power_suffix(source, node(49, copy_long_string_literal(source, current), 0), lexer.lexer_token_end(source, current));
  }
  if kind == 11 {
    return parse_power_suffix(source, node(1, 1, 0), lexer.lexer_token_end(source, current));
  }
  if kind == 12 {
    return parse_power_suffix(source, node(1, 0, 0), lexer.lexer_token_end(source, current));
  }
  if kind == 13 {
    return parse_power_suffix(source, node(1, 0, 0), lexer.lexer_token_end(source, current));
  }
  if kind == 28 {
    let function_result: u32 = parse_function_expression(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(function_result + 8) != 0 {
      return function_result;
    }
    return parse_power_suffix(source, memory_load_u32(function_result + 4), memory_load_u32(function_result));
  }
  if kind == 52 {
    return parse_power_suffix(source, node(52, 0, 0), lexer.lexer_token_end(source, current));
  }
  if kind == 20 {
    let indexed: u32 = parse_index_suffix(
      source,
      node(20, lexer.identifier_hash(source, current), 0),
      lexer.lexer_token_end(source, current),
    );
    if memory_load_u32(indexed + 8) != 0 {
      return indexed;
    }
    return parse_power_suffix(source, memory_load_u32(indexed + 4), memory_load_u32(indexed));
  }
  if kind == 39 {
    let entries: u32 = parse_table_entries(source, lexer.lexer_token_end(source, current), 0);
    if memory_load_u32(entries + 8) != 0 {
      return entries;
    }
    return parse_power_suffix(source, node(44, memory_load_u32(entries + 4), 0), memory_load_u32(entries));
  }
  if kind == 4 {
    let nested: u32 = parse_factor(source, lexer.lexer_token_end(source, current));
    return result(memory_load_u32(nested), node(6, memory_load_u32(nested + 4), 0), memory_load_u32(nested + 8));
  }
  if kind == 35 {
    let nested: u32 = parse_factor(source, lexer.lexer_token_end(source, current));
    return result(memory_load_u32(nested), node(9, memory_load_u32(nested + 4), 0), memory_load_u32(nested + 8));
  }
  if kind == 77 {
    let nested: u32 = parse_factor(source, lexer.lexer_token_end(source, current));
    return result(memory_load_u32(nested), node(10, memory_load_u32(nested + 4), 0), memory_load_u32(nested + 8));
  }
  if kind == 78 {
    let nested: u32 = parse_factor(source, lexer.lexer_token_end(source, current));
    return result(memory_load_u32(nested), node(11, memory_load_u32(nested + 4), 0), memory_load_u32(nested + 8));
  }
  if kind == 7 {
    let nested: u32 = parse_expression(source, lexer.lexer_token_end(source, current));
    let end: u32 = lexer.lexer_skip(source, memory_load_u32(nested));
    if lexer.lexer_token_kind(source, end) != 8 {
      return result(end, 0, 1);
    }
    let indexed: u32 = parse_index_suffix(
      source,
      memory_load_u32(nested + 4),
      lexer.lexer_token_end(source, end),
    );
    if memory_load_u32(indexed + 8) != 0 {
      return indexed;
    }
    return parse_power_suffix(source, memory_load_u32(indexed + 4), memory_load_u32(indexed));
  }
  return result(lexer.lexer_token_end(source, current), 0, 1);
}

export fn parse_term(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_factor(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  let status: u32 = memory_load_u32(left_result + 8);
  if status != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  let active: u32 = kind;
  while is_term_operator(active) == 1 {
    let right_result: u32 = parse_factor(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return result(memory_load_u32(right_result), 0, 1);
    }
    let operation: u32 = 5;
    if active == 5 {
      operation = active - active + 4;
    }
    if active == 36 {
      operation = operation - operation + 71;
    }
    if active == 31 {
      operation = operation - operation + 26;
    }
    left = node(operation, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    active = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_arithmetic(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_term(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_expression_operator(kind) == 1 {
    let right_result: u32 = parse_term(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return result(memory_load_u32(right_result), 0, 1);
    }
    let operation: u32 = 3;
    if kind == 3 {
      operation = kind - kind + 2;
    }
    left = node(operation, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_shift(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_concat(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_shift_operator(kind) == 1 {
    let right_result: u32 = parse_concat(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    let operation: u32 = 30;
    if kind == 38 {
      operation = operation - operation + 31;
    }
    left = node(operation, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_bitand(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_shift(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_bitand_operator(kind) == 1 {
    let right_result: u32 = parse_shift(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    left = node(27, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_bitxor(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_bitand(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_bitxor_operator(kind) == 1 {
    let right_result: u32 = parse_bitand(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    left = node(29, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_bitor(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_bitxor(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_bitor_operator(kind) == 1 {
    let right_result: u32 = parse_bitxor(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    left = node(28, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_concat(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_arithmetic(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_concat_operator(kind) == 1 {
    let right_result: u32 = parse_arithmetic(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    left = node(50, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

export fn parse_expression(source: bytes, position: u32) -> u32 {
  return parse_logical_or(source, position);
}

fn parse_comparison(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_bitor(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while is_comparison_operator(kind) == 1 {
    let right_result: u32 = parse_bitor(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return result(memory_load_u32(right_result), 0, 1);
    }
    left = node(kind, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, left, 0);
}

fn parse_logical_and(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_comparison(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  while lexer.lexer_token_kind(source, current) == 75 {
    let right_result: u32 = parse_comparison(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    left = node(73, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
  }
  return result(current, left, 0);
}

fn parse_logical_or(source: bytes, position: u32) -> u32 {
  let left_result: u32 = parse_logical_and(source, position);
  let current: u32 = memory_load_u32(left_result);
  let left: u32 = memory_load_u32(left_result + 4);
  if memory_load_u32(left_result + 8) != 0 {
    return left_result;
  }
  while lexer.lexer_token_kind(source, current) == 76 {
    let right_result: u32 = parse_logical_and(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(right_result + 8) != 0 {
      return right_result;
    }
    left = node(74, left, memory_load_u32(right_result + 4));
    current = memory_load_u32(right_result);
  }
  return result(current, left, 0);
}

export fn parse_expression_list(source: bytes, position: u32) -> u32 {
  let current: u32 = position;
  let head: u32 = 0;
  let tail: u32 = 0;
  let scanning: u32 = 1;
  while scanning == 1 {
    let expression: u32 = parse_expression(source, current);
    if memory_load_u32(expression + 8) != 0 {
      return expression;
    }
    let entry: u32 = node(41, memory_load_u32(expression + 4), 0);
    if head == 0 {
      head = entry;
    } else {
      memory_store_u32(tail + 8, entry);
    }
    tail = entry;
    current = memory_load_u32(expression);
    if lexer.lexer_token_kind(source, current) == 29 {
      current = lexer.lexer_token_end(source, current);
    } else {
      scanning = scanning - scanning;
    }
  }
  return result(current, head, 0);
}

fn parse_if_tail(source: bytes, position: u32, loop_depth: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  if lexer.lexer_token_kind(source, current) == 64 {
    let condition: u32 = parse_expression(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(condition + 8) != 0 {
      return condition;
    }
    let then_position: u32 = lexer.lexer_skip(source, memory_load_u32(condition));
    if lexer.lexer_token_kind(source, then_position) != 23 {
      return result(then_position, 0, 1);
    }
    let then_block: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, then_position), loop_depth);
    if memory_load_u32(then_block + 8) != 0 {
      return then_block;
    }
    let nested: u32 = parse_if_tail(source, memory_load_u32(then_block), loop_depth);
    if memory_load_u32(nested + 8) != 0 {
      return nested;
    }
    return result(
      memory_load_u32(nested),
      node_extra(32, memory_load_u32(condition + 4), memory_load_u32(then_block + 4), memory_load_u32(nested + 4)),
      0,
    );
  }
  let else_block: u32 = 0;
  let end_position: u32 = current;
  if lexer.lexer_token_kind(source, current) == 25 {
    let parsed_else: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, current), loop_depth);
    if memory_load_u32(parsed_else + 8) != 0 {
      return parsed_else;
    }
    else_block = memory_load_u32(parsed_else + 4);
    end_position = lexer.lexer_skip(source, memory_load_u32(parsed_else));
  }
  if lexer.lexer_token_kind(source, end_position) != 24 {
    return result(end_position, 0, 1);
  }
  return result(lexer.lexer_token_end(source, end_position), else_block, 0);
}

export fn parse_statement(source: bytes, position: u32) -> u32 {
  return parse_statement_ctx(source, position, 0);
}

fn parse_statement_ctx(source: bytes, position: u32, loop_depth: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let kind: u32 = lexer.lexer_token_kind(source, current);
  if kind == 1 {
    let after_return: u32 = lexer.lexer_token_end(source, current);
    let next: u32 = lexer.lexer_token_kind(source, after_return);
    if next == 0 || next == 9 || next == 24 || next == 25 {
      return result(after_return, node(34, 0, 0), 0);
    }
    let expressions: u32 = parse_expression_list(source, after_return);
    if memory_load_u32(expressions + 8) != 0 {
      return expressions;
    }
    return result(memory_load_u32(expressions), node(34, memory_load_u32(expressions + 4), 0), 0);
  }
  if kind == 28 {
    let name_position: u32 = lexer.lexer_token_end(source, current);
    if lexer.lexer_token_kind(source, name_position) != 20 {
      return result(name_position, 0, 1);
    }
    let target: u32 = node(20, lexer.identifier_hash(source, name_position), 0);
    current = lexer.lexer_token_end(source, name_position);
    current = lexer.lexer_skip(source, current);
    let has_colon: u32 = 0;
    while lexer.lexer_token_kind(source, current) == 43 {
      let field_position: u32 = lexer.lexer_token_end(source, current);
      if lexer.lexer_token_kind(source, field_position) != 20 {
        return result(field_position, 0, 1);
      }
      target = node(46, target, node(47, lexer.identifier_hash(source, field_position), 0));
      current = lexer.lexer_token_end(source, field_position);
      current = lexer.lexer_skip(source, current);
    }
    if lexer.lexer_token_kind(source, current) == 65 {
      let field_position: u32 = lexer.lexer_token_end(source, current);
      if lexer.lexer_token_kind(source, field_position) != 20 {
        return result(field_position, 0, 1);
      }
      target = node(46, target, node(47, lexer.identifier_hash(source, field_position), 0));
      current = lexer.lexer_token_end(source, field_position);
      current = lexer.lexer_skip(source, current);
      has_colon = has_colon - has_colon + 1;
    }
    if lexer.lexer_token_kind(source, current) != 7 {
      return result(current, 0, 1);
    }
    let parameters: u32 = parse_parameters(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(parameters + 8) != 0 {
      return parameters;
    }
    if has_colon == 1 {
      let self_param: u32 = declaration_name(self_identifier_hash(), 0);
      memory_store_u32(self_param + 8, memory_load_u32(parameters + 4));
      memory_store_u32(parameters + 4, self_param);
    }
    let close_position: u32 = lexer.lexer_skip(source, memory_load_u32(parameters));
    if lexer.lexer_token_kind(source, close_position) != 8 {
      return result(close_position, 0, 1);
    }
    let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, close_position), 0);
    if memory_load_u32(body + 8) != 0 {
      return body;
    }
    let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
    if lexer.lexer_token_kind(source, end_position) != 24 {
      return result(end_position, 0, 1);
    }
    let function_ast: u32 = node_full(51, memory_load_u32(body + 4), memory_load_u32(parameters + 4), parameter_count(memory_load_u32(parameters + 4)), parameters_are_vararg(memory_load_u32(parameters + 4)));
    if memory_load_u32(target) == 20 {
      return result(
        lexer.lexer_token_end(source, end_position),
        node_full(38, memory_load_u32(target + 4), memory_load_u32(body + 4), memory_load_u32(parameters + 4), parameters_are_vararg(memory_load_u32(parameters + 4))),
        0,
      );
    }
    return result(
      lexer.lexer_token_end(source, end_position),
      node(48, target, function_ast),
      0,
    );
  }
  if kind == 21 {
    let local_value_position: u32 = lexer.lexer_token_end(source, current);
    if lexer.lexer_token_kind(source, local_value_position) == 28 {
      let function_name_position: u32 = lexer.lexer_token_end(source, local_value_position);
      if lexer.lexer_token_kind(source, function_name_position) != 20 {
        return result(function_name_position, 0, 1);
      }
      let expression: u32 = parse_function_expression(source, lexer.lexer_token_end(source, function_name_position));
      if memory_load_u32(expression + 8) != 0 {
        return expression;
      }
      return result(
        memory_load_u32(expression),
        node(35, lexer.identifier_hash(source, function_name_position), memory_load_u32(expression + 4)),
        0,
      );
    }
    let names: u32 = parse_declaration_names(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(names + 8) != 0 || memory_load_u32(names + 4) == 0 {
      return result(memory_load_u32(names), 0, 1);
    }
    let equals_position: u32 = lexer.lexer_skip(source, memory_load_u32(names));
    if lexer.lexer_token_kind(source, equals_position) != 30 {
      return result(
        equals_position,
        node(53, memory_load_u32(names + 4), 0),
        0,
      );
    }
    let expressions: u32 = parse_expression_list(source, lexer.lexer_token_end(source, equals_position));
    if memory_load_u32(expressions + 8) != 0 {
      return expressions;
    }
    return result(
      memory_load_u32(expressions),
      node(53, memory_load_u32(names + 4), memory_load_u32(expressions + 4)),
    0,
    );
  }
  if kind == 61 {
    let after_global: u32 = lexer.lexer_token_end(source, current);
    let prefix: u32 = parse_optional_const_attribute(source, after_global);
    if memory_load_u32(prefix + 8) != 0 {
      return prefix;
    }
    let declared_position: u32 = memory_load_u32(prefix);
    if lexer.lexer_token_kind(source, declared_position) == 5 {
      return result(
        lexer.lexer_token_end(source, declared_position),
        node(61, 0, 0),
        0,
      );
    }
    if lexer.lexer_token_kind(source, declared_position) == 28 {
      let function_name_position: u32 = lexer.lexer_token_end(source, declared_position);
      if lexer.lexer_token_kind(source, function_name_position) != 20 {
        return result(function_name_position, 0, 1);
      }
      let open_position: u32 = lexer.lexer_token_end(source, function_name_position);
      if lexer.lexer_token_kind(source, open_position) != 7 {
        return result(open_position, 0, 1);
      }
      let parameters: u32 = parse_parameters(source, lexer.lexer_token_end(source, open_position));
      if memory_load_u32(parameters + 8) != 0 {
        return parameters;
      }
      let close_position: u32 = lexer.lexer_skip(source, memory_load_u32(parameters));
      if lexer.lexer_token_kind(source, close_position) != 8 {
        return result(close_position, 0, 1);
      }
      let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, close_position), 0);
      if memory_load_u32(body + 8) != 0 {
        return body;
      }
      let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
      if lexer.lexer_token_kind(source, end_position) != 24 {
        return result(end_position, 0, 1);
      }
      return result(
        lexer.lexer_token_end(source, end_position),
        node_full(38, lexer.identifier_hash(source, function_name_position), memory_load_u32(body + 4), memory_load_u32(parameters + 4), parameters_are_vararg(memory_load_u32(parameters + 4))),
        0,
      );
    }
    if lexer.lexer_token_kind(source, declared_position) == 5 {
      return result(
        lexer.lexer_token_end(source, declared_position),
        node_extra(61, 0, 0, memory_load_u32(prefix + 4)),
        0,
      );
    }
    let names: u32 = parse_declaration_names_with_flags(source, declared_position, memory_load_u32(prefix + 4));
    if memory_load_u32(names + 8) != 0 || memory_load_u32(names + 4) == 0 {
      return result(memory_load_u32(names), 0, 1);
    }
    return result(
      memory_load_u32(names),
      node(61, memory_load_u32(names + 4), 0),
      0,
    );
  }
  if kind == 20 {
    let target: u32 = parse_factor(source, current);
    if memory_load_u32(target + 8) != 0 {
      return target;
    }
    let next: u32 = lexer.lexer_skip(source, memory_load_u32(target));
    if lexer.lexer_token_kind(source, next) == 30 {
      let expression: u32 = parse_expression(source, lexer.lexer_token_end(source, next));
      if memory_load_u32(expression + 8) != 0 {
        return expression;
      }
      let target_node: u32 = memory_load_u32(target + 4);
      if memory_load_u32(target_node) == 20 {
        return result(
          memory_load_u32(expression),
          node(36, memory_load_u32(target_node + 4), memory_load_u32(expression + 4)),
          0,
        );
      }
      if memory_load_u32(target_node) == 46 {
        return result(
          memory_load_u32(expression),
          node(48, target_node, memory_load_u32(expression + 4)),
          0,
        );
      }
    }
    if lexer.lexer_token_kind(source, next) == 29 {
      let names: u32 = parse_assignment_names(source, current);
      if memory_load_u32(names + 8) != 0 {
        return names;
      }
      let equals_position: u32 = lexer.lexer_skip(source, memory_load_u32(names));
      if lexer.lexer_token_kind(source, equals_position) != 30 {
        return result(equals_position, 0, 1);
      }
      let expressions: u32 = parse_expression_list(source, lexer.lexer_token_end(source, equals_position));
      if memory_load_u32(expressions + 8) != 0 {
        return expressions;
      }
      return result(
        memory_load_u32(expressions),
        node(70, memory_load_u32(names + 4), memory_load_u32(expressions + 4)),
        0,
      );
    }
    let target_node: u32 = memory_load_u32(target + 4);
    if memory_load_u32(target_node) == 39 || memory_load_u32(target_node) == 68 {
      return result(memory_load_u32(target), target_node, 0);
    }
    return result(next, 0, 1);
  }
  // A statement may also start with a parenthesized prefix expression, e.g.
  // `(f or g)(...)`. Only a resulting call/method-call is a valid statement.
  if kind == 7 {
    let target: u32 = parse_factor(source, current);
    if memory_load_u32(target + 8) != 0 {
      return target;
    }
    let target_node: u32 = memory_load_u32(target + 4);
    if memory_load_u32(target_node) == 39 || memory_load_u32(target_node) == 68 {
      return result(memory_load_u32(target), target_node, 0);
    }
    return result(memory_load_u32(target), 0, 1);
  }
  if kind == 22 {
    let condition: u32 = parse_expression(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(condition + 8) != 0 {
      return condition;
    }
    let then_position: u32 = lexer.lexer_skip(source, memory_load_u32(condition));
    if lexer.lexer_token_kind(source, then_position) != 23 {
      return result(then_position, 0, 1);
    }
    let then_block: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, then_position), loop_depth);
    if memory_load_u32(then_block + 8) != 0 {
      return then_block;
    }
    let tail: u32 = parse_if_tail(source, memory_load_u32(then_block), loop_depth);
    if memory_load_u32(tail + 8) != 0 {
      return tail;
    }
    return result(
      memory_load_u32(tail),
      node_extra(32, memory_load_u32(condition + 4), memory_load_u32(then_block + 4), memory_load_u32(tail + 4)),
      0,
    );
  }
  if kind == 27 {
    let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, current), loop_depth);
    if memory_load_u32(body + 8) != 0 {
      return body;
    }
    let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
    if lexer.lexer_token_kind(source, end_position) != 24 {
      return result(end_position, 0, 1);
    }
    return result(lexer.lexer_token_end(source, end_position), node(64, memory_load_u32(body + 4), 0), 0);
  }
  if kind == 63 {
    if loop_depth == 0 {
      return result(current, 0, 1);
    }
    return result(lexer.lexer_token_end(source, current), node(65, 0, 0), 0);
  }
  if kind == 26 {
    let condition: u32 = parse_expression(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(condition + 8) != 0 {
      return condition;
    }
    let do_position: u32 = lexer.lexer_skip(source, memory_load_u32(condition));
    if lexer.lexer_token_kind(source, do_position) != 27 {
      return result(do_position, 0, 1);
    }
    let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, do_position), loop_depth + 1);
    if memory_load_u32(body + 8) != 0 {
      return body;
    }
    let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
    if lexer.lexer_token_kind(source, end_position) != 24 {
      return result(end_position, 0, 1);
    }
    return result(
      lexer.lexer_token_end(source, end_position),
      node_extra(33, memory_load_u32(condition + 4), memory_load_u32(body + 4), 0),
      0,
    );
  }
  if kind == 57 {
    let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, current), loop_depth + 1);
    if memory_load_u32(body + 8) != 0 {
      return body;
    }
    let until_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
    if lexer.lexer_token_kind(source, until_position) != 58 {
      return result(until_position, 0, 1);
    }
    let condition: u32 = parse_expression(source, lexer.lexer_token_end(source, until_position));
    if memory_load_u32(condition + 8) != 0 {
      return condition;
    }
    return result(
      memory_load_u32(condition),
      node(56, memory_load_u32(body + 4), memory_load_u32(condition + 4)),
      0,
    );
  }
  if kind == 59 {
    let names: u32 = parse_declaration_names_with_flags(source, lexer.lexer_token_end(source, current), 0);
    if memory_load_u32(names + 8) != 0 || memory_load_u32(names + 4) == 0 {
      return result(memory_load_u32(names), 0, 1);
    }
    let after_names: u32 = memory_load_u32(names);
    let after_kind: u32 = lexer.lexer_token_kind(source, after_names);
    if after_kind == 30 {
      let first_name: u32 = memory_load_u32(names + 4);
      if memory_load_u32(first_name + 8) != 0 {
        return result(after_names, 0, 1);
      }
      let start: u32 = parse_expression(source, lexer.lexer_token_end(source, after_names));
      if memory_load_u32(start + 8) != 0 {
        return start;
      }
      let first_comma: u32 = lexer.lexer_skip(source, memory_load_u32(start));
      if lexer.lexer_token_kind(source, first_comma) != 29 {
        return result(first_comma, 0, 1);
      }
      let finish: u32 = parse_expression(source, lexer.lexer_token_end(source, first_comma));
      if memory_load_u32(finish + 8) != 0 {
        return finish;
      }
      let after_finish: u32 = lexer.lexer_skip(source, memory_load_u32(finish));
      let step: u32 = node(1, 1, 0);
      if lexer.lexer_token_kind(source, after_finish) == 29 {
        let parsed_step: u32 = parse_expression(source, lexer.lexer_token_end(source, after_finish));
        if memory_load_u32(parsed_step + 8) != 0 {
          return parsed_step;
        }
        step = memory_load_u32(parsed_step + 4);
        after_finish = lexer.lexer_skip(source, memory_load_u32(parsed_step));
      }
      if lexer.lexer_token_kind(source, after_finish) != 27 {
        return result(after_finish, 0, 1);
      }
      let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, after_finish), loop_depth + 1);
      if memory_load_u32(body + 8) != 0 {
        return body;
      }
      let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
      if lexer.lexer_token_kind(source, end_position) != 24 {
        return result(end_position, 0, 1);
      }
      let header: u32 = node_full(
        57,
        memory_load_u32(first_name + 4),
        memory_load_u32(start + 4),
        memory_load_u32(finish + 4),
        step,
      );
      return result(
        lexer.lexer_token_end(source, end_position),
        node(58, header, memory_load_u32(body + 4)),
        0,
      );
    }
    if after_kind == 62 {
      let expressions: u32 = parse_expression_list(source, lexer.lexer_token_end(source, after_names));
      if memory_load_u32(expressions + 8) != 0 {
        return expressions;
      }
      let do_position: u32 = lexer.lexer_skip(source, memory_load_u32(expressions));
      if lexer.lexer_token_kind(source, do_position) != 27 {
        return result(do_position, 0, 1);
      }
      let body: u32 = parse_block_ctx(source, lexer.lexer_token_end(source, do_position), loop_depth + 1);
      if memory_load_u32(body + 8) != 0 {
        return body;
      }
      let end_position: u32 = lexer.lexer_skip(source, memory_load_u32(body));
      if lexer.lexer_token_kind(source, end_position) != 24 {
        return result(end_position, 0, 1);
      }
      return result(
        lexer.lexer_token_end(source, end_position),
        node_extra(62, memory_load_u32(names + 4), memory_load_u32(expressions + 4), memory_load_u32(body + 4)),
        0,
      );
    }
    return result(after_names, 0, 1);
  }
  if kind == 53 {
    let name_position: u32 = lexer.lexer_token_end(source, current);
    if lexer.lexer_token_kind(source, name_position) != 20 {
      return result(name_position, 0, 1);
    }
    return result(
      lexer.lexer_token_end(source, name_position),
      node(55, lexer.identifier_hash(source, name_position), 0),
      0,
    );
  }
  if kind == 54 {
    let name_position: u32 = lexer.lexer_token_end(source, current);
    if lexer.lexer_token_kind(source, name_position) != 20 {
      return result(name_position, 0, 1);
    }
    let close_position: u32 = lexer.lexer_token_end(source, name_position);
    if lexer.lexer_token_kind(source, close_position) != 54 {
      return result(close_position, 0, 1);
    }
    return result(
      lexer.lexer_token_end(source, close_position),
      node(54, lexer.identifier_hash(source, name_position), 0),
      0,
    );
  }
  if kind == 60 {
    let expression: u32 = parse_expression(source, lexer.lexer_token_end(source, current));
    if memory_load_u32(expression + 8) != 0 {
      return expression;
    }
    return result(
      memory_load_u32(expression),
      node(60, memory_load_u32(expression + 4), 0),
      0,
    );
  }
  return result(current, 0, 1);
}

export fn parse_block(source: bytes, position: u32) -> u32 {
  return parse_block_ctx(source, position, 0);
}

fn parse_block_ctx(source: bytes, position: u32, loop_depth: u32) -> u32 {
  let current: u32 = lexer.lexer_skip(source, position);
  let head: u32 = 0;
  let tail: u32 = 0;
  let kind: u32 = lexer.lexer_token_kind(source, current);
  while kind != 0 && kind != 24 && kind != 25 && kind != 58 && kind != 64 {
    if kind == 9 {
      let after_semicolon: u32 = lexer.lexer_token_end(source, current);
      if head != 0 {
        if lexer.lexer_token_kind(source, after_semicolon) == 9 {
          return result(after_semicolon, 0, 1);
        }
      }
      current = after_semicolon;
    } else {
      let statement: u32 = parse_statement_ctx(source, current, loop_depth);
      if memory_load_u32(statement + 8) != 0 {
        return statement;
      }
      let entry: u32 = node(37, memory_load_u32(statement + 4), 0);
      if head == 0 {
        head = entry;
      } else {
        memory_store_u32(tail + 8, entry);
      }
      tail = entry;
      current = memory_load_u32(statement);
    }
    kind = lexer.lexer_token_kind(source, current);
  }
  return result(current, head, 0);
}

export fn parse_chunk(source: bytes) -> u32 {
  // Lua skips a first line starting with '#' (shebang / special comment).
  let start: u32 = 0;
  if bytes_length_u32(source) != 0 {
    if bytes_byte_at_u32(source, 0) == 35 {
      let cursor: u32 = 1;
      let length: u32 = bytes_length_u32(source);
      while cursor < length {
        if bytes_byte_at_u32(source, cursor) == 10 {
          cursor = cursor + 1;
          start = cursor;
          cursor = length;
        } else {
          cursor = cursor + 1;
          if cursor >= length {
            start = length;
          }
        }
      }
    }
  }
  let parsed: u32 = parse_block_ctx(source, start, 0);
  if memory_load_u32(parsed + 8) != 0 {
    return parsed;
  }
  let end: u32 = lexer.lexer_skip(source, memory_load_u32(parsed));
  if lexer.lexer_token_kind(source, end) != 0 {
    return result(end, 0, 1);
  }
  return result(end, memory_load_u32(parsed + 4), 0);
}