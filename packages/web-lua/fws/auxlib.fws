export fn status_ok() -> u32 {
  return 0;
}

export fn status_syntax_error() -> u32 {
  return 1;
}

export fn status_runtime_error() -> u32 {
  return 2;
}

export fn status_division_by_zero() -> u32 {
  return 3;
}

export fn status_malformed_chunk() -> u32 {
  return 4;
}

export fn status_yield() -> u32 {
  return 5;
}

export fn status_for_chunk_error(error: u32) -> u32 {
  if error != 0 {
    return status_malformed_chunk();
  }
  return status_ok();
}

export fn chunk_format_text() -> u32 {
  return 1;
}

export fn chunk_format_binary() -> u32 {
  return 2;
}

export fn chunk_format_invalid() -> u32 {
  return 0;
}