import "./auxlib.fws" as auxlib;
import "./codegen.fws" as codegen;
import "./memory.fws" as memory;
import "./vm.fws" as vm;

export fn api_is_invalid(state: u32, prototype: u32, closed: u32) -> u32 {
  if state == 0 {
    return 1;
  }
  if prototype == 0 {
    return 1;
  }
  if closed == 1 {
    return 1;
  }
  return 0;
}

export fn api_load(state: u32, source: bytes) -> u32 {
  if state == 0 {
    return 0;
  }
  if memory.heap_closed(state) == 1 {
    return 0;
  }
  let prototype: u32 = codegen.compile_chunk(source);
  if prototype == 0 {
    memory.heap_set_status(state, auxlib.status_runtime_error());
    return 0;
  }
  memory.heap_set_chunk(state, prototype);
  memory_store_u32(prototype + 48, state);
  let compile_error: u32 = codegen.chunk_error(prototype);
  let mut compile_status: u32 = memory_load_u32(prototype);
  if compile_error != 0 {
    compile_status = auxlib.status_for_chunk_error(compile_error);
  }
  memory.heap_set_status(state, compile_status);
  memory_store_u32(prototype, compile_status);
  return prototype;
}

export fn api_call(state: u32, prototype: u32) -> u32 {
  if api_is_invalid(state, prototype, memory.heap_closed(state)) == 1 {
    return 0;
  }
  vm.execute(prototype);
  let status: u32 = memory_load_u32(prototype + 28);
  memory.heap_set_status(state, status);
  return vm.execute_result(prototype);
}

export fn api_resume(state: u32, prototype: u32) -> u32 {
  if api_is_invalid(state, prototype, memory.heap_closed(state)) == 1 {
    return 0;
  }
  if vm.vm_is_yielded(prototype) == 0 {
    memory.heap_set_status(state, auxlib.status_runtime_error());
    return 0;
  }
  vm.execute(prototype);
  let status: u32 = memory_load_u32(prototype + 28);
  memory.heap_set_status(state, status);
  return vm.execute_result(prototype);
}

export fn api_close(state: u32) -> u32 {
  if state == 0 {
    return 1;
  }
  memory.heap_set_closed(state, 1);
  memory.heap_set_status(state, auxlib.status_ok());
  return 0;
}

export fn api_status(state: u32) -> u32 {
  if state == 0 {
    return auxlib.status_runtime_error();
  }
  return memory.heap_status(state);
}

export fn api_chunk_format(prototype: u32) -> u32 {
  return codegen.chunk_format(prototype);
}

export fn api_chunk_source_length(prototype: u32) -> u32 {
  return codegen.chunk_source_length(prototype);
}

export fn api_chunk_error(prototype: u32) -> u32 {
  return codegen.chunk_error(prototype);
}

export fn api_result_count(prototype: u32) -> u32 {
  return vm.execute_result_count(prototype);
}

export fn api_result_value(prototype: u32, index: u32) -> u32 {
  return vm.execute_result_value(prototype, index);
}