// Code 93 standard and full-ASCII encoder graph with weighted check symbols.

export fn code93_letter(value: i32) -> string {
  if value == 0 { return "A"; }
  if value == 1 { return "B"; }
  if value == 2 { return "C"; }
  if value == 3 { return "D"; }
  if value == 4 { return "E"; }
  if value == 5 { return "F"; }
  if value == 6 { return "G"; }
  if value == 7 { return "H"; }
  if value == 8 { return "I"; }
  if value == 9 { return "J"; }
  if value == 10 { return "K"; }
  if value == 11 { return "L"; }
  if value == 12 { return "M"; }
  if value == 13 { return "N"; }
  if value == 14 { return "O"; }
  if value == 15 { return "P"; }
  if value == 16 { return "Q"; }
  if value == 17 { return "R"; }
  if value == 18 { return "S"; }
  if value == 19 { return "T"; }
  if value == 20 { return "U"; }
  if value == 21 { return "V"; }
  if value == 22 { return "W"; }
  if value == 23 { return "X"; }
  if value == 24 { return "Y"; }
  return "Z";
}

fn digit(value: i32) -> string {
  if value == 0 { return "0"; }
  if value == 1 { return "1"; }
  if value == 2 { return "2"; }
  if value == 3 { return "3"; }
  if value == 4 { return "4"; }
  if value == 5 { return "5"; }
  if value == 6 { return "6"; }
  if value == 7 { return "7"; }
  if value == 8 { return "8"; }
  return "9";
}

export fn code93_character_for_value(value: i32) -> string {
  if value >= 0 && value <= 9 { return digit(value); }
  if value >= 10 && value <= 35 { return code93_letter(value - 10); }
  if value == 36 { return "-"; }
  if value == 37 { return "."; }
  if value == 38 { return " "; }
  if value == 39 { return "$"; }
  if value == 40 { return "/"; }
  if value == 41 { return "+"; }
  if value == 42 { return "%"; }
  return "";
}

fn extended_sequence(value: i32) -> string {
  if value == 0 { return "%U"; }
  if value >= 1 && value <= 26 { return string_concat("$", code93_letter(value - 1)); }
  if value >= 27 && value <= 31 { return string_concat("%", code93_letter(value - 27)); }
  if value == 32 { return " "; }
  if value >= 33 && value <= 44 { return string_concat("/", code93_letter(value - 33)); }
  if value == 45 { return "-"; }
  if value == 46 { return "."; }
  if value == 47 { return "/O"; }
  if value >= 48 && value <= 57 { return digit(value - 48); }
  if value == 58 { return "/Z"; }
  if value >= 59 && value <= 63 { return string_concat("%", code93_letter(value - 54)); }
  if value == 64 { return "%V"; }
  if value >= 65 && value <= 90 { return code93_letter(value - 65); }
  if value >= 91 && value <= 95 { return string_concat("%", code93_letter(value - 81)); }
  if value == 96 { return "%W"; }
  if value >= 97 && value <= 122 { return string_concat("+", code93_letter(value - 97)); }
  if value >= 123 && value <= 127 { return string_concat("%", code93_letter(value - 108)); }
  return "";
}

fn uppercase(value: i32) -> i32 {
  if value >= 97 && value <= 122 { return value - 32; }
  return value;
}

fn standard_sequence(value: string, index: i32, result: string) -> string {
  if index >= string_length(value) { return result; }
  let code: i32 = uppercase(string_byte_at(value, index));
  let symbol: string = code93_character_for_value(base_value(code));
  if string_length(symbol) == 0 { return ""; }
  return standard_sequence(value, index + 1, string_concat(result, symbol));
}

fn extended_sequence_for_value(value: string, index: i32, result: string) -> string {
  if index >= string_length(value) { return result; }
  let sequence: string = extended_sequence(string_byte_at(value, index));
  if string_length(sequence) == 0 { return ""; }
  return extended_sequence_for_value(value, index + 1, string_concat(result, sequence));
}

export fn code93_remainder(value: i32, divisor: i32) -> i32 {
  if value < divisor { return value; }
  return code93_remainder(value - divisor, divisor);
}

fn weighted_sum(value: string, index: i32, max_weight: i32, weight: i32, extended: i32) -> i32 {
  if index >= string_length(value) { return 0; }
  let next_weight: i32 = weight - 1;
  if next_weight < 1 { next_weight = max_weight; }
  return sequence_value(string_byte_at(value, index), extended) * weight + weighted_sum(value, index + 1, max_weight, next_weight, extended);
}

fn render_pattern(value: string, index: i32) -> string {
  if index >= string_length(value) { return ""; }
  let bit: string = "0";
  if string_byte_at(value, index) == 49 { bit = "1"; }
  return string_concat(bit, render_pattern(value, index + 1));
}

fn append_value(result: string, value: i32) -> string {
  let value_pattern: string = pattern(value);
  if string_length(value_pattern) == 0 { return ""; }
  return string_concat(result, render_pattern(value_pattern, 0));
}

fn render_values(value: string, index: i32, result: string, check_c: i32, check_k: i32, extended: i32) -> string {
  if index >= string_length(value) {
    let with_c: string = append_value(result, check_c);
    if string_length(with_c) == 0 { return ""; }
    let with_k: string = append_value(with_c, check_k);
    if string_length(with_k) == 0 { return ""; }
    return string_concat(string_concat(with_k, render_pattern("101011110", 0)), "1");
  }
  let next: string = append_value(result, sequence_value(string_byte_at(value, index), extended));
  if string_length(next) == 0 { return ""; }
  return render_values(value, index + 1, next, check_c, check_k, extended);
}

fn encode_sequence(value: string, extended: i32) -> string {
  if string_length(value) == 0 { return ""; }
  let c_weight: i32 = code93_remainder(string_length(value) - 1, 20) + 1;
  let k_weight: i32 = code93_remainder(string_length(value), 15) + 1;
  let check_c: i32 = code93_remainder(weighted_sum(value, 0, 20, c_weight, extended), 47);
  let check_k: i32 = code93_remainder(weighted_sum(value, 0, 15, k_weight, extended) + check_c, 47);
  return render_values(value, 0, render_pattern("101011110", 0), check_c, check_k, extended);
}

export fn encode_code93_impl(value: string) -> string {
  return encode_sequence(standard_sequence(value, 0, ""), 0);
}

export fn encode_code93_extended_impl(value: string) -> string {
  return encode_sequence(extended_sequence_for_value(value, 0, ""), 1);
}

fn base_value(value: i32) -> i32 {
  if value >= 48 && value <= 57 { return value - 48; }
  if value >= 65 && value <= 90 { return value - 55; }
  if value == 45 { return 36; }
  if value == 46 { return 37; }
  if value == 32 { return 38; }
  if value == 36 { return 39; }
  if value == 47 { return 40; }
  if value == 43 { return 41; }
  if value == 37 { return 42; }
  return -1;
}

fn value_for_character(value: i32) -> i32 {
  if value == 36 { return 43; }
  if value == 37 { return 44; }
  if value == 47 { return 45; }
  if value == 43 { return 46; }
  return base_value(value);
}

fn sequence_value(value: i32, extended: i32) -> i32 {
  if extended == 1 { return value_for_character(value); }
  return base_value(value);
}

fn pattern(value: i32) -> string {
  if value == 0 { return "100010100"; }
  if value == 1 { return "101001000"; }
  if value == 2 { return "101000100"; }
  if value == 3 { return "101000010"; }
  if value == 4 { return "100101000"; }
  if value == 5 { return "100100100"; }
  if value == 6 { return "100100010"; }
  if value == 7 { return "101010000"; }
  if value == 8 { return "100010010"; }
  if value == 9 { return "100001010"; }
  if value == 10 { return "110101000"; }
  if value == 11 { return "110100100"; }
  if value == 12 { return "110100010"; }
  if value == 13 { return "110010100"; }
  if value == 14 { return "110010010"; }
  if value == 15 { return "110001010"; }
  if value == 16 { return "101101000"; }
  if value == 17 { return "101100100"; }
  if value == 18 { return "101100010"; }
  if value == 19 { return "100110100"; }
  if value == 20 { return "100011010"; }
  if value == 21 { return "101011000"; }
  if value == 22 { return "101001100"; }
  if value == 23 { return "101000110"; }
  if value == 24 { return "100101100"; }
  if value == 25 { return "100010110"; }
  if value == 26 { return "110110100"; }
  if value == 27 { return "110110010"; }
  if value == 28 { return "110101100"; }
  if value == 29 { return "110100110"; }
  if value == 30 { return "110010110"; }
  if value == 31 { return "110011010"; }
  if value == 32 { return "101101100"; }
  if value == 33 { return "101100110"; }
  if value == 34 { return "100110110"; }
  if value == 35 { return "100111010"; }
  if value == 36 { return "100101110"; }
  if value == 37 { return "111010100"; }
  if value == 38 { return "111010010"; }
  if value == 39 { return "111001010"; }
  if value == 40 { return "101101110"; }
  if value == 41 { return "101110110"; }
  if value == 42 { return "110101110"; }
  if value == 43 { return "100100110"; }
  if value == 44 { return "111011010"; }
  if value == 45 { return "111010110"; }
  if value == 46 { return "100110010"; }
  return "";
}