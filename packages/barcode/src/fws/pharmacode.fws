// Pharmacode encoder graph for values from 3 through 131070.

fn u32_to_i32_len(value: u32) -> i32 {
  let mut remaining: u32 = value;
  let mut place: i32 = 1;
  let mut result: i32 = 0;
  while remaining > 0 {
    let mut bit: u32 = remaining - remaining / 2 * 2;
    if bit == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place * 2;
  }
  return result;
}

fn modules_len(modules: Array<i32>) -> i32 {
  return u32_to_i32_len(modules.length());
}


fn is_digit_at(value: string, index: i32) -> bool {
  let code: i32 = string_byte_at(value, index);
  return code >= 48 && code <= 57;
}

fn parse_value(value: string, index: i32, result: i32) -> i32 {
  if index >= string_length(value) {
    if result < 3 || result > 131070 { return -1; }
    return result;
  }
  if !is_digit_at(value, index) { return -1; }
  let digit: i32 = string_byte_at(value, index) - 48;
  if result > 13107 { return -1; }
  if result == 13107 && digit > 0 { return -1; }
  return parse_value(value, index + 1, result * 10 + digit);
}

fn bar_widths(value: i32) -> string {
  if value == 0 { return ""; }
  if value % 2 == 0 {
    let next: i32 = value - 2;
    return string_concat(bar_widths(next / 2), "w");
  }
  let next: i32 = value - 1;
  return string_concat(bar_widths(next / 2), "n");
}

fn render_bars(value: string, index: i32) -> string {
  if index >= string_length(value) { return ""; }
  let mut separator: string = "";
  if index > 0 { separator = "0"; }
  let mut bar: string = "1";
  if string_byte_at(value, index) == 119 { bar = "111"; }
  return string_concat(string_concat(separator, bar), render_bars(value, index + 1));
}

export fn encode_pharmacode(value: string) -> string {
  if string_length(value) == 0 { return ""; }
  let parsed: i32 = parse_value(value, 0, 0);
  if parsed < 0 { return ""; }
  return string_concat(render_bars(bar_widths(parsed), 0), "");
}

fn valid_bits(modules: Array<i32>, index: i32, end: i32) -> bool {
  if index >= end { return true; }
  if index >= modules_len(modules) { return false; }
  let bit: i32 = modules[index];
  if bit != 0 && bit != 1 { return false; }
  return valid_bits(modules, index + 1, end);
}

fn run_length(modules: Array<i32>, end: i32, start: i32, bit: i32, length: i32) -> i32 {
  if start + length >= end || start + length >= modules_len(modules) { return length; }
  if modules[start + length] != bit { return length; }
  return run_length(modules, end, start, bit, length + 1);
}

fn narrowest_run(modules: Array<i32>, end: i32, index: i32, current: i32) -> i32 {
  if index >= end { return current; }
  let width: i32 = run_length(modules, end, index, modules[index], 0);
  let mut next: i32 = current;
  if current == 0 || width < current { next = width; }
  return narrowest_run(modules, end, index + width, next);
}

fn pharmacode_value(modules: Array<i32>, end: i32, index: i32, narrow: i32, result: i32, bars: i32) -> i32 {
  if index >= end {
    if bars == 0 || result < 3 || result > 131070 { return -1; }
    return result;
  }
  let bit: i32 = modules[index];
  let width: i32 = run_length(modules, end, index, bit, 0);
  if bit == 1 {
    let mut next: i32 = result * 2 + 1;
    if width >= narrow * 2 { next = result * 2 + 2; }
    if next > 131070 { return -1; }
    return pharmacode_value(modules, end, index + width, narrow, next, bars + 1);
  }
  return pharmacode_value(modules, end, index + width, narrow, result, bars);
}

fn digit_char(value: i32) -> string {
  if value == 0 { return "0"; }
  if value == 1 { return "1"; }
  if value == 2 { return "2"; }
  if value == 3 { return "3"; }
  if value == 4 { return "4"; }
  if value == 5 { return "5"; }
  if value == 6 { return "6"; }
  if value == 7 { return "7"; }
  if value == 8 { return "8"; }
  return "9";
}

fn decimal(value: i32) -> string {
  if value < 10 { return string_concat(digit_char(value), ""); }
  return string_concat(decimal(value / 10), digit_char(value % 10));
}

fn decode_pharmacode_frame(modules: Array<i32>, length: i32) -> string {
  if length > modules_len(modules) || length == 0 || !valid_bits(modules, 0, length) { return ""; }
  let narrow: i32 = narrowest_run(modules, length, 0, 0);
  if narrow <= 0 { return ""; }
  let parsed: i32 = pharmacode_value(modules, length, 0, narrow, 0, 0);
  if parsed < 0 { return ""; }
  return string_concat(decimal(parsed), "");
}

export fn decode_pharmacode(modules: Array<i32>) -> string {
  return string_concat(decode_pharmacode_frame(modules, modules_len(modules)), "");
}

export fn decode_pharmacode_row(modules: Array<i32>, count: i32) -> string {
  return string_concat(decode_pharmacode_frame(modules, count), "");
}
