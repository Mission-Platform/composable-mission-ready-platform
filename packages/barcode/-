/**
 * Styling for the write-once `ForgeBarcode`.
 *
 * `ForgeBarcode` owns this co-located CSS Module: it side-effect-imports the
 * stylesheet so its appearance ships in the built package CSS (the two-stage
 * compiler carries the import onto both the React and Vue builds).
 *
 * The rules live in the package-owned `mp.barcode` cascade layer.
 */
/**
 * Registered inherited custom properties for forge-barcode overrides.
 *
 * Kept in a dedicated partial so the component module can stay focused on
 * selectors while @property initial values remain token-backed defaults.
 */
@property --forge-barcode-code-barcode-figure-gap {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-code-barcode-figure-gap);
}
@property --forge-barcode-code-barcode-actions-gap {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-code-barcode-actions-gap);
}
@layer mp.barcode {
  .forge-barcode {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .forge-barcode-figure {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--forge-barcode-code-barcode-figure-gap, var(--mp-code-barcode-figure-gap));
  }
  .forge-barcode__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--forge-barcode-code-barcode-actions-gap, var(--mp-code-barcode-actions-gap));
  }
}
