// Shared QR primitives tuned for the single-page (64KiB) FWS linear memory.
// Prefer doubling string builds and in-place bit buffers over O(n) string rewrites.

export fn safe_div_i32(a: i32, b: i32) -> i32 {
  if b == 0 { return 0; }
  return a / b;
}

export fn digit(value: i32) -> string {
  if value == 0 { return "0"; }
  if value == 1 { return "1"; }
  if value == 2 { return "2"; }
  if value == 3 { return "3"; }
  if value == 4 { return "4"; }
  if value == 5 { return "5"; }
  if value == 6 { return "6"; }
  if value == 7 { return "7"; }
  if value == 8 { return "8"; }
  return "9";
}

fn itoa_inner(value: i32, tail: string) -> string {
  if value < 10 { return string_concat(digit(value), tail); }
  let q: i32 = value / 10;
  let r: i32 = value - q * 10;
  return itoa_inner(q, string_concat(digit(r), tail));
}

export fn itoa(value: i32) -> string {
  if value == 0 { return "0"; }
  if value < 0 { return string_concat("-", itoa_inner(0 - value, "")); }
  return itoa_inner(value, "");
}

export fn byte_char(value: i32) -> string {
  let v: i32 = value;
  if v < 0 { v = 0; }
  if v > 255 { v = 255; }
  let s: string = itoa(v);
  if v < 10 { return string_concat("00", s); }
  if v < 100 { return string_concat("0", s); }
  return s;
}

export fn bytes_get(data: string, index: i32) -> i32 {
  let offset: i32 = index * 3;
  if index < 0 || offset + 2 >= string_length(data) { return 0; }
  let hundreds: i32 = string_byte_at(data, offset) - 48;
  let tens: i32 = string_byte_at(data, offset + 1) - 48;
  let ones: i32 = string_byte_at(data, offset + 2) - 48;
  return hundreds * 100 + tens * 10 + ones;
}

export fn bytes_push(data: string, value: i32) -> string {
  return string_concat(data, byte_char(value));
}

// Exponential doubling keeps total allocation O(n) under the bump allocator.
export fn bytes_zeros(count: i32) -> string {
  if count <= 0 { return ""; }
  let chunk: string = "000";
  while string_length(chunk) / 3 < count {
    chunk = string_concat(chunk, chunk);
  }
  let end: i32 = count * 3;
  return string_slice(chunk, 0, end);
}

export fn bits_get(data: string, index: i32) -> bool {
  if index < 0 || index >= string_length(data) { return false; }
  return string_byte_at(data, index) == 49;
}

export fn bits_push(data: string, on: bool) -> string {
  if on { return string_concat(data, "1"); }
  return string_concat(data, "0");
}

export fn bits_zeros(count: i32) -> string {
  if count <= 0 { return ""; }
  let chunk: string = "0";
  while string_length(chunk) < count {
    chunk = string_concat(chunk, chunk);
  }
  return string_slice(chunk, 0, count);
}

export fn bit_test(value: i32, bit: i32) -> bool {
  let shifted: i32 = value;
  let index: i32 = 0;
  while index < bit {
    shifted = shifted / 2;
    index = index + 1;
  }
  return shifted - shifted / 2 * 2 == 1;
}

export fn bits_push_value(data: string, value: i32, count: i32) -> string {
  let chunk: string = "";
  let shift: i32 = count - 1;
  while shift >= 0 {
    chunk = bits_push(chunk, bit_test(value, shift));
    shift = shift - 1;
  }
  return string_concat(data, chunk);
}

fn bits_to_byte(bits: string, start: i32) -> i32 {
  let value: i32 = 0;
  let bit: i32 = 0;
  while bit < 8 {
    value = value * 2;
    if bits_get(bits, start + bit) { value = value + 1; }
    bit = bit + 1;
  }
  return value;
}

fn bits_to_bytes_range(bits: string, start: i32, end: i32) -> string {
  if end <= start { return ""; }
  let span: i32 = end - start;
  if span <= 64 {
    let result: string = "";
    let index: i32 = start;
    while index < end {
      result = bytes_push(result, bits_to_byte(bits, index));
      index = index + 8;
    }
    return result;
  }
  let middle: i32 = start + span / 16 * 8;
  if middle <= start { middle = start + 8; }
  let left: string = bits_to_bytes_range(bits, start, middle);
  let right: string = bits_to_bytes_range(bits, middle, end);
  return string_concat(left, right);
}

export fn bits_to_bytes(bits: string) -> string {
  let length: i32 = string_length(bits);
  let end: i32 = length / 8 * 8;
  return bits_to_bytes_range(bits, 0, end);
}

export fn xor_value(left: i32, right: i32, width: i32) -> i32 {
  let result: i32 = 0;
  let place: i32 = 1;
  let index: i32 = 0;
  let a: i32 = left;
  let b: i32 = right;
  while index < width {
    let abit: i32 = a - a / 2 * 2;
    let bbit: i32 = b - b / 2 * 2;
    if abit != bbit { result = result + place; }
    a = a / 2;
    b = b / 2;
    place = place * 2;
    index = index + 1;
  }
  return result;
}

export fn gf_mul(a: i32, b: i32) -> i32 {
  if a == 0 || b == 0 { return 0; }
  let result: i32 = 0;
  let x: i32 = a;
  let y: i32 = b;
  let index: i32 = 0;
  while index < 8 {
    if y - y / 2 * 2 == 1 { result = xor_value(result, x, 9); }
    let high: i32 = x / 128;
    x = x * 2 % 256;
    if high == 1 { x = xor_value(x, 29, 8); }
    y = y / 2;
    index = index + 1;
  }
  return result;
}


// ---- In-place bit buffer (u32 words) ----

// Bit-decomposition (halve/double) keeps this O(log n) instead of counting up to `value`.
export fn u32_from_i32(value: i32) -> u32 {
  if value <= 0 { return 0; }
  let remaining: i32 = value;
  let place: u32 = 1;
  let result: u32 = 0;
  while remaining > 0 {
    if remaining - remaining / 2 * 2 == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place + place;
  }
  return result;
}

// Reverse of `u32_from_i32`, also O(log n) via bit-decomposition.
export fn i32_from_u32(value: u32) -> i32 {
  let remaining: u32 = value;
  let place: i32 = 1;
  let result: i32 = 0;
  while remaining > 0 {
    let bit: u32 = remaining - remaining / 2 * 2;
    if bit == 1 { result = result + place; }
    remaining = remaining / 2;
    place = place * 2;
  }
  return result;
}

export fn mem_alloc_bytes(nbytes: i32) -> u32 {
  let aligned: i32 = nbytes;
  if aligned < 4 { aligned = 4; }
  let rem: i32 = aligned - aligned / 4 * 4;
  if rem != 0 { aligned = aligned + 4 - rem; }
  let size: u32 = u32_from_i32(aligned);
  let ptr: u32 = memory_alloc(size);
  let offset: u32 = 0;
  while offset < size {
    memory_store_u32(ptr + offset, 0);
    offset = offset + 4;
  }
  return ptr;
}

export fn mem_get_u8(ptr: u32, index: i32) -> i32 {
  if index < 0 { return 0; }
  let word_index: i32 = index / 4;
  let byte_index: i32 = index - word_index * 4;
  let addr: u32 = ptr + u32_from_i32(word_index * 4);
  let word: u32 = memory_load_u32(addr);
  let shifted: u32 = word;
  let b: i32 = 0;
  while b < byte_index {
    shifted = shifted / 256;
    b = b + 1;
  }
  let value: u32 = shifted - shifted / 256 * 256;
  return i32_from_u32(value);
}

export fn mem_set_u8(ptr: u32, index: i32, value: i32) -> unit {
  if index < 0 { return; }
  let word_index: i32 = index / 4;
  let byte_index: i32 = index - word_index * 4;
  let addr: u32 = ptr + u32_from_i32(word_index * 4);
  let word: u32 = memory_load_u32(addr);
  let v: i32 = value;
  if v < 0 { v = 0; }
  if v > 255 { v = 255; }
  // Reconstruct word with the replaced byte (little-endian byte order).
  let tmp: u32 = word;
  let part0: u32 = tmp - tmp / 256 * 256;
  let bytes0: i32 = i32_from_u32(part0);
  tmp = tmp / 256;
  let part1: u32 = tmp - tmp / 256 * 256;
  let bytes1: i32 = i32_from_u32(part1);
  tmp = tmp / 256;
  let part2: u32 = tmp - tmp / 256 * 256;
  let bytes2: i32 = i32_from_u32(part2);
  tmp = tmp / 256;
  let part3: u32 = tmp - tmp / 256 * 256;
  let bytes3: i32 = i32_from_u32(part3);
  if byte_index == 0 { bytes0 = v; }
  if byte_index == 1 { bytes1 = v; }
  if byte_index == 2 { bytes2 = v; }
  if byte_index == 3 { bytes3 = v; }
  let out: u32 = u32_from_i32(bytes0) + u32_from_i32(bytes1) * 256 + u32_from_i32(bytes2) * 65536 + u32_from_i32(bytes3) * 16777216;
  memory_store_u32(addr, out);
}

export fn bitbuf_alloc(bits: i32) -> u32 {
  let padded: i32 = bits + 31;
  let words: i32 = padded / 32;
  let nbytes: i32 = words * 4;
  if nbytes < 4 { nbytes = 4; }
  return mem_alloc_bytes(nbytes);
}


export fn bytes_set(data: string, index: i32, value: i32) -> string {
  let offset: i32 = index * 3;
  if offset < 0 || offset + 2 >= string_length(data) { return data; }
  let left: string = string_slice(data, 0, offset);
  let right_start: i32 = offset + 3;
  let right: string = string_slice(data, right_start, string_length(data));
  return string_concat(string_concat(left, byte_char(value)), right);
}

// In-place RS over a pre-sized generator buffer (count+1 bytes) and remainder (count bytes).
fn rs_generator_mem(gen: u32, count: i32) -> unit {
  // gen[0] = 1, rest 0 initially assumed.
  mem_set_u8(gen, 0, 1);
  let root: i32 = 1;
  let round: i32 = 0;
  while round < count {
    // Multiply by (x - root) in place from high to low.
    let index: i32 = round;
    while index >= 0 {
      let coefficient: i32 = mem_get_u8(gen, index);
      let right: i32 = gf_mul(coefficient, root);
      if index + 1 <= count {
        let existing: i32 = mem_get_u8(gen, index + 1);
        mem_set_u8(gen, index + 1, xor_value(existing, right, 8));
      }
      index = index - 1;
    }
    root = gf_mul(root, 2);
    round = round + 1;
  }
}

// Each helper holds exactly one loop: the FWS codegen mishandles two sequential
// call-bearing loops in a single function body (observed as a runtime hang), so
// the remainder pipeline is decomposed into single-loop helpers.
fn rs_zero(rem: u32, count: i32) -> unit {
  let i: i32 = 0;
  while i < count {
    mem_set_u8(rem, i, 0);
    i = i + 1;
  }
}

fn rs_shift_left(rem: u32, count: i32) -> unit {
  let i: i32 = 0;
  while i < count - 1 {
    let next: i32 = mem_get_u8(rem, i + 1);
    mem_set_u8(rem, i, next);
    i = i + 1;
  }
  mem_set_u8(rem, count - 1, 0);
}

fn rs_apply_generator(rem: u32, gen: u32, factor: i32, count: i32) -> unit {
  let i: i32 = 0;
  while i < count {
    let coefficient: i32 = mem_get_u8(gen, i + 1);
    let product: i32 = gf_mul(coefficient, factor);
    let current: i32 = mem_get_u8(rem, i);
    let value: i32 = xor_value(current, product, 8);
    mem_set_u8(rem, i, value);
    i = i + 1;
  }
}

fn rs_remainder_mem(data: u32, data_len: i32, gen: u32, rem: u32, count: i32) -> unit {
  rs_zero(rem, count);
  let data_index: i32 = 0;
  while data_index < data_len {
    let byte: i32 = mem_get_u8(data, data_index);
    let head: i32 = mem_get_u8(rem, 0);
    let factor: i32 = xor_value(byte, head, 8);
    rs_shift_left(rem, count);
    rs_apply_generator(rem, gen, factor, count);
    data_index = data_index + 1;
  }
}

fn rs_load_data(data: string, data_mem: u32, data_len: i32) -> unit {
  let i: i32 = 0;
  while i < data_len {
    let value: i32 = bytes_get(data, i);
    mem_set_u8(data_mem, i, value);
    i = i + 1;
  }
}

fn rs_dump(rem: u32, count: i32) -> string {
  let result: string = "";
  let i: i32 = 0;
  while i < count {
    result = bytes_push(result, mem_get_u8(rem, i));
    i = i + 1;
  }
  return result;
}

export fn rs_remainder(data: string, count: i32) -> string {
  if count <= 0 { return ""; }
  let data_len: i32 = string_length(data) / 3;
  let data_mem: u32 = mem_alloc_bytes(data_len + 4);
  let gen: u32 = mem_alloc_bytes(count + 5);
  let rem: u32 = mem_alloc_bytes(count + 4);
  rs_load_data(data, data_mem, data_len);
  rs_generator_mem(gen, count);
  rs_remainder_mem(data_mem, data_len, gen, rem, count);
  return rs_dump(rem, count);
}

// ECC ordinal: 0=L, 1=M, 2=Q, 3=H.
export fn ecc_per_block(ecc: i32, version: i32) -> i32 {
  if version < 1 || version > 40 { return 0; }
  if ecc == 0 {
    if version == 1 { return 7; }
    if version == 2 { return 10; }
    if version == 3 { return 15; }
    if version == 4 { return 20; }
    if version == 5 { return 26; }
    if version == 6 { return 18; }
    if version == 7 { return 20; }
    if version == 8 { return 24; }
    if version == 9 { return 30; }
    if version == 10 { return 18; }
    if version == 11 { return 20; }
    if version == 12 { return 24; }
    if version == 13 { return 26; }
    if version == 14 { return 30; }
    if version == 15 { return 22; }
    if version == 16 { return 24; }
    if version == 17 { return 28; }
    if version == 18 { return 30; }
    if version == 19 { return 28; }
    if version == 20 { return 28; }
    if version == 21 { return 28; }
    if version == 22 { return 28; }
    if version == 23 { return 30; }
    if version == 24 { return 30; }
    if version == 25 { return 26; }
    if version == 26 { return 28; }
    return 30;
  }
  if ecc == 1 {
    if version == 1 { return 10; }
    if version == 2 { return 16; }
    if version == 3 { return 26; }
    if version == 4 { return 18; }
    if version == 5 { return 24; }
    if version == 6 { return 16; }
    if version == 7 { return 18; }
    if version == 8 { return 22; }
    if version == 9 { return 22; }
    if version == 10 { return 26; }
    if version == 11 { return 30; }
    if version == 12 { return 22; }
    if version == 13 { return 22; }
    if version == 14 { return 24; }
    if version == 15 { return 24; }
    if version == 16 { return 28; }
    if version == 17 { return 28; }
    if version == 18 { return 26; }
    if version == 19 { return 26; }
    if version == 20 { return 26; }
    if version == 21 { return 26; }
    return 28;
  }
  if ecc == 2 {
    if version == 1 { return 13; }
    if version == 2 { return 22; }
    if version == 3 { return 18; }
    if version == 4 { return 26; }
    if version == 5 { return 18; }
    if version == 6 { return 24; }
    if version == 7 { return 18; }
    if version == 8 { return 22; }
    if version == 9 { return 20; }
    if version == 10 { return 24; }
    if version == 11 { return 30; }
    if version == 12 { return 22; }
    if version == 13 { return 20; }
    if version == 14 { return 24; }
    if version == 15 { return 28; }
    if version == 16 { return 24; }
    if version == 17 { return 28; }
    if version == 18 { return 22; }
    if version == 19 { return 26; }
    if version == 20 { return 24; }
    if version == 21 { return 30; }
    if version == 22 { return 24; }
    if version == 23 { return 30; }
    if version == 24 { return 30; }
    if version == 25 { return 28; }
    if version == 26 { return 28; }
    return 30;
  }
  if version == 1 { return 17; }
  if version == 2 { return 28; }
  if version == 3 { return 22; }
  if version == 4 { return 16; }
  if version == 5 { return 22; }
  if version == 6 { return 28; }
  if version == 7 { return 26; }
  if version == 8 { return 26; }
  if version == 9 { return 24; }
  if version == 10 { return 20; }
  if version == 11 { return 24; }
  if version == 12 { return 28; }
  if version == 13 { return 22; }
  if version == 14 { return 24; }
  if version == 15 { return 24; }
  if version == 16 { return 30; }
  if version == 17 { return 28; }
  if version == 18 { return 28; }
  if version == 19 { return 26; }
  if version == 20 { return 30; }
  if version == 21 { return 28; }
  if version == 22 { return 30; }
  if version == 23 { return 30; }
  if version == 24 { return 30; }
  if version == 25 { return 30; }
  if version == 26 { return 28; }
  return 30;
}

export fn block_count(ecc: i32, version: i32) -> i32 {
  if version < 1 || version > 40 { return 0; }
  if ecc == 0 {
    if version <= 5 { return 1; }
    if version <= 9 { return 2; }
    if version <= 13 { return 4; }
    if version <= 17 { return 6; }
    if version == 18 { return 6; }
    if version == 19 { return 7; }
    if version == 20 { return 8; }
    if version <= 22 { return 8; }
    if version <= 24 { return 9; }
    if version == 25 { return 10; }
    if version <= 27 { return 12; }
    if version == 28 { return 13; }
    if version == 29 { return 14; }
    if version == 30 { return 15; }
    if version == 31 { return 16; }
    if version == 32 { return 17; }
    if version == 33 { return 18; }
    if version == 34 { return 19; }
    if version <= 36 { return 19; }
    if version == 37 { return 20; }
    if version == 38 { return 21; }
    if version == 39 { return 22; }
    return 25;
  }
  if ecc == 1 {
    if version <= 3 { return 1; }
    if version <= 5 { return 2; }
    if version <= 8 { return 4; }
    if version == 9 { return 5; }
    if version <= 11 { return 5; }
    if version == 12 { return 8; }
    if version <= 14 { return 9; }
    if version <= 16 { return 10; }
    if version == 17 { return 11; }
    if version == 18 { return 13; }
    if version == 19 { return 14; }
    if version == 20 { return 16; }
    if version <= 22 { return 17; }
    if version == 23 { return 18; }
    if version == 24 { return 20; }
    if version == 25 { return 21; }
    if version == 26 { return 23; }
    if version == 27 { return 25; }
    if version == 28 { return 26; }
    if version == 29 { return 28; }
    if version == 30 { return 29; }
    if version == 31 { return 31; }
    if version == 32 { return 33; }
    if version == 33 { return 35; }
    if version == 34 { return 37; }
    if version == 35 { return 38; }
    if version == 36 { return 40; }
    if version == 37 { return 43; }
    if version == 38 { return 45; }
    if version == 39 { return 47; }
    return 49;
  }
  if ecc == 2 {
    if version <= 2 { return 1; }
    if version <= 4 { return 2; }
    if version <= 6 { return 4; }
    if version <= 8 { return 6; }
    if version <= 11 { return 8; }
    if version == 12 { return 10; }
    if version == 13 { return 12; }
    if version == 14 { return 16; }
    if version == 15 { return 12; }
    if version == 16 { return 17; }
    if version == 17 { return 16; }
    if version == 18 { return 18; }
    if version == 19 { return 21; }
    if version == 20 { return 20; }
    if version == 21 { return 23; }
    if version <= 23 { return 23; }
    if version == 24 { return 25; }
    if version == 25 { return 27; }
    if version == 26 { return 29; }
    if version <= 28 { return 34; }
    if version == 29 { return 35; }
    if version == 30 { return 38; }
    if version == 31 { return 40; }
    if version == 32 { return 43; }
    if version == 33 { return 45; }
    if version == 34 { return 48; }
    if version == 35 { return 51; }
    if version == 36 { return 53; }
    if version == 37 { return 56; }
    if version == 38 { return 59; }
    if version == 39 { return 62; }
    return 68;
  }
  if version <= 2 { return 1; }
  if version == 3 { return 2; }
  if version <= 6 { return 4; }
  if version == 7 { return 5; }
  if version == 8 { return 6; }
  if version <= 10 { return 8; }
  if version <= 12 { return 11; }
  if version <= 14 { return 16; }
  if version == 15 { return 18; }
  if version == 16 { return 16; }
  if version == 17 { return 19; }
  if version == 18 { return 21; }
  if version == 19 { return 25; }
  if version <= 21 { return 25; }
  if version == 22 { return 34; }
  if version == 23 { return 30; }
  if version == 24 { return 32; }
  if version == 25 { return 35; }
  if version == 26 { return 37; }
  if version == 27 { return 40; }
  if version == 28 { return 42; }
  if version == 29 { return 45; }
  if version == 30 { return 48; }
  if version == 31 { return 51; }
  if version == 32 { return 54; }
  if version == 33 { return 57; }
  if version == 34 { return 60; }
  if version == 35 { return 63; }
  if version == 36 { return 66; }
  if version == 37 { return 70; }
  if version == 38 { return 74; }
  if version == 39 { return 77; }
  return 81;
}

export fn total_codewords(version: i32) -> i32 {
  if version < 1 || version > 40 { return 0; }
  // Hard-coded lookup avoids a fragile packed table for the 40 totals.
  if version == 1 { return 26; }
  if version == 2 { return 44; }
  if version == 3 { return 70; }
  if version == 4 { return 100; }
  if version == 5 { return 134; }
  if version == 6 { return 172; }
  if version == 7 { return 196; }
  if version == 8 { return 242; }
  if version == 9 { return 292; }
  if version == 10 { return 346; }
  if version == 11 { return 404; }
  if version == 12 { return 466; }
  if version == 13 { return 532; }
  if version == 14 { return 581; }
  if version == 15 { return 655; }
  if version == 16 { return 733; }
  if version == 17 { return 815; }
  if version == 18 { return 901; }
  if version == 19 { return 991; }
  if version == 20 { return 1085; }
  if version == 21 { return 1156; }
  if version == 22 { return 1258; }
  if version == 23 { return 1364; }
  if version == 24 { return 1474; }
  if version == 25 { return 1588; }
  if version == 26 { return 1706; }
  if version == 27 { return 1828; }
  if version == 28 { return 1921; }
  if version == 29 { return 2051; }
  if version == 30 { return 2185; }
  if version == 31 { return 2323; }
  if version == 32 { return 2465; }
  if version == 33 { return 2611; }
  if version == 34 { return 2761; }
  if version == 35 { return 2876; }
  if version == 36 { return 3034; }
  if version == 37 { return 3196; }
  if version == 38 { return 3362; }
  if version == 39 { return 3532; }
  return 3706;
}

export fn data_codewords(ecc: i32, version: i32) -> i32 {
  let total: i32 = total_codewords(version);
  let blocks: i32 = block_count(ecc, version);
  let ecc_n: i32 = ecc_per_block(ecc, version);
  return total - blocks * ecc_n;
}

export fn count_bits(version: i32) -> i32 {
  if version < 10 { return 8; }
  if version < 27 { return 16; }
  return 16;
}

export fn block_length(data_count: i32, blocks: i32, index: i32) -> i32 {
  let short_len: i32 = data_count / blocks;
  let long_blocks: i32 = data_count - short_len * blocks;
  let first_long: i32 = blocks - long_blocks;
  if index < first_long { return short_len; }
  return short_len + 1;
}

export fn block_offset(data_count: i32, blocks: i32, index: i32) -> i32 {
  let offset: i32 = 0;
  let i: i32 = 0;
  while i < index {
    offset = offset + block_length(data_count, blocks, i);
    i = i + 1;
  }
  return offset;
}

fn interleave_data_row(data: string, data_count: i32, blocks: i32, position: i32) -> string {
  let result: string = "";
  let block: i32 = 0;
  while block < blocks {
    let length: i32 = block_length(data_count, blocks, block);
    if position < length {
      let source_index: i32 = block_offset(data_count, blocks, block) + position;
      result = bytes_push(result, bytes_get(data, source_index));
    }
    block = block + 1;
  }
  return result;
}

fn interleave_data_rows(data: string, data_count: i32, blocks: i32, start: i32, end: i32) -> string {
  if end <= start { return ""; }
  if end - start == 1 { return interleave_data_row(data, data_count, blocks, start); }
  let span: i32 = end - start;
  let middle: i32 = start + span / 2;
  let left: string = interleave_data_rows(data, data_count, blocks, start, middle);
  let right: string = interleave_data_rows(data, data_count, blocks, middle, end);
  return string_concat(left, right);
}

fn interleave_parity_row(parity: string, blocks: i32, ecc_count: i32, position: i32) -> string {
  let result: string = "";
  let block: i32 = 0;
  while block < blocks {
    let parity_index: i32 = block * ecc_count + position;
    result = bytes_push(result, bytes_get(parity, parity_index));
    block = block + 1;
  }
  return result;
}

fn interleave_parity_rows(parity: string, blocks: i32, ecc_count: i32, start: i32, end: i32) -> string {
  if end <= start { return ""; }
  if end - start == 1 { return interleave_parity_row(parity, blocks, ecc_count, start); }
  let span: i32 = end - start;
  let middle: i32 = start + span / 2;
  let left: string = interleave_parity_rows(parity, blocks, ecc_count, start, middle);
  let right: string = interleave_parity_rows(parity, blocks, ecc_count, middle, end);
  return string_concat(left, right);
}

export fn interleave_data(data: string, version: i32, ecc: i32) -> string {
  let data_count: i32 = data_codewords(ecc, version);
  let blocks: i32 = block_count(ecc, version);
  let ecc_count: i32 = ecc_per_block(ecc, version);
  if data_count <= 0 || blocks <= 0 || ecc_count <= 0 { return ""; }

  let max_numerator: i32 = data_count + blocks - 1;
  let max_data: i32 = max_numerator / blocks;
  let result: string = interleave_data_rows(data, data_count, blocks, 0, max_data);

  // Compute each block's parity once, then interleave.
  let all_parity: string = "";
  let block: i32 = 0;
  while block < blocks {
    let start_index: i32 = block_offset(data_count, blocks, block);
    let length: i32 = block_length(data_count, blocks, block);
    let start_char: i32 = start_index * 3;
    let finish_index: i32 = start_index + length;
    let end_char: i32 = finish_index * 3;
    let block_bytes: string = "";
    if start_char >= 0 && end_char >= start_char && end_char <= string_length(data) {
      block_bytes = string_slice(data, start_char, end_char);
    }
    all_parity = string_concat(all_parity, rs_remainder(block_bytes, ecc_count));
    block = block + 1;
  }

  return string_concat(result, interleave_parity_rows(all_parity, blocks, ecc_count, 0, ecc_count));
}

export fn ecc_format(ecc: i32) -> i32 {
  if ecc == 0 { return 1; }
  if ecc == 1 { return 0; }
  if ecc == 2 { return 3; }
  return 2;
}

export fn mask_condition(mask: i32, x: i32, y: i32) -> bool {
  if mask == 0 {
    let sum0: i32 = x + y;
    return sum0 - sum0 / 2 * 2 == 0;
  }
  if mask == 1 { return y - y / 2 * 2 == 0; }
  if mask == 2 { return x - x / 3 * 3 == 0; }
  if mask == 3 {
    let sum3: i32 = x + y;
    return sum3 - sum3 / 3 * 3 == 0;
  }
  if mask == 4 {
    let sum: i32 = y / 2 + x / 3;
    return sum - sum / 2 * 2 == 0;
  }
  let product: i32 = x * y;
  if mask == 5 {
    let a: i32 = product - product / 2 * 2;
    let b: i32 = product - product / 3 * 3;
    return a + b == 0;
  }
  if mask == 6 {
    let a: i32 = product - product / 2 * 2;
    let b: i32 = product - product / 3 * 3;
    let sum: i32 = a + b;
    return sum - sum / 2 * 2 == 0;
  }
  let sum_xy: i32 = x + y;
  let a: i32 = sum_xy - sum_xy / 2 * 2;
  let b: i32 = product - product / 3 * 3;
  let sum: i32 = a + b;
  return sum - sum / 2 * 2 == 0;
}

export fn bitbuf_get(ptr: u32, index: i32) -> bool {
  if index < 0 { return false; }
  let word_index: i32 = index / 32;
  let bit: i32 = index - word_index * 32;
  let word: u32 = u32_from_i32(word_index * 4);
  let value: u32 = memory_load_u32(ptr + word);
  let mask: u32 = 1;
  let b: i32 = 0;
  while b < bit {
    mask = mask + mask;
    b = b + 1;
  }
  let shifted: u32 = value / mask;
  return shifted - shifted / 2 * 2 == 1;
}

export fn bitbuf_set(ptr: u32, index: i32, on: bool) -> unit {
  if index < 0 { return; }
  let word_index: i32 = index / 32;
  let bit: i32 = index - word_index * 32;
  let word: u32 = u32_from_i32(word_index * 4);
  let value: u32 = memory_load_u32(ptr + word);
  let mask: u32 = 1;
  let b: i32 = 0;
  while b < bit {
    mask = mask + mask;
    b = b + 1;
  }
  let shifted: u32 = value / mask;
  let bit_on: bool = shifted - shifted / 2 * 2 == 1;
  if on && !bit_on { memory_store_u32(ptr + word, value + mask); }
  if !on && bit_on { memory_store_u32(ptr + word, value - mask); }
}

// Balanced divide-and-conquer merge keeps total allocation O(n log n) instead of
// O(n^2) for large symbols (rMQR can reach ~2400 bits); a flat left-to-right
// concatenation loop would repeatedly copy the whole growing result and blow the
// fixed 64KiB linear-memory budget for multi-block payloads. A single-bit base
// case avoids any inner loop allocation cost on top of the merge cost.
fn bitbuf_to_bits_range(ptr: u32, start: i32, end: i32) -> string {
  let span: i32 = end - start;
  if span <= 0 { return ""; }
  if span <= 64 {
    let result: string = "";
    let index: i32 = start;
    while index < end {
      result = bits_push(result, bitbuf_get(ptr, index));
      index = index + 1;
    }
    return result;
  }
  let mid: i32 = start + span / 2;
  let left: string = bitbuf_to_bits_range(ptr, start, mid);
  let right: string = bitbuf_to_bits_range(ptr, mid, end);
  return string_concat(left, right);
}

export fn bitbuf_to_bits(ptr: u32, count: i32) -> string {
  if count <= 0 { return ""; }
  return bitbuf_to_bits_range(ptr, 0, count);
}
