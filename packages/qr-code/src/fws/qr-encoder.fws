// Standard QR encoder graph.
// Public ABI: encode_qr(ecc, text) -> "version,size,module-bits" or "" on overflow.
// Matrix construction uses in-place bit buffers to stay inside the 64KiB FWS page.
import "./qr-common.fws" as q;

fn text_bits_range(text: string, start: i32, end: i32) -> string {
  if end <= start { return ""; }
  let span: i32 = end - start;
  if span <= 32 {
    let mut result: string = "";
    let mut index: i32 = start;
    while index < end {
      result = q.bits_push_value(result, string_byte_at(text, index), 8);
      index = index + 1;
    }
    return string_concat("", result);
  }
  let middle: i32 = start + span / 2;
  let left: string = text_bits_range(text, start, middle);
  let right: string = text_bits_range(text, middle, end);
  return string_concat(left, right);
}

fn pad_bits_range(start: i32, end: i32) -> string {
  if end <= start { return ""; }
  let span: i32 = end - start;
  if span <= 64 {
    let mut result: string = "";
    let mut index: i32 = start;
    while index < end {
      let mut pad: i32 = 236;
      if index / 8 % 2 == 1 { pad = 17; }
      result = q.bits_push(result, q.bit_test(pad, 7 - index % 8));
      index = index + 1;
    }
    return string_concat("", result);
  }
  let middle: i32 = start + span / 2;
  let left: string = pad_bits_range(start, middle);
  let right: string = pad_bits_range(middle, end);
  return string_concat(left, right);
}

fn data_bits(text: string, version: i32, ecc: i32) -> string {
  let capacity: i32 = q.data_codewords(ecc, version) * 8;
  let count: i32 = string_length(text);
  let mut result: string = q.bits_push_value("", 4, 4);
  result = q.bits_push_value(result, count, q.count_bits(version));
  result = string_concat(result, text_bits_range(text, 0, count));
  let remaining: i32 = capacity - string_length(result);
  let mut terminator: i32 = remaining;
  if terminator > 4 { terminator = 4; }
  if terminator < 0 { terminator = 0; }
  result = string_concat(result, q.bits_zeros(terminator));
  let mut align: i32 = 8 - string_length(result) % 8;
  if align == 8 { align = 0; }
  result = string_concat(result, q.bits_zeros(align));
  result = string_concat(result, pad_bits_range(string_length(result), capacity));
  // Cap exactly at capacity (should already be aligned).
  if string_length(result) > capacity {
    result = string_slice(result, 0, capacity);
  }
  return string_concat("", result);
}


fn alignment_position(version: i32, index: i32, count: i32, size: i32) -> i32 {
  if index == 0 { return 6; }
  let step_numerator: i32 = version * 8 + count * 3 + 5;
  let step_denominator: i32 = count * 4 - 4;
  let step: i32 = step_numerator / step_denominator * 2;
  let last: i32 = size - 7;
  let distance: i32 = count - 1 - index;
  return last - step * distance;
}

fn set_xy(modules: u32, reserved: u32, size: i32, x: i32, y: i32, on: bool, mark_reserved: bool) -> unit {
  if x < 0 || y < 0 || x >= size || y >= size { return; }
  let index: i32 = y * size + x;
  q.bitbuf_set(modules, index, on);
  if mark_reserved { q.bitbuf_set(reserved, index, true); }
}

fn draw_finder(modules: u32, reserved: u32, size: i32, cx: i32, cy: i32) -> unit {
  let mut dy: i32 = -4;
  while dy <= 4 {
    let mut dx: i32 = -4;
    while dx <= 4 {
      let x: i32 = cx + dx;
      let y: i32 = cy + dy;
      if x >= 0 && x < size && y >= 0 && y < size {
        let mut adx: i32 = dx;
        if adx < 0 { adx = 0 - adx; }
        let mut ady: i32 = dy;
        if ady < 0 { ady = 0 - ady; }
        let mut distance: i32 = adx;
        if ady > distance { distance = ady; }
        // Chebyshev distance rings: dark except ring 2 (white) and ring 4 (separator white).
        let on: bool = distance != 2 && distance != 4;
        set_xy(modules, reserved, size, x, y, on, true);
      }
      dx = dx + 1;
    }
    dy = dy + 1;
  }
}

fn draw_alignment_module(modules: u32, reserved: u32, size: i32, cx: i32, cy: i32, dx: i32, dy: i32) -> unit {
  let outer_x: bool = dx == -2 || dx == 2;
  let outer_y: bool = dy == -2 || dy == 2;
  let center: bool = dx == 0 && dy == 0;
  set_xy(modules, reserved, size, cx + dx, cy + dy, outer_x || outer_y || center, true);
}

fn draw_alignment_modules_row(modules: u32, reserved: u32, size: i32, cx: i32, cy: i32, dy: i32) -> unit {
  draw_alignment_module(modules, reserved, size, cx, cy, -2, dy);
  draw_alignment_module(modules, reserved, size, cx, cy, -1, dy);
  draw_alignment_module(modules, reserved, size, cx, cy, 0, dy);
  draw_alignment_module(modules, reserved, size, cx, cy, 1, dy);
  draw_alignment_module(modules, reserved, size, cx, cy, 2, dy);
}

fn version_value(version: i32) -> i32 {
  let data: i32 = version * 4096;
  let mut rem: i32 = data;
  let mut index: i32 = 0;
  while index < 12 {
    let high: i32 = rem / 4096;
    rem = rem * 2;
    if high == 1 { rem = q.xor_value(rem, 7973, 13); }
    index = index + 1;
  }
  return data + rem;
}

fn draw_version_top_right(modules: u32, reserved: u32, size: i32, bits: i32) -> unit {
  let mut index: i32 = 0;
  while index < 18 {
    let x: i32 = size - 11 + index % 3;
    let y: i32 = index / 3;
    set_xy(modules, reserved, size, x, y, q.bit_test(bits, index), true);
    index = index + 1;
  }
}

fn draw_version_bottom_left(modules: u32, reserved: u32, size: i32, bits: i32) -> unit {
  let mut index: i32 = 0;
  while index < 18 {
    let x: i32 = index / 3;
    let y: i32 = size - 11 + index % 3;
    set_xy(modules, reserved, size, x, y, q.bit_test(bits, index), true);
    index = index + 1;
  }
}

fn draw_version(modules: u32, reserved: u32, version: i32, size: i32) -> unit {
  if version < 7 { return; }
  let bits: i32 = version_value(version);
  draw_version_top_right(modules, reserved, size, bits);
  draw_version_bottom_left(modules, reserved, size, bits);
}

fn draw_alignment(modules: u32, reserved: u32, size: i32, cx: i32, cy: i32) -> unit {
  draw_alignment_modules_row(modules, reserved, size, cx, cy, -2);
  draw_alignment_modules_row(modules, reserved, size, cx, cy, -1);
  draw_alignment_modules_row(modules, reserved, size, cx, cy, 0);
  draw_alignment_modules_row(modules, reserved, size, cx, cy, 1);
  draw_alignment_modules_row(modules, reserved, size, cx, cy, 2);
}

fn format_value(ecc: i32, mask: i32) -> i32 {
  let data: i32 = q.ecc_format(ecc) * 8 + mask;
  let mut rem: i32 = data;
  let mut index: i32 = 0;
  while index < 10 {
    let high: i32 = rem / 512;
    rem = rem * 2;
    if high == 1 { rem = q.xor_value(rem, 1335, 11); }
    index = index + 1;
  }
  let combined: i32 = data * 1024 + rem;
  return q.xor_value(combined, 21522, 15);
}

// Format helpers stay single-loop: FWS codegen hangs when a u32 value is used
// across two sequential loops in one function, so each loop lives in its own fn.
fn draw_format_top_left_a(modules: u32, reserved: u32, size: i32, bits: i32, mark_reserved: bool) -> unit {
  let mut index: i32 = 0;
  while index <= 5 {
    set_xy(modules, reserved, size, 8, index, q.bit_test(bits, index), mark_reserved);
    index = index + 1;
  }
}

fn draw_format_top_left_b(modules: u32, reserved: u32, size: i32, bits: i32, mark_reserved: bool) -> unit {
  let mut index: i32 = 9;
  while index < 15 {
    set_xy(modules, reserved, size, 14 - index, 8, q.bit_test(bits, index), mark_reserved);
    index = index + 1;
  }
}

fn draw_format_bottom_right_low(modules: u32, reserved: u32, size: i32, bits: i32, mark_reserved: bool) -> unit {
  let mut index: i32 = 0;
  while index < 8 {
    set_xy(modules, reserved, size, size - 1 - index, 8, q.bit_test(bits, index), mark_reserved);
    index = index + 1;
  }
}

fn draw_format_bottom_right_high(modules: u32, reserved: u32, size: i32, bits: i32, mark_reserved: bool) -> unit {
  let mut index: i32 = 8;
  while index < 15 {
    set_xy(modules, reserved, size, 8, size - 15 + index, q.bit_test(bits, index), mark_reserved);
    index = index + 1;
  }
}

fn draw_format(modules: u32, reserved: u32, size: i32, ecc: i32, mask: i32, mark_reserved: bool) -> unit {
  let bits: i32 = format_value(ecc, mask);
  draw_format_top_left_a(modules, reserved, size, bits, mark_reserved);
  set_xy(modules, reserved, size, 8, 7, q.bit_test(bits, 6), mark_reserved);
  set_xy(modules, reserved, size, 8, 8, q.bit_test(bits, 7), mark_reserved);
  set_xy(modules, reserved, size, 7, 8, q.bit_test(bits, 8), mark_reserved);
  draw_format_top_left_b(modules, reserved, size, bits, mark_reserved);
  draw_format_bottom_right_low(modules, reserved, size, bits, mark_reserved);
  draw_format_bottom_right_high(modules, reserved, size, bits, mark_reserved);
  set_xy(modules, reserved, size, 8, size - 8, true, mark_reserved);
}

fn draw_timing(modules: u32, reserved: u32, size: i32) -> unit {
  let mut index: i32 = 0;
  while index < size {
    set_xy(modules, reserved, size, 6, index, index % 2 == 0, true);
    set_xy(modules, reserved, size, index, 6, index % 2 == 0, true);
    index = index + 1;
  }
}

fn draw_alignment_cell(modules: u32, reserved: u32, version: i32, size: i32, count: i32, a: i32, b: i32) -> unit {
  if a == 0 && b == 0 { return; }
  if a == 0 && b == count - 1 { return; }
  if a == count - 1 && b == 0 { return; }
  let x: i32 = alignment_position(version, a, count, size);
  let y: i32 = alignment_position(version, b, count, size);
  draw_alignment(modules, reserved, size, x, y);
}

fn draw_alignment_row(modules: u32, reserved: u32, version: i32, size: i32, count: i32, a: i32) -> unit {
  let mut b: i32 = 0;
  while b < count {
    draw_alignment_cell(modules, reserved, version, size, count, a, b);
    b = b + 1;
  }
}

fn draw_alignments(modules: u32, reserved: u32, version: i32, size: i32, count: i32) -> unit {
  let mut a: i32 = 0;
  while a < count {
    draw_alignment_row(modules, reserved, version, size, count, a);
    a = a + 1;
  }
}

fn draw_function_patterns(modules: u32, reserved: u32, version: i32, ecc: i32) -> unit {
  let size: i32 = version * 4 + 17;
  draw_timing(modules, reserved, size);
  draw_finder(modules, reserved, size, 3, 3);
  draw_finder(modules, reserved, size, size - 4, 3);
  draw_finder(modules, reserved, size, 3, size - 4);
  let mut count: i32 = 0;
  if version > 1 { count = version / 7 + 2; }
  draw_alignments(modules, reserved, version, size, count);
  draw_version(modules, reserved, version, size);
  // Reserve format areas (values filled later per mask).
  draw_format(modules, reserved, size, ecc, 0, true);
}

// Reads codeword bits directly from the packed byte string (3 chars/byte, MSB
// first) to avoid materializing a full bit string, which would overflow the
// single 64KiB FWS page for larger versions.
fn draw_data(modules: u32, reserved: u32, size: i32, codewords: string) -> unit {
  let mut bit_index: i32 = 0;
  let bit_count: i32 = string_length(codewords) / 3 * 8;
  let mut right: i32 = size - 1;
  while right >= 1 {
    if right == 6 { right = 5; }
    let mut vertical: i32 = 0;
    while vertical < size {
      let mut pair: i32 = 0;
      while pair < 2 {
        let x: i32 = right - pair;
        let right_plus_one: i32 = right + 1;
        let upward: bool = right_plus_one % 4 == 0;
        let mut y: i32 = vertical;
        if upward { y = size - 1 - vertical; }
        let index: i32 = y * size + x;
        if !q.bitbuf_get(reserved, index) && bit_index < bit_count {
          let byte_index: i32 = bit_index / 8;
          let bit_in_byte: i32 = bit_index - byte_index * 8;
          let value: i32 = q.bytes_get(codewords, byte_index);
          let on: bool = q.bit_test(value, 7 - bit_in_byte);
          q.bitbuf_set(modules, index, on);
          bit_index = bit_index + 1;
        }
        pair = pair + 1;
      }
      vertical = vertical + 1;
    }
    right = right - 2;
  }
}

fn apply_mask(modules: u32, reserved: u32, size: i32, mask: i32) -> unit {
  let mut y: i32 = 0;
  while y < size {
    let mut x: i32 = 0;
    while x < size {
      let index: i32 = y * size + x;
      if !q.bitbuf_get(reserved, index) && q.mask_condition(mask, x, y) {
        q.bitbuf_set(modules, index, !q.bitbuf_get(modules, index));
      }
      x = x + 1;
    }
    y = y + 1;
  }
}

// N1 rows: adjacent same-color runs along each row.
fn penalty_n1_rows(modules: u32, size: i32) -> i32 {
  let mut score: i32 = 0;
  let mut y: i32 = 0;
  while y < size {
    let mut x: i32 = 0;
    while x < size {
      let mut run: i32 = 1;
      while x + run < size && q.bitbuf_get(modules, y * size + x) == q.bitbuf_get(modules, y * size + x + run) {
        run = run + 1;
      }
      if run >= 5 {
        let extra: i32 = run - 5;
        score = score + 3 + extra;
      }
      x = x + run;
    }
    y = y + 1;
  }
  return score;
}

// N1 cols: adjacent same-color runs along each column.
fn penalty_n1_cols(modules: u32, size: i32) -> i32 {
  let mut score: i32 = 0;
  let mut x: i32 = 0;
  while x < size {
    let mut y: i32 = 0;
    while y < size {
      let mut run: i32 = 1;
      let mut y_run: i32 = y + run;
      while y_run < size && q.bitbuf_get(modules, y * size + x) == q.bitbuf_get(modules, y_run * size + x) {
        run = run + 1;
        y_run = y + run;
      }
      if run >= 5 {
        let extra: i32 = run - 5;
        score = score + 3 + extra;
      }
      y = y + run;
    }
    x = x + 1;
  }
  return score;
}

// N2: 2x2 same-color blocks.
fn penalty_n2(modules: u32, size: i32) -> i32 {
  let mut score: i32 = 0;
  let mut y: i32 = 0;
  while y + 1 < size {
    let mut x: i32 = 0;
    while x + 1 < size {
      let c: bool = q.bitbuf_get(modules, y * size + x);
      let y1: i32 = y + 1;
      if c == q.bitbuf_get(modules, y * size + x + 1) && c == q.bitbuf_get(modules, y1 * size + x) && c == q.bitbuf_get(modules, y1 * size + x + 1) {
        score = score + 3;
      }
      x = x + 1;
    }
    y = y + 1;
  }
  return score;
}

// N3 rows: finder-like 1:1:3:1:1 patterns along rows.
fn penalty_n3_rows(modules: u32, size: i32) -> i32 {
  let mut score: i32 = 0;
  let mut y: i32 = 0;
  while y < size {
    let mut x: i32 = 0;
    while x + 6 < size {
      let b0: bool = q.bitbuf_get(modules, y * size + x);
      let b1: bool = q.bitbuf_get(modules, y * size + x + 1);
      let b2: bool = q.bitbuf_get(modules, y * size + x + 2);
      let b3: bool = q.bitbuf_get(modules, y * size + x + 3);
      let b4: bool = q.bitbuf_get(modules, y * size + x + 4);
      let b5: bool = q.bitbuf_get(modules, y * size + x + 5);
      let b6: bool = q.bitbuf_get(modules, y * size + x + 6);
      if b0 && !b1 && b2 && b3 && b4 && !b5 && b6 { score = score + 40; }
      x = x + 1;
    }
    y = y + 1;
  }
  return score;
}

// N3 cols: finder-like 1:1:3:1:1 patterns along columns.
fn penalty_n3_cols(modules: u32, size: i32) -> i32 {
  let mut score: i32 = 0;
  let mut x: i32 = 0;
  while x < size {
    let mut y: i32 = 0;
    while y + 6 < size {
      let b0: bool = q.bitbuf_get(modules, y * size + x);
      let b1: bool = q.bitbuf_get(modules, y * size + x + size);
      let b2: bool = q.bitbuf_get(modules, y * size + x + size * 2);
      let b3: bool = q.bitbuf_get(modules, y * size + x + size * 3);
      let b4: bool = q.bitbuf_get(modules, y * size + x + size * 4);
      let b5: bool = q.bitbuf_get(modules, y * size + x + size * 5);
      let b6: bool = q.bitbuf_get(modules, y * size + x + size * 6);
      if b0 && !b1 && b2 && b3 && b4 && !b5 && b6 { score = score + 40; }
      y = y + 1;
    }
    x = x + 1;
  }
  return score;
}

// N4: penalty for deviation from 50% dark proportion.
fn penalty_n4(modules: u32, size: i32) -> i32 {
  let mut dark: i32 = 0;
  let total: i32 = size * size;
  let mut i: i32 = 0;
  while i < total {
    if q.bitbuf_get(modules, i) { dark = dark + 1; }
    i = i + 1;
  }
  let percent: i32 = dark * 100 / total;
  let mut k: i32 = percent - 50;
  if k < 0 { k = 0 - k; }
  return k / 5 * 10;
}

fn penalty_score(modules: u32, size: i32) -> i32 {
  let mut score: i32 = 0;
  score = score + penalty_n1_rows(modules, size);
  score = score + penalty_n1_cols(modules, size);
  score = score + penalty_n2(modules, size);
  score = score + penalty_n3_rows(modules, size);
  score = score + penalty_n3_cols(modules, size);
  score = score + penalty_n4(modules, size);
  return score;
}

fn clear_nonreserved(modules: u32, reserved: u32, size: i32) -> unit {
  let total: i32 = size * size;
  let mut i: i32 = 0;
  while i < total {
    if !q.bitbuf_get(reserved, i) {
      q.bitbuf_set(modules, i, false);
    }
    i = i + 1;
  }
}

fn build_matrix(version: i32, ecc: i32, codewords: string) -> string {
  let size: i32 = version * 4 + 17;
  let total: i32 = size * size;
  let modules: u32 = q.bitbuf_alloc(total);
  let reserved: u32 = q.bitbuf_alloc(total);
  draw_function_patterns(modules, reserved, version, ecc);
  clear_nonreserved(modules, reserved, size);
  draw_data(modules, reserved, size, codewords);

  // Evaluate masks without copying full buffers: apply, score, then undo.
  let mut best_mask: i32 = 0;
  let mut best_score: i32 = 1000000000;
  let mut mask: i32 = 0;
  while mask < 8 {
    apply_mask(modules, reserved, size, mask);
    draw_format(modules, reserved, size, ecc, mask, false);
    let score: i32 = penalty_score(modules, size);
    if score < best_score {
      best_score = score;
      best_mask = mask;
    }
    // Undo mask XOR (format overwritten each trial).
    apply_mask(modules, reserved, size, mask);
    mask = mask + 1;
  }

  apply_mask(modules, reserved, size, best_mask);
  draw_format(modules, reserved, size, ecc, best_mask, false);
  return string_concat("", q.bitbuf_to_bits(modules, total));
}

export fn encode_qr(ecc: i32, text: string) -> string {
  if ecc < 0 || ecc > 3 { return ""; }
  let mut version: i32 = 1;
  while version <= 40 {
    let capacity_bits: i32 = q.data_codewords(ecc, version) * 8;
    let header: i32 = 4 + q.count_bits(version);
    let need: i32 = header + string_length(text) * 8;
    if need <= capacity_bits {
      let bits: string = data_bits(text, version, ecc);
      let data: string = q.bits_to_bytes(bits);
      let interleaved: string = q.interleave_data(data, version, ecc);
      let modules: string = build_matrix(version, ecc, interleaved);
      let size: i32 = version * 4 + 17;
      return string_concat( string_concat(q.itoa(version), string_concat(",", string_concat(q.itoa(size), ","))), modules );
    }
    version = version + 1;
  }
  return "";
}

// Focused test exports (no temporary isolation probes).
export fn __test_tables(ecc: i32) -> string {
  return string_concat(q.itoa(q.block_count(ecc, 1)), string_concat(",", q.itoa(q.ecc_per_block(ecc, 1))));
}

export fn __test_interleave(ecc: i32, data: string) -> string {
  return string_concat("", q.interleave_data(data, 1, ecc));
}

export fn __test_gf256_mul(a: i32, b: i32) -> i32 { return q.gf_mul(a, b); }

export fn __test_rs_remainder(data: string, count: i32) -> string { return string_concat("", q.rs_remainder(data, count)); }
