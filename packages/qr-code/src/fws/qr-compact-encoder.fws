// Compact QR encoder graph.
//
// The compact entry points intentionally use the same packed string ABI as the
// Rust wrappers: `width,height,row-major-bits`, or an empty string when no
// compact symbol can hold the UTF-8 byte payload.  The implementation keeps
// matrix construction in linear memory; this is important because an FWS
// instance has one 64KiB page and string replacement is not reclaimed during
// an export call.
import "./qr-common.fws" as q;
import "./qr-rmqr-encoder.fws" as rmqr;

fn byte_at(text: string, index: i32) -> i32 {
  if index < 0 || index >= string_length(text) { return 0; }
  return string_byte_at(text, index);
}

fn payload_bit(text: string, index: i32) -> bool {
  if index < 0 { return false; }
  let byte_index: i32 = index / 8;
  let bit_index: i32 = index - byte_index * 8;
  let value: i32 = byte_at(text, byte_index);
  return q.bit_test(value, 7 - bit_index);
}

fn all_numeric(text: string) -> bool {
  let mut index: i32 = 0;
  while index < string_length(text) {
    let value: i32 = byte_at(text, index);
    if value < 48 || value > 57 { return false; }
    index = index + 1;
  }
  return true;
}

fn numeric_bits(text: string) -> i32 {
  let mut result: i32 = 0;
  let mut index: i32 = 0;
  while index + 3 <= string_length(text) {
    result = result + 10;
    index = index + 3;
  }
  let remaining: i32 = string_length(text) - index;
  if remaining == 1 { result = result + 4; }
  if remaining == 2 { result = result + 7; }
  return result;
}

fn append_numeric_from(data: string, text: string, index: i32, count: i32) -> string {
  let remaining: i32 = count - index;
  if remaining <= 0 { return data; }
  if remaining == 1 {
    return string_concat("", q.bits_push_value(data, byte_at(text, index) - 48, 4));
  }
  if remaining == 2 {
    let first: i32 = byte_at(text, index) - 48;
    let second: i32 = byte_at(text, index + 1) - 48;
    return string_concat("", q.bits_push_value(data, first * 10 + second, 7));
  }
  let a: i32 = byte_at(text, index) - 48;
  let b: i32 = byte_at(text, index + 1) - 48;
  let c: i32 = byte_at(text, index + 2) - 48;
  let next: string = q.bits_push_value(data, a * 100 + b * 10 + c, 10);
  return string_concat("", append_numeric_from(next, text, index + 3, count));
}

fn append_numeric(data: string, text: string) -> string {
  return string_concat("", append_numeric_from(data, text, 0, string_length(text)));
}

fn micro_m1_numeric_data(text: string) -> string {
  let count: i32 = string_length(text);
  let mut result: string = "";
  result = q.bits_push_value(result, count, 3);
  if count <= 0 { return string_concat("", result); }
  if count == 1 {
    return string_concat("", q.bits_push_value(result, byte_at(text, 0) - 48, 4));
  }
  if count == 2 {
    let digit0: i32 = byte_at(text, 0) - 48;
    let digit1: i32 = byte_at(text, 1) - 48;
    let value: i32 = digit0 * 10 + digit1;
    return string_concat("", q.bits_push_value(result, value, 7));
  }
  let digit0: i32 = byte_at(text, 0) - 48;
  let digit1: i32 = byte_at(text, 1) - 48;
  let digit2: i32 = byte_at(text, 2) - 48;
  let first_three: i32 = digit0 * 100 + digit1 * 10 + digit2;
  result = string_concat("", q.bits_push_value(result, first_three, 10));
  if count == 3 { return string_concat("", result); }
  if count == 4 {
    return string_concat("", q.bits_push_value(result, byte_at(text, 3) - 48, 4));
  }
  let digit3: i32 = byte_at(text, 3) - 48;
  let digit4: i32 = byte_at(text, 4) - 48;
  let tail: i32 = digit3 * 10 + digit4;
  return string_concat("", q.bits_push_value(result, tail, 7));
}

fn micro_capacity(version: i32, rank: i32) -> i32 {
  if version == 0 { if rank == 0 { return 20; } return 0; }
  if version == 1 { if rank == 0 { return 40; } return 32; }
  if version == 2 { if rank == 0 { return 84; } return 68; }
  if rank == 0 { return 128; }
  if rank == 1 { return 112; }
  return 80;
}

fn micro_size(version: i32) -> i32 { return 11 + version * 2; }

fn micro_data_bits(text: string, version: i32, numeric: bool) -> i32 {
  let header: i32 = version;
  if numeric {
    let numeric_count_bits: i32 = version + 3;
    return header + numeric_count_bits + numeric_bits(text);
  }
  let mut payload_count_bits: i32 = 4;
  if version == 3 { payload_count_bits = 5; }
  return header + payload_count_bits + string_length(text) * 8;
}

fn micro_numeric_data(text: string, version: i32) -> string {
  if version == 0 { return string_concat("", micro_m1_numeric_data(text)); }
  let mut result: string = "";
  if version > 0 { result = string_concat("", q.bits_push_value(result, 0, version)); }
  result = string_concat("", q.bits_push_value(result, string_length(text), version + 3));
  return string_concat("", append_numeric(result, text));
}

fn micro_byte_data(text: string, version: i32) -> string {
  let mut result: string = "";
  result = string_concat("", q.bits_push_value(result, 2, version));
  let mut mode_count_bits: i32 = 4;
  if version == 3 { mode_count_bits = 5; }
  result = string_concat("", q.bits_push_value(result, string_length(text), mode_count_bits));
  let mut index: i32 = 0;
  while index < string_length(text) {
    result = string_concat("", q.bits_push_value(result, byte_at(text, index), 8));
    index = index + 1;
  }
  return string_concat("", result);
}

fn micro_pad_short(result: string, capacity: i32, terminator: i32) -> string {
  let mut padded: string = string_concat(result, q.bits_zeros(terminator));
  while string_length(padded) < capacity {
    padded = string_concat(padded, "0");
  }
  return string_concat("", padded);
}

fn micro_pad_full(result: string, capacity: i32, terminator: i32) -> string {
  let mut padded: string = string_concat(result, q.bits_zeros(terminator));
  let mut align: i32 = 8 - string_length(padded) % 8;
  if align == 8 { align = 0; }
  if align > capacity - string_length(padded) { align = capacity - string_length(padded); }
  padded = string_concat(padded, q.bits_zeros(align));
  let mut pad: i32 = 236;
  while string_length(padded) + 8 <= capacity {
    padded = string_concat("", q.bits_push_value(padded, pad, 8));
    if pad == 236 { pad = 17; } else { pad = 236; }
  }
  while string_length(padded) < capacity {
    padded = string_concat(padded, "0");
  }
  return string_concat("", padded);
}

fn micro_make_data(text: string, version: i32, capacity: i32, numeric: bool) -> string {
  let mut result: string = "";
  if numeric {
    result = micro_numeric_data(text, version);
  } else {
    result = micro_byte_data(text, version);
  }
  let remaining: i32 = capacity - string_length(result);
  let mut terminator: i32 = version * 2 + 3;
  if terminator > remaining { terminator = remaining; }
  if terminator < 0 { terminator = 0; }
  if version == 0 || version == 2 { return string_concat("", micro_pad_short(result, capacity, terminator)); }
  return string_concat("", micro_pad_full(result, capacity, terminator));
}

fn micro_pack_bytes(bits: string, short: bool) -> string {
  let full: i32 = string_length(bits) / 8;
  let mut result: string = "";
  let mut index: i32 = 0;
  while index < full {
    let mut value: i32 = 0;
    let mut bit: i32 = 0;
    while bit < 8 {
      value = value * 2;
      if q.bits_get(bits, index * 8 + bit) { value = value + 1; }
      bit = bit + 1;
    }
    result = q.bytes_push(result, value);
    index = index + 1;
  }
  if short && string_length(bits) - full * 8 >= 4 {
    let mut value: i32 = 0;
    let mut bit: i32 = 0;
    while bit < 4 {
      value = value * 2;
      if q.bits_get(bits, full * 8 + bit) { value = value + 1; }
      bit = bit + 1;
    }
    result = q.bytes_push(result, value * 16);
  }
  return string_concat("", result);
}

fn micro_set(modules: u32, reserved: u32, size: i32, x: i32, y: i32, on: bool, mark: bool) -> unit {
  if x < 0 || y < 0 || x >= size || y >= size { return; }
  let index: i32 = y * size + x;
  q.bitbuf_set(modules, index, on);
  if mark { q.bitbuf_set(reserved, index, true); }
}

fn micro_total_codewords(version: i32) -> i32 {
  if version == 0 { return 5; }
  if version == 1 { return 10; }
  if version == 2 { return 17; }
  return 24;
}

fn micro_data_codewords(version: i32, rank: i32) -> i32 {
  if version == 0 { return 3; }
  if version == 1 {
    if rank == 0 { return 5; }
    return 4;
  }
  if version == 2 {
    if rank == 0 { return 11; }
    return 9;
  }
  if rank == 0 { return 16; }
  if rank == 1 { return 14; }
  return 10;
}

fn micro_symbol(version: i32, rank: i32) -> i32 {
  if version == 0 { return 0; }
  if version == 1 {
    if rank == 0 { return 1; }
    return 2;
  }
  if version == 2 {
    if rank == 0 { return 3; }
    return 4;
  }
  if rank == 0 { return 5; }
  if rank == 1 { return 6; }
  return 7;
}

fn micro_data_codeword_bits(data: string, short: bool) -> string {
  let mut result: string = "";
  let data_count: i32 = string_length(data) / 3;
  let mut index: i32 = 0;
  while index < data_count {
    let value: i32 = q.bytes_get(data, index);
    if short && index == data_count - 1 {
      result = q.bits_push_value(result, value / 16, 4);
    } else {
      result = string_concat("", q.bits_push_value(result, value, 8));
    }
    index = index + 1;
  }
  return string_concat("", result);
}

fn micro_ecc_bits(parity: string, ecc_count: i32) -> string {
  let mut result: string = "";
  let mut index: i32 = 0;
  while index < ecc_count {
    result = string_concat("", q.bits_push_value(result, q.bytes_get(parity, index), 8));
    index = index + 1;
  }
  return string_concat("", result);
}

fn micro_final_bits(data: string, short: bool, ecc_count: i32) -> string {
  let parity: string = q.rs_remainder(data, ecc_count);
  let data_bits: string = micro_data_codeword_bits(data, short);
  let ecc_bits: string = micro_ecc_bits(parity, ecc_count);
  return string_concat(data_bits, ecc_bits);
}

fn micro_reserve_format(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 8, 0, false, true);
  micro_set(modules, reserved, size, 8, 1, false, true);
  micro_set(modules, reserved, size, 8, 2, false, true);
  micro_set(modules, reserved, size, 8, 3, false, true);
  micro_set(modules, reserved, size, 8, 4, false, true);
  micro_set(modules, reserved, size, 8, 5, false, true);
  micro_set(modules, reserved, size, 8, 6, false, true);
  micro_set(modules, reserved, size, 8, 7, false, true);
  micro_set(modules, reserved, size, 8, 8, false, true);
  micro_set(modules, reserved, size, 0, 8, false, true);
  micro_set(modules, reserved, size, 1, 8, false, true);
  micro_set(modules, reserved, size, 2, 8, false, true);
  micro_set(modules, reserved, size, 3, 8, false, true);
  micro_set(modules, reserved, size, 4, 8, false, true);
  micro_set(modules, reserved, size, 5, 8, false, true);
  micro_set(modules, reserved, size, 6, 8, false, true);
  micro_set(modules, reserved, size, 7, 8, false, true);
  micro_set(modules, reserved, size, 8, 8, false, true);
}

fn micro_finder_row0(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 0, true, true);
  micro_set(modules, reserved, size, 1, 0, true, true);
  micro_set(modules, reserved, size, 2, 0, true, true);
  micro_set(modules, reserved, size, 3, 0, true, true);
  micro_set(modules, reserved, size, 4, 0, true, true);
  micro_set(modules, reserved, size, 5, 0, true, true);
  micro_set(modules, reserved, size, 6, 0, true, true);
  micro_set(modules, reserved, size, 7, 0, false, true);
}

fn micro_finder_row1(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 1, true, true);
  micro_set(modules, reserved, size, 1, 1, false, true);
  micro_set(modules, reserved, size, 2, 1, false, true);
  micro_set(modules, reserved, size, 3, 1, false, true);
  micro_set(modules, reserved, size, 4, 1, false, true);
  micro_set(modules, reserved, size, 5, 1, false, true);
  micro_set(modules, reserved, size, 6, 1, true, true);
  micro_set(modules, reserved, size, 7, 1, false, true);
}

fn micro_finder_row2(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 2, true, true);
  micro_set(modules, reserved, size, 1, 2, false, true);
  micro_set(modules, reserved, size, 2, 2, true, true);
  micro_set(modules, reserved, size, 3, 2, true, true);
  micro_set(modules, reserved, size, 4, 2, true, true);
  micro_set(modules, reserved, size, 5, 2, false, true);
  micro_set(modules, reserved, size, 6, 2, true, true);
  micro_set(modules, reserved, size, 7, 2, false, true);
}

fn micro_finder_row3(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 3, true, true);
  micro_set(modules, reserved, size, 1, 3, false, true);
  micro_set(modules, reserved, size, 2, 3, true, true);
  micro_set(modules, reserved, size, 3, 3, true, true);
  micro_set(modules, reserved, size, 4, 3, true, true);
  micro_set(modules, reserved, size, 5, 3, false, true);
  micro_set(modules, reserved, size, 6, 3, true, true);
  micro_set(modules, reserved, size, 7, 3, false, true);
}

fn micro_finder_row4(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 4, true, true);
  micro_set(modules, reserved, size, 1, 4, false, true);
  micro_set(modules, reserved, size, 2, 4, true, true);
  micro_set(modules, reserved, size, 3, 4, true, true);
  micro_set(modules, reserved, size, 4, 4, true, true);
  micro_set(modules, reserved, size, 5, 4, false, true);
  micro_set(modules, reserved, size, 6, 4, true, true);
  micro_set(modules, reserved, size, 7, 4, false, true);
}

fn micro_finder_row5(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 5, true, true);
  micro_set(modules, reserved, size, 1, 5, false, true);
  micro_set(modules, reserved, size, 2, 5, false, true);
  micro_set(modules, reserved, size, 3, 5, false, true);
  micro_set(modules, reserved, size, 4, 5, false, true);
  micro_set(modules, reserved, size, 5, 5, false, true);
  micro_set(modules, reserved, size, 6, 5, true, true);
  micro_set(modules, reserved, size, 7, 5, false, true);
}

fn micro_finder_row6(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 6, true, true);
  micro_set(modules, reserved, size, 1, 6, true, true);
  micro_set(modules, reserved, size, 2, 6, true, true);
  micro_set(modules, reserved, size, 3, 6, true, true);
  micro_set(modules, reserved, size, 4, 6, true, true);
  micro_set(modules, reserved, size, 5, 6, true, true);
  micro_set(modules, reserved, size, 6, 6, true, true);
  micro_set(modules, reserved, size, 7, 6, false, true);
}

fn micro_finder_row7(modules: u32, reserved: u32, size: i32) -> unit {
  micro_set(modules, reserved, size, 0, 7, false, true);
  micro_set(modules, reserved, size, 1, 7, false, true);
  micro_set(modules, reserved, size, 2, 7, false, true);
  micro_set(modules, reserved, size, 3, 7, false, true);
  micro_set(modules, reserved, size, 4, 7, false, true);
  micro_set(modules, reserved, size, 5, 7, false, true);
  micro_set(modules, reserved, size, 6, 7, false, true);
  micro_set(modules, reserved, size, 7, 7, false, true);
}

fn micro_finder(modules: u32, reserved: u32, size: i32) -> unit {
  micro_finder_row0(modules, reserved, size);
  micro_finder_row1(modules, reserved, size);
  micro_finder_row2(modules, reserved, size);
  micro_finder_row3(modules, reserved, size);
  micro_finder_row4(modules, reserved, size);
  micro_finder_row5(modules, reserved, size);
  micro_finder_row6(modules, reserved, size);
  micro_finder_row7(modules, reserved, size);
}

fn micro_timing(modules: u32, reserved: u32, size: i32) -> unit {
  let mut index: i32 = 8;
  while index < size {
    let delta: i32 = index - 8;
    let on: bool = delta % 2 == 0;
    micro_set(modules, reserved, size, 0, index, on, true);
    micro_set(modules, reserved, size, index, 0, on, true);
    index = index + 1;
  }
}

fn micro_format_value(symbol: i32, mask: i32) -> i32 {
  if symbol == 0 && mask == 0 { return 17477; }
  if symbol == 0 && mask == 1 { return 16754; }
  if symbol == 0 && mask == 2 { return 20011; }
  if symbol == 0 && mask == 3 { return 19228; }
  if symbol == 1 && mask == 0 { return 21934; }
  if symbol == 1 && mask == 1 { return 20633; }
  if symbol == 1 && mask == 2 { return 24512; }
  if symbol == 1 && mask == 3 { return 23287; }
  if symbol == 2 && mask == 0 { return 25252; }
  if symbol == 2 && mask == 1 { return 24740; }
  if symbol == 2 && mask == 2 { return 28157; }
  if symbol == 2 && mask == 3 { return 26826; }
  if symbol == 3 && mask == 0 { return 30328; }
  if symbol == 3 && mask == 1 { return 29519; }
  if symbol == 3 && mask == 2 { return 31766; }
  if symbol == 3 && mask == 3 { return 31009; }
  if symbol == 4 && mask == 0 { return 1758; }
  if symbol == 4 && mask == 1 { return 1001; }
  if symbol == 4 && mask == 2 { return 3248; }
  if symbol == 4 && mask == 3 { return 2439; }
  if symbol == 5 && mask == 0 { return 5941; }
  if symbol == 5 && mask == 1 { return 4610; }
  if symbol == 5 && mask == 2 { return 7515; }
  if symbol == 5 && mask == 3 { return 6252; }
  if symbol == 6 && mask == 0 { return 9480; }
  if symbol == 6 && mask == 1 { return 8255; }
  if symbol == 6 && mask == 2 { return 12134; }
  if symbol == 6 && mask == 3 { return 10321; }
  if symbol == 7 && mask == 0 { return 13539; }
  if symbol == 7 && mask == 1 { return 12724; }
  if symbol == 7 && mask == 2 { return 16013; }
  return 15290;
}

fn micro_format(modules: u32, reserved: u32, size: i32, symbol: i32, mask: i32) -> unit {
  let value: i32 = micro_format_value(symbol, mask);
  micro_set(modules, reserved, size, 8, 1, q.bit_test(value, 0), true);
  micro_set(modules, reserved, size, 1, 8, q.bit_test(value, 14), true);
  micro_set(modules, reserved, size, 8, 2, q.bit_test(value, 1), true);
  micro_set(modules, reserved, size, 2, 8, q.bit_test(value, 13), true);
  micro_set(modules, reserved, size, 8, 3, q.bit_test(value, 2), true);
  micro_set(modules, reserved, size, 3, 8, q.bit_test(value, 12), true);
  micro_set(modules, reserved, size, 8, 4, q.bit_test(value, 3), true);
  micro_set(modules, reserved, size, 4, 8, q.bit_test(value, 11), true);
  micro_set(modules, reserved, size, 8, 5, q.bit_test(value, 4), true);
  micro_set(modules, reserved, size, 5, 8, q.bit_test(value, 10), true);
  micro_set(modules, reserved, size, 8, 6, q.bit_test(value, 5), true);
  micro_set(modules, reserved, size, 6, 8, q.bit_test(value, 9), true);
  micro_set(modules, reserved, size, 8, 7, q.bit_test(value, 6), true);
  micro_set(modules, reserved, size, 7, 8, q.bit_test(value, 8), true);
  micro_set(modules, reserved, size, 8, 8, q.bit_test(value, 7), true);
}

fn micro_mask(modules: u32, reserved: u32, size: i32, mask: i32) -> unit {
  let mut index: i32 = 0;
  let total: i32 = size * size;
  while index < total {
    let x: i32 = index - index / size * size;
    let y: i32 = index / size;
    if !q.bitbuf_get(reserved, index) {
      let mut apply: bool = false;
      if mask == 0 { apply = y % 2 == 0; }
      let half: i32 = y / 2 + x / 3;
      if mask == 1 { apply = half % 2 == 0; }
      let product: i32 = x * y;
      let product2: i32 = product % 2 + product % 3;
      if mask == 2 { apply = product2 % 2 == 0; }
      let sum: i32 = x + y;
      let sum2: i32 = sum % 2 + product % 3;
      if mask == 3 { apply = sum2 % 2 == 0; }
      if apply {
        let old: bool = q.bitbuf_get(modules, index);
        q.bitbuf_set(modules, index, !old);
      }
    }
    index = index + 1;
  }
}

fn micro_place(modules: u32, reserved: u32, size: i32, version: i32, bits: string) -> unit {
  let mut right: i32 = size - 1;
  let mut cursor: i32 = 0;
  while right > 0 {
    let mut vertical: i32 = 0;
    while vertical < size {
      let mut z: i32 = 0;
      while z < 2 {
        let x: i32 = right - z;
        let mut direction: i32 = right;
        if version == 0 || version == 2 { direction = direction + 2; }
        let upwards: bool = direction % 4 == 0;
        let mut y: i32 = vertical;
        if upwards { y = size - 1 - vertical; }
        let index: i32 = y * size + x;
        if !q.bitbuf_get(reserved, index) {
          q.bitbuf_set(modules, index, q.bits_get(bits, cursor));
          cursor = cursor + 1;
        }
        z = z + 1;
      }
      vertical = vertical + 1;
    }
    right = right - 2;
  }
}

fn micro_score(modules: u32, size: i32) -> i32 {
  let mut sum1: i32 = 0;
  let mut sum2: i32 = 0;
  let mut index: i32 = 1;
  let bottom_row: i32 = size - 1;
  while index < size {
    let right_index: i32 = index * size + size - 1;
    let bottom_index: i32 = bottom_row * size + index;
    if q.bitbuf_get(modules, right_index) { sum1 = sum1 + 1; }
    if q.bitbuf_get(modules, bottom_index) { sum2 = sum2 + 1; }
    index = index + 1;
  }
  if sum1 <= sum2 { return sum1 * 16 + sum2; }
  return sum2 * 16 + sum1;
}

fn micro_candidate_score(size: i32, version: i32, bits: string, mask: i32) -> i32 {
  let total: i32 = size * size;
  let modules: u32 = q.bitbuf_alloc(total);
  let reserved: u32 = q.bitbuf_alloc(total);
  micro_reserve_format(modules, reserved, size);
  micro_timing(modules, reserved, size);
  micro_finder(modules, reserved, size);
  micro_place(modules, reserved, size, version, bits);
  micro_mask(modules, reserved, size, mask);
  return micro_score(modules, size);
}

fn micro_emit(size: i32, version: i32, symbol: i32, bits: string, mask: i32) -> string {
  let total: i32 = size * size;
  let modules: u32 = q.bitbuf_alloc(total);
  let reserved: u32 = q.bitbuf_alloc(total);
  micro_reserve_format(modules, reserved, size);
  micro_timing(modules, reserved, size);
  micro_finder(modules, reserved, size);
  micro_place(modules, reserved, size, version, bits);
  micro_mask(modules, reserved, size, mask);
  micro_format(modules, reserved, size, symbol, mask);
  let packed_bits: string = q.bitbuf_to_bits(modules, total);
  return string_concat(q.itoa(size), string_concat(",", string_concat(q.itoa(size), string_concat(",", packed_bits))));
}

fn micro_matrix_real(text: string, version: i32, rank: i32, numeric: bool) -> string {
  let capacity: i32 = micro_capacity(version, rank);
  let size: i32 = micro_size(version);
  let short: bool = version == 0 || version == 2;
  let data_bits: string = micro_make_data(text, version, capacity, numeric);
  let packed_data: string = micro_pack_bytes(data_bits, short);
  let ecc_count: i32 = micro_total_codewords(version) - micro_data_codewords(version, rank);
  let final_bits: string = micro_final_bits(packed_data, short, ecc_count);
  let symbol: i32 = micro_symbol(version, rank);
  let score0: i32 = micro_candidate_score(size, version, final_bits, 0);
  let score1: i32 = micro_candidate_score(size, version, final_bits, 1);
  let score2: i32 = micro_candidate_score(size, version, final_bits, 2);
  let score3: i32 = micro_candidate_score(size, version, final_bits, 3);
  let mut best_mask: i32 = 0;
  let mut best_score: i32 = score0;
  if score1 > best_score { best_score = score1; best_mask = 1; }
  if score2 > best_score { best_score = score2; best_mask = 2; }
  if score3 > best_score { best_score = score3; best_mask = 3; }
  return string_concat("", micro_emit(size, version, symbol, final_bits, best_mask));
}

export fn encode_micro_qr(ecc: i32, text: string) -> string {
  if ecc < 0 || ecc > 2 { return ""; }
  let numeric: bool = all_numeric(text);
  let mut version: i32 = 0;
  while version < 4 {
    let mut rank: i32 = 0;
    while rank < 3 {
      let capacity: i32 = micro_capacity(version, rank);
      let version_allowed: bool = numeric || version >= 2;
      if rank >= ecc && capacity > 0 && version_allowed {
        if micro_data_bits(text, version, numeric) <= capacity { return string_concat("", micro_matrix_real(text, version, rank, numeric)); }
      }
      rank = rank + 1;
    }
    version = version + 1;
  }
  return "";
}




export fn encode_rmqr(ecc: i32, text: string) -> string {
  return string_concat("", rmqr.encode_rmqr_impl(ecc, text));
}
