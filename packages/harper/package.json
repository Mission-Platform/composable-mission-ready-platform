{
  "name": "@mission-platform/harper",
  "version": "0.2.1",
  "license": "BSD-4-Clause",
  "description": "Harper grammar and style checker integration for Monaco editor",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/harper.worker.d.ts",
      "import": "./dist/harper.worker.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node --experimental-strip-types ../../scripts/extract-package-docs.ts --package=.",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "tsdown"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "harper.js": "catalog:code",
    "monaco-editor": "catalog:code"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/i18n-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/test-utils": "catalog:vue",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue",
    "@mission-platform/tsdown-config": "workspace:*",
    "tsdown": "catalog:build"
  }
}
