{
  "name": "@mission-platform/i18n",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/i18n.js",
  "module": "./dist/i18n.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/i18n.js"
    }
  },
  "scripts": {
    "build": "vue-tsc -b tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@intlify/unplugin-vue-i18n": "catalog:vue",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/tsconfig": "catalog:vue",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  },
  "dependencies": {
    "vue-i18n": "catalog:vue"
  }
}
