{
  "name": "@mission-platform/i18n",
  "version": "0.4.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build:check": "vue-tsc -b",
    "build:bundle": "vite build",
    "build:types": "vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "peerDependencies": {
    "i18next-vue": "catalog:i18next",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-i18next": "catalog:i18next",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "i18next-vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-i18next": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "i18next": "catalog:i18next"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/test-utils": "catalog:vue",
    "eslint": "catalog:eslint",
    "i18next-vue": "catalog:i18next",
    "jsdom": "catalog:testing",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-i18next": "catalog:i18next",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
