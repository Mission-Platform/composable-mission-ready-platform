{
  "name": "@mission-platform/components",
  "version": "3.2.1",
  "publishConfig": {
    "access": "public"
  },
  "license": "BSD-4-Clause",
  "description": "Sample write-once Mission Platform components authored with @mission-platform/forge-jsx and shipped as both Vue 3 and React components",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/web-components/**/*.js"
  ],
  "exports": {
    ".": {
      "mp:vue": {
        "types": "./dist/vue/index.d.ts",
        "import": "./dist/vue/index.js"
      },
      "mp:react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "mp:solid": {
        "types": "./dist/solid/index.d.ts",
        "import": "./dist/solid/index.js"
      },
      "mp:svelte": {
        "types": "./dist/svelte/index.d.ts",
        "import": "./dist/svelte/index.js"
      },
      "mp:web-component": {
        "types": "./dist/web-components/index.d.ts",
        "import": "./dist/web-components/index.js"
      },
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./*": {
      "mp:vue": {
        "types": "./dist/vue/index.d.ts",
        "import": "./dist/vue/*.js"
      },
      "mp:react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/*.js"
      },
      "mp:solid": {
        "types": "./dist/solid/index.d.ts",
        "import": "./dist/solid/*.js"
      },
      "mp:web-component": {
        "types": "./dist/web-components/index.d.ts",
        "import": "./dist/web-components/*.js"
      },
      "mp:svelte": {
        "types": "./dist/svelte/index.d.ts",
        "import": "./dist/svelte/*.js"
      }
    },
    "./cms/storyblok/react": {
      "types": "./dist/cms/storyblok/react/index.d.ts",
      "import": "./dist/cms/storyblok/react/index.js"
    },
    "./cms/storyblok/vue": {
      "types": "./dist/cms/storyblok/vue/index.d.ts",
      "import": "./dist/cms/storyblok/vue/index.js"
    },
    "./cms/storyblok/svelte": {
      "types": "./dist/cms/storyblok/svelte/index.d.ts",
      "import": "./dist/cms/storyblok/svelte/index.js"
    },
    "./cms/storyblok/solid": {
      "types": "./dist/cms/storyblok/solid/index.d.ts",
      "import": "./dist/cms/storyblok/solid/index.js"
    },
    "./cms/storyblok/web-components": {
      "types": "./dist/cms/storyblok/web-components/index.d.ts",
      "import": "./dist/cms/storyblok/web-components/index.js"
    },
    "./cms/storyblok/components.json": "./dist/cms/storyblok/components.json"
  },
  "main": "./dist/components/index.js",
  "types": "./dist/components/index.d.ts",
  "files": [
    "dist",
    "src/components",
    "src/styles",
    "src/utils"
  ],
  "scripts": {
    "build:forge": "tsdown --config tsdown.forge.config.ts",
    "build:react": "tsdown --config tsdown.react.config.ts",
    "build:vue": "tsdown --config tsdown.vue.config.ts",
    "build:svelte": "tsdown --config tsdown.svelte.config.ts",
    "build:solid": "tsdown --config tsdown.solid.config.ts",
    "build:web-components": "tsdown --config tsdown.web-components.config.ts",
    "build:cms-storyblok:assets": "tsdown --config tsdown.cms.config.ts",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "test": "vitest run",
    "i18n:extract": "i18next-cli extract --config i18next.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/forge-adapters": "workspace:*",
    "@mission-platform/forge-jsx": "workspace:*",
    "@mission-platform/forms-core": "workspace:*",
    "@mission-platform/icons": "workspace:*",
    "@mission-platform/phone-number": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "@mission-platform/typography": "workspace:*",
    "i18next": "catalog:i18next",
    "luxon": "catalog:"
  },
  "peerDependencies": {
    "@storyblok/js": "^5.1.10",
    "@storyblok/react": "^6.1.11",
    "@storyblok/svelte": "^5.0.0",
    "@storyblok/vue": "^10.1.10",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@storyblok/js": {
      "optional": true
    },
    "@storyblok/react": {
      "optional": true
    },
    "@storyblok/svelte": {
      "optional": true
    },
    "@storyblok/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/forge-cms-plugin-api": "workspace:*",
    "@mission-platform/forge-cms-storyblok": "workspace:*",
    "@mission-platform/forge-plugin-react": "workspace:*",
    "@mission-platform/forge-plugin-solid": "workspace:*",
    "@mission-platform/forge-plugin-svelte": "workspace:*",
    "@mission-platform/forge-plugin-vue": "workspace:*",
    "@mission-platform/forge-plugin-web-components": "workspace:*",
    "@mission-platform/i18n-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/storybook-framework": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@storybook/react-vite": "catalog:storybook",
    "@storybook/vue3-vite": "catalog:storybook",
    "@tsdown/css": "catalog:build",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-vue-jsx": "catalog:vue",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "i18next-cli": "1.73.3",
    "jsdom": "catalog:testing",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "sass-embedded": "catalog:vite",
    "solid-js": "catalog:solid",
    "storybook": "catalog:storybook",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "svelte": "catalog:svelte",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
