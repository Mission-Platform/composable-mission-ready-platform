export fn font_append_text_quads(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32
) -> u32 {
  return font.sdf_append_text_quads_styled(text, origin_x, baseline_y, font_size, r, g, b, a, align, false, false, false, f64_from_u32(0));
}

export fn font_append_text_quads_styled(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32,
  is_italic: bool,
  is_underline: bool,
  is_strike: bool,
  max_width: f64
) -> u32 {
  return font.sdf_append_text_quads_styled(
    text,
    origin_x,
    baseline_y,
    font_size,
    r,
    g,
    b,
    a,
    align,
    is_italic,
    is_underline,
    is_strike,
    max_width
  );
}

export fn font_measure_text_mono(text: string, font_size: f64) -> f64 {
  return font.sdf_measure_text_mono(text, font_size);
}

export fn font_append_text_quads_mono(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32
) -> u32 {
  return font.sdf_append_text_quads_mono(text, origin_x, baseline_y, font_size, r, g, b, a, align);
}

