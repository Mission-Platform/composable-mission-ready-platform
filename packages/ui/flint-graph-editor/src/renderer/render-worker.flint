  p0x: i32, p0y: i32, p1x: i32, p1y: i32, p2x: i32, p2y: i32, p3x: i32, p3y: i32,
  is_selected: u32, is_active: u32, pulse_offset_permille: u32
) -> unit;

import capability "webgpu.write_pin_instance" as gpu_write_pin_instance(
