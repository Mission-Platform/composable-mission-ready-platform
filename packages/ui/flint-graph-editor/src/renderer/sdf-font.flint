export fn sdf_get_char_advance_u32(code: i32) -> u32 {
  if code == 32 { return 6; }
  let idx: u32 = char_code_to_idx(code);
  return get_glyph_advance_u32(idx);
}


fn is_kerning_negative(c1: i32, c2: i32) -> bool {
  if c1 == 65 { // 'A'
    if c2 == 86 || c2 == 87 || c2 == 89 || c2 == 118 || c2 == 119 || c2 == 121 { return true; } // V, W, Y, v, w, y
  }
  if c1 == 84 { // 'T'
    if c2 == 97 || c2 == 101 || c2 == 111 || c2 == 117 || c2 == 114 || c2 == 121 { return true; } // a, e, o, u, r, y
  }
  if c1 == 86 || c1 == 87 || c1 == 89 { // 'V', 'W', 'Y'
    if c2 == 65 || c2 == 97 || c2 == 101 || c2 == 111 { return true; } // A, a, e, o
  }
  if c1 == 70 || c1 == 80 { // 'F', 'P'
    if c2 == 65 || c2 == 97 || c2 == 101 || c2 == 111 { return true; } // A, a, e, o
  }
  return false;
}

fn is_ligature_arrow_right(c1: i32, c2: i32) -> bool {
  return c1 == 45 && c2 == 62; // "->"
}

fn is_ligature_arrow_left(c1: i32, c2: i32) -> bool {
  return c1 == 60 && c2 == 45; // "<-"
}

fn is_ligature_not_equal(c1: i32, c2: i32) -> bool {
  return c1 == 33 && c2 == 61; // "!="
}

fn is_ligature_arrow_double(c1: i32, c2: i32) -> bool {
  return c1 == 61 && c2 == 62; // "=>"
}

fn is_ligature_less_equal(c1: i32, c2: i32) -> bool {
  return c1 == 60 && c2 == 61; // "<="
}

fn is_ligature_greater_equal(c1: i32, c2: i32) -> bool {
  return c1 == 62 && c2 == 61; // ">="
}

fn get_kerning_adj(c1: i32, c2: i32, font_size: f64, base_size: f64) -> f64 {
  let kern: f64 = sdf_get_kerning(c1, c2);
  return (kern * font_size) / base_size;
}

export fn is_multi_color_emoji(code: i32) -> bool {
  if code == 9889 || code == 9733 || code == 10003 || code == 10060 || code == 9888 || code == 8505 { return true; } // ⚡, ★, ✓, ❌, ⚠️, ℹ️
  if code == 128640 || code == 128161 || code == 9881 || code == 10084 || code == 128293 { return true; } // 🚀, 💡, ⚙️, ❤️, 🔥
  if code == 127752 || code == 127912 || code == 128512 || code == 128077 || code == 128170 { return true; } // 🌈, 🎨, 😀, 👍, 💪
  if code == 128187 || code == 129302 || code == 127918 || code == 128269 || code == 128274 || code == 128275 { return true; } // 💻, 🤖, 🎮, 🔍, 🔒, 🔓
  if code >= 127744 && code <= 129535 { return true; }
  return false;
}

fn is_ligature_ellipsis(c1: i32, c2: i32, c3: i32) -> bool {
  return c1 == 46 && c2 == 46 && c3 == 46; // "..."
}

export fn sdf_get_kerning(c1: i32, c2: i32) -> f64 {
  if is_kerning_negative(c1, c2) {
    return f64_from_u32(0) - f64_from_u32(1);
  }
  return f64_from_u32(0);
}

export fn sdf_measure_text(text: string, font_size: f64) -> f64 {
  let len: i32 = string_length(text);
  if len == 0 {
    return f64_from_u32(0);
  }
  let base_size: f64 = f64_from_u32(24);
  let mut max_w_units: f64 = f64_from_u32(0);
  let mut current_line_w: f64 = f64_from_u32(0);
  let char_spacing: f64 = sdf_get_char_spacing();
  let mut prev_code: i32 = 0;

  let mut i: i32 = 0;
  while i < len {
    let b0: i32 = string_byte_at(text, i);
    if b0 == 10 {
      if current_line_w > max_w_units {
        max_w_units = current_line_w;
      }
      current_line_w = f64_from_u32(0);
      prev_code = 0;
      i = i + 1;
    } else {
      let mut step: i32 = 1;
      let mut ucode: i32 = b0;

      if i + 2 < len && is_ligature_ellipsis(b0, string_byte_at(text, i + 1), string_byte_at(text, i + 2)) {
        ucode = 8230;
        step = 3;
      } else {
        if i + 1 < len {
          let b1: i32 = string_byte_at(text, i + 1);
          if is_ligature_arrow_right(b0, b1) {
            ucode = 8594;
            step = 2;
          } else {
            if is_ligature_not_equal(b0, b1) {
              ucode = 8800;
              step = 2;
            } else {
              if b0 >= 192 {
                let decoded_len: i32 = utf8_codepoint_length(b0);
                ucode = utf8_decode_codepoint(text, i, decoded_len);
                step = decoded_len;
              }
            }
          }
        } else {
          if b0 >= 192 {
            let decoded_len: i32 = utf8_codepoint_length(b0);
            ucode = utf8_decode_codepoint(text, i, decoded_len);
            step = decoded_len;
          }
        }
      }

      let kern: f64 = sdf_get_kerning(prev_code, ucode);
      let adv_u32: u32 = sdf_get_char_advance_u32(ucode);
      let adv_f64: f64 = f64_from_u32(adv_u32) + kern + char_spacing;
      current_line_w = current_line_w + adv_f64;
      prev_code = ucode;
      i = i + step;
    }
  }

  if current_line_w > max_w_units {
    max_w_units = current_line_w;
  }

  return (max_w_units * font_size) / base_size;
}

export fn sdf_append_text_quads_styled(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32,
  is_italic: bool,
  is_underline: bool,
  is_strike: bool,
  max_width: f64
) -> u32 {
  let u_one: u32 = 1;
  let u_four: u32 = 4;
  let u_eight: u32 = 8;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let u_48: u32 = 48;
  let u_256: u32 = 256;
  let u_max_floats: u32 = 1048576;
  let len: i32 = string_length(text);
  if len == 0 {
    return 0;
  }

  let base_size: f64 = f64_from_u32(24);
  let scale: f64 = font_size / base_size;
  let atlas_size_f64: f64 = f64_from_u32(sdf_get_atlas_size());

  let char_spacing: f64 = sdf_get_char_spacing();
  let line_height_mul: f64 = sdf_get_line_height();
  let line_step_y: f64 = font_size * line_height_mul;

  let total_width: f64 = sdf_measure_text(text, font_size);
  let mut cursor_x: f64 = origin_x;
  if align == 1 {
    cursor_x = origin_x - total_width;
  } else {
    if align == 2 {
      cursor_x = origin_x - (total_width / f64_from_u32(2));
    }
  }

  let mut current_baseline_y: f64 = baseline_y;

  let vbuf_base: u32 = sdf_get_vertex_buffer_ptr();
  let mut float_count: u32 = sdf_get_vertex_float_count();

  let top_f64: f64 = f64_from_u32(23);
  let mut slant_f64: f64 = f64_from_u32(0);
  if is_italic {
    slant_f64 = (font_size * f64_from_u32(22)) / f64_from_u32(100);
  }

  let mut i: i32 = 0;
  let mut quads_added: u32 = 0;
  let mut prev_code: i32 = 0;

  while i < len {
    let b0: i32 = string_byte_at(text, i);
    if b0 == 10 {
      current_baseline_y = current_baseline_y + line_step_y;
      cursor_x = origin_x;
      prev_code = 0;
      i = i + 1;
    } else {
      let mut step: i32 = 1;
      let mut ucode: i32 = b0;

      if i + 2 < len && is_ligature_ellipsis(b0, string_byte_at(text, i + 1), string_byte_at(text, i + 2)) {
        ucode = 8230;
        step = 3;
      } else {
        if i + 1 < len {
          let b1: i32 = string_byte_at(text, i + 1);
          if is_ligature_arrow_right(b0, b1) {
            ucode = 8594;
            step = 2;
          } else {
            if is_ligature_arrow_left(b0, b1) {
              ucode = 8592;
              step = 2;
            } else {
              if is_ligature_arrow_double(b0, b1) {
                ucode = 8658;
                step = 2;
              } else {
                if is_ligature_not_equal(b0, b1) {
                  ucode = 8800;
                  step = 2;
                } else {
                  if is_ligature_less_equal(b0, b1) {
                    ucode = 8804;
                    step = 2;
                  } else {
                    if is_ligature_greater_equal(b0, b1) {
                      ucode = 8805;
                      step = 2;
                    } else {
                      step = utf8_codepoint_length(b0);
                      ucode = utf8_decode_codepoint(text, i, len);
                    }
                  }
                }
              }
            }
          }
        } else {
          step = utf8_codepoint_length(b0);
          ucode = utf8_decode_codepoint(text, i, len);
        }
      }

      if prev_code != 0 {
        let kern_adj: f64 = get_kerning_adj(prev_code, ucode, font_size, base_size);
        cursor_x = cursor_x + kern_adj;
      }

      let adv_u32: u32 = sdf_get_char_advance_u32(ucode);
      let adv_f64: f64 = (f64_from_u32(adv_u32) * font_size) / base_size;

      // Automated word wrapping if max_width > 0
      if max_width > f64_from_u32(0) && (cursor_x + adv_f64) > (origin_x + max_width) {
        current_baseline_y = current_baseline_y + line_step_y;
        cursor_x = origin_x;
      }

      if ucode == 32 {
        cursor_x = cursor_x + adv_f64 + char_spacing;
      } else {
        let idx: u32 = char_code_to_idx(ucode);
        let table_base: u32 = sdf_get_table_ptr();
        let table_entry: u32 = table_base + idx * u_16;
        let cell_x: u32 = memory_load_u32(table_entry);
        let cell_y: u32 = memory_load_u32(table_entry + u_four);
        let cell_w: u32 = memory_load_u32(table_entry + u_eight);
        let cell_h: u32 = memory_load_u32(table_entry + u_twelve);

        let cell_x_f64: f64 = f64_from_u32(cell_x);
        let cell_y_f64: f64 = f64_from_u32(cell_y);
        let cell_w_f64: f64 = f64_from_u32(cell_w);
        let cell_h_f64: f64 = f64_from_u32(cell_h);

        let em_dim_f64: f64 = f64_from_u32(32);
        let min_x_raw: u32 = get_glyph_min_x_u32(idx);
        let min_x_f64: f64 = f64_from_u32(min_x_raw) / f64_from_u32(8);
        let lsb_f64: f64 = f64_from_u32(1);

        let qx0: f64 = cursor_x + ((lsb_f64 - min_x_f64) * scale);
        let qy0: f64 = current_baseline_y - (top_f64 * scale);
        let qx1: f64 = qx0 + (em_dim_f64 * scale);
        let qy1: f64 = qy0 + (em_dim_f64 * scale);

        let u0: f64 = cell_x_f64 / atlas_size_f64;
        let v0: f64 = cell_y_f64 / atlas_size_f64;
        let u1: f64 = (cell_x_f64 + cell_w_f64) / atlas_size_f64;
        let v1: f64 = (cell_y_f64 + cell_h_f64) / atlas_size_f64;

        let mut quad_a: f64 = a;
        if is_multi_color_emoji(ucode) {
          quad_a = f64_from_u32(0) - a;
        }

        if float_count + u_48 <= u_max_floats {
          let v0_ptr: u32 = vbuf_base + float_count * u_eight;
          memory_store_f64(v0_ptr, qx0 + slant_f64); memory_store_f64(v0_ptr + 8, qy0); memory_store_f64(v0_ptr + 16, u0); memory_store_f64(v0_ptr + 24, v0);
          memory_store_f64(v0_ptr + 32, r); memory_store_f64(v0_ptr + 40, g); memory_store_f64(v0_ptr + 48, b); memory_store_f64(v0_ptr + 56, quad_a);

          let v1_ptr: u32 = v0_ptr + 64;
          memory_store_f64(v1_ptr, qx1 + slant_f64); memory_store_f64(v1_ptr + 8, qy0); memory_store_f64(v1_ptr + 16, u1); memory_store_f64(v1_ptr + 24, v0);
          memory_store_f64(v1_ptr + 32, r); memory_store_f64(v1_ptr + 40, g); memory_store_f64(v1_ptr + 48, b); memory_store_f64(v1_ptr + 56, quad_a);

          let v2_ptr: u32 = v1_ptr + 64;
          memory_store_f64(v2_ptr, qx0); memory_store_f64(v2_ptr + 8, qy1); memory_store_f64(v2_ptr + 16, u0); memory_store_f64(v2_ptr + 24, v1);
          memory_store_f64(v2_ptr + 32, r); memory_store_f64(v2_ptr + 40, g); memory_store_f64(v2_ptr + 48, b); memory_store_f64(v2_ptr + 56, quad_a);

          let v3_ptr: u32 = v2_ptr + 64;
          memory_store_f64(v3_ptr, qx0); memory_store_f64(v3_ptr + 8, qy1); memory_store_f64(v3_ptr + 16, u0); memory_store_f64(v3_ptr + 24, v1);
          memory_store_f64(v3_ptr + 32, r); memory_store_f64(v3_ptr + 40, g); memory_store_f64(v3_ptr + 48, b); memory_store_f64(v3_ptr + 56, quad_a);

          let v4_ptr: u32 = v3_ptr + 64;
          memory_store_f64(v4_ptr, qx1 + slant_f64); memory_store_f64(v4_ptr + 8, qy0); memory_store_f64(v4_ptr + 16, u1); memory_store_f64(v4_ptr + 24, v0);
          memory_store_f64(v4_ptr + 32, r); memory_store_f64(v4_ptr + 40, g); memory_store_f64(v4_ptr + 48, b); memory_store_f64(v4_ptr + 56, quad_a);

          let v5_ptr: u32 = v4_ptr + 64;
          memory_store_f64(v5_ptr, qx1); memory_store_f64(v5_ptr + 8, qy1); memory_store_f64(v5_ptr + 16, u1); memory_store_f64(v5_ptr + 24, v1);
          memory_store_f64(v5_ptr + 32, r); memory_store_f64(v5_ptr + 40, g); memory_store_f64(v5_ptr + 48, b); memory_store_f64(v5_ptr + 56, quad_a);

          float_count = float_count + u_48;
          quads_added = quads_added + u_one;
        }

        cursor_x = cursor_x + adv_f64 + char_spacing;
      }

      prev_code = ucode;
      i = i + step;
    }
  }

  memory_store_u32(200, float_count);
  return quads_added;
}

export fn sdf_append_text_quads(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32
) -> u32 {
  return sdf_append_text_quads_styled(
    text,
    origin_x,
    baseline_y,
    font_size,
    r,
    g,
    b,
    a,
    align,
    false,
    false,
    false,
    f64_from_u32(0)
  );
}

export fn sdf_measure_text_mono(text: string, font_size: f64) -> f64 {
  let len: i32 = string_length(text);
  let base_size: f64 = f64_from_u32(24);
  let fixed_adv: f64 = (f64_from_u32(11) * font_size) / base_size;
  let mut total: f64 = f64_from_u32(0);
  let mut i: i32 = 0;
  while i < len {
    total = total + fixed_adv;
    i = i + 1;
  }
  return total;
}

export fn sdf_append_text_quads_mono(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32
) -> u32 {
  let u_one: u32 = 1;
  let u_four: u32 = 4;
  let u_eight: u32 = 8;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let u_48: u32 = 48;
  let u_max_floats: u32 = 1048576;
  let len: i32 = string_length(text);
  if len == 0 {
    return 0;
  }

  let base_size: f64 = f64_from_u32(24);
  let scale: f64 = font_size / base_size;
  let atlas_size_f64: f64 = f64_from_u32(sdf_get_atlas_size());

  let total_width: f64 = sdf_measure_text_mono(text, font_size);
  let mut cursor_x: f64 = origin_x;
  if align == 1 {
    cursor_x = origin_x - total_width;
  } else {
    if align == 2 {
      cursor_x = origin_x - (total_width / f64_from_u32(2));
    }
  }

  let fixed_adv_f64: f64 = (f64_from_u32(11) * font_size) / base_size;

  let vbuf_base: u32 = sdf_get_vertex_buffer_ptr();
  let mut float_count: u32 = sdf_get_vertex_float_count();

  let top_f64: f64 = f64_from_u32(23);

  let mut i: i32 = 0;
  let mut quads_added: u32 = 0;

  while i < len {
    let b0: i32 = string_byte_at(text, i);
    let step: i32 = utf8_codepoint_length(b0);
    let ucode: i32 = utf8_decode_codepoint(text, i, len);

    if ucode == 32 {
      cursor_x = cursor_x + fixed_adv_f64;
    } else {
      let idx: u32 = char_code_to_idx(ucode);
      let table_base: u32 = sdf_get_table_ptr();
      let table_entry: u32 = table_base + idx * u_16;
      let cell_x: u32 = memory_load_u32(table_entry);
      let cell_y: u32 = memory_load_u32(table_entry + u_four);
      let cell_w: u32 = memory_load_u32(table_entry + u_eight);
      let cell_h: u32 = memory_load_u32(table_entry + u_twelve);

      let cell_x_f64: f64 = f64_from_u32(cell_x);
      let cell_y_f64: f64 = f64_from_u32(cell_y);
      let cell_w_f64: f64 = f64_from_u32(cell_w);
      let cell_h_f64: f64 = f64_from_u32(cell_h);

      let em_dim_f64: f64 = f64_from_u32(32);
      let min_x_raw: u32 = get_glyph_min_x_u32(idx);
      let min_x_f64: f64 = f64_from_u32(min_x_raw) / f64_from_u32(8);
      let lsb_f64: f64 = f64_from_u32(1);

      let qx0: f64 = cursor_x + ((lsb_f64 - min_x_f64) * scale);
      let qy0: f64 = baseline_y - (top_f64 * scale);
      let qx1: f64 = qx0 + (em_dim_f64 * scale);
      let qy1: f64 = qy0 + (em_dim_f64 * scale);

      let u0: f64 = cell_x_f64 / atlas_size_f64;
      let v0: f64 = cell_y_f64 / atlas_size_f64;
      let u1: f64 = (cell_x_f64 + cell_w_f64) / atlas_size_f64;
      let v1: f64 = (cell_y_f64 + cell_h_f64) / atlas_size_f64;

      if float_count + u_48 <= u_max_floats {
        let v0_ptr: u32 = vbuf_base + float_count * u_eight;
        memory_store_f64(v0_ptr, qx0); memory_store_f64(v0_ptr + 8, qy0); memory_store_f64(v0_ptr + 16, u0); memory_store_f64(v0_ptr + 24, v0);
        memory_store_f64(v0_ptr + 32, r); memory_store_f64(v0_ptr + 40, g); memory_store_f64(v0_ptr + 48, b); memory_store_f64(v0_ptr + 56, a);

        let v1_ptr: u32 = v0_ptr + 64;
        memory_store_f64(v1_ptr, qx1); memory_store_f64(v1_ptr + 8, qy0); memory_store_f64(v1_ptr + 16, u1); memory_store_f64(v1_ptr + 24, v0);
        memory_store_f64(v1_ptr + 32, r); memory_store_f64(v1_ptr + 40, g); memory_store_f64(v1_ptr + 48, b); memory_store_f64(v1_ptr + 56, a);

        let v2_ptr: u32 = v1_ptr + 64;
        memory_store_f64(v2_ptr, qx0); memory_store_f64(v2_ptr + 8, qy1); memory_store_f64(v2_ptr + 16, u0); memory_store_f64(v2_ptr + 24, v1);
        memory_store_f64(v2_ptr + 32, r); memory_store_f64(v2_ptr + 40, g); memory_store_f64(v2_ptr + 48, b); memory_store_f64(v2_ptr + 56, a);

        let v3_ptr: u32 = v2_ptr + 64;
        memory_store_f64(v3_ptr, qx0); memory_store_f64(v3_ptr + 8, qy1); memory_store_f64(v3_ptr + 16, u0); memory_store_f64(v3_ptr + 24, v1);
        memory_store_f64(v3_ptr + 32, r); memory_store_f64(v3_ptr + 40, g); memory_store_f64(v3_ptr + 48, b); memory_store_f64(v3_ptr + 56, a);

        let v4_ptr: u32 = v3_ptr + 64;
        memory_store_f64(v4_ptr, qx1); memory_store_f64(v4_ptr + 8, qy0); memory_store_f64(v4_ptr + 16, u1); memory_store_f64(v4_ptr + 24, v0);
        memory_store_f64(v4_ptr + 32, r); memory_store_f64(v4_ptr + 40, g); memory_store_f64(v4_ptr + 48, b); memory_store_f64(v4_ptr + 56, a);

        let v5_ptr: u32 = v4_ptr + 64;
        memory_store_f64(v5_ptr, qx1); memory_store_f64(v5_ptr + 8, qy1); memory_store_f64(v5_ptr + 16, u1); memory_store_f64(v5_ptr + 24, v1);
        memory_store_f64(v5_ptr + 32, r); memory_store_f64(v5_ptr + 40, g); memory_store_f64(v5_ptr + 48, b); memory_store_f64(v5_ptr + 56, a);

        float_count = float_count + u_48;
        quads_added = quads_added + u_one;
      }

      cursor_x = cursor_x + fixed_adv_f64;
    }

    i = i + step;
  }

  memory_store_u32(200, float_count);
  return quads_added;
}
