// ============================================================================
// Flint High-Performance Signed Distance Field (MSDF) Font Engine
// Supports 1024x1024 Atlas, 2D Shelf Rect Packing, Base-2 Cell Variations (4x4, 8x8, 8x16, 16x8, 16x16, 16x32, 32x16, 32x32, 32x64, 64x32, 64x64 - up to 64x64 max),
// UTF-8 Typography, Rich Text Styling (Colors, Italic Slant, Underline, Strike-Through,
// Automated Word-Wrapping, Line Height, Letter Spacing, and Kerning).
// ============================================================================

export fn isqrt_u32(val: u32) -> u32 {
  if val == 0 { return 0; }
  let mut x: u32 = val;
  let u_one: u32 = 1;
  let u_two: u32 = 2;
  let mut y: u32 = (x + u_one) / u_two;
  while y < x {
    x = y;
    y = (x + val / x) / u_two;
  }
  return x;
}

export fn dist_to_segment_u32(
  px: u32, py: u32,
  ax: u32, ay: u32,
  bx: u32, by: u32
) -> u32 {
  let mut dx_pos: bool = true;
  let mut dx: u32 = 0;
  if bx >= ax { dx = bx - ax; } else { dx = ax - bx; dx_pos = false; }

  let mut dy_pos: bool = true;
  let mut dy: u32 = 0;
  if by >= ay { dy = by - ay; } else { dy = ay - by; dy_pos = false; }

  let l2: u32 = dx * dx + dy * dy;
  if l2 == 0 {
    let mut rx: u32 = 0;
    let mut ry: u32 = 0;
    if px >= ax { rx = px - ax; } else { rx = ax - px; }
    if py >= ay { ry = py - ay; } else { ry = ay - py; }
    return isqrt_u32(rx * rx + ry * ry);
  }

  let mut dpx_pos: bool = true;
  let mut dpx: u32 = 0;
  if px >= ax { dpx = px - ax; } else { dpx = ax - px; dpx_pos = false; }

  let mut dpy_pos: bool = true;
  let mut dpy: u32 = 0;
  if py >= ay { dpy = py - ay; } else { dpy = ay - py; dpy_pos = false; }

  let mut dot_pos: bool = true;
  let mut dot_mag: u32 = 0;

  let term1_pos: bool = (dx_pos && dpx_pos) || (!dx_pos && !dpx_pos);
  let term1_mag: u32 = dx * dpx;

  let term2_pos: bool = (dy_pos && dpy_pos) || (!dy_pos && !dpy_pos);
  let term2_mag: u32 = dy * dpy;

  if term1_pos && term2_pos {
    dot_pos = true;
    dot_mag = term1_mag + term2_mag;
  } else {
    if !term1_pos && !term2_pos {
      dot_pos = false;
      dot_mag = term1_mag + term2_mag;
    } else {
      if term1_pos && !term2_pos {
        if term1_mag >= term2_mag {
          dot_pos = true;
          dot_mag = term1_mag - term2_mag;
        } else {
          dot_pos = false;
          dot_mag = term2_mag - term1_mag;
        }
      } else {
        if term2_mag >= term1_mag {
          dot_pos = true;
          dot_mag = term2_mag - term1_mag;
        } else {
          dot_pos = false;
          dot_mag = term1_mag - term2_mag;
        }
      }
    }
  }

  if !dot_pos || dot_mag == 0 {
    let mut rx: u32 = 0;
    let mut ry: u32 = 0;
    if px >= ax { rx = px - ax; } else { rx = ax - px; }
    if py >= ay { ry = py - ay; } else { ry = ay - py; }
    return isqrt_u32(rx * rx + ry * ry);
  }

  if dot_mag >= l2 {
    let mut rx: u32 = 0;
    let mut ry: u32 = 0;
    if px >= bx { rx = px - bx; } else { rx = bx - px; }
    if py >= by { ry = py - by; } else { ry = by - py; }
    return isqrt_u32(rx * rx + ry * ry);
  }

  let qx_diff: u32 = (dx * dot_mag) / l2;
  let qy_diff: u32 = (dy * dot_mag) / l2;

  let mut qx: u32 = 0;
  let mut qy: u32 = 0;

  if dx_pos { qx = ax + qx_diff; } else { qx = ax - qx_diff; }
  if dy_pos { qy = ay + qy_diff; } else { qy = ay - qy_diff; }

  let mut rx: u32 = 0;
  let mut ry: u32 = 0;
  if px >= qx { rx = px - qx; } else { rx = qx - px; }
  if py >= qy { ry = py - qy; } else { ry = qy - py; }
  return isqrt_u32(rx * rx + ry * ry);
}

export fn sdf_get_atlas_size() -> u32 {
  let stored: u32 = memory_load_u32(192);
  if stored != 0 {
    return stored;
  }
  return 1024;
}

export fn sdf_get_base_font_size() -> f64 {
  return f64_from_u32(24);
}

export fn utf8_codepoint_length(byte_val: i32) -> i32 {
  if byte_val < 128 { return 1; }
  if byte_val >= 192 && byte_val < 224 { return 2; }
  if byte_val >= 224 && byte_val < 240 { return 3; }
  if byte_val >= 240 && byte_val < 248 { return 4; }
  return 1;
}

export fn utf8_decode_codepoint(text: string, i: i32, len: i32) -> i32 {
  let b0: i32 = string_byte_at(text, i);
  if b0 < 128 { return b0; }
  if b0 >= 192 && b0 < 224 {
    if i + 1 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      return (b0 - 192) * 64 + (b1 - 128);
    }
  }
  if b0 >= 224 && b0 < 240 {
    if i + 2 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      let b2: i32 = string_byte_at(text, i + 2);
      return (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
    }
  }
  if b0 >= 240 && b0 < 248 {
    if i + 3 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      let b2: i32 = string_byte_at(text, i + 2);
      let b3: i32 = string_byte_at(text, i + 3);
      return (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
    }
  }
  return b0;
}

export fn unicode_to_idx(code: i32) -> u32 {
  // Math & Logic
  if code == 177 { return 96; } // ±
  if code == 215 { return 97; } // ×
  if code == 247 { return 98; } // ÷
  if code == 8730 { return 99; } // √
  if code == 8734 { return 100; } // ∞
  if code == 8776 { return 101; } // ≈
  if code == 8800 { return 102; } // ≠
  if code == 8804 { return 103; } // ≤
  if code == 8805 { return 104; } // ≥
  if code == 8721 { return 105; } // ∑
  if code == 8719 { return 106; } // ∏
  if code == 8747 { return 107; } // ∫
  if code == 8722 { return 108; } // −
  if code == 8706 { return 109; } // ∂
  if code == 8711 { return 110; } // ∇
  if code == 8712 { return 111; } // ∈

  // Arrows
  if code == 8592 { return 112; } // ←
  if code == 8593 { return 113; } // ↑
  if code == 8594 { return 114; } // →
  if code == 8595 { return 115; } // ↓
  if code == 8596 { return 116; } // ↔
  if code == 8658 { return 117; } // ⇒

  // Common symbols & punctuation
  if code == 176 { return 118; } // °
  if code == 8226 { return 119; } // •
  if code == 8230 { return 120; } // …
  if code == 8212 { return 121; } // —
  if code == 8211 { return 122; } // –
  if code == 10003 { return 123; } // ✓
  if code == 10007 { return 124; } // ✗
  if code == 9733 { return 125; } // ★
  if code == 9889 { return 126; } // ⚡
  if code == 169 { return 127; } // ©
  if code == 174 { return 128; } // ®
  if code == 181 { return 129; } // µ
  if code == 178 { return 130; } // ²
  if code == 179 { return 131; } // ³

  // Greek
  if code == 945 { return 132; } // α
  if code == 946 { return 133; } // β
  if code == 947 { return 134; } // γ
  if code == 948 { return 135; } // δ
  if code == 955 { return 136; } // λ
  if code == 956 { return 137; } // μ
  if code == 960 { return 138; } // π
  if code == 963 { return 139; } // σ
  if code == 969 { return 140; } // ω
  if code == 916 { return 141; } // Δ
  if code == 937 { return 142; } // Ω
  if code == 952 { return 143; } // θ

  // Latin-1 Accented Letters
  if code == 228 { return 144; } // ä
  if code == 246 { return 145; } // ö
  if code == 252 { return 146; } // ü
  if code == 233 { return 147; } // é
  if code == 232 { return 148; } // è
  if code == 234 { return 149; } // ê
  if code == 225 { return 150; } // á
  if code == 237 { return 151; } // í
  if code == 243 { return 152; } // ó
  if code == 250 { return 153; } // ú
  if code == 241 { return 154; } // ñ
  if code == 231 { return 155; } // ç
  if code == 223 { return 156; } // ß

  // Fallback box for unmapped printable UTF-8 character
  return 95;
}







export fn char_code_to_idx(code: i32) -> u32 {
  if code >= 32 && code <= 126 {
    let mut idx: u32 = 0;
    let mut cur: i32 = 32;
    while cur <= 126 {
      if cur == code {
        return idx;
      }
      idx = idx + 1;
      cur = cur + 1;
    }
    return 0;
  }
  if code < 32 {
    return 0;
  }
  return unicode_to_idx(code);
}

export fn is_narrow_glyph_idx(idx: u32) -> bool {
  if idx == 1 || idx == 2 || idx == 7 || idx == 8 || idx == 9 || idx == 12 || idx == 14 {
    return true;
  }
  if idx == 26 || idx == 27 || idx == 41 || idx == 59 || idx == 61 || idx == 73 || idx == 74 || idx == 76 {
    return true;
  }
  if idx == 92 || idx == 105 || idx == 106 || idx == 108 || idx == 130 || idx == 131 || idx == 133 || idx == 144 || idx == 151 || idx == 156 {
    return true;
  }
  return false;
}

export fn get_glyph_cell_w_u32(idx: u32) -> u32 {
  if idx == 0 { return 8; }
  let adv: u32 = get_glyph_advance_u32(idx);
  let w: u32 = get_glyph_width_u32(idx);
  let u_eight: u32 = 8;
  let u_three: u32 = 3;
  let u_two: u32 = 2;
  let u_one: u32 = 1;
  let u_16: u32 = 16;
  let u_64: u32 = 64;
  let mut cw: u32 = ((adv * u_eight) / u_three) + u_eight;
  if w > adv {
    cw = ((w * u_eight) / u_three) + u_eight;
  }
  let rem: u32 = cw % u_two;
  if rem != 0 {
    cw = cw + u_one;
  }
  if cw < u_16 { cw = u_16; }
  if cw > u_64 { cw = u_64; }
  return cw;
}

export fn get_glyph_cell_h_u32(idx: u32) -> u32 {
  if idx == 0 { return 8; }
  let h: u32 = get_glyph_height_u32(idx);
  let u_two: u32 = 2;
  let u_one: u32 = 1;
  let u_24: u32 = 24;
  let u_44: u32 = 44;
  let u_64: u32 = 64;
  if h <= 6 {
    return u_24;
  }
  if h <= 12 {
    return u_44;
  }
  return u_64;
}

export fn get_glyph_stroke_bias_u32(idx: u32) -> u32 {
  return 0;
}

export fn write_seg(seg_ptr: u32, seg_idx: u32, x1: u32, y1: u32, x2: u32, y2: u32) -> unit {
  let offset: u32 = seg_ptr + seg_idx * 16;
  memory_store_u32(offset, x1);
  memory_store_u32(offset + 4, y1);
  memory_store_u32(offset + 8, x2);
  memory_store_u32(offset + 12, y2);
}







