
export fn isqrt_u32(val: u32) -> u32 {
  if val == 0 { return 0; }
  let mut x: u32 = val;
  let mut y: u32 = (x + 1) / 2;
  while y < x {
    x = y;
    y = (x + val / x) / 2;
  }
  return x;
}

export fn dist_to_segment_u32(px: u32, py: u32, ax: u32, ay: u32, bx: u32, by: u32) -> u32 {
  let mut dx: u32 = 0;
  let mut dy: u32 = 0;
  let mut dx_pos: bool = true;
  let mut dy_pos: bool = true;
  if bx >= ax { dx = bx - ax; } else { dx = ax - bx; dx_pos = false; }
  if by >= ay { dy = by - ay; } else { dy = ay - by; dy_pos = false; }
  let len_sq: u32 = dx * dx + dy * dy;
  if len_sq == 0 {
    let mut ex: u32 = 0;
    let mut ey: u32 = 0;
    if px >= ax { ex = px - ax; } else { ex = ax - px; }
    if py >= ay { ey = py - ay; } else { ey = ay - py; }
    return isqrt_u32(ex * ex + ey * ey);
  }

  let mut px_diff: u32 = 0;
  let mut px_pos: bool = true;
  if px >= ax { px_diff = px - ax; } else { px_diff = ax - px; px_pos = false; }

  let mut py_diff: u32 = 0;
  let mut py_pos: bool = true;
  if py >= ay { py_diff = py - ay; } else { py_diff = ay - py; py_pos = false; }

  let term_x: u32 = px_diff * dx;
  let term_y: u32 = py_diff * dy;
  let term_x_pos: bool = (px_pos && dx_pos) || ((!px_pos) && (!dx_pos));
  let term_y_pos: bool = (py_pos && dy_pos) || ((!py_pos) && (!dy_pos));

  let mut dot: u32 = 0;
  let mut dot_pos: bool = true;
  if term_x_pos && term_y_pos {
    dot = term_x + term_y;
  } else {
    if (!term_x_pos) && (!term_y_pos) {
      dot = term_x + term_y;
      dot_pos = false;
    } else {
      if term_x_pos && (!term_y_pos) {
        if term_x >= term_y {
          dot = term_x - term_y;
        } else {
          dot = term_y - term_x;
          dot_pos = false;
        }
      } else {
        if term_y >= term_x {
          dot = term_y - term_x;
        } else {
          dot = term_x - term_y;
          dot_pos = false;
        }
      }
    }
  }

  if !dot_pos {
    let mut ex: u32 = 0;
    let mut ey: u32 = 0;
    if px >= ax { ex = px - ax; } else { ex = ax - px; }
    if py >= ay { ey = py - ay; } else { ey = ay - py; }
    return isqrt_u32(ex * ex + ey * ey);
  }

  if dot >= len_sq {
    let mut ex: u32 = 0;
    let mut ey: u32 = 0;
    if px >= bx { ex = px - bx; } else { ex = bx - px; }
    if py >= by { ey = py - by; } else { ey = by - py; }
    return isqrt_u32(ex * ex + ey * ey);
  }

  let frac: u32 = (dot * 256) / len_sq;
  let qx_diff: u32 = (dx * frac) / 256;
  let qy_diff: u32 = (dy * frac) / 256;
  let mut qx: u32 = ax;
  if dx_pos { qx = ax + qx_diff; } else { qx = ax - qx_diff; }
  let mut qy: u32 = ay;
  if dy_pos { qy = ay + qy_diff; } else { qy = ay - qy_diff; }

  let mut rx: u32 = 0;
  let mut ry: u32 = 0;
  if px >= qx { rx = px - qx; } else { rx = qx - px; }
  if py >= qy { ry = py - qy; } else { ry = qy - py; }
  return isqrt_u32(rx * rx + ry * ry);
}

export fn sdf_get_atlas_size() -> u32 {
  return 512;
}

export fn sdf_get_base_font_size() -> f64 {
  return f64_from_u32(24);
}

export fn utf8_codepoint_length(byte_val: i32) -> i32 {
  if byte_val < 128 {
    return 1;
  }
  if byte_val >= 192 && byte_val < 224 {
    return 2;
  }
  if byte_val >= 224 && byte_val < 240 {
    return 3;
  }
  if byte_val >= 240 && byte_val < 248 {
    return 4;
  }
  return 1;
}

export fn utf8_decode_codepoint(text: string, i: i32, len: i32) -> i32 {
  let b0: i32 = string_byte_at(text, i);
  if b0 < 128 {
    return b0;
  }
  if b0 >= 192 && b0 < 224 {
    if i + 1 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      return (b0 - 192) * 64 + (b1 - 128);
    }
  }
  if b0 >= 224 && b0 < 240 {
    if i + 2 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      let b2: i32 = string_byte_at(text, i + 2);
      return (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
    }
  }
  if b0 >= 240 && b0 < 248 {
    if i + 3 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      let b2: i32 = string_byte_at(text, i + 2);
      let b3: i32 = string_byte_at(text, i + 3);
      return (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
    }
  }
  return b0;
}

export fn unicode_to_idx(code: i32) -> u32 {
  // Math & Logic
  if code == 177 { return 96; } // ±
  if code == 215 { return 97; } // ×
  if code == 247 { return 98; } // ÷
  if code == 8730 { return 99; } // √
  if code == 8734 { return 100; } // ∞
  if code == 8776 { return 101; } // ≈
  if code == 8800 { return 102; } // ≠
  if code == 8804 { return 103; } // ≤
  if code == 8805 { return 104; } // ≥
  if code == 8721 { return 105; } // ∑
  if code == 8719 { return 106; } // ∏
  if code == 8747 { return 107; } // ∫
  if code == 8722 { return 108; } // −
  if code == 8706 { return 109; } // ∂
  if code == 8711 { return 110; } // ∇
  if code == 8712 { return 111; } // ∈

  // Arrows
  if code == 8592 { return 112; } // ←
  if code == 8593 { return 113; } // ↑
  if code == 8594 { return 114; } // →
  if code == 8595 { return 115; } // ↓
  if code == 8596 { return 116; } // ↔
  if code == 8658 { return 117; } // ⇒

  // Common symbols & punctuation
  if code == 176 { return 118; } // °
  if code == 8226 { return 119; } // •
  if code == 8230 { return 120; } // …
  if code == 8212 { return 121; } // —
  if code == 8211 { return 122; } // –
  if code == 10003 { return 123; } // ✓
  if code == 10007 { return 124; } // ✗
  if code == 9733 { return 125; } // ★
  if code == 9889 { return 126; } // ⚡
  if code == 169 { return 127; } // ©
  if code == 174 { return 128; } // ®
  if code == 181 { return 129; } // µ
  if code == 178 { return 130; } // ²
  if code == 179 { return 131; } // ³

  // Greek
  if code == 945 { return 132; } // α
  if code == 946 { return 133; } // β
  if code == 947 { return 134; } // γ
  if code == 948 { return 135; } // δ
  if code == 955 { return 136; } // λ
  if code == 956 { return 137; } // μ
  if code == 960 { return 138; } // π
  if code == 963 { return 139; } // σ
  if code == 969 { return 140; } // ω
  if code == 916 { return 141; } // Δ
  if code == 937 { return 142; } // Ω
  if code == 952 { return 143; } // θ

  // Latin-1 Accented Letters
  if code == 228 { return 144; } // ä
  if code == 246 { return 145; } // ö
  if code == 252 { return 146; } // ü
  if code == 233 { return 147; } // é
  if code == 232 { return 148; } // è
  if code == 234 { return 149; } // ê
  if code == 225 { return 150; } // á
  if code == 237 { return 151; } // í
  if code == 243 { return 152; } // ó
  if code == 250 { return 153; } // ú
  if code == 241 { return 154; } // ñ
  if code == 231 { return 155; } // ç
  if code == 223 { return 156; } // ß

  // Fallback box for unmapped printable UTF-8 character
  return 95;
}

export fn char_code_to_idx(code: i32) -> u32 {
  if code >= 32 && code <= 126 {
    let mut idx: u32 = 0;
    let mut cur: i32 = 32;
    while cur <= 126 {
      if cur == code {
        return idx;
      }
      idx = idx + 1;
      cur = cur + 1;
    }
    return 0;
  }
  if code < 32 {
    return 0;
  }
  return unicode_to_idx(code);
}

export fn sdf_get_char_advance_u32(code: i32) -> u32 {
  if code < 32 { return 6; }
  if code > 126 {
    if code == 8722 || code == 215 || code == 247 || code == 177 { return 14; }
    if code >= 8704 && code <= 8959 { return 16; }
    if code >= 8592 && code <= 8703 { return 16; }
    if code >= 913 && code <= 969 { return 14; }
    if code >= 160 && code <= 255 { return 13; }
    return 14;
  }
  if code == 32 { return 6; }
  if code == 33 { return 7; }
  if code == 34 { return 9; }
  if code == 35 { return 14; }
  if code == 36 { return 14; }
  if code == 37 { return 22; }
  if code == 38 { return 17; }
  if code == 39 { return 5; }
  if code == 40 { return 8; }
  if code == 41 { return 8; }
  if code == 42 { return 10; }
  if code == 43 { return 14; }
  if code == 44 { return 7; }
  if code == 45 { return 8; }
  if code == 46 { return 7; }
  if code == 47 { return 8; }
  if code >= 48 && code <= 57 { return 14; }
  if code == 58 { return 7; }
  if code == 59 { return 7; }
  if code == 60 { return 14; }
  if code == 61 { return 14; }
  if code == 62 { return 14; }
  if code == 63 { return 13; }
  if code == 64 { return 25; }

  if code == 65 { return 16; }
  if code == 66 { return 15; }
  if code == 67 { return 16; }
  if code == 68 { return 16; }
  if code == 69 { return 14; }
  if code == 70 { return 13; }
  if code == 71 { return 17; }
  if code == 72 { return 17; }
  if code == 73 { return 7; }
  if code == 74 { return 12; }
  if code == 75 { return 15; }
  if code == 76 { return 13; }
  if code == 77 { return 20; }
  if code == 78 { return 17; }
  if code == 79 { return 17; }
  if code == 80 { return 15; }
  if code == 81 { return 17; }
  if code == 82 { return 16; }
  if code == 83 { return 14; }
  if code == 84 { return 14; }
  if code == 85 { return 17; }
  if code == 86 { return 15; }
  if code == 87 { return 22; }
  if code == 88 { return 15; }
  if code == 89 { return 15; }
  if code == 90 { return 14; }

  if code == 91 { return 8; }
  if code == 92 { return 8; }
  if code == 93 { return 8; }
  if code == 94 { return 11; }
  if code == 95 { return 14; }
  if code == 96 { return 8; }

  if code == 97 { return 13; }
  if code == 98 { return 14; }
  if code == 99 { return 12; }
  if code == 100 { return 14; }
  if code == 101 { return 13; }
  if code == 102 { return 8; }
  if code == 103 { return 14; }
  if code == 104 { return 14; }
  if code == 105 { return 6; }
  if code == 106 { return 6; }
  if code == 107 { return 13; }
  if code == 108 { return 6; }
  if code == 109 { return 20; }
  if code == 110 { return 14; }
  if code == 111 { return 14; }
  if code == 112 { return 14; }
  if code == 113 { return 14; }
  if code == 114 { return 9; }
  if code == 115 { return 11; }
  if code == 116 { return 8; }
  if code == 117 { return 14; }
  if code == 118 { return 12; }
  if code == 119 { return 18; }
  if code == 120 { return 12; }
  if code == 121 { return 12; }
  if code == 122 { return 11; }

  if code == 123 { return 8; }
  if code == 124 { return 6; }
  if code == 125 { return 8; }
  if code == 126 { return 14; }

  return 14;
}

export fn sdf_get_char_advance(code: i32) -> f64 {
  let adv: u32 = sdf_get_char_advance_u32(code);
  return f64_from_u32(adv);
}

export fn sdf_measure_text(text: string, font_size: f64) -> f64 {
  let len: i32 = string_length(text);
  let mut total: f64 = f64_from_u32(0);
  let mut i: i32 = 0;
  let base_size: f64 = f64_from_u32(24);
  while i < len {
    let b0: i32 = string_byte_at(text, i);
    let step: i32 = utf8_codepoint_length(b0);
    let ucode: i32 = utf8_decode_codepoint(text, i, len);
    let adv_u32: u32 = sdf_get_char_advance_u32(ucode);
    let adv: f64 = (f64_from_u32(adv_u32) * font_size) / base_size;
    total = total + adv;
    i = i + step;
  }
  return total;
}

export fn write_seg(seg_ptr: u32, seg_idx: u32, x1: u32, y1: u32, x2: u32, y2: u32) -> unit {
  let offset: u32 = seg_ptr + seg_idx * 16;
  memory_store_u32(offset, x1 * 8);
  memory_store_u32(offset + 4, y1 * 8);
  memory_store_u32(offset + 8, x2 * 8);
  memory_store_u32(offset + 12, y2 * 8);
}

export fn sdf_load_char_segments(idx: u32, seg_ptr: u32) -> u32 {
  // idx 0 is space (' ' = 32)
  if idx == 0 { return 0; }
  // '-' = 45 -> idx = 13
  if idx == 13 {
    write_seg(seg_ptr, 0, 7, 16, 23, 16);
    return 1;
  }
  // '+' = 43 -> idx = 11
  if idx == 11 {
    write_seg(seg_ptr, 0, 7, 16, 23, 16);
    write_seg(seg_ptr, 1, 15, 8, 15, 24);
    return 2;
  }
  // '=' = 61 -> idx = 29
  if idx == 29 {
    write_seg(seg_ptr, 0, 7, 13, 23, 13);
    write_seg(seg_ptr, 1, 7, 19, 23, 19);
    return 2;
  }
  // '_' = 95 -> idx = 63
  if idx == 63 {
    write_seg(seg_ptr, 0, 6, 24, 24, 24);
    return 1;
  }
  // '|' = 124 -> idx = 92
  if idx == 92 {
    write_seg(seg_ptr, 0, 16, 6, 16, 25);
    return 1;
  }
  // '/' = 47 -> idx = 15
  if idx == 15 {
    write_seg(seg_ptr, 0, 9, 24, 22, 7);
    return 1;
  }
  // '\' = 92 -> idx = 60
  if idx == 60 {
    write_seg(seg_ptr, 0, 9, 7, 22, 24);
    return 1;
  }
  // '<' = 60 -> idx = 28
  if idx == 28 {
    write_seg(seg_ptr, 0, 22, 9, 9, 16);
    write_seg(seg_ptr, 1, 9, 16, 22, 23);
    return 2;
  }
  // '>' = 62 -> idx = 30
  if idx == 30 {
    write_seg(seg_ptr, 0, 9, 9, 22, 16);
    write_seg(seg_ptr, 1, 22, 16, 9, 23);
    return 2;
  }
  // '(' = 40 -> idx = 8
  if idx == 8 {
    write_seg(seg_ptr, 0, 19, 7, 13, 15);
    write_seg(seg_ptr, 1, 13, 15, 19, 24);
    return 2;
  }
  // ')' = 41 -> idx = 9
  if idx == 9 {
    write_seg(seg_ptr, 0, 13, 7, 19, 15);
    write_seg(seg_ptr, 1, 19, 15, 13, 24);
    return 2;
  }
  // '[' = 91 -> idx = 59
  if idx == 59 {
    write_seg(seg_ptr, 0, 20, 7, 13, 7);
    write_seg(seg_ptr, 1, 13, 7, 13, 24);
    write_seg(seg_ptr, 2, 13, 24, 20, 24);
    return 3;
  }
  // ']' = 93 -> idx = 61
  if idx == 61 {
    write_seg(seg_ptr, 0, 13, 7, 20, 7);
    write_seg(seg_ptr, 1, 20, 7, 20, 24);
    write_seg(seg_ptr, 2, 20, 24, 13, 24);
    return 3;
  }
  // '.' = 46 -> idx = 14
  if idx == 14 {
    write_seg(seg_ptr, 0, 15, 23, 16, 23);
    return 1;
  }
  // ',' = 44 -> idx = 12
  if idx == 12 {
    write_seg(seg_ptr, 0, 16, 22, 14, 26);
    return 1;
  }
  // ':' = 58 -> idx = 26
  if idx == 26 {
    write_seg(seg_ptr, 0, 15, 12, 16, 12);
    write_seg(seg_ptr, 1, 15, 21, 16, 21);
    return 2;
  }
  // ';' = 59 -> idx = 27
  if idx == 27 {
    write_seg(seg_ptr, 0, 15, 12, 16, 12);
    write_seg(seg_ptr, 1, 16, 21, 14, 25);
    return 2;
  }
  // '!' = 33 -> idx = 1
  if idx == 1 {
    write_seg(seg_ptr, 0, 15, 7, 15, 18);
    write_seg(seg_ptr, 1, 15, 23, 16, 23);
    return 2;
  }
  // '"' = 34 -> idx = 2
  if idx == 2 {
    write_seg(seg_ptr, 0, 12, 7, 12, 12);
    write_seg(seg_ptr, 1, 18, 7, 18, 12);
    return 2;
  }
  // '#' = 35 -> idx = 3
  if idx == 3 {
    write_seg(seg_ptr, 0, 13, 7, 13, 23);
    write_seg(seg_ptr, 1, 18, 7, 18, 23);
    write_seg(seg_ptr, 2, 9, 12, 22, 12);
    write_seg(seg_ptr, 3, 9, 18, 22, 18);
    return 4;
  }
  // '$' = 36 -> idx = 4
  if idx == 4 {
    write_seg(seg_ptr, 0, 15, 6, 15, 24);
    write_seg(seg_ptr, 1, 20, 10, 12, 10);
    write_seg(seg_ptr, 2, 11, 11, 11, 14);
    write_seg(seg_ptr, 3, 11, 14, 19, 16);
    write_seg(seg_ptr, 4, 19, 16, 19, 20);
    write_seg(seg_ptr, 5, 19, 20, 11, 20);
    return 6;
  }
  // '%' = 37 -> idx = 5
  if idx == 5 {
    write_seg(seg_ptr, 0, 22, 7, 9, 23);
    write_seg(seg_ptr, 1, 11, 8, 14, 8);
    write_seg(seg_ptr, 2, 14, 8, 14, 12);
    write_seg(seg_ptr, 3, 14, 12, 11, 12);
    write_seg(seg_ptr, 4, 11, 12, 11, 8);
    write_seg(seg_ptr, 5, 17, 18, 20, 18);
    write_seg(seg_ptr, 6, 20, 18, 20, 22);
    write_seg(seg_ptr, 7, 20, 22, 17, 22);
    write_seg(seg_ptr, 8, 17, 22, 17, 18);
    return 9;
  }
  // '&' = 38 -> idx = 6
  if idx == 6 {
    write_seg(seg_ptr, 0, 19, 21, 13, 23);
    write_seg(seg_ptr, 1, 13, 23, 10, 19);
    write_seg(seg_ptr, 2, 10, 19, 17, 13);
    write_seg(seg_ptr, 3, 17, 13, 15, 8);
    write_seg(seg_ptr, 4, 15, 8, 12, 11);
    write_seg(seg_ptr, 5, 12, 11, 21, 23);
    return 6;
  }
  // '\'' = 39 -> idx = 7
  if idx == 7 {
    write_seg(seg_ptr, 0, 15, 7, 15, 12);
    return 1;
  }
  // '*' = 42 -> idx = 10
  if idx == 10 {
    write_seg(seg_ptr, 0, 11, 15, 20, 15);
    write_seg(seg_ptr, 1, 13, 10, 18, 20);
    write_seg(seg_ptr, 2, 18, 10, 13, 20);
    return 3;
  }
  // '?' = 63 -> idx = 31
  if idx == 31 {
    write_seg(seg_ptr, 0, 10, 10, 16, 7);
    write_seg(seg_ptr, 1, 16, 7, 21, 11);
    write_seg(seg_ptr, 2, 21, 11, 16, 16);
    write_seg(seg_ptr, 3, 16, 16, 16, 19);
    write_seg(seg_ptr, 4, 16, 23, 16, 23);
    return 5;
  }
  // '@' = 64 -> idx = 32
  if idx == 32 {
    write_seg(seg_ptr, 0, 20, 12, 13, 8);
    write_seg(seg_ptr, 1, 13, 8, 9, 15);
    write_seg(seg_ptr, 2, 9, 15, 13, 23);
    write_seg(seg_ptr, 3, 13, 23, 21, 23);
    write_seg(seg_ptr, 4, 21, 23, 22, 15);
    write_seg(seg_ptr, 5, 22, 15, 18, 15);
    write_seg(seg_ptr, 6, 18, 15, 18, 20);
    write_seg(seg_ptr, 7, 18, 17, 14, 17);
    return 8;
  }

  // Digits 0..9 (48..57 -> idx 16..25)
  if idx == 16 {
    write_seg(seg_ptr, 0, 10, 7, 21, 7);
    write_seg(seg_ptr, 1, 21, 7, 21, 23);
    write_seg(seg_ptr, 2, 21, 23, 10, 23);
    write_seg(seg_ptr, 3, 10, 23, 10, 7);
    write_seg(seg_ptr, 4, 20, 8, 11, 22);
    return 5;
  }
  if idx == 17 {
    write_seg(seg_ptr, 0, 12, 10, 16, 7);
    write_seg(seg_ptr, 1, 16, 7, 16, 23);
    write_seg(seg_ptr, 2, 11, 23, 21, 23);
    return 3;
  }
  if idx == 18 {
    write_seg(seg_ptr, 0, 9, 10, 15, 7);
    write_seg(seg_ptr, 1, 15, 7, 21, 10);
    write_seg(seg_ptr, 2, 21, 10, 9, 23);
    write_seg(seg_ptr, 3, 9, 23, 21, 23);
    return 4;
  }
  if idx == 19 {
    write_seg(seg_ptr, 0, 9, 7, 21, 7);
    write_seg(seg_ptr, 1, 21, 7, 15, 14);
    write_seg(seg_ptr, 2, 15, 14, 21, 17);
    write_seg(seg_ptr, 3, 21, 17, 9, 23);
    return 4;
  }
  if idx == 20 {
    write_seg(seg_ptr, 0, 18, 7, 18, 23);
    write_seg(seg_ptr, 1, 18, 7, 8, 17);
    write_seg(seg_ptr, 2, 8, 17, 22, 17);
    return 3;
  }
  if idx == 21 {
    write_seg(seg_ptr, 0, 21, 7, 9, 7);
    write_seg(seg_ptr, 1, 9, 7, 9, 14);
    write_seg(seg_ptr, 2, 9, 14, 21, 15);
    write_seg(seg_ptr, 3, 21, 15, 21, 22);
    write_seg(seg_ptr, 4, 21, 22, 9, 23);
    return 5;
  }
  if idx == 22 {
    write_seg(seg_ptr, 0, 20, 8, 10, 14);
    write_seg(seg_ptr, 1, 10, 14, 10, 22);
    write_seg(seg_ptr, 2, 10, 22, 21, 22);
    write_seg(seg_ptr, 3, 21, 22, 21, 15);
    write_seg(seg_ptr, 4, 21, 15, 10, 15);
    return 5;
  }
  if idx == 23 {
    write_seg(seg_ptr, 0, 8, 7, 22, 7);
    write_seg(seg_ptr, 1, 22, 7, 12, 23);
    return 2;
  }
  if idx == 24 {
    write_seg(seg_ptr, 0, 10, 7, 20, 7);
    write_seg(seg_ptr, 1, 20, 7, 20, 23);
    write_seg(seg_ptr, 2, 20, 23, 10, 23);
    write_seg(seg_ptr, 3, 10, 23, 10, 7);
    write_seg(seg_ptr, 4, 10, 15, 20, 15);
    return 5;
  }
  if idx == 25 {
