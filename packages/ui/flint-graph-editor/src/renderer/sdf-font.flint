    write_seg(seg_ptr, 0, 68, 108, 68, 152);
    write_seg(seg_ptr, 1, 68, 152, 75, 169);
    write_seg(seg_ptr, 2, 75, 169, 92, 176);
    write_seg(seg_ptr, 3, 92, 176, 109, 169);
    write_seg(seg_ptr, 4, 109, 169, 116, 152);
    write_seg(seg_ptr, 5, 116, 108, 116, 180);
    write_seg(seg_ptr, 6, 80, 68, 80, 76);
    write_seg(seg_ptr, 7, 112, 68, 112, 76);
    return 8;
  }
  if idx == 147 {
    write_seg(seg_ptr, 0, 64, 140, 128, 140);
