    write_seg(seg_ptr, 4, 68, 120, 64, 140);
    write_seg(seg_ptr, 5, 64, 140, 68, 164);
    write_seg(seg_ptr, 6, 68, 164, 96, 176);
    write_seg(seg_ptr, 7, 96, 176, 124, 168);
    write_seg(seg_ptr, 8, 76, 84, 96, 64);
    write_seg(seg_ptr, 9, 96, 64, 116, 84);
    return 10;
  }
  if idx == 150 {
    write_seg(seg_ptr, 0, 124, 108, 124, 180);
    write_seg(seg_ptr, 1, 124, 144, 118, 118);
    write_seg(seg_ptr, 2, 118, 118, 96, 108);
    write_seg(seg_ptr, 3, 96, 108, 74, 118);
    write_seg(seg_ptr, 4, 74, 118, 68, 144);
    write_seg(seg_ptr, 5, 68, 144, 74, 170);
    write_seg(seg_ptr, 6, 74, 170, 96, 180);
    write_seg(seg_ptr, 7, 96, 180, 118, 170);
    write_seg(seg_ptr, 8, 118, 170, 124, 144);
    write_seg(seg_ptr, 9, 80, 84, 104, 64);
    return 10;
  }
  if idx == 151 {
    write_seg(seg_ptr, 0, 76, 108, 76, 180);
    write_seg(seg_ptr, 1, 68, 84, 88, 68);
    return 2;
  }
  if idx == 152 {
    write_seg(seg_ptr, 0, 132, 140, 121, 165);
    write_seg(seg_ptr, 1, 121, 165, 96, 176);
    write_seg(seg_ptr, 2, 96, 176, 71, 165);
    write_seg(seg_ptr, 3, 71, 165, 60, 140);
    write_seg(seg_ptr, 4, 60, 140, 71, 115);
    write_seg(seg_ptr, 5, 71, 115, 96, 104);
    write_seg(seg_ptr, 6, 96, 104, 121, 115);
    write_seg(seg_ptr, 7, 121, 115, 132, 140);
    write_seg(seg_ptr, 8, 80, 84, 104, 64);
    return 9;
  }
  if idx == 153 {
    write_seg(seg_ptr, 0, 68, 108, 68, 152);
    write_seg(seg_ptr, 1, 68, 152, 75, 169);
    write_seg(seg_ptr, 2, 75, 169, 92, 176);
    write_seg(seg_ptr, 3, 92, 176, 109, 169);
    write_seg(seg_ptr, 4, 109, 169, 116, 152);
    write_seg(seg_ptr, 5, 116, 108, 116, 180);
    write_seg(seg_ptr, 6, 80, 84, 104, 64);
    return 7;
  }
  if idx == 154 {
    write_seg(seg_ptr, 0, 68, 108, 68, 180);
    write_seg(seg_ptr, 1, 116, 132, 116, 180);
    write_seg(seg_ptr, 2, 68, 132, 75, 115);
    write_seg(seg_ptr, 3, 75, 115, 92, 108);
    write_seg(seg_ptr, 4, 92, 108, 109, 115);
    write_seg(seg_ptr, 5, 109, 115, 116, 132);
    write_seg(seg_ptr, 6, 76, 72, 92, 64);
    write_seg(seg_ptr, 7, 92, 64, 108, 72);
    return 8;
  }
  if idx == 155 {
    write_seg(seg_ptr, 0, 121, 165, 96, 176);
    write_seg(seg_ptr, 1, 96, 176, 71, 165);
    write_seg(seg_ptr, 2, 71, 165, 60, 140);
    write_seg(seg_ptr, 3, 60, 140, 71, 115);
    write_seg(seg_ptr, 4, 71, 115, 96, 104);
    write_seg(seg_ptr, 5, 96, 104, 121, 115);
    write_seg(seg_ptr, 6, 88, 180, 88, 200);
    write_seg(seg_ptr, 7, 88, 200, 76, 212);
    return 8;
  }
  if idx == 156 {
    write_seg(seg_ptr, 0, 68, 56, 68, 184);
    write_seg(seg_ptr, 1, 68, 58, 89, 67);
    write_seg(seg_ptr, 2, 89, 67, 98, 88);
    write_seg(seg_ptr, 3, 98, 88, 89, 109);
    write_seg(seg_ptr, 4, 89, 109, 68, 118);
    write_seg(seg_ptr, 5, 68, 110, 88, 117);
    write_seg(seg_ptr, 6, 88, 117, 100, 134);
    write_seg(seg_ptr, 7, 100, 134, 100, 154);
    write_seg(seg_ptr, 8, 100, 154, 88, 171);
    write_seg(seg_ptr, 9, 88, 171, 68, 178);
    return 10;
  }
  return 0;
}



fn dist_to_val_u32(min_d: u32, radius: u32) -> u32 {
  let mut val: u32 = 0;
  let u_255: u32 = 255;
  let u_128: u32 = 128;
  let u_127: u32 = 127;
  if radius == 0 {
    return 0;
  }
  if min_d <= radius {
    val = u_128 + ((radius - min_d) * u_127) / radius;
  } else {
    let outer_radius: u32 = radius * 2;
    if min_d <= outer_radius {
      val = ((outer_radius - min_d) * u_128) / radius;
    }
  }
  if val > u_255 {
    val = u_255;
  }
  return val;
}

export fn sdf_render_char_cell(
  idx: u32,
  atlas_ptr: u32,
  atlas_dim: u32,
  cell_x0: u32,
  cell_y0: u32,
  cell_w: u32,
  cell_h: u32,
  temp_seg_ptr: u32
) -> unit {
  let num_segs: u32 = sdf_load_char_segments(idx, temp_seg_ptr);

  let u_two: u32 = 2;
  let u_three: u32 = 3;
  let u_four: u32 = 4;
  let u_eight: u32 = 8;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let u_256: u32 = 256;
  let u_65536: u32 = 65536;
  let u_16777216: u32 = 16777216;
  let u_9999: u32 = 9999;
  let u_255: u32 = 255;
  let u_220: u32 = 220;
  let u_204: u32 = 204;
  let u_153: u32 = 153;
  let u_140: u32 = 140;
  let u_113: u32 = 113;
  let u_46: u32 = 46;
  let u_240: u32 = 240;
  let u_zero: u32 = 0;

  let stroke_bias: u32 = get_glyph_stroke_bias_u32(idx);
  let weight_bias: u32 = memory_load_u32(228);
  let total_bias: u32 = stroke_bias + weight_bias;

  let u_128: u32 = 128;
  let mut radius: u32 = u_eight;

  let scale_units: u32 = 4;
  let half_w: u32 = cell_w / u_two;
  let half_h: u32 = cell_h / u_two;
  let span_x: u32 = half_w * scale_units;
  let span_y: u32 = half_h * scale_units;
  let cx: u32 = get_glyph_center_x_u32(idx);
  let cy: u32 = get_glyph_center_y_u32(idx);
  let mut base_x: u32 = 0;
  let mut neg_x: u32 = 0;
  if cx >= span_x {
    base_x = cx - span_x;
  } else {
    neg_x = span_x - cx;
  }
  let mut base_y: u32 = 0;
  let mut neg_y: u32 = 0;
  if cy >= span_y {
    base_y = cy - span_y;
  } else {
    neg_y = span_y - cy;
  }

  let mut ly: u32 = 0;
  while ly < cell_h {
    let curr_y: u32 = ly * scale_units + u_two;
    let mut py: u32 = 0;
    if neg_y == 0 {
      py = base_y + curr_y;
    } else {
      if curr_y >= neg_y {
        py = curr_y - neg_y;
      }
    }
    let mut lx: u32 = 0;
    while lx < cell_w {
      let curr_x: u32 = lx * scale_units + u_two;
      let mut px: u32 = 0;
      if neg_x == 0 {
        px = base_x + curr_x;
      } else {
        if curr_x >= neg_x {
          px = curr_x - neg_x;
        }
      }

      let mut val_r: u32 = 0;
      let mut val_g: u32 = 0;
      let mut val_b: u32 = 0;
      let mut val_a: u32 = 0;

      if num_segs > 0 {
        let mut min_d_r: u32 = u_9999;
        let mut min_d_g: u32 = u_9999;
        let mut min_d_b: u32 = u_9999;
        let mut min_d_a: u32 = u_9999;

        let mut s: u32 = 0;
        while s < num_segs {
          let s_off: u32 = temp_seg_ptr + s * u_16;
          let ax: u32 = memory_load_u32(s_off);
          let ay: u32 = memory_load_u32(s_off + u_four);
          let bx: u32 = memory_load_u32(s_off + u_eight);
          let by: u32 = memory_load_u32(s_off + u_twelve);
          let raw_d: u32 = dist_to_segment_u32(px, py, ax, ay, bx, by);
          let mut d: u32 = 0;
          if raw_d > total_bias {
            d = raw_d - total_bias;
          }

          if d < min_d_a {
            min_d_a = d;
          }

          if num_segs == 1 {
            if d < min_d_r { min_d_r = d; }
            if d < min_d_g { min_d_g = d; }
            if d < min_d_b { min_d_b = d; }
          } else {
            let color_cycle: u32 = s % u_three;
            // Yellow: R + G
            if color_cycle == 0 {
              if d < min_d_r { min_d_r = d; }
              if d < min_d_g { min_d_g = d; }
            }
            // Cyan: G + B
            if color_cycle == 1 {
              if d < min_d_g { min_d_g = d; }
              if d < min_d_b { min_d_b = d; }
            }
            // Magenta: R + B
            if color_cycle == 2 {
              if d < min_d_r { min_d_r = d; }
              if d < min_d_b { min_d_b = d; }
            }
          }

          s = s + 1;
        }

        val_r = dist_to_val_u32(min_d_r, radius);
        val_g = dist_to_val_u32(min_d_g, radius);
        val_b = dist_to_val_u32(min_d_b, radius);
        val_a = dist_to_val_u32(min_d_a, radius);

        let emoji_inner: u32 = radius;
        let emoji_outer: u32 = (radius * u_three) / u_two;

        if idx == 126 { // ⚡
          if min_d_a < emoji_inner {
            val_r = u_255;
            val_g = u_220;
            val_b = u_zero;
            val_a = u_255;
          } else {
            if min_d_a < emoji_outer {
              val_r = u_255;
              val_g = u_140;
              val_b = u_zero;
              val_a = u_240;
            }
          }
        } else {
          if idx == 125 { // ★
            if min_d_a < emoji_inner {
              val_r = u_255;
              val_g = u_204;
              val_b = u_zero;
              val_a = u_255;
            } else {
              if min_d_a < emoji_outer {
                val_r = u_255;
                val_g = u_153;
                val_b = u_zero;
                val_a = u_240;
              }
            }
          }
        }
      }

      let packed: u32 = val_r + (val_g * u_256) + (val_b * u_65536) + (val_a * u_16777216);
      let pixel_idx: u32 = (cell_y0 + ly) * atlas_dim + (cell_x0 + lx);
      memory_store_u32(atlas_ptr + pixel_idx * 4, packed);

      lx = lx + 1;
    }
    ly = ly + 1;
  }
}

fn compute_best_atlas_dim(total_glyphs: u32, order_ptr: u32) -> u32 {
  let u_zero: u32 = 0;
  let u_one: u32 = 1;
  let u_two: u32 = 2;
  let u_four: u32 = 4;
  let mut candidate: u32 = 256;
  while candidate <= 2048 {
    let mut shelf_x: u32 = u_zero;
    let mut shelf_y: u32 = u_zero;
    let mut shelf_h: u32 = u_zero;
    let mut fits: bool = true;

    let mut k: u32 = u_zero;
    while k < total_glyphs {
      let idx: u32 = memory_load_u32(order_ptr + k * u_four);
      let cell_w: u32 = get_glyph_cell_w_u32(idx);
      let cell_h: u32 = get_glyph_cell_h_u32(idx);
      if cell_w > candidate || cell_h > candidate {
        fits = false;
      }
      if shelf_x + cell_w > candidate {
        shelf_y = shelf_y + shelf_h;
        shelf_x = u_zero;
        shelf_h = u_zero;
      }
      if cell_h > shelf_h {
        shelf_h = cell_h;
      }
      shelf_x = shelf_x + cell_w;
      k = k + u_one;
    }
    if shelf_y + shelf_h > candidate {
      fits = false;
    }
    if fits {
      return candidate;
    }
    candidate = candidate * u_two;
  }
  return 2048;
}

export fn sdf_init_atlas_data() -> u32 {
  let u_zero: u32 = 0;
  let u_one: u32 = 1;
  let u_four: u32 = 4;
  let u_eight: u32 = 8;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let existing_ptr: u32 = memory_load_u32(196);
  if existing_ptr != 0 {
    return existing_ptr;
  }

  let total_glyphs: u32 = 220;

  // Allocate order buffer for sorted packing
  let order_ptr: u32 = memory_alloc(total_glyphs * u_four + u_16);
  let mut i: u32 = u_zero;
  while i < total_glyphs {
    memory_store_u32(order_ptr + i * u_four, i);
    i = i + u_one;
  }

  // Selection sort glyphs by cell_h descending, then cell_w descending, then idx ascending
  i = u_zero;
  while i < total_glyphs {
    let mut best_j: u32 = i;
    let mut best_idx: u32 = memory_load_u32(order_ptr + best_j * u_four);
    let mut best_h: u32 = get_glyph_cell_h_u32(best_idx);
    let mut best_w: u32 = get_glyph_cell_w_u32(best_idx);

    let mut j: u32 = i + u_one;
    while j < total_glyphs {
      let cand_idx: u32 = memory_load_u32(order_ptr + j * u_four);
      let cand_h: u32 = get_glyph_cell_h_u32(cand_idx);
      let cand_w: u32 = get_glyph_cell_w_u32(cand_idx);

      let mut is_better: bool = false;
      if cand_h > best_h {
        is_better = true;
      } else {
        if cand_h == best_h {
          if cand_w > best_w {
            is_better = true;
          } else {
            if cand_w == best_w && cand_idx < best_idx {
              is_better = true;
            }
          }
        }
      }

      if is_better {
        best_j = j;
        best_idx = cand_idx;
        best_h = cand_h;
        best_w = cand_w;
      }
      j = j + u_one;
    }

    if best_j != i {
      let temp: u32 = memory_load_u32(order_ptr + i * u_four);
      memory_store_u32(order_ptr + i * u_four, memory_load_u32(order_ptr + best_j * u_four));
      memory_store_u32(order_ptr + best_j * u_four, temp);
    }
    i = i + u_one;
  }

  let atlas_dim: u32 = compute_best_atlas_dim(total_glyphs, order_ptr);
  memory_store_u32(192, atlas_dim);

  // Allocate table ptr for glyph rects (220 glyphs * 16 bytes = 3520 bytes + padding)
  let table_bytes: u32 = total_glyphs * u_16 + u_16;
  let raw_table_ptr: u32 = memory_alloc(table_bytes);
  let rem_t: u32 = raw_table_ptr % u_eight;
  let mut table_ptr: u32 = raw_table_ptr;
  if rem_t != 0 {
    table_ptr = raw_table_ptr + (u_eight - rem_t);
  }
  memory_store_u32(224, table_ptr);

  // Allocate table ptr for FreeType glyph metrics (220 glyphs * 32 bytes = 7040 bytes + padding)
  let metrics_bytes: u32 = total_glyphs * 32 + 32;
  let raw_metrics_ptr: u32 = memory_alloc(metrics_bytes);
  let rem_m: u32 = raw_metrics_ptr % u_eight;
  let mut metrics_ptr: u32 = raw_metrics_ptr;
  if rem_m != 0 {
    metrics_ptr = raw_metrics_ptr + (u_eight - rem_m);
  }
  memory_store_u32(232, metrics_ptr);

  // atlas_dim * atlas_dim * 4 bytes + 16 bytes alignment padding
  let atlas_bytes: u32 = atlas_dim * atlas_dim * 4 + 16;
  let raw_ptr: u32 = memory_alloc(atlas_bytes);
  let rem: u32 = raw_ptr % u_eight;
  let mut atlas_ptr: u32 = raw_ptr;
  if rem != 0 {
    atlas_ptr = raw_ptr + (u_eight - rem);
  }
  memory_store_u32(196, atlas_ptr);

  // Scratch memory for up to 32 segments * 16 bytes = 512 bytes
  let temp_seg_ptr: u32 = memory_alloc(512);

  // 2D Shelf Rectangle Packing Algorithm across sorted non-sequential glyphs
  let mut shelf_x: u32 = u_zero;
  let mut shelf_y: u32 = u_zero;
  let mut shelf_h: u32 = u_zero;

  let mut k: u32 = u_zero;
  while k < total_glyphs {
    let idx: u32 = memory_load_u32(order_ptr + k * u_four);
    let cell_w: u32 = get_glyph_cell_w_u32(idx);
    let cell_h: u32 = get_glyph_cell_h_u32(idx);

    if shelf_x + cell_w > atlas_dim {
      shelf_y = shelf_y + shelf_h;
      shelf_x = u_zero;
      shelf_h = u_zero;
    }

    let cell_x: u32 = shelf_x;
    let cell_y: u32 = shelf_y;

    if cell_h > shelf_h {
      shelf_h = cell_h;
    }
    shelf_x = shelf_x + cell_w;

    // Store packed rect table at table_ptr + idx * 16 (indexed by original idx)
    let table_entry: u32 = table_ptr + idx * u_16;
    memory_store_u32(table_entry, cell_x);
    memory_store_u32(table_entry + u_four, cell_y);
    memory_store_u32(table_entry + u_eight, cell_w);
    memory_store_u32(table_entry + u_twelve, cell_h);

    // Store FreeType glyph metrics table at metrics_ptr + idx * 32
    let metrics_entry: u32 = metrics_ptr + idx * 32;
    sdf_get_glyph_metrics(idx, metrics_entry);

    // Rasterize character cell MSDF into atlas
    sdf_render_char_cell(idx, atlas_ptr, atlas_dim, cell_x, cell_y, cell_w, cell_h, temp_seg_ptr);
    k = k + u_one;
  }

  return atlas_ptr;
}

export fn sdf_get_metrics_table_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(232);
  if existing_ptr == 0 {
    sdf_init_atlas_data();
    return memory_load_u32(232);
  }
  return existing_ptr;
}

export fn sdf_get_table_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(224);
  if existing_ptr == 0 {
    sdf_init_atlas_data();
    return memory_load_u32(224);
  }
  return existing_ptr;
}

export fn sdf_get_atlas_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(196);
  if existing_ptr == 0 {
    return sdf_init_atlas_data();
  }
  return existing_ptr;
}

export fn sdf_clear_text_vertices() -> unit {
  let u_zero: u32 = 0;
  memory_store_u32(200, u_zero);
}

export fn sdf_get_vertex_buffer_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(204);
  if existing_ptr != 0 {
    return existing_ptr;
  }
  // 1048576 floats * 8 bytes (f64) = 8,388,608 bytes + 16 bytes alignment padding
  let raw_ptr: u32 = memory_alloc(8388624);
  let u_eight: u32 = 8;
  let rem: u32 = raw_ptr % u_eight;
  let mut aligned_ptr: u32 = raw_ptr;
  if rem != 0 {
    aligned_ptr = raw_ptr + (u_eight - rem);
  }
  memory_store_u32(204, aligned_ptr);
  return aligned_ptr;
}

export fn sdf_get_vertex_float_count() -> u32 {
  return memory_load_u32(200);
}

export fn sdf_set_char_spacing(spacing: f64) -> unit {
  memory_store_f64(208, spacing);
}

export fn sdf_get_char_spacing() -> f64 {
  return memory_load_f64(208);
}

export fn sdf_set_line_height(line_height: f64) -> unit {
  memory_store_f64(216, line_height);
}

export fn sdf_get_line_height() -> f64 {
  let val: f64 = memory_load_f64(216);
  if val == f64_from_u32(0) {
    return f64_from_u32(1);
  }
  return val;
}




export fn sdf_get_font_ascent() -> u32 {
  return 18;
}

export fn sdf_get_font_descent() -> u32 {
  return 6;
}

export fn sdf_get_font_linegap() -> u32 {
  return 4;
}

export fn sdf_get_font_internal_leading() -> u32 {
  return 2;
}

export fn sdf_get_font_external_leading() -> u32 {
  return 4;
}

export fn get_glyph_right_bearing_i32(idx: u32) -> i32 {
  if idx == 0 { return 0; }
  let adv: u32 = get_glyph_advance_u32(idx);
  let bx: i32 = get_glyph_hori_bearing_x_i32(idx);
  let w: u32 = get_glyph_width_u32(idx);
  let u_zero: u32 = 0;
  let u_two: u32 = 2;
  let u_four: u32 = 4;
  let u_six: u32 = 6;
  let u_eight: u32 = 8;
  let u_ten: u32 = 10;
  let u_12: u32 = 12;
  let mut bx_u32: u32 = u_zero;
  if bx == 2 { bx_u32 = u_two; }
  if bx == 4 { bx_u32 = u_four; }
  if bx == 6 { bx_u32 = u_six; }
  if bx == 8 { bx_u32 = u_eight; }
  if bx == 10 { bx_u32 = u_ten; }
  let used: u32 = bx_u32 + w;
  if adv >= used {
    let diff: u32 = adv - used;
    if diff == u_two { return 2; }
    if diff == u_four { return 4; }
    if diff == u_six { return 6; }
    if diff == u_eight { return 8; }
    if diff == u_ten { return 10; }
    if diff == u_12 { return 12; }
    return 0;
  }
  return 0;
}

export fn get_glyph_center_x_u32(idx: u32) -> u32 {
  if idx == 0 { return 128; }
  if idx == 1 { return 80; }
  if idx == 2 { return 88; }
  if idx == 3 { return 96; }
  if idx == 4 { return 96; }
  if idx == 5 { return 96; }
  if idx == 6 { return 118; }
  if idx == 7 { return 68; }
  if idx == 8 { return 67; }
  if idx == 9 { return 94; }
  if idx == 10 { return 96; }
  if idx == 11 { return 104; }
  if idx == 12 { return 66; }
  if idx == 13 { return 88; }
  if idx == 14 { return 72; }
  if idx == 15 { return 80; }
  if idx == 16 { return 96; }
  if idx == 17 { return 86; }
  if idx == 18 { return 96; }
  if idx == 19 { return 97; }
  if idx == 20 { return 98; }
  if idx == 21 { return 99; }
  if idx == 22 { return 96; }
  if idx == 23 { return 96; }
  if idx == 24 { return 96; }
  if idx == 25 { return 96; }
  if idx == 26 { return 76; }
  if idx == 27 { return 70; }
  if idx == 28 { return 94; }
  if idx == 29 { return 96; }
  if idx == 30 { return 94; }
  if idx == 31 { return 96; }
  if idx == 32 { return 106; }
  if idx == 33 { return 112; }
  if idx == 34 { return 100; }
  if idx == 35 { return 105; }
  if idx == 36 { return 99; }
