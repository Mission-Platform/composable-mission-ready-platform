// ============================================================================
// FreeType Glyph Metrics Suite (https://freetype.org/freetype2/docs/glyphs/glyphs-3.html)
// Captures full FreeType metrics: width, height, horiBearingX, horiBearingY,
// horiAdvance, vertBearingX, vertBearingY, vertAdvance, and BBox (minX, minY, maxX, maxY).
// All glyph bounds and bearing dimensions are aligned to multiples of 2 on X & Y planes.
// ============================================================================

export fn get_glyph_hori_advance_u32(idx: u32) -> u32 {
  return get_glyph_advance_u32(idx);
}

export fn get_glyph_width_u32(idx: u32) -> u32 {
  if idx == 0 { return 0; }
  let adv: u32 = get_glyph_advance_u32(idx);
  let u_two: u32 = 2;
  let u_four: u32 = 4;
  let u_one: u32 = 1;
  if adv <= u_four {
    return u_two;
  }
  let mut w: u32 = adv - u_two;
  if is_narrow_glyph_idx(idx) {
    if adv > u_four {
      w = adv - u_four;
    }
  }
  let rem: u32 = w % u_two;
  if rem != 0 {
    w = w + u_one;
  }
  return w;
}

export fn get_glyph_height_u32(idx: u32) -> u32 {
  if idx == 0 { return 0; }
  let u_two: u32 = 2;
  let u_four: u32 = 4;
  let u_12: u32 = 12;
  let u_16: u32 = 16;
  let u_18: u32 = 18;
  let u_24: u32 = 24;
  let u_one: u32 = 1;
  let mut h: u32 = u_12;
  if (idx >= 16 && idx <= 25) || (idx >= 33 && idx <= 58) || idx == 66 || idx == 68 || idx == 70 || idx == 72 || idx == 75 || idx == 76 {
    h = u_18;
  } else {
    if idx == 71 || idx == 80 || idx == 81 || idx == 89 || (idx >= 96 && idx <= 156) {
      if idx == 107 {
        h = u_24;
      } else {
        if idx == 118 || idx == 119 || idx == 121 || idx == 122 || idx == 130 || idx == 131 {
          h = u_12;
        } else {
          h = u_18;
        }
      }
    } else {
      if idx == 74 {
        h = u_24;
      } else {
        if idx == 12 || idx == 14 {
          h = u_four;
        } else {
          if idx == 26 || idx == 27 {
            h = u_12;
          } else {
            if idx == 73 || idx == 84 {
              h = u_16;
            }
          }
        }
      }
    }
  }
  let rem: u32 = h % u_two;
  if rem != 0 {
    h = h + u_one;
  }
  return h;
}

export fn get_glyph_hori_bearing_x_i32(idx: u32) -> i32 {
  if idx == 0 { return 0; }
  let adv: u32 = get_glyph_advance_u32(idx);
  let w: u32 = get_glyph_width_u32(idx);
  let u_two: u32 = 2;
  let u_one: u32 = 1;
  if adv >= w {
    let diff: u32 = adv - w;
    let bearing: u32 = diff / u_two;
    let rem: u32 = bearing % u_two;
    let mut aligned: u32 = bearing;
    if rem != 0 {
      aligned = bearing - u_one;
    }
    if aligned == 2 { return 2; }
    if aligned == 4 { return 4; }
    if aligned == 6 { return 6; }
    if aligned == 8 { return 8; }
    if aligned == 10 { return 10; }
    return 0;
  }
  return 0;
}

export fn get_glyph_hori_bearing_y_i32(idx: u32) -> i32 {
  if idx == 0 { return 0; }
  let h: u32 = get_glyph_height_u32(idx);
  if h == 24 { return 24; }
  if h == 18 { return 18; }
  if h == 16 { return 16; }
  if h == 12 { return 12; }
  if h == 4 { return 4; }
  if h == 2 { return 2; }
  return 12;
}

export fn get_glyph_vert_advance_u32(idx: u32) -> u32 {
  let u_24: u32 = 24;
  return u_24;
}

export fn get_glyph_vert_bearing_x_u32(idx: u32) -> u32 {
  let w: u32 = get_glyph_width_u32(idx);
  let u_two: u32 = 2;
  let u_one: u32 = 1;
  let half: u32 = w / u_two;
  let rem: u32 = half % u_two;
  let mut aligned: u32 = half;
  if rem != 0 {
    aligned = half + u_one;
  }
  return aligned;
}

export fn get_glyph_vert_bearing_x_i32(idx: u32) -> i32 {
  let aligned: u32 = get_glyph_vert_bearing_x_u32(idx);
  if aligned == 2 { return -2; }
  if aligned == 4 { return -4; }
  if aligned == 6 { return -6; }
  if aligned == 8 { return -8; }
  if aligned == 10 { return -10; }
  if aligned == 12 { return -12; }
  if aligned == 14 { return -14; }
  if aligned == 16 { return -16; }
  if aligned == 18 { return -18; }
  if aligned == 20 { return -20; }
  if aligned == 22 { return -22; }
  if aligned == 24 { return -24; }
  return 0;
}

export fn get_glyph_vert_bearing_y_i32(idx: u32) -> i32 {
  let h: u32 = get_glyph_height_u32(idx);
  let u_two: u32 = 2;
  let u_one: u32 = 1;
  let u_24: u32 = 24;
  if u_24 >= h {
    let diff: u32 = u_24 - h;
    let bearing: u32 = diff / u_two;
    let rem: u32 = bearing % u_two;
    let mut aligned: u32 = bearing;
    if rem != 0 {
      aligned = bearing + u_one;
    }
    if aligned == 2 { return 2; }
    if aligned == 4 { return 4; }
    if aligned == 6 { return 6; }
    if aligned == 8 { return 8; }
    if aligned == 10 { return 10; }
    if aligned == 12 { return 12; }
    return 0;
  }
  return 0;
}

export fn get_glyph_bbox_min_x_i32(idx: u32) -> i32 {
  return get_glyph_hori_bearing_x_i32(idx);
}

export fn get_glyph_bbox_max_x_i32(idx: u32) -> i32 {
  let bx: i32 = get_glyph_hori_bearing_x_i32(idx);
  let w: u32 = get_glyph_width_u32(idx);
  if w == 2 { return bx + 2; }
  if w == 4 { return bx + 4; }
  if w == 6 { return bx + 6; }
  if w == 8 { return bx + 8; }
  if w == 10 { return bx + 10; }
  if w == 12 { return bx + 12; }
  if w == 14 { return bx + 14; }
  if w == 16 { return bx + 16; }
  if w == 18 { return bx + 18; }
  if w == 20 { return bx + 20; }
  if w == 22 { return bx + 22; }
  if w == 24 { return bx + 24; }
  if w == 26 { return bx + 26; }
  return bx;
}

export fn get_glyph_bbox_min_y_i32(idx: u32) -> i32 {
  let by: i32 = get_glyph_hori_bearing_y_i32(idx);
  let h: u32 = get_glyph_height_u32(idx);
  if h == 2 { return by - 2; }
  if h == 4 { return by - 4; }
  if h == 6 { return by - 6; }
  if h == 8 { return by - 8; }
  if h == 10 { return by - 10; }
  if h == 12 { return by - 12; }
  if h == 14 { return by - 14; }
  if h == 16 { return by - 16; }
  if h == 18 { return by - 18; }
  if h == 20 { return by - 20; }
  if h == 22 { return by - 22; }
  if h == 24 { return by - 24; }
  return by;
}

export fn get_glyph_bbox_max_y_i32(idx: u32) -> i32 {
  return get_glyph_hori_bearing_y_i32(idx);
}

export fn sdf_get_glyph_metrics(idx: u32, out_ptr: u32) -> unit {
  let w: u32 = get_glyph_width_u32(idx);
  let h: u32 = get_glyph_height_u32(idx);
  let adv: u32 = get_glyph_hori_advance_u32(idx);
  let vadv: u32 = get_glyph_vert_advance_u32(idx);

  let u_zero: u32 = 0;
  let u_two: u32 = 2;
  let u_four: u32 = 4;
  let u_six: u32 = 6;
  let u_eight: u32 = 8;
  let u_ten: u32 = 10;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let u_18: u32 = 18;
  let u_20: u32 = 20;
  let u_24: u32 = 24;
  let u_28: u32 = 28;

  memory_store_u32(out_ptr, w);
  memory_store_u32(out_ptr + u_four, h);

  let bx: i32 = get_glyph_hori_bearing_x_i32(idx);
  let mut bx_u32: u32 = u_zero;
  if bx == 2 { bx_u32 = u_two; }
  if bx == 4 { bx_u32 = u_four; }
  if bx == 6 { bx_u32 = u_six; }
  if bx == 8 { bx_u32 = u_eight; }
  memory_store_u32(out_ptr + u_eight, bx_u32);

  let by: i32 = get_glyph_hori_bearing_y_i32(idx);
  let mut by_u32: u32 = u_zero;
  if by == 24 { by_u32 = u_24; }
  if by == 18 { by_u32 = u_18; }
  if by == 16 { by_u32 = u_16; }
  if by == 12 { by_u32 = u_twelve; }
  if by == 4 { by_u32 = u_four; }
  if by == 2 { by_u32 = u_two; }
  memory_store_u32(out_ptr + u_twelve, by_u32);

  memory_store_u32(out_ptr + u_16, adv);

  let vbx_u32: u32 = get_glyph_vert_bearing_x_u32(idx);
  memory_store_u32(out_ptr + u_20, vbx_u32);

  let vby: i32 = get_glyph_vert_bearing_y_i32(idx);
  let mut vby_u32: u32 = u_zero;
  if vby == 2 { vby_u32 = u_two; }
  if vby == 4 { vby_u32 = u_four; }
  if vby == 6 { vby_u32 = u_six; }
  if vby == 8 { vby_u32 = u_eight; }
  if vby == 10 { vby_u32 = u_ten; }
  if vby == 12 { vby_u32 = u_twelve; }
  memory_store_u32(out_ptr + u_24, vby_u32);

  memory_store_u32(out_ptr + u_28, vadv);
}

