fn dist_to_val_u32(min_d: u32, radius: u32) -> u32 {
  let mut val: u32 = 0;
  let u_255: u32 = 255;
  if radius == 0 {
    return 0;
  }
  if min_d <= radius {
    val = ((radius - min_d) * u_255) / radius;
  }
  if val > u_255 {
    val = u_255;
  }
  return val;
}

export fn sdf_render_char_cell(
  idx: u32,
  atlas_ptr: u32,
  atlas_dim: u32,
  cell_x0: u32,
  cell_y0: u32,
  cell_w: u32,
  cell_h: u32,
  temp_seg_ptr: u32
) -> unit {
  let num_segs: u32 = sdf_load_char_segments(idx, temp_seg_ptr);

  let u_two: u32 = 2;
  let u_three: u32 = 3;
  let u_four: u32 = 4;
  let u_eight: u32 = 8;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let u_256: u32 = 256;
  let u_65536: u32 = 65536;
  let u_16777216: u32 = 16777216;
  let u_9999: u32 = 9999;
  let u_255: u32 = 255;
  let u_220: u32 = 220;
  let u_204: u32 = 204;
  let u_153: u32 = 153;
  let u_140: u32 = 140;
  let u_113: u32 = 113;
  let u_46: u32 = 46;
  let u_240: u32 = 240;
  let u_zero: u32 = 0;

  let step_x: u32 = u_256 / cell_w;
  let step_y: u32 = u_256 / cell_h;
  let half_x: u32 = step_x / u_two;
  let half_y: u32 = step_y / u_two;
  let mut radius: u32 = step_x * u_four;
  if radius < u_four { radius = u_four; }

  let mut ly: u32 = 0;
  while ly < cell_h {
    let py: u32 = ly * step_y + half_y;
    let mut lx: u32 = 0;
    while lx < cell_w {
      let px: u32 = lx * step_x + half_x;

      let mut val_r: u32 = 0;
      let mut val_g: u32 = 0;
      let mut val_b: u32 = 0;
      let mut val_a: u32 = 0;

      if num_segs > 0 {
        let mut min_d_r: u32 = u_9999;
        let mut min_d_g: u32 = u_9999;
        let mut min_d_b: u32 = u_9999;
        let mut min_d_a: u32 = u_9999;

        let mut s: u32 = 0;
        while s < num_segs {
          let s_off: u32 = temp_seg_ptr + s * u_16;
          let ax: u32 = memory_load_u32(s_off);
          let ay: u32 = memory_load_u32(s_off + u_four);
          let bx: u32 = memory_load_u32(s_off + u_eight);
          let by: u32 = memory_load_u32(s_off + u_twelve);
          let d: u32 = dist_to_segment_u32(px, py, ax, ay, bx, by);

          if d < min_d_a {
            min_d_a = d;
          }

          if num_segs == 1 {
            if d < min_d_r { min_d_r = d; }
            if d < min_d_g { min_d_g = d; }
            if d < min_d_b { min_d_b = d; }
          } else {
            let color_cycle: u32 = s % u_three;
            // Yellow: R + G
            if color_cycle == 0 {
              if d < min_d_r { min_d_r = d; }
              if d < min_d_g { min_d_g = d; }
            }
            // Cyan: G + B
            if color_cycle == 1 {
              if d < min_d_g { min_d_g = d; }
              if d < min_d_b { min_d_b = d; }
            }
            // Magenta: R + B
            if color_cycle == 2 {
              if d < min_d_r { min_d_r = d; }
              if d < min_d_b { min_d_b = d; }
            }
          }

          s = s + 1;
        }

        if min_d_r == u_9999 { min_d_r = min_d_a; }
        if min_d_g == u_9999 { min_d_g = min_d_a; }
        if min_d_b == u_9999 { min_d_b = min_d_a; }

        val_r = dist_to_val_u32(min_d_r, radius);
        val_g = dist_to_val_u32(min_d_g, radius);
        val_b = dist_to_val_u32(min_d_b, radius);
        val_a = dist_to_val_u32(min_d_a, radius);

        let emoji_inner: u32 = radius;
        let emoji_outer: u32 = (radius * u_three) / u_two;

        if idx == 155 {
          if min_d_a < emoji_inner {
            val_r = u_255;
            val_g = u_220;
            val_b = u_zero;
            val_a = u_255;
          } else {
            if min_d_a < emoji_outer {
              val_r = u_255;
              val_g = u_140;
              val_b = u_zero;
              val_a = u_240;
            }
          }
        } else {
          if idx == 156 {
            if min_d_a < emoji_inner {
              val_r = u_255;
              val_g = u_204;
              val_b = u_zero;
              val_a = u_255;
            } else {
              if min_d_a < emoji_outer {
                val_r = u_255;
                val_g = u_153;
                val_b = u_zero;
                val_a = u_240;
              }
            }
          } else {
            if idx == 138 {
              if min_d_a < emoji_inner {
                val_r = u_46;
                val_g = u_204;
                val_b = u_113;
                val_a = u_255;
              }
            }
          }
        }
      }

      let packed: u32 = val_r + (val_g * u_256) + (val_b * u_65536) + (val_a * u_16777216);
      let pixel_idx: u32 = (cell_y0 + ly) * atlas_dim + (cell_x0 + lx);
      memory_store_u32(atlas_ptr + pixel_idx * 4, packed);

      lx = lx + 1;
    }
    ly = ly + 1;
  }
}

fn compute_best_atlas_dim(total_glyphs: u32) -> u32 {
  let u_zero: u32 = 0;
  let u_one: u32 = 1;
  let u_two: u32 = 2;
  let mut candidate: u32 = 256;
  while candidate <= 2048 {
    let mut shelf_x: u32 = u_zero;
    let mut shelf_y: u32 = u_zero;
    let mut shelf_h: u32 = u_zero;
    let mut fits: bool = true;

    let mut i: u32 = u_zero;
    while i < total_glyphs {
      let cell_w: u32 = get_glyph_cell_w_u32(i);
      let cell_h: u32 = get_glyph_cell_h_u32(i);
      if cell_w > candidate || cell_h > candidate {
        fits = false;
      }
      if shelf_x + cell_w > candidate {
        shelf_y = shelf_y + shelf_h;
        shelf_x = u_zero;
        shelf_h = u_zero;
      }
      if cell_h > shelf_h {
        shelf_h = cell_h;
      }
      shelf_x = shelf_x + cell_w;
      i = i + u_one;
    }
    if shelf_y + shelf_h > candidate {
      fits = false;
    }
    if fits {
      return candidate;
    }
    candidate = candidate * u_two;
  }
  return 2048;
}

export fn sdf_init_atlas_data() -> u32 {
  let u_one: u32 = 1;
  let u_four: u32 = 4;
  let u_eight: u32 = 8;
  let u_twelve: u32 = 12;
  let u_16: u32 = 16;
  let existing_ptr: u32 = memory_load_u32(196);
  if existing_ptr != 0 {
    return existing_ptr;
  }

  let total_glyphs: u32 = 220;
  let atlas_dim: u32 = compute_best_atlas_dim(total_glyphs);
  memory_store_u32(192, atlas_dim);

  // Allocate table ptr for glyph rects (220 glyphs * 16 bytes = 3520 bytes + padding)
  let table_bytes: u32 = total_glyphs * u_16 + u_16;
  let raw_table_ptr: u32 = memory_alloc(table_bytes);
  let rem_t: u32 = raw_table_ptr % u_eight;
  let mut table_ptr: u32 = raw_table_ptr;
  if rem_t != 0 {
    table_ptr = raw_table_ptr + (u_eight - rem_t);
  }
  memory_store_u32(224, table_ptr);

  // atlas_dim * atlas_dim * 4 bytes + 16 bytes alignment padding
  let atlas_bytes: u32 = atlas_dim * atlas_dim * 4 + 16;
  let raw_ptr: u32 = memory_alloc(atlas_bytes);
  let rem: u32 = raw_ptr % u_eight;
  let mut atlas_ptr: u32 = raw_ptr;
  if rem != 0 {
    atlas_ptr = raw_ptr + (u_eight - rem);
  }
  memory_store_u32(196, atlas_ptr);

  // Scratch memory for up to 32 segments * 16 bytes = 512 bytes
  let temp_seg_ptr: u32 = memory_alloc(512);

  // 2D Shelf Rectangle Packing Algorithm across optimal base-2 sprite sheet
  let u_zero: u32 = 0;
  let mut shelf_x: u32 = u_zero;
  let mut shelf_y: u32 = u_zero;
  let mut shelf_h: u32 = u_zero;

  let mut idx: u32 = u_zero;
  while idx < total_glyphs {
    let cell_w: u32 = get_glyph_cell_w_u32(idx);
    let cell_h: u32 = get_glyph_cell_h_u32(idx);

    if shelf_x + cell_w > atlas_dim {
      shelf_y = shelf_y + shelf_h;
      shelf_x = u_zero;
      shelf_h = u_zero;
    }

    let cell_x: u32 = shelf_x;
    let cell_y: u32 = shelf_y;

    if cell_h > shelf_h {
      shelf_h = cell_h;
    }
    shelf_x = shelf_x + cell_w;

    // Store packed rect table at table_ptr + idx * 16
    let table_entry: u32 = table_ptr + idx * u_16;
    memory_store_u32(table_entry, cell_x);
    memory_store_u32(table_entry + u_four, cell_y);
    memory_store_u32(table_entry + u_eight, cell_w);
    memory_store_u32(table_entry + u_twelve, cell_h);

    // Rasterize character cell MSDF into atlas
    sdf_render_char_cell(idx, atlas_ptr, atlas_dim, cell_x, cell_y, cell_w, cell_h, temp_seg_ptr);
    idx = idx + u_one;
  }

  return atlas_ptr;
}

export fn sdf_get_table_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(224);
  if existing_ptr == 0 {
    sdf_init_atlas_data();
    return memory_load_u32(224);
  }
  return existing_ptr;
}

export fn sdf_get_atlas_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(196);
  if existing_ptr == 0 {
    return sdf_init_atlas_data();
  }
  return existing_ptr;
}

export fn sdf_clear_text_vertices() -> unit {
  let u_zero: u32 = 0;
  memory_store_u32(200, u_zero);
}

export fn sdf_get_vertex_buffer_ptr() -> u32 {
  let existing_ptr: u32 = memory_load_u32(204);
  if existing_ptr != 0 {
    return existing_ptr;
  }
  // 1048576 floats * 8 bytes (f64) = 8,388,608 bytes + 16 bytes alignment padding
  let raw_ptr: u32 = memory_alloc(8388624);
  let u_eight: u32 = 8;
  let rem: u32 = raw_ptr % u_eight;
  let mut aligned_ptr: u32 = raw_ptr;
  if rem != 0 {
    aligned_ptr = raw_ptr + (u_eight - rem);
  }
  memory_store_u32(204, aligned_ptr);
  return aligned_ptr;
}

export fn sdf_get_vertex_float_count() -> u32 {
  return memory_load_u32(200);
}

export fn sdf_set_char_spacing(spacing: f64) -> unit {
  memory_store_f64(208, spacing);
}

export fn sdf_get_char_spacing() -> f64 {
  return memory_load_f64(208);
}

export fn sdf_set_line_height(line_height: f64) -> unit {
  memory_store_f64(216, line_height);
}

export fn sdf_get_line_height() -> f64 {
  let val: f64 = memory_load_f64(216);
  if val == f64_from_u32(0) {
    return f64_from_u32(1);
  }
  return val;
}



