    write_seg(seg_ptr, 7, 96, 180, 118, 170);
    write_seg(seg_ptr, 8, 118, 170, 124, 144);
    write_seg(seg_ptr, 9, 76, 68, 76, 76);
    write_seg(seg_ptr, 10, 108, 68, 108, 76);
    return 11;
  }
  if idx == 145 {
    write_seg(seg_ptr, 0, 132, 140, 121, 165);
    write_seg(seg_ptr, 1, 121, 165, 96, 176);
    write_seg(seg_ptr, 2, 96, 176, 71, 165);
