    write_seg(seg_ptr, 0, 7, 16, 24, 16);
    return 1;
  }
  if idx == 123 {
    // ✓
    write_seg(seg_ptr, 0, 7, 16, 13, 23);
    write_seg(seg_ptr, 1, 13, 23, 25, 7);
    return 2;
  }
  if idx == 124 {
    // ✗
    write_seg(seg_ptr, 0, 8, 8, 24, 24);
    write_seg(seg_ptr, 1, 24, 8, 8, 24);
    return 2;
  }
  if idx == 125 {
    // ★
    write_seg(seg_ptr, 0, 16, 6, 19, 13);
    write_seg(seg_ptr, 1, 19, 13, 26, 14);
    write_seg(seg_ptr, 2, 26, 14, 21, 19);
    write_seg(seg_ptr, 3, 21, 19, 23, 26);
    write_seg(seg_ptr, 4, 23, 26, 16, 22);
    write_seg(seg_ptr, 5, 16, 22, 9, 26);
    write_seg(seg_ptr, 6, 9, 26, 11, 19);
    write_seg(seg_ptr, 7, 11, 19, 6, 14);
    write_seg(seg_ptr, 8, 6, 14, 13, 13);
    write_seg(seg_ptr, 9, 13, 13, 16, 6);
    return 10;
  }
  if idx == 126 {
    // ⚡
    write_seg(seg_ptr, 0, 18, 6, 10, 16);
    write_seg(seg_ptr, 1, 10, 16, 17, 16);
    write_seg(seg_ptr, 2, 17, 16, 13, 26);
    write_seg(seg_ptr, 3, 13, 26, 22, 14);
    write_seg(seg_ptr, 4, 22, 14, 16, 14);
    write_seg(seg_ptr, 5, 16, 14, 18, 6);
    return 6;
  }
  if idx == 127 {
    // ©
    write_seg(seg_ptr, 0, 10, 8, 22, 8);
    write_seg(seg_ptr, 1, 22, 8, 24, 16);
    write_seg(seg_ptr, 2, 24, 16, 22, 24);
    write_seg(seg_ptr, 3, 22, 24, 10, 24);
    write_seg(seg_ptr, 4, 10, 24, 8, 16);
    write_seg(seg_ptr, 5, 8, 16, 10, 8);
    write_seg(seg_ptr, 6, 18, 12, 14, 12);
    write_seg(seg_ptr, 7, 14, 12, 14, 20);
    write_seg(seg_ptr, 8, 14, 20, 18, 20);
    return 9;
  }
  if idx == 128 {
    // ®
    write_seg(seg_ptr, 0, 10, 8, 22, 8);
    write_seg(seg_ptr, 1, 22, 8, 24, 16);
    write_seg(seg_ptr, 2, 24, 16, 22, 24);
    write_seg(seg_ptr, 3, 22, 24, 10, 24);
    write_seg(seg_ptr, 4, 10, 24, 8, 16);
    write_seg(seg_ptr, 5, 8, 16, 10, 8);
    write_seg(seg_ptr, 6, 13, 12, 13, 20);
    write_seg(seg_ptr, 7, 13, 12, 18, 12);
    write_seg(seg_ptr, 8, 18, 12, 18, 16);
    write_seg(seg_ptr, 9, 18, 16, 13, 16);
    return 10;
  }
  if idx == 129 {
    // µ
    write_seg(seg_ptr, 0, 10, 13, 10, 26);
    write_seg(seg_ptr, 1, 10, 20, 18, 20);
    write_seg(seg_ptr, 2, 18, 13, 18, 21);
    return 3;
  }
  if idx == 130 {
    // ²
    write_seg(seg_ptr, 0, 12, 8, 18, 8);
    write_seg(seg_ptr, 1, 18, 8, 18, 11);
    write_seg(seg_ptr, 2, 18, 11, 12, 15);
    write_seg(seg_ptr, 3, 12, 15, 18, 15);
    return 4;
  }
  if idx == 131 {
    // ³
    write_seg(seg_ptr, 0, 12, 8, 18, 8);
    write_seg(seg_ptr, 1, 18, 8, 15, 11);
    write_seg(seg_ptr, 2, 15, 11, 18, 13);
    write_seg(seg_ptr, 3, 18, 13, 12, 15);
    return 4;
  }
  if idx == 132 {
    // α
    write_seg(seg_ptr, 0, 22, 13, 14, 21);
    write_seg(seg_ptr, 1, 14, 21, 10, 17);
    write_seg(seg_ptr, 2, 10, 17, 14, 13);
    write_seg(seg_ptr, 3, 14, 13, 22, 21);
    return 4;
  }
  if idx == 133 {
    // β
    write_seg(seg_ptr, 0, 11, 7, 11, 26);
    write_seg(seg_ptr, 1, 11, 7, 19, 7);
    write_seg(seg_ptr, 2, 19, 7, 19, 13);
    write_seg(seg_ptr, 3, 19, 13, 11, 13);
    write_seg(seg_ptr, 4, 11, 13, 20, 13);
    write_seg(seg_ptr, 5, 20, 13, 20, 20);
    write_seg(seg_ptr, 6, 20, 20, 11, 20);
    return 7;
  }
  if idx == 134 {
    // γ
    write_seg(seg_ptr, 0, 10, 13, 16, 20);
    write_seg(seg_ptr, 1, 21, 13, 16, 20);
    write_seg(seg_ptr, 2, 16, 20, 13, 26);
    return 3;
  }
  if idx == 135 {
    // δ
    write_seg(seg_ptr, 0, 19, 7, 16, 7);
    write_seg(seg_ptr, 1, 16, 7, 12, 15);
    write_seg(seg_ptr, 2, 12, 15, 20, 15);
    write_seg(seg_ptr, 3, 20, 15, 20, 21);
    write_seg(seg_ptr, 4, 20, 21, 12, 21);
    write_seg(seg_ptr, 5, 12, 21, 12, 15);
    return 6;
  }
  if idx == 136 {
    // λ
    write_seg(seg_ptr, 0, 11, 24, 20, 7);
    write_seg(seg_ptr, 1, 15, 14, 23, 24);
    return 2;
  }
  if idx == 137 {
    // μ
    write_seg(seg_ptr, 0, 10, 13, 10, 26);
    write_seg(seg_ptr, 1, 10, 20, 18, 20);
    write_seg(seg_ptr, 2, 18, 13, 18, 21);
    return 3;
  }
  if idx == 138 {
    // π
    write_seg(seg_ptr, 0, 8, 13, 24, 13);
    write_seg(seg_ptr, 1, 12, 13, 12, 22);
    write_seg(seg_ptr, 2, 19, 13, 20, 22);
    return 3;
  }
  if idx == 139 {
    // σ
    write_seg(seg_ptr, 0, 16, 13, 23, 13);
    write_seg(seg_ptr, 1, 16, 13, 11, 13);
    write_seg(seg_ptr, 2, 11, 13, 11, 21);
    write_seg(seg_ptr, 3, 11, 21, 19, 21);
    write_seg(seg_ptr, 4, 19, 21, 19, 13);
    return 5;
  }
  if idx == 140 {
    // ω
    write_seg(seg_ptr, 0, 8, 13, 11, 21);
    write_seg(seg_ptr, 1, 11, 21, 16, 17);
    write_seg(seg_ptr, 2, 16, 17, 21, 21);
    write_seg(seg_ptr, 3, 21, 21, 24, 13);
    return 4;
  }
  if idx == 141 {
    // Δ
    write_seg(seg_ptr, 0, 16, 7, 8, 24);
    write_seg(seg_ptr, 1, 8, 24, 24, 24);
    write_seg(seg_ptr, 2, 24, 24, 16, 7);
    return 3;
  }
  if idx == 142 {
    // Ω
    write_seg(seg_ptr, 0, 8, 24, 12, 24);
    write_seg(seg_ptr, 1, 12, 24, 10, 14);
    write_seg(seg_ptr, 2, 10, 14, 16, 7);
    write_seg(seg_ptr, 3, 16, 7, 22, 14);
    write_seg(seg_ptr, 4, 22, 14, 20, 24);
    write_seg(seg_ptr, 5, 20, 24, 24, 24);
    return 6;
  }
  if idx == 143 {
    // θ
    write_seg(seg_ptr, 0, 16, 7, 10, 14);
    write_seg(seg_ptr, 1, 10, 14, 10, 18);
    write_seg(seg_ptr, 2, 10, 18, 16, 24);
    write_seg(seg_ptr, 3, 16, 24, 22, 18);
    write_seg(seg_ptr, 4, 22, 18, 22, 14);
    write_seg(seg_ptr, 5, 22, 14, 16, 7);
    write_seg(seg_ptr, 6, 10, 16, 22, 16);
    return 7;
  }
  if idx == 144 {
    // ä
    write_seg(seg_ptr, 0, 13, 8, 14, 8);
    write_seg(seg_ptr, 1, 18, 8, 19, 8);
    write_seg(seg_ptr, 2, 19, 13, 13, 13);
    write_seg(seg_ptr, 3, 13, 13, 11, 17);
    write_seg(seg_ptr, 4, 11, 17, 19, 17);
    write_seg(seg_ptr, 5, 19, 13, 19, 21);
    write_seg(seg_ptr, 6, 11, 17, 11, 21);
    write_seg(seg_ptr, 7, 11, 21, 19, 21);
    return 8;
  }
  if idx == 145 {
    // ö
    write_seg(seg_ptr, 0, 13, 8, 14, 8);
    write_seg(seg_ptr, 1, 18, 8, 19, 8);
    write_seg(seg_ptr, 2, 12, 13, 20, 13);
    write_seg(seg_ptr, 3, 20, 13, 20, 21);
    write_seg(seg_ptr, 4, 20, 21, 12, 21);
    write_seg(seg_ptr, 5, 12, 21, 12, 13);
    return 6;
  }
  if idx == 146 {
    // ü
    write_seg(seg_ptr, 0, 13, 8, 14, 8);
    write_seg(seg_ptr, 1, 18, 8, 19, 8);
    write_seg(seg_ptr, 2, 12, 13, 12, 20);
    write_seg(seg_ptr, 3, 12, 20, 20, 20);
    write_seg(seg_ptr, 4, 20, 13, 20, 21);
    return 5;
  }
  if idx == 147 {
    // é
    write_seg(seg_ptr, 0, 14, 10, 18, 6);
    write_seg(seg_ptr, 1, 12, 17, 20, 17);
    write_seg(seg_ptr, 2, 20, 17, 20, 13);
    write_seg(seg_ptr, 3, 20, 13, 12, 13);
    write_seg(seg_ptr, 4, 12, 13, 12, 21);
    write_seg(seg_ptr, 5, 12, 21, 20, 21);
    return 6;
  }
  if idx == 148 {
    // è
    write_seg(seg_ptr, 0, 18, 10, 14, 6);
    write_seg(seg_ptr, 1, 12, 17, 20, 17);
    write_seg(seg_ptr, 2, 20, 17, 20, 13);
    write_seg(seg_ptr, 3, 20, 13, 12, 13);
    write_seg(seg_ptr, 4, 12, 13, 12, 21);
    write_seg(seg_ptr, 5, 12, 21, 20, 21);
    return 6;
  }
  if idx == 149 {
    // ê
    write_seg(seg_ptr, 0, 13, 10, 16, 7);
    write_seg(seg_ptr, 1, 16, 7, 19, 10);
    write_seg(seg_ptr, 2, 12, 17, 20, 17);
    write_seg(seg_ptr, 3, 20, 17, 20, 13);
    write_seg(seg_ptr, 4, 20, 13, 12, 13);
    write_seg(seg_ptr, 5, 12, 13, 12, 21);
    write_seg(seg_ptr, 6, 12, 21, 20, 21);
    return 7;
  }
  if idx == 150 {
    // á
    write_seg(seg_ptr, 0, 14, 10, 18, 6);
    write_seg(seg_ptr, 1, 19, 13, 13, 13);
    write_seg(seg_ptr, 2, 13, 13, 11, 17);
    write_seg(seg_ptr, 3, 11, 17, 19, 17);
    write_seg(seg_ptr, 4, 19, 13, 19, 21);
    write_seg(seg_ptr, 5, 11, 17, 11, 21);
    write_seg(seg_ptr, 6, 11, 21, 19, 21);
    return 7;
  }
  if idx == 151 {
    // í
    write_seg(seg_ptr, 0, 14, 10, 18, 6);
    write_seg(seg_ptr, 1, 16, 13, 16, 21);
    return 2;
  }
  if idx == 152 {
    // ó
    write_seg(seg_ptr, 0, 14, 10, 18, 6);
    write_seg(seg_ptr, 1, 12, 13, 20, 13);
    write_seg(seg_ptr, 2, 20, 13, 20, 21);
    write_seg(seg_ptr, 3, 20, 21, 12, 21);
    write_seg(seg_ptr, 4, 12, 21, 12, 13);
    return 5;
  }
  if idx == 153 {
    // ú
    write_seg(seg_ptr, 0, 14, 10, 18, 6);
    write_seg(seg_ptr, 1, 12, 13, 12, 20);
    write_seg(seg_ptr, 2, 12, 20, 20, 20);
    write_seg(seg_ptr, 3, 20, 13, 20, 21);
    return 4;
  }
  if idx == 154 {
    // ñ
    write_seg(seg_ptr, 0, 13, 9, 15, 7);
    write_seg(seg_ptr, 1, 15, 7, 17, 10);
    write_seg(seg_ptr, 2, 17, 10, 19, 8);
    write_seg(seg_ptr, 3, 12, 13, 12, 21);
    write_seg(seg_ptr, 4, 12, 13, 20, 13);
    write_seg(seg_ptr, 5, 20, 13, 20, 21);
    return 6;
  }
  if idx == 155 {
    // ç
    write_seg(seg_ptr, 0, 20, 13, 12, 13);
    write_seg(seg_ptr, 1, 12, 13, 12, 21);
    write_seg(seg_ptr, 2, 12, 21, 20, 21);
    write_seg(seg_ptr, 3, 16, 21, 14, 25);
    write_seg(seg_ptr, 4, 14, 25, 17, 25);
    return 5;
  }
  if idx == 156 {
    // ß
    write_seg(seg_ptr, 0, 12, 7, 12, 24);
    write_seg(seg_ptr, 1, 12, 7, 18, 7);
    write_seg(seg_ptr, 2, 18, 7, 18, 14);
    write_seg(seg_ptr, 3, 18, 14, 12, 14);
    write_seg(seg_ptr, 4, 18, 14, 19, 18);
    write_seg(seg_ptr, 5, 19, 18, 15, 22);
    write_seg(seg_ptr, 6, 15, 22, 12, 22);
    return 7;
  }

  // Fallback box for unhandled printable characters
  write_seg(seg_ptr, 0, 9, 7, 23, 7);
  write_seg(seg_ptr, 1, 23, 7, 23, 23);
  write_seg(seg_ptr, 2, 23, 23, 9, 23);
  write_seg(seg_ptr, 3, 9, 23, 9, 7);
  return 4;
}

export fn sdf_render_char_cell(idx: u32, atlas_ptr: u32, col: u32, row: u32, temp_seg_ptr: u32) -> unit {
  let num_segs: u32 = sdf_load_char_segments(idx, temp_seg_ptr);
  let cell_x0: u32 = col * 32;
  let cell_y0: u32 = row * 32;
  let u_8: u32 = 8;
  let u_16: u32 = 16;
  let u_127: u32 = 127;
  let u_128: u32 = 128;
  let u_255: u32 = 255;

  let mut ly: u32 = 0;
  while ly < 32 {
    let py: u32 = ly * 8 + 4;
    let mut lx: u32 = 0;
    while lx < 32 {
      let px: u32 = lx * 8 + 4;

      let mut val: u32 = 0;
      if num_segs > 0 {
        let mut min_d: u32 = 9999;
        let mut s: u32 = 0;
        while s < num_segs {
          let s_off: u32 = temp_seg_ptr + s * 16;
          let ax: u32 = memory_load_u32(s_off);
          let ay: u32 = memory_load_u32(s_off + 4);
          let bx: u32 = memory_load_u32(s_off + 8);
          let by: u32 = memory_load_u32(s_off + 12);
          let d: u32 = dist_to_segment_u32(px, py, ax, ay, bx, by);
          if d < min_d {
            min_d = d;
          }
          s = s + 1;
        }

        if min_d <= u_8 {
          val = u_128 + ((u_8 - min_d) * u_127) / u_8;
        } else {
          let out: u32 = min_d - u_8;
          if out < u_16 {
            let drop: u32 = (out * u_128) / u_16;
            val = u_128 - drop;
          }
        }
        if val > u_255 {
          val = u_255;
        }
      }

      let packed: u32 = val + (val * 256) + (val * 65536) + (val * 16777216);
      let pixel_idx: u32 = (cell_y0 + ly) * 512 + (cell_x0 + lx);
      memory_store_u32(atlas_ptr + pixel_idx * 4, packed);

      lx = lx + 1;
    }
    ly = ly + 1;
  }
}

export fn sdf_init_atlas_data() -> u32 {
  let existing_ptr: u32 = memory_load_u32(196);
  if existing_ptr != 0 {
    return existing_ptr;
  }

  // 512 * 512 * 4 bytes = 1,048,576 bytes + 16 bytes alignment padding
  let atlas_bytes: u32 = 1048592;
  let raw_ptr: u32 = memory_alloc(atlas_bytes);
  let rem: u32 = raw_ptr % 8;
  let mut atlas_ptr: u32 = raw_ptr;
  let u_eight: u32 = 8;
  if rem != 0 {
    atlas_ptr = raw_ptr + (u_eight - rem);
  }
  memory_store_u32(196, atlas_ptr);

  // Scratch memory for 10 segments * 16 bytes = 160 bytes
  let temp_seg_ptr: u32 = memory_alloc(160);

  let mut idx: u32 = 0;
  while idx < 157 {
    let col: u32 = idx % 16;
    let row: u32 = idx / 16;
    sdf_render_char_cell(idx, atlas_ptr, col, row, temp_seg_ptr);
    idx = idx + 1;
  }

  return atlas_ptr;
}

export fn sdf_get_atlas_ptr() -> u32 {
  let ptr: u32 = memory_load_u32(196);
  if ptr == 0 {
    return sdf_init_atlas_data();
  }
  return ptr;
}

export fn sdf_clear_text_vertices() -> unit {
  memory_store_u32(200, 0);
}

export fn sdf_get_vertex_buffer_ptr() -> u32 {
  let mut ptr: u32 = memory_load_u32(204);
  if ptr == 0 {
    // 64,000 floats * 4 bytes = 256,000 bytes + 16 bytes alignment padding
    let raw: u32 = memory_alloc(256016);
    let rem: u32 = raw % 8;
    let u_eight: u32 = 8;
    if rem != 0 {
      ptr = raw + (u_eight - rem);
    } else {
      ptr = raw;
    }
    memory_store_u32(204, ptr);
  }
  return ptr;
}

export fn sdf_get_vertex_float_count() -> u32 {
  return memory_load_u32(200);
}

export fn sdf_append_text_quads(
  text: string,
  origin_x: f64,
  baseline_y: f64,
  font_size: f64,
  r: f64,
  g: f64,
  b: f64,
  a: f64,
  align: u32
) -> u32 {
  let len: i32 = string_length(text);
  if len == 0 {
    return 0;
  }

  let base_size: f64 = f64_from_u32(24);
  let scale: f64 = font_size / base_size;
  let mut cursor_x: f64 = origin_x;

  if align == 1 {
    let total_w: f64 = sdf_measure_text(text, font_size);
    cursor_x = origin_x - total_w;
  } else {
    if align == 2 {
      let total_w: f64 = sdf_measure_text(text, font_size);
      let two: f64 = f64_from_u32(2);
      cursor_x = origin_x - (total_w / two);
    }
  }

  let vbuf_base: u32 = sdf_get_vertex_buffer_ptr();
  let mut float_count: u32 = memory_load_u32(200);
  let atlas_size_f64: f64 = f64_from_u32(512);

  let buffer_f64: f64 = f64_from_u32(6);
  let top_f64: f64 = f64_from_u32(23);
  let dim_f64: f64 = f64_from_u32(32);

  let mut i: i32 = 0;
  let mut quads_added: u32 = 0;

  while i < len {
    let b0: i32 = string_byte_at(text, i);
    let step: i32 = utf8_codepoint_length(b0);
    let ucode: i32 = utf8_decode_codepoint(text, i, len);
    let adv_u32: u32 = sdf_get_char_advance_u32(ucode);
    let adv_f64: f64 = (f64_from_u32(adv_u32) * font_size) / base_size;

    if ucode == 32 {
      cursor_x = cursor_x + adv_f64;
    } else {
      let idx: u32 = char_code_to_idx(ucode);
      let col: u32 = idx % 16;
      let row: u32 = idx / 16;

      let cell_x: f64 = f64_from_u32(col * 32);
      let cell_y: f64 = f64_from_u32(row * 32);

      let qx0: f64 = cursor_x - (buffer_f64 * scale);
      let qy0: f64 = baseline_y - (top_f64 * scale);
      let qx1: f64 = qx0 + (dim_f64 * scale);
      let qy1: f64 = qy0 + (dim_f64 * scale);

      let u0: f64 = cell_x / atlas_size_f64;
      let v0: f64 = cell_y / atlas_size_f64;
      let u1: f64 = (cell_x + dim_f64) / atlas_size_f64;
      let v1: f64 = (cell_y + dim_f64) / atlas_size_f64;

      if float_count + 48 <= 64000 {
        // 6 vertices per quad: (qx0,qy0), (qx1,qy0), (qx0,qy1), (qx0,qy1), (qx1,qy0), (qx1,qy1)
        let v0_ptr: u32 = vbuf_base + float_count * 8;
        memory_store_f64(v0_ptr, qx0); memory_store_f64(v0_ptr + 8, qy0); memory_store_f64(v0_ptr + 16, u0); memory_store_f64(v0_ptr + 24, v0);
        memory_store_f64(v0_ptr + 32, r); memory_store_f64(v0_ptr + 40, g); memory_store_f64(v0_ptr + 48, b); memory_store_f64(v0_ptr + 56, a);

        let v1_ptr: u32 = v0_ptr + 64;
        memory_store_f64(v1_ptr, qx1); memory_store_f64(v1_ptr + 8, qy0); memory_store_f64(v1_ptr + 16, u1); memory_store_f64(v1_ptr + 24, v0);
        memory_store_f64(v1_ptr + 32, r); memory_store_f64(v1_ptr + 40, g); memory_store_f64(v1_ptr + 48, b); memory_store_f64(v1_ptr + 56, a);

        let v2_ptr: u32 = v1_ptr + 64;
        memory_store_f64(v2_ptr, qx0); memory_store_f64(v2_ptr + 8, qy1); memory_store_f64(v2_ptr + 16, u0); memory_store_f64(v2_ptr + 24, v1);
        memory_store_f64(v2_ptr + 32, r); memory_store_f64(v2_ptr + 40, g); memory_store_f64(v2_ptr + 48, b); memory_store_f64(v2_ptr + 56, a);

        let v3_ptr: u32 = v2_ptr + 64;
        memory_store_f64(v3_ptr, qx0); memory_store_f64(v3_ptr + 8, qy1); memory_store_f64(v3_ptr + 16, u0); memory_store_f64(v3_ptr + 24, v1);
        memory_store_f64(v3_ptr + 32, r); memory_store_f64(v3_ptr + 40, g); memory_store_f64(v3_ptr + 48, b); memory_store_f64(v3_ptr + 56, a);

        let v4_ptr: u32 = v3_ptr + 64;
        memory_store_f64(v4_ptr, qx1); memory_store_f64(v4_ptr + 8, qy0); memory_store_f64(v4_ptr + 16, u1); memory_store_f64(v4_ptr + 24, v0);
        memory_store_f64(v4_ptr + 32, r); memory_store_f64(v4_ptr + 40, g); memory_store_f64(v4_ptr + 48, b); memory_store_f64(v4_ptr + 56, a);

        let v5_ptr: u32 = v4_ptr + 64;
        memory_store_f64(v5_ptr, qx1); memory_store_f64(v5_ptr + 8, qy1); memory_store_f64(v5_ptr + 16, u1); memory_store_f64(v5_ptr + 24, v1);
        memory_store_f64(v5_ptr + 32, r); memory_store_f64(v5_ptr + 40, g); memory_store_f64(v5_ptr + 48, b); memory_store_f64(v5_ptr + 56, a);

        float_count = float_count + 48;
        quads_added = quads_added + 1;
      }
      cursor_x = cursor_x + adv_f64;
    }
    i = i + step;
  }

  memory_store_u32(200, float_count);
  return quads_added;
}
