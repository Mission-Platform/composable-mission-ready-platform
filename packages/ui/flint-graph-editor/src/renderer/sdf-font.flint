export fn isqrt_u32(val: u32) -> u32 {
  if val == 0 { return 0; }
  let mut x: u32 = val;
  let mut y: u32 = (x + 1) / 2;
  while y < x {
    x = y;
    y = (x + val / x) / 2;
  }
  return x;
}

export fn dist_to_segment_u32(px: u32, py: u32, ax: u32, ay: u32, bx: u32, by: u32) -> u32 {
  let mut dx: u32 = 0;
  let mut dy: u32 = 0;
  let mut dx_pos: bool = true;
  let mut dy_pos: bool = true;
  if bx >= ax { dx = bx - ax; } else { dx = ax - bx; dx_pos = false; }
  if by >= ay { dy = by - ay; } else { dy = ay - by; dy_pos = false; }
  let len_sq: u32 = dx * dx + dy * dy;
  if len_sq == 0 {
    let mut ex: u32 = 0;
    let mut ey: u32 = 0;
    if px >= ax { ex = px - ax; } else { ex = ax - px; }
    if py >= ay { ey = py - ay; } else { ey = ay - py; }
    return isqrt_u32(ex * ex + ey * ey);
  }

  let mut px_diff: u32 = 0;
  let mut px_pos: bool = true;
  if px >= ax { px_diff = px - ax; } else { px_diff = ax - px; px_pos = false; }

  let mut py_diff: u32 = 0;
  let mut py_pos: bool = true;
  if py >= ay { py_diff = py - ay; } else { py_diff = ay - py; py_pos = false; }

  let term_x: u32 = px_diff * dx;
  let term_y: u32 = py_diff * dy;
  let term_x_pos: bool = (px_pos && dx_pos) || ((!px_pos) && (!dx_pos));
  let term_y_pos: bool = (py_pos && dy_pos) || ((!py_pos) && (!dy_pos));

  let mut dot: u32 = 0;
  let mut dot_pos: bool = true;
  if term_x_pos && term_y_pos {
    dot = term_x + term_y;
  } else {
    if (!term_x_pos) && (!term_y_pos) {
      dot = term_x + term_y;
      dot_pos = false;
    } else {
      if term_x_pos && (!term_y_pos) {
        if term_x >= term_y {
          dot = term_x - term_y;
        } else {
          dot = term_y - term_x;
          dot_pos = false;
        }
      } else {
        if term_y >= term_x {
          dot = term_y - term_x;
        } else {
          dot = term_x - term_y;
          dot_pos = false;
        }
      }
    }
  }

  if !dot_pos {
    let mut ex: u32 = 0;
    let mut ey: u32 = 0;
    if px >= ax { ex = px - ax; } else { ex = ax - px; }
    if py >= ay { ey = py - ay; } else { ey = ay - py; }
    return isqrt_u32(ex * ex + ey * ey);
  }

  if dot >= len_sq {
    let mut ex: u32 = 0;
    let mut ey: u32 = 0;
    if px >= bx { ex = px - bx; } else { ex = bx - px; }
    if py >= by { ey = py - by; } else { ey = by - py; }
    return isqrt_u32(ex * ex + ey * ey);
  }

  let frac: u32 = (dot * 256) / len_sq;
  let qx_diff: u32 = (dx * frac) / 256;
  let qy_diff: u32 = (dy * frac) / 256;
  let mut qx: u32 = ax;
  if dx_pos { qx = ax + qx_diff; } else { qx = ax - qx_diff; }
  let mut qy: u32 = ay;
  if dy_pos { qy = ay + qy_diff; } else { qy = ay - qy_diff; }

  let mut rx: u32 = 0;
  let mut ry: u32 = 0;
  if px >= qx { rx = px - qx; } else { rx = qx - px; }
  if py >= qy { ry = py - qy; } else { ry = qy - py; }
  return isqrt_u32(rx * rx + ry * ry);
}

export fn sdf_get_atlas_size() -> u32 {
  return 512;
}

export fn sdf_get_base_font_size() -> f64 {
  return f64_from_u32(24);
}

export fn utf8_codepoint_length(byte_val: i32) -> i32 {
  if byte_val < 128 {
    return 1;
  }
  if byte_val >= 192 && byte_val < 224 {
    return 2;
  }
  if byte_val >= 224 && byte_val < 240 {
    return 3;
  }
  if byte_val >= 240 && byte_val < 248 {
    return 4;
  }
  return 1;
}

export fn utf8_decode_codepoint(text: string, i: i32, len: i32) -> i32 {
  let b0: i32 = string_byte_at(text, i);
  if b0 < 128 {
    return b0;
  }
  if b0 >= 192 && b0 < 224 {
    if i + 1 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      return (b0 - 192) * 64 + (b1 - 128);
    }
  }
  if b0 >= 224 && b0 < 240 {
    if i + 2 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      let b2: i32 = string_byte_at(text, i + 2);
      return (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
    }
  }
  if b0 >= 240 && b0 < 248 {
    if i + 3 < len {
      let b1: i32 = string_byte_at(text, i + 1);
      let b2: i32 = string_byte_at(text, i + 2);
      let b3: i32 = string_byte_at(text, i + 3);
      return (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
    }
  }
  return b0;
}

export fn unicode_to_idx(code: i32) -> u32 {
  // Math & Logic
  if code == 177 { return 96; } // ±
  if code == 215 { return 97; } // ×
  if code == 247 { return 98; } // ÷
  if code == 8730 { return 99; } // √
  if code == 8734 { return 100; } // ∞
  if code == 8776 { return 101; } // ≈
  if code == 8800 { return 102; } // ≠
  if code == 8804 { return 103; } // ≤
  if code == 8805 { return 104; } // ≥
  if code == 8721 { return 105; } // ∑
  if code == 8719 { return 106; } // ∏
  if code == 8747 { return 107; } // ∫
  if code == 8722 { return 108; } // −
  if code == 8706 { return 109; } // ∂
  if code == 8711 { return 110; } // ∇
  if code == 8712 { return 111; } // ∈

  // Arrows
  if code == 8592 { return 112; } // ←
  if code == 8593 { return 113; } // ↑
  if code == 8594 { return 114; } // →
  if code == 8595 { return 115; } // ↓
  if code == 8596 { return 116; } // ↔
  if code == 8658 { return 117; } // ⇒

  // Common symbols & punctuation
  if code == 176 { return 118; } // °
  if code == 8226 { return 119; } // •
  if code == 8230 { return 120; } // …
  if code == 8212 { return 121; } // —
  if code == 8211 { return 122; } // –
  if code == 10003 { return 123; } // ✓
  if code == 10007 { return 124; } // ✗
  if code == 9733 { return 125; } // ★
  if code == 9889 { return 126; } // ⚡
  if code == 169 { return 127; } // ©
  if code == 174 { return 128; } // ®
  if code == 181 { return 129; } // µ
  if code == 178 { return 130; } // ²
  if code == 179 { return 131; } // ³

  // Greek
  if code == 945 { return 132; } // α
  if code == 946 { return 133; } // β
  if code == 947 { return 134; } // γ
  if code == 948 { return 135; } // δ
  if code == 955 { return 136; } // λ
  if code == 956 { return 137; } // μ
  if code == 960 { return 138; } // π
  if code == 963 { return 139; } // σ
  if code == 969 { return 140; } // ω
  if code == 916 { return 141; } // Δ
  if code == 937 { return 142; } // Ω
  if code == 952 { return 143; } // θ

  // Latin-1 Accented Letters
  if code == 228 { return 144; } // ä
  if code == 246 { return 145; } // ö
  if code == 252 { return 146; } // ü
  if code == 233 { return 147; } // é
  if code == 232 { return 148; } // è
  if code == 234 { return 149; } // ê
  if code == 225 { return 150; } // á
  if code == 237 { return 151; } // í
  if code == 243 { return 152; } // ó
  if code == 250 { return 153; } // ú
  if code == 241 { return 154; } // ñ
  if code == 231 { return 155; } // ç
  if code == 223 { return 156; } // ß

  // Fallback box for unmapped printable UTF-8 character
  return 95;
}

export fn char_code_to_idx(code: i32) -> u32 {
  if code >= 32 && code <= 126 {
    let mut idx: u32 = 0;
    let mut cur: i32 = 32;
    while cur <= 126 {
      if cur == code {
        return idx;
      }
      idx = idx + 1;
      cur = cur + 1;
    }
    return 0;
  }
  if code < 32 {
    return 0;
  }
  return unicode_to_idx(code);
}

// Exact Comfortaa proportional advance widths at 24px
export fn sdf_get_char_advance_u32(code: i32) -> u32 {
  if code < 32 { return 6; }
  if code > 126 {
    if code == 945 { return 15; } // α
    if code == 946 { return 13; } // β
    if code == 947 { return 12; } // γ
    if code == 948 { return 13; } // δ
    if code == 955 { return 12; } // λ
    if code == 956 { return 13; } // μ
    if code == 960 { return 13; } // π
    if code == 963 { return 13; } // σ
    if code == 969 { return 17; } // ω
    if code == 916 { return 17; } // Δ
    if code == 937 { return 18; } // Ω
    if code == 952 { return 13; } // θ
    if code == 8594 || code == 8592 { return 24; }
    if code == 8593 || code == 8595 { return 12; }
    if code == 8721 { return 17; } // ∑
    if code == 8719 { return 20; } // ∏
    if code == 8747 { return 7; } // ∫
    if code == 8730 { return 13; } // √
    if code == 177 || code == 215 || code == 247 || code == 8722 { return 14; }
    if code == 9889 || code == 9733 { return 24; }
    if code >= 224 && code <= 235 { return 11; }
    if code == 236 || code == 237 { return 7; }
    if code >= 241 && code <= 250 { return 12; }
    return 13;
  }
  if code == 32 { return 6; }
  if code == 33 { return 8; }
  if code == 34 { return 10; }
  if code == 35 { return 12; }
  if code == 36 { return 12; }
  if code == 37 { return 20; }
  if code == 38 { return 19; }
  if code == 39 { return 5; }
  if code == 40 { return 8; }
  if code == 41 { return 8; }
  if code == 42 { return 12; }
  if code == 43 { return 14; }
  if code == 44 { return 6; }
  if code == 45 { return 8; }
  if code == 46 { return 6; }
  if code == 47 { return 7; }
  if code >= 48 && code <= 57 { return 12; }
  if code == 58 { return 7; }
  if code == 59 { return 7; }
  if code == 60 { return 14; }
  if code == 61 { return 14; }
  if code == 62 { return 14; }
  if code == 63 { return 11; }
  if code == 64 { return 22; }

  if code == 65 { return 17; } // A
  if code == 66 { return 16; } // B
  if code == 67 { return 16; } // C
  if code == 68 { return 17; } // D
  if code == 69 { return 15; } // E
  if code == 70 { return 13; } // F
  if code == 71 { return 17; } // G
  if code == 72 { return 17; } // H
  if code == 73 { return 8; }  // I
  if code == 74 { return 9; }  // J
  if code == 75 { return 17; } // K
  if code == 76 { return 15; } // L
  if code == 77 { return 21; } // M
  if code == 78 { return 17; } // N
  if code == 79 { return 17; } // O
  if code == 80 { return 13; } // P
  if code == 81 { return 17; } // Q
  if code == 82 { return 16; } // R
  if code == 83 { return 13; } // S
  if code == 84 { return 15; } // T
  if code == 85 { return 17; } // U
  if code == 86 { return 17; } // V
  if code == 87 { return 23; } // W
  if code == 88 { return 17; } // X
  if code == 89 { return 17; } // Y
  if code == 90 { return 15; } // Z

  if code == 91 { return 8; }
  if code == 92 { return 7; }
  if code == 93 { return 8; }
  if code == 94 { return 11; }
  if code == 95 { return 12; }
  if code == 96 { return 8; }

  if code == 97 { return 11; }  // a
  if code == 98 { return 12; }  // b
  if code == 99 { return 11; }  // c
  if code == 100 { return 12; } // d
  if code == 101 { return 11; } // e
  if code == 102 { return 8; }  // f
  if code == 103 { return 12; } // g
  if code == 104 { return 12; } // h
  if code == 105 { return 7; }  // i
  if code == 106 { return 7; }  // j
  if code == 107 { return 12; } // k
  if code == 108 { return 7; }  // l
  if code == 109 { return 19; } // m
  if code == 110 { return 12; } // n
  if code == 111 { return 12; } // o
  if code == 112 { return 12; } // p
  if code == 113 { return 12; } // q
  if code == 114 { return 8; }  // r
  if code == 115 { return 9; }  // s
  if code == 116 { return 7; }  // t
  if code == 117 { return 12; } // u
  if code == 118 { return 12; } // v
  if code == 119 { return 17; } // w
  if code == 120 { return 12; } // x
  if code == 121 { return 12; } // y
  if code == 122 { return 11; } // z

  if code == 123 { return 12; }
  if code == 124 { return 5; }
  if code == 125 { return 12; }
  if code == 126 { return 13; }

  return 12;
}

export fn sdf_get_char_advance(code: i32) -> f64 {
  let adv: u32 = sdf_get_char_advance_u32(code);
  return f64_from_u32(adv);
}

export fn sdf_measure_text(text: string, font_size: f64) -> f64 {
  let len: i32 = string_length(text);
  let mut total: f64 = f64_from_u32(0);
  let mut i: i32 = 0;
  let base_size: f64 = f64_from_u32(24);
  while i < len {
    let b0: i32 = string_byte_at(text, i);
    let step: i32 = utf8_codepoint_length(b0);
    let ucode: i32 = utf8_decode_codepoint(text, i, len);
    let adv_u32: u32 = sdf_get_char_advance_u32(ucode);
    let adv: f64 = (f64_from_u32(adv_u32) * font_size) / base_size;
    total = total + adv;
    i = i + step;
  }
  return total;
}

export fn write_seg(seg_ptr: u32, seg_idx: u32, x1: u32, y1: u32, x2: u32, y2: u32) -> unit {
  let offset: u32 = seg_ptr + seg_idx * 16;
  memory_store_u32(offset, x1);
  memory_store_u32(offset + 4, y1);
  memory_store_u32(offset + 8, x2);
  memory_store_u32(offset + 12, y2);
}

export fn sdf_load_char_segments(idx: u32, seg_ptr: u32) -> u32 {
  if idx == 0 { return 0; }
  if idx == 1 {
    write_seg(seg_ptr, 0, 80, 64, 80, 144);
    write_seg(seg_ptr, 1, 80, 172, 80, 180);
    return 2;
  }
  if idx == 2 {
    write_seg(seg_ptr, 0, 72, 64, 72, 96);
    write_seg(seg_ptr, 1, 104, 64, 104, 96);
    return 2;
  }
  if idx == 3 {
    write_seg(seg_ptr, 0, 80, 72, 80, 184);
    write_seg(seg_ptr, 1, 112, 72, 112, 184);
    write_seg(seg_ptr, 2, 64, 104, 128, 104);
    write_seg(seg_ptr, 3, 64, 152, 128, 152);
    return 4;
  }
  if idx == 4 {
    write_seg(seg_ptr, 0, 96, 56, 96, 184);
    write_seg(seg_ptr, 1, 118, 90, 110, 74);
    write_seg(seg_ptr, 2, 110, 74, 96, 68);
    write_seg(seg_ptr, 3, 96, 68, 82, 74);
    write_seg(seg_ptr, 4, 82, 74, 74, 90);
    write_seg(seg_ptr, 5, 74, 90, 78, 108);
    write_seg(seg_ptr, 6, 78, 108, 96, 120);
    write_seg(seg_ptr, 7, 96, 120, 114, 132);
    write_seg(seg_ptr, 8, 114, 132, 118, 150);
    write_seg(seg_ptr, 9, 118, 150, 110, 166);
    write_seg(seg_ptr, 10, 110, 166, 96, 172);
    write_seg(seg_ptr, 11, 96, 172, 82, 166);
    write_seg(seg_ptr, 12, 82, 166, 74, 150);
    return 13;
  }
  if idx == 5 {
    write_seg(seg_ptr, 0, 136, 56, 56, 184);
    write_seg(seg_ptr, 1, 96, 88, 86, 105);
    write_seg(seg_ptr, 2, 86, 105, 66, 105);
    write_seg(seg_ptr, 3, 66, 105, 56, 88);
    write_seg(seg_ptr, 4, 56, 88, 66, 71);
    write_seg(seg_ptr, 5, 66, 71, 86, 71);
    write_seg(seg_ptr, 6, 86, 71, 96, 88);
    write_seg(seg_ptr, 7, 136, 152, 126, 169);
    write_seg(seg_ptr, 8, 126, 169, 106, 169);
    write_seg(seg_ptr, 9, 106, 169, 96, 152);
    write_seg(seg_ptr, 10, 96, 152, 106, 135);
    write_seg(seg_ptr, 11, 106, 135, 126, 135);
    write_seg(seg_ptr, 12, 126, 135, 136, 152);
    return 13;
  }
  if idx == 6 {
    write_seg(seg_ptr, 0, 101, 111, 84, 90);
    write_seg(seg_ptr, 1, 84, 90, 97, 67);
    write_seg(seg_ptr, 2, 97, 67, 124, 70);
    write_seg(seg_ptr, 3, 124, 70, 131, 95);
    write_seg(seg_ptr, 4, 142, 163, 118, 176);
    write_seg(seg_ptr, 5, 118, 176, 93, 166);
    write_seg(seg_ptr, 6, 93, 166, 84, 140);
    write_seg(seg_ptr, 7, 84, 140, 99, 117);
    write_seg(seg_ptr, 8, 99, 117, 126, 114);
    write_seg(seg_ptr, 9, 88, 120, 152, 184);
    return 10;
  }
  if idx == 7 {
    write_seg(seg_ptr, 0, 68, 64, 68, 96);
    return 1;
  }
  if idx == 8 {
    write_seg(seg_ptr, 0, 76, 159, 63, 146);
    write_seg(seg_ptr, 1, 63, 146, 57, 129);
    write_seg(seg_ptr, 2, 57, 129, 57, 111);
    write_seg(seg_ptr, 3, 57, 111, 63, 94);
    write_seg(seg_ptr, 4, 63, 94, 76, 81);
    return 5;
  }
  if idx == 9 {
    write_seg(seg_ptr, 0, 84, 81, 97, 94);
    write_seg(seg_ptr, 1, 97, 94, 103, 111);
    write_seg(seg_ptr, 2, 103, 111, 103, 129);
    write_seg(seg_ptr, 3, 103, 129, 97, 146);
    write_seg(seg_ptr, 4, 97, 146, 84, 159);
    return 5;
  }
  if idx == 10 {
    write_seg(seg_ptr, 0, 64, 128, 128, 128);
    write_seg(seg_ptr, 1, 96, 96, 96, 160);
    write_seg(seg_ptr, 2, 76, 108, 116, 148);
    write_seg(seg_ptr, 3, 76, 148, 116, 108);
    return 4;
  }
  if idx == 11 {
    write_seg(seg_ptr, 0, 64, 128, 144, 128);
    write_seg(seg_ptr, 1, 104, 88, 104, 168);
    return 2;
  }
  if idx == 12 {
    write_seg(seg_ptr, 0, 72, 164, 72, 176);
    write_seg(seg_ptr, 1, 72, 176, 60, 192);
    return 2;
  }
  if idx == 13 {
    write_seg(seg_ptr, 0, 64, 132, 112, 132);
    return 1;
  }
  if idx == 14 {
    write_seg(seg_ptr, 0, 72, 172, 72, 180);
    return 1;
  }
  if idx == 15 {
    write_seg(seg_ptr, 0, 56, 184, 104, 56);
    return 1;
  }
  if idx == 16 {
    write_seg(seg_ptr, 0, 140, 128, 127, 159);
    write_seg(seg_ptr, 1, 127, 159, 96, 172);
    write_seg(seg_ptr, 2, 96, 172, 65, 159);
    write_seg(seg_ptr, 3, 65, 159, 52, 128);
    write_seg(seg_ptr, 4, 52, 128, 65, 97);
    write_seg(seg_ptr, 5, 65, 97, 96, 84);
    write_seg(seg_ptr, 6, 96, 84, 127, 97);
    write_seg(seg_ptr, 7, 127, 97, 140, 128);
    return 8;
  }
  if idx == 17 {
    write_seg(seg_ptr, 0, 76, 92, 96, 72);
    write_seg(seg_ptr, 1, 96, 72, 96, 184);
    return 2;
  }
  if idx == 18 {
    write_seg(seg_ptr, 0, 68, 88, 76, 68);
    write_seg(seg_ptr, 1, 76, 68, 96, 56);
    write_seg(seg_ptr, 2, 96, 56, 116, 68);
    write_seg(seg_ptr, 3, 116, 68, 124, 88);
    write_seg(seg_ptr, 4, 124, 88, 116, 112);
    write_seg(seg_ptr, 5, 116, 112, 68, 180);
    write_seg(seg_ptr, 6, 68, 180, 124, 180);
    return 7;
  }
  if idx == 19 {
    write_seg(seg_ptr, 0, 73, 84, 94, 72);
    write_seg(seg_ptr, 1, 94, 72, 116, 80);
    write_seg(seg_ptr, 2, 116, 80, 124, 102);
    write_seg(seg_ptr, 3, 124, 102, 112, 123);
    write_seg(seg_ptr, 4, 115, 126, 127, 146);
    write_seg(seg_ptr, 5, 127, 146, 123, 169);
    write_seg(seg_ptr, 6, 123, 169, 104, 183);
    write_seg(seg_ptr, 7, 104, 183, 81, 180);
    write_seg(seg_ptr, 8, 81, 180, 66, 162);
    return 9;
  }
  if idx == 20 {
    write_seg(seg_ptr, 0, 112, 64, 68, 140);
    write_seg(seg_ptr, 1, 68, 140, 128, 140);
    write_seg(seg_ptr, 2, 112, 64, 112, 184);
    return 3;
  }
  if idx == 21 {
    write_seg(seg_ptr, 0, 120, 72, 72, 72);
    write_seg(seg_ptr, 1, 72, 72, 72, 116);
    write_seg(seg_ptr, 2, 76, 121, 101, 115);
    write_seg(seg_ptr, 3, 101, 115, 123, 128);
    write_seg(seg_ptr, 4, 123, 128, 129, 153);
    write_seg(seg_ptr, 5, 129, 153, 116, 175);
    write_seg(seg_ptr, 6, 116, 175, 91, 181);
    write_seg(seg_ptr, 7, 91, 181, 69, 168);
    return 8;
  }
  if idx == 22 {
    write_seg(seg_ptr, 0, 120, 68, 104, 60);
    write_seg(seg_ptr, 1, 104, 60, 84, 68);
    write_seg(seg_ptr, 2, 84, 68, 68, 92);
    write_seg(seg_ptr, 3, 68, 92, 64, 128);
    write_seg(seg_ptr, 4, 64, 128, 64, 152);
    write_seg(seg_ptr, 5, 64, 152, 72, 174);
    write_seg(seg_ptr, 6, 72, 174, 96, 184);
    write_seg(seg_ptr, 7, 96, 184, 120, 174);
    write_seg(seg_ptr, 8, 120, 174, 128, 152);
    write_seg(seg_ptr, 9, 128, 152, 120, 130);
    write_seg(seg_ptr, 10, 120, 130, 96, 120);
    write_seg(seg_ptr, 11, 96, 120, 72, 130);
    write_seg(seg_ptr, 12, 72, 130, 64, 152);
    return 13;
  }
  if idx == 23 {
    write_seg(seg_ptr, 0, 68, 72, 124, 72);
    write_seg(seg_ptr, 1, 124, 72, 84, 184);
    return 2;
  }
  if idx == 24 {
    write_seg(seg_ptr, 0, 96, 60, 118, 68);
    write_seg(seg_ptr, 1, 118, 68, 124, 88);
