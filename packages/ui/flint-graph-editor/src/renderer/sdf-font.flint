    write_seg(seg_ptr, 7, 96, 180, 118, 170);
    write_seg(seg_ptr, 8, 118, 170, 124, 144);
    write_seg(seg_ptr, 9, 80, 84, 104, 64);
    return 10;
  }
  if idx == 151 {
    write_seg(seg_ptr, 0, 76, 108, 76, 180);
    write_seg(seg_ptr, 1, 68, 84, 88, 68);
    return 2;
  }
  if idx == 152 {
    write_seg(seg_ptr, 0, 132, 140, 121, 165);
    write_seg(seg_ptr, 1, 121, 165, 96, 176);
    write_seg(seg_ptr, 2, 96, 176, 71, 165);
    write_seg(seg_ptr, 3, 71, 165, 60, 140);
    write_seg(seg_ptr, 4, 60, 140, 71, 115);
    write_seg(seg_ptr, 5, 71, 115, 96, 104);
    write_seg(seg_ptr, 6, 96, 104, 121, 115);
    write_seg(seg_ptr, 7, 121, 115, 132, 140);
    write_seg(seg_ptr, 8, 80, 84, 104, 64);
