export fn write_seg(seg_ptr: u32, seg_idx: u32, x1: u32, y1: u32, x2: u32, y2: u32) -> unit {
  let offset: u32 = seg_ptr + seg_idx * 16;
  memory_store_u32(offset, x1);
  memory_store_u32(offset + 4, y1);
  memory_store_u32(offset + 8, x2);
  memory_store_u32(offset + 12, y2);
}







