          "$value": "{spacing.2}"
        },
        "padding-inline": {
          "$value": "{spacing.1}"
        }
      },
      "body": {
        "padding-block": {
          "$value": "{spacing.2}"
        },
        "padding-inline": {
          "$value": "{spacing.3}"
        },
        "surface": {
          "$value": "{color.bg.sunken}"
        },
        "text": {
          "$value": "{color.text.primary}"
        },
        "radius": {
          "$value": "{radius.lg}"
        },
        "tail-radius": {
          "$value": "{radius.xs}"
        },
        "font-family": {
          "$value": "{font.family.sans}"
        },
        "font-size": {
          "$value": "{size.font.sm}"
        },
        "line-height": {
          "$value": "{line-height.normal}"
        },
        "font-weight": {
          "$value": "{font.weight.regular}"
        }
      },
      "primary": {
