{
  "name": "@mission-platform/forge-adapters",
  "version": "1.2.0",
  "license": "BSD-4-Clause",
  "description": "Framework adapters for the Mission Platform Forge JSX runtime",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./web-components": {
      "types": "./dist/web-components.d.ts",
      "import": "./dist/web-components.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/forge-jsx": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "solid-js": "catalog:solid",
    "svelte": "catalog:svelte",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
