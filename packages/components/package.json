{
  "name": "@mission-platform/components",
  "version": "1.0.0",
  "license": "BSD-4-Clause",
  "description": "Sample write-once Mission Platform components authored with @mission-platform/forge and shipped as both Vue 3 and React components",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "mp:vue": {
        "types": "./dist/vue/index.d.ts",
        "import": "./dist/vue/index.js"
      },
      "mp:react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "mp:solid": {
        "types": "./dist/solid/index.d.ts",
        "import": "./dist/solid/index.js"
      },
      "mp:svelte": {
        "types": "./dist/svelte/index.d.ts",
        "import": "./dist/svelte/index.js"
      },
      "mp:web-component": {
        "types": "./dist/web-components/index.d.ts",
        "import": "./dist/web-components/index.js"
      },
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "import": "./dist/solid/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "import": "./dist/svelte/index.js"
    },
    "./web-components": {
      "types": "./dist/web-components/index.d.ts",
      "import": "./dist/web-components/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./forge-drawer": {
      "types": "./dist/components/forge-drawer/index.d.ts",
      "import": "./dist/components/forge-drawer/index.js"
    },
    "./storyblok/react": {
      "types": "./dist/storyblok/react/index.d.ts",
      "import": "./dist/storyblok/react/index.js"
    },
    "./storyblok/vue": {
      "types": "./dist/storyblok/vue/index.d.ts",
      "import": "./dist/storyblok/vue/index.js"
    },
    "./storyblok/components.json": "./dist/storyblok/components.json",
    "./styles": "./src/styles/_a11y.scss",
    "./styles/scss": "./src/styles/_a11y.scss"
  },
  "files": [
    "dist",
    "src/components",
    "src/styles",
    "src/utils",
    "src/stores"
  ],
  "scripts": {
    "build": "tsdown",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/forms-core": "workspace:*",
    "@mission-platform/harper": "workspace:*",
    "@mission-platform/hunspell": "workspace:*",
    "@mission-platform/icons": "workspace:*",
    "@mission-platform/forge": "workspace:*",
    "@mission-platform/phone-number": "workspace:*",
    "@mission-platform/scheduler-core": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "highlight.js": "catalog:code",
    "luxon": "catalog:",
    "marked": "catalog:code",
    "monaco-editor": "catalog:code"
  },
  "peerDependencies": {
    "@storyblok/react": "^6.1.11",
    "@storyblok/vue": "^10.1.10",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@storyblok/react": {
      "optional": true
    },
    "@storyblok/vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/i18n-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/storybook-framework": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@storybook/react-vite": "catalog:storybook",
    "@storybook/vue3-vite": "catalog:storybook",
    "@tsdown/css": "catalog:build",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-vue-jsx": "catalog:vue",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "sass-embedded": "catalog:vite",
    "solid-js": "catalog:solid",
    "storybook": "catalog:storybook",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "svelte": "catalog:svelte",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
