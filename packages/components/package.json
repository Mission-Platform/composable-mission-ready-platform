{
  "name": "@mission-platform/components",
  "version": "0.2.1",
  "description": "Vue 3 component library for Mission Platform",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles": "./dist/components.css"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -b && vite build && vue-tsc --project tsconfig.app.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.{vue,scss}\"",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.5"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/vue": "catalog:",
    "@mission-platform/breakpoints": "workspace:*",
    "@mission-platform/hunspell": "workspace:*",
    "@mission-platform/i18n": "workspace:*",
    "@mission-platform/icons": "workspace:*",
    "@mission-platform/harper": "workspace:*",
    "@mission-platform/tokens": "workspace:*",
    "highlight.js": "catalog:",
    "luxon": "catalog:",
    "marked": "catalog:",
    "monaco-editor": "catalog:",
    "nanoid": "catalog:",
    "vue-i18n": "catalog:vue",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@storybook/vue3-vite": "catalog:storybook",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/test-utils": "catalog:vue",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "sass-embedded": "catalog:vite",
    "storybook": "catalog:storybook",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-router": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
