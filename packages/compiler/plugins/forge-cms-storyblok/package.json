{
  "name": "@mission-platform/forge-cms-storyblok",
  "version": "0.2.2",
  "license": "BSD-4-Clause",
  "description": "Storyblok CMS target for Forge components",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solid": {
      "types": "./dist/runtime/solid.d.ts",
      "import": "./dist/runtime/solid.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@mission-platform/forge-cms-plugin-api": "workspace:*",
    "@mission-platform/forge-plugin-api": "workspace:*",
    "@storyblok/js": "^5.1.10",
    "typescript": "catalog:typescript"
  },
  "peerDependencies": {
    "@storyblok/react": "^6.1.11",
    "@storyblok/svelte": "^5.0.0",
    "@storyblok/vue": "^10.1.10",
    "react": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@types/node": "catalog:typescript",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:build",
    "vite": "catalog:vite",
    "vitest": "catalog:testing"
  }
}
