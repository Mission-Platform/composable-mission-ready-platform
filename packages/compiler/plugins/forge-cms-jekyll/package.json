{
  "name": "@mission-platform/forge-cms-jekyll",
  "version": "0.2.2",
  "license": "BSD-4-Clause",
  "description": "Jekyll CMS target for Forge components",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@mission-platform/forge-cms-plugin-api": "workspace:*",
    "@mission-platform/forge-plugin-api": "workspace:*"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@types/js-yaml": "catalog:typescript",
    "@types/node": "catalog:typescript",
    "eslint": "catalog:eslint",
    "js-yaml": "catalog:",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:build",
    "vite": "catalog:vite",
    "vitest": "catalog:testing"
  }
}
