// Shared Galois-field arithmetic for matrix Reed-Solomon decoding.
// Static tables match matrix-encoder-core.fws to avoid rebuild cost and keep
// the decoder graph aligned with the proven encoder field constants.
import "./matrix-decoder-core.fws" as dec;

export fn field_exp_table(primitive: i32, size: i32) -> string {
  if primitive == 19 {
    if size == 16 {
      return "001002004008003006012011005010007014015013009001002004008003006012011005010007014015013009";
    }
  }
  if primitive == 67 {
    if size == 64 {
      return "";
    }
  }
  if primitive == 301 {
    if size == 256 {
      return "";
    }
  }
  return "";
}

export fn field_log_table(primitive: i32, size: i32) -> string {
  if primitive == 19 {
    if size == 16 {
      return "000000001004002008005010003014009007006013011012";
    }
  }
  if primitive == 67 {
    if size == 64 {
      return "000000001006002012007026003032013035008048027018004024033016014052036054009045049038028041019056005062025011034031017047015023053051037044055040010061046030050022039043029060042021020059057058";
    }
  }
  if primitive == 301 {
    if size == 256 {
      return "";
    }
  }
  return "";
}

export fn gf_mul(exp: string, log: string, a: i32, b: i32) -> i32 {
  if a == 0 { return 0; }
  if b == 0 { return 0; }
  return dec.dget(exp, dec.dget(log, a) + dec.dget(log, b));
}

export fn field_inverse(exp: string, log: string, field_size: i32, value: i32) -> i32 {
  if value == 0 { return 0; }
  let order: i32 = field_size - 1;
  let mut exponent: i32 = order - dec.dget(log, value);
  while exponent < 0 {
    exponent = exponent + order;
  }
  while exponent >= order {
    exponent = exponent - order;
  }
  return dec.dget(exp, exponent);
}

export fn field_pow(exp: string, order: i32, power: i32) -> i32 {
  let mut reduced: i32 = power;
  while reduced < 0 {
    reduced = reduced + order;
  }
  while reduced >= order {
    reduced = reduced - order;
  }
  return dec.dget(exp, reduced);
}

export fn poly_mul(exp: string, log: string, left: string, right: string) -> string {
  let left_len: i32 = string_length(left) / 3;
  let right_len: i32 = string_length(right) / 3;
  if left_len == 0 { return right; }
  if right_len == 0 { return left; }
  let mut result: string = dec.dzeros(left_len + right_len - 1);
  let mut i: i32 = 0;
  while i < left_len {
    let a: i32 = dec.dget(left, i);
    if a != 0 {
      let mut j: i32 = 0;
      while j < right_len {
        let b: i32 = dec.dget(right, j);
        let product: i32 = gf_mul(exp, log, a, b);
        result = dec.dset(result, i + j, dec.xor16(dec.dget(result, i + j), product));
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return string_concat(result, "");
}
