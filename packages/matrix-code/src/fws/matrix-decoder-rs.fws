// Reed-Solomon correction (with erasure support) for matrix decoding.
// Split into small helpers so the self-hosted WASM backend keeps each
// function body under its control-flow complexity limit.
import "./matrix-decoder-core.fws" as dec;
import "./matrix-decoder-galois.fws" as gf;

fn syndromes_zero(exp: string, log: string, block: string, ecc: i32) -> bool {
  let syndrome: i32 = 0;
  let length: i32 = string_length(block) / 3;
  while syndrome < ecc {
    let alpha: i32 = dec.dget(exp, syndrome + 1);
    let value: i32 = 0;
    let index: i32 = 0;
    while index < length {
      value = dec.xor16(gf.gf_mul(exp, log, value, alpha), dec.dget(block, index));
      index = index + 1;
    }
    if value != 0 { return false; }
    syndrome = syndrome + 1;
  }
  return true;
}

fn compute_syndromes(exp: string, log: string, block: string, ecc: i32) -> string {
  let length: i32 = string_length(block) / 3;
  let syndromes: string = dec.dzeros(ecc);
  let syndrome_index: i32 = 0;
  while syndrome_index < ecc {
    let alpha: i32 = dec.dget(exp, syndrome_index + 1);
    let value: i32 = 0;
    let index: i32 = 0;
    while index < length {
      value = dec.xor16(gf.gf_mul(exp, log, value, alpha), dec.dget(block, index));
      index = index + 1;
    }
    syndromes = dec.dset(syndromes, syndrome_index, value);
    syndrome_index = syndrome_index + 1;
  }
  return syndromes;
}

fn syndromes_are_zero(syndromes: string, ecc: i32) -> bool {
  let index: i32 = 0;
  while index < ecc {
    if dec.dget(syndromes, index) != 0 { return false; }
    index = index + 1;
  }
  return true;
}

fn build_erasure_locator(exp: string, log: string, order: i32, length: i32, erasure_flags: string, ecc: i32) -> string {
  // Returns packed "count|locator" or empty on failure.
  let erasure_count: i32 = 0;
  let erasure_locator: string = dec.dset(dec.dzeros(1), 0, 1);
  let erasure_index: i32 = 0;
  while erasure_index < length {
    if dec.dget(erasure_flags, erasure_index) != 0 {
      erasure_count = erasure_count + 1;
      if erasure_count > ecc { return ""; }
      let factor: string = dec.dzeros(2);
      factor = dec.dset(factor, 0, 1);
      factor = dec.dset(factor, 1, gf.field_pow(exp, order, length - 1 - erasure_index));
      erasure_locator = gf.poly_mul(exp, log, erasure_locator, factor);
    }
    erasure_index = erasure_index + 1;
  }
  return string_concat(dec.decoder_digits(erasure_count), string_concat("|", erasure_locator));
}

fn apply_erasure_forney(exp: string, log: string, order: i32, length: i32, syndromes: string, erasure_flags: string, ecc: i32) -> string {
  let forney: string = syndromes;
  let erasure_index: i32 = 0;
  while erasure_index < length {
    if dec.dget(erasure_flags, erasure_index) != 0 {
      let x: i32 = gf.field_pow(exp, order, length - 1 - erasure_index);
      let j: i32 = 0;
      while j < ecc - 1 {
        forney = dec.dset(forney, j, dec.xor16(gf.gf_mul(exp, log, dec.dget(forney, j), x), dec.dget(forney, j + 1)));
        j = j + 1;
      }
    }
    erasure_index = erasure_index + 1;
  }
  return forney;
}

fn berlekamp_massey(exp: string, log: string, field_size: i32, forney: string, rounds: i32) -> string {
  // Returns packed "errors|lambda" 
  let lambda: string = dec.dset(dec.dzeros(1), 0, 1);
  let previous: string = dec.dset(dec.dzeros(1), 0, 1);
  let errors: i32 = 0;
  let shift: i32 = 1;
  let discrepancy_previous: i32 = 1;
  let round: i32 = 0;
  while round < rounds {
    let discrepancy: i32 = dec.dget(forney, round);
    let tap: i32 = 1;
    let lambda_len: i32 = string_length(lambda) / 3;
    while tap <= errors {
      if tap < lambda_len {
        discrepancy = dec.xor16(discrepancy, gf.gf_mul(exp, log, dec.dget(lambda, tap), dec.dget(forney, round - tap)));
      }
      tap = tap + 1;
    }
    if discrepancy == 0 {
      shift = shift + 1;
    } else {
      let scale: i32 = gf.gf_mul(exp, log, discrepancy, gf.field_inverse(exp, log, field_size, discrepancy_previous));
      let previous_len: i32 = string_length(previous) / 3;
      let target_len: i32 = shift + previous_len;
      while string_length(lambda) / 3 < target_len {
        lambda = string_concat(lambda, "000");
      }
      if 2 * errors <= round {
        let saved: string = lambda;
        tap = 0;
        while tap < previous_len {
          lambda = dec.dset(lambda, tap + shift, dec.xor16(dec.dget(lambda, tap + shift), gf.gf_mul(exp, log, scale, dec.dget(previous, tap))));
          tap = tap + 1;
        }
        previous = saved;
        errors = round + 1 - errors;
        discrepancy_previous = discrepancy;
        shift = 1;
      } else {
        tap = 0;
        while tap < previous_len {
          lambda = dec.dset(lambda, tap + shift, dec.xor16(dec.dget(lambda, tap + shift), gf.gf_mul(exp, log, scale, dec.dget(previous, tap))));
          tap = tap + 1;
        }
        shift = shift + 1;
      }
    }
    round = round + 1;
  }
  return string_concat(dec.decoder_digits(errors), string_concat("|", lambda));
}

fn chien_search(exp: string, log: string, order: i32, length: i32, sigma: string, total_positions: i32) -> string {
  // Returns packed positions (3-digit each) or empty on failure.
  let found: string = dec.dzeros(length);
  let found_count: i32 = 0;
  let root_index: i32 = 0;
  let sigma_len: i32 = string_length(sigma) / 3;
  while root_index < length {
    let root_mod: i32 = root_index - root_index / order * order;
    let inv_exp: i32 = order - root_mod;
    while inv_exp < 0 {
      inv_exp = inv_exp + order;
    }
    while inv_exp >= order {
      inv_exp = inv_exp - order;
    }
    let inverse: i32 = dec.dget(exp, inv_exp);
    let sum: i32 = 0;
    let power: i32 = 1;
    let coefficient: i32 = 0;
    while coefficient < sigma_len {
      sum = dec.xor16(sum, gf.gf_mul(exp, log, dec.dget(sigma, coefficient), power));
      power = gf.gf_mul(exp, log, power, inverse);
      coefficient = coefficient + 1;
    }
    if sum == 0 {
      if found_count >= length { return ""; }
      found = dec.dset(found, found_count, length - 1 - root_index);
      found_count = found_count + 1;
    }
    root_index = root_index + 1;
  }
  if found_count != total_positions { return ""; }
  return string_slice(found, 0, found_count * 3);
}

fn eval_poly_at_inverse(exp: string, log: string, poly: string, inverse: i32) -> i32 {
  let length: i32 = string_length(poly) / 3;
  let value: i32 = 0;
  let power: i32 = 1;
  let coefficient: i32 = 0;
  while coefficient < length {
    value = dec.xor16(value, gf.gf_mul(exp, log, dec.dget(poly, coefficient), power));
    power = gf.gf_mul(exp, log, power, inverse);
    coefficient = coefficient + 1;
  }
  return value;
}

fn eval_derivative_at_inverse(exp: string, log: string, sigma: string, inverse: i32) -> i32 {
  let length: i32 = string_length(sigma) / 3;
  let derivative: i32 = 0;
  let power: i32 = 1;
  let coefficient: i32 = 0;
  while coefficient < length {
    let odd: i32 = coefficient - coefficient / 2 * 2;
    if odd == 1 {
      derivative = dec.xor16(derivative, gf.gf_mul(exp, log, dec.dget(sigma, coefficient), power));
    }
    if coefficient >= 1 {
      power = gf.gf_mul(exp, log, power, inverse);
    }
    coefficient = coefficient + 1;
  }
  return derivative;
}

fn reduce_mod_order(value: i32, order: i32) -> i32 {
  if order <= 0 { return 0; }
  let reduced: i32 = value;
  while reduced < 0 {
    reduced = reduced + order;
  }
  while reduced >= order {
    reduced = reduced - order;
  }
  return reduced;
}

fn correct_one_position(exp: string, log: string, field_size: i32, order: i32, length: i32, block: string, omega: string, sigma: string, position: i32) -> string {
  if position < 0 { return ""; }
  if position >= length { return ""; }
  let loc_exp: i32 = reduce_mod_order(length - 1 - position, order);
  let locator: i32 = dec.dget(exp, loc_exp);
  if locator == 0 { return ""; }
  let inverse: i32 = gf.field_inverse(exp, log, field_size, locator);
  let omega_value: i32 = eval_poly_at_inverse(exp, log, omega, inverse);
  let derivative: i32 = eval_derivative_at_inverse(exp, log, sigma, inverse);
  if derivative == 0 { return ""; }
  let correction: i32 = gf.gf_mul(exp, log, omega_value, gf.field_inverse(exp, log, field_size, derivative));
  return dec.dset(block, position, dec.xor16(dec.dget(block, position), correction));
}

fn forney_correct(exp: string, log: string, field_size: i32, order: i32, length: i32, block: string, syndromes: string, sigma: string, found: string, ecc: i32) -> string {
  let corrected: string = block;
  let sigma_len: i32 = string_length(sigma) / 3;
  if sigma_len < 0 { return ""; }
  if sigma_len > 64 { return ""; }
  let omega: string = dec.dzeros(ecc);
  let omega_index: i32 = 0;
  while omega_index < ecc {
    let value: i32 = 0;
    let tap: i32 = 0;
    while tap <= omega_index {
      if tap < sigma_len {
        value = dec.xor16(value, gf.gf_mul(exp, log, dec.dget(sigma, tap), dec.dget(syndromes, omega_index - tap)));
      }
      tap = tap + 1;
    }
    omega = dec.dset(omega, omega_index, value);
    omega_index = omega_index + 1;
  }

  let found_count: i32 = string_length(found) / 3;
  if found_count < 0 { return ""; }
  if found_count > length { return ""; }
  let found_index: i32 = 0;
  while found_index < found_count {
    let position: i32 = dec.dget(found, found_index);
    let next: string = correct_one_position(exp, log, field_size, order, length, corrected, omega, sigma, position);
    if string_length(next) == 0 { return ""; }
    corrected = next;
    found_index = found_index + 1;
  }
  return corrected;
}

export fn rs_correct(block: string, ecc: i32, primitive: i32, field_size: i32, erasure_flags: string) -> string {
  if ecc < 0 { return ""; }
  if field_size <= 1 { return ""; }
  let exp: string = gf.field_exp_table(primitive, field_size);
  let log: string = gf.field_log_table(primitive, field_size);
  if string_length(exp) == 0 { return ""; }
  if string_length(log) == 0 { return ""; }
  let length: i32 = string_length(block) / 3;
  if length == 0 { return ""; }
  let order: i32 = field_size - 1;

  let syndromes: string = compute_syndromes(exp, log, block, ecc);
  if syndromes_are_zero(syndromes, ecc) {
    return block;
  } else {
    return rs_correct_errors(exp, log, field_size, order, length, block, syndromes, erasure_flags, ecc);
  }
}

fn rs_correct_errors(exp: string, log: string, field_size: i32, order: i32, length: i32, block: string, syndromes: string, erasure_flags: string, ecc: i32) -> string {
  let erasure_pack: string = build_erasure_locator(exp, log, order, length, erasure_flags, ecc);
  if string_length(erasure_pack) == 0 { return ""; }
  let split: i32 = 0;
  while split < string_length(erasure_pack) {
    if string_byte_at(erasure_pack, split) == 124 {
      let erasure_count: i32 = 0;
      let pi: i32 = 0;
      while pi < split {
        let digit: i32 = string_byte_at(erasure_pack, pi) - 48;
        erasure_count = erasure_count * 10 + digit;
        pi = pi + 1;
      }
      let erasure_locator: string = string_slice(erasure_pack, split + 1, string_length(erasure_pack));
      let forney: string = apply_erasure_forney(exp, log, order, length, syndromes, erasure_flags, ecc);
      let rounds: i32 = ecc - erasure_count;
      if rounds < 0 { return ""; }
      let bm_pack: string = berlekamp_massey(exp, log, field_size, forney, rounds);
      let bm_split: i32 = 0;
      while bm_split < string_length(bm_pack) {
        if string_byte_at(bm_pack, bm_split) == 124 {
          let errors: i32 = 0;
          let ei: i32 = 0;
          while ei < bm_split {
            let digit2: i32 = string_byte_at(bm_pack, ei) - 48;
            errors = errors * 10 + digit2;
            ei = ei + 1;
          }
          let lambda: string = string_slice(bm_pack, bm_split + 1, string_length(bm_pack));
          if 2 * errors + erasure_count > ecc { return ""; }
          let sigma: string = gf.poly_mul(exp, log, lambda, erasure_locator);
          let total_positions: i32 = errors + erasure_count;
          let found: string = chien_search(exp, log, order, length, sigma, total_positions);
          if string_length(found) == 0 {
            if total_positions != 0 { return ""; }
          }
          let corrected: string = forney_correct(exp, log, field_size, order, length, block, syndromes, sigma, found, ecc);
          if string_length(corrected) == 0 { return ""; }
          if syndromes_zero(exp, log, corrected, ecc) { return corrected; }
          return "";
        }
        bm_split = bm_split + 1;
      }
      return "";
    }
    split = split + 1;
  }
  return "";
}

export fn packed_bytes(bytes: string) -> string {
  let result: string = "";
  let index: i32 = 0;
  let length: i32 = string_length(bytes) / 3;
  while index < length {
    result = string_concat(result, dec.byte_char3(dec.dget(bytes, index)));
    index = index + 1;
  }
  return result;
}
