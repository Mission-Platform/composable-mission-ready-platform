// Compact Aztec extraction and high-level decoding.
import "./matrix-decoder-core.fws" as dec;
import "./matrix-decoder-rs.fws" as rs;

fn total_aztec_bits(layers: i32) -> i32 {
  return 88 * layers + 16 * layers * layers;
}

fn aztec_word_size(layers: i32) -> i32 {
  if layers <= 2 { return 6; }
  return 8;
}

fn extract_mode_message(size: i32, modules: Array<i32>) -> string {
  let center: i32 = size / 2;
  let radius: i32 = 5;
  let mut bits: string = dec.bits_zeros(28);
  let mut index: i32 = 0;
  while index < 7 {
    let offset: i32 = center - 3 + index;
    let top_row: i32 = center - radius;
    let top: i32 = top_row * size + offset;
    bits = dec.bit_array_set(bits, index, dec.module_bit(modules, top));
    let right: i32 = offset * size + center + radius;
    bits = dec.bit_array_set(bits, index + 7, dec.module_bit(modules, right));
    let bottom_row: i32 = center + radius;
    let bottom: i32 = bottom_row * size + offset;
    bits = dec.bit_array_set(bits, 20 - index, dec.module_bit(modules, bottom));
    let left: i32 = offset * size + center - radius;
    bits = dec.bit_array_set(bits, 27 - index, dec.module_bit(modules, left));
    index = index + 1;
  }
  return string_concat(bits, "");
}

fn aztec_nibble_value(bits: string, start: i32) -> i32 {
  let mut b0: i32 = 0;
  let mut b1: i32 = 0;
  let mut b2: i32 = 0;
  let mut b3: i32 = 0;
  if dec.bit_array_get(bits, start) { b0 = 1; }
  if dec.bit_array_get(bits, start + 1) { b1 = 1; }
  if dec.bit_array_get(bits, start + 2) { b2 = 1; }
  if dec.bit_array_get(bits, start + 3) { b3 = 1; }
  return b0 * 8 + b1 * 4 + b2 * 2 + b3;
}

fn aztec_word_value(bits: string, start: i32, word_size: i32) -> i32 {
  let mut b0: i32 = 0;
  let mut b1: i32 = 0;
  let mut b2: i32 = 0;
  let mut b3: i32 = 0;
  let mut b4: i32 = 0;
  let mut b5: i32 = 0;
  let mut b6: i32 = 0;
  let mut b7: i32 = 0;
  if dec.bit_array_get(bits, start) { b0 = 1; }
  if dec.bit_array_get(bits, start + 1) { b1 = 1; }
  if dec.bit_array_get(bits, start + 2) { b2 = 1; }
  if dec.bit_array_get(bits, start + 3) { b3 = 1; }
  if word_size > 4 && dec.bit_array_get(bits, start + 4) { b4 = 1; }
  if word_size > 4 && dec.bit_array_get(bits, start + 5) { b5 = 1; }
  if word_size > 6 && dec.bit_array_get(bits, start + 6) { b6 = 1; }
  if word_size > 6 && dec.bit_array_get(bits, start + 7) { b7 = 1; }
  if word_size == 4 { return b0 * 8 + b1 * 4 + b2 * 2 + b3; }
  if word_size == 6 { return b0 * 32 + b1 * 16 + b2 * 8 + b3 * 4 + b4 * 2 + b5; }
  return b0 * 128 + b1 * 64 + b2 * 32 + b3 * 16 + b4 * 8 + b5 * 4 + b6 * 2 + b7;
}

fn bits_to_nibbles(bits: string) -> string {
  let mut words: string = dec.dzeros(7);
  let mut index: i32 = 0;
  while index < 7 {
    let value: i32 = aztec_nibble_value(bits, index * 4);
    words = dec.dset(words, index, value);
    index = index + 1;
  }
  return string_concat(words, "");
}

fn aztec_bit(on: bool) -> string {
  if on { return "1"; }
  return "0";
}

fn aztec_append_stuffed_word(data: string, stuffed: string, start: i32, word_size: i32) -> string {
  let mut result: string = data;
  if word_size == 4 {
    result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start)));
    result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 1)));
    result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 2)));
    result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 3)));
  } else {
    if word_size == 6 {
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 1)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 2)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 3)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 4)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 5)));
    } else {
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 1)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 2)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 3)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 4)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 5)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 6)));
      result = string_concat(result, aztec_bit(dec.bit_array_get(stuffed, start + 7)));
    }
  }
  return string_concat(result, "");
}

fn extract_message_bits(size: i32, modules: Array<i32>, erasures: Array<i32>, layers: i32, total_bits: i32) -> string {
  let mut message: string = dec.bits_zeros(total_bits);
  let mut erased: string = dec.bits_zeros(total_bits);
  let has_erasures: bool = true;
  let mut row_offset: i32 = 0;
  let mut layer: i32 = 0;
  while layer < layers {
    let layer_span: i32 = layers - layer;
    let row_size: i32 = layer_span * 4 + 9;
    let mut j: i32 = 0;
    while j < row_size {
      let column_offset: i32 = j * 2;
      let mut k: i32 = 0;
      while k < 2 {
        let top_x: i32 = layer * 2 + k;
        let top_y: i32 = layer * 2 + j;
        let right_x: i32 = layer * 2 + j;
        let right_y: i32 = size - 1 - layer * 2 - k;
        let bottom_x: i32 = size - 1 - layer * 2 - k;
        let bottom_y: i32 = size - 1 - layer * 2 - j;
        let left_x: i32 = size - 1 - layer * 2 - j;
        let left_y: i32 = layer * 2 + k;

        let i_top: i32 = row_offset + column_offset + k;
        let i_right: i32 = row_offset + row_size * 2 + column_offset + k;
        let i_bottom: i32 = row_offset + row_size * 4 + column_offset + k;
        let i_left: i32 = row_offset + row_size * 6 + column_offset + k;

        message = dec.bit_array_set(message, i_top, dec.module_bit(modules, top_y * size + top_x));
        message = dec.bit_array_set(message, i_right, dec.module_bit(modules, right_y * size + right_x));
        message = dec.bit_array_set(message, i_bottom, dec.module_bit(modules, bottom_y * size + bottom_x));
        message = dec.bit_array_set(message, i_left, dec.module_bit(modules, left_y * size + left_x));

        if has_erasures {
          if dec.erasure_bit(erasures, top_y * size + top_x) { erased = dec.bit_array_set(erased, i_top, true); }
          if dec.erasure_bit(erasures, right_y * size + right_x) { erased = dec.bit_array_set(erased, i_right, true); }
          if dec.erasure_bit(erasures, bottom_y * size + bottom_x) { erased = dec.bit_array_set(erased, i_bottom, true); }
          if dec.erasure_bit(erasures, left_y * size + left_x) { erased = dec.bit_array_set(erased, i_left, true); }
        }
        k = k + 1;
      }
      j = j + 1;
    }
    row_offset = row_offset + row_size * 8;
    layer = layer + 1;
  }
  return string_concat(message, string_concat("|", erased));
}

fn unstuff_bits(stuffed: string, word_size: i32) -> string {
  let mut ones_prefix: i32 = 127;
  if word_size == 6 { ones_prefix = 31; }
  if word_size == 4 { ones_prefix = 7; }
  let mut bits: string = "";
  let mut index: i32 = 0;
  let length: i32 = string_length(stuffed);
  while index + word_size <= length {
    let mut word: i32 = 0;
    let mut bit0: i32 = 0;
    let mut bit1: i32 = 0;
    let mut bit2: i32 = 0;
    let mut bit3: i32 = 0;
    let mut bit4: i32 = 0;
    let mut bit5: i32 = 0;
    let mut bit6: i32 = 0;
    let mut bit7: i32 = 0;
    if dec.bit_array_get(stuffed, index) { bit0 = 1; }
    if dec.bit_array_get(stuffed, index + 1) { bit1 = 1; }
    if dec.bit_array_get(stuffed, index + 2) { bit2 = 1; }
    if dec.bit_array_get(stuffed, index + 3) { bit3 = 1; }
    if word_size > 4 && dec.bit_array_get(stuffed, index + 4) { bit4 = 1; }
    if word_size > 4 && dec.bit_array_get(stuffed, index + 5) { bit5 = 1; }
    if word_size > 6 && dec.bit_array_get(stuffed, index + 6) { bit6 = 1; }
    if word_size > 6 && dec.bit_array_get(stuffed, index + 7) { bit7 = 1; }
    if word_size == 4 { word = bit0 * 8 + bit1 * 4 + bit2 * 2 + bit3; }
    if word_size == 6 { word = bit0 * 32 + bit1 * 16 + bit2 * 8 + bit3 * 4 + bit4 * 2 + bit5; }
    if word_size == 8 { word = bit0 * 128 + bit1 * 64 + bit2 * 32 + bit3 * 16 + bit4 * 8 + bit5 * 4 + bit6 * 2 + bit7; }
    let prefix: i32 = word / 2;
    let mut step: i32 = word_size;
    if prefix == 0 {
      if word_size == 4 { bits = string_concat(bits, "000"); }
      if word_size == 6 { bits = string_concat(bits, "00000"); }
      if word_size == 8 { bits = string_concat(bits, "0000000"); }
    } else {
      if prefix == ones_prefix {
        if word_size == 4 { bits = string_concat(bits, "111"); }
        if word_size == 6 { bits = string_concat(bits, "11111"); }
        if word_size == 8 { bits = string_concat(bits, "1111111"); }
        } else {
          bits = aztec_append_stuffed_word(bits, stuffed, index, word_size);
        }
    }
    index = index + step;
  }
  return string_concat(bits, "");
}

fn read_bits(bits: string, offset: i32, count: i32) -> i32 {
  let mut b0: i32 = 0;
  let mut b1: i32 = 0;
  let mut b2: i32 = 0;
  let mut b3: i32 = 0;
  let mut b4: i32 = 0;
  let mut b5: i32 = 0;
  let mut b6: i32 = 0;
  let mut b7: i32 = 0;
  let mut b8: i32 = 0;
  let mut b9: i32 = 0;
  let mut b10: i32 = 0;
  if string_byte_at(bits, offset) == 49 { b0 = 1; }
  if count > 1 && string_byte_at(bits, offset + 1) == 49 { b1 = 1; }
  if count > 2 && string_byte_at(bits, offset + 2) == 49 { b2 = 1; }
  if count > 3 && string_byte_at(bits, offset + 3) == 49 { b3 = 1; }
  if count > 4 && string_byte_at(bits, offset + 4) == 49 { b4 = 1; }
  if count > 5 && string_byte_at(bits, offset + 5) == 49 { b5 = 1; }
  if count > 6 && string_byte_at(bits, offset + 6) == 49 { b6 = 1; }
  if count > 7 && string_byte_at(bits, offset + 7) == 49 { b7 = 1; }
  if count > 8 && string_byte_at(bits, offset + 8) == 49 { b8 = 1; }
  if count > 9 && string_byte_at(bits, offset + 9) == 49 { b9 = 1; }
  if count > 10 && string_byte_at(bits, offset + 10) == 49 { b10 = 1; }
  if count == 5 { return b0 * 16 + b1 * 8 + b2 * 4 + b3 * 2 + b4; }
  if count == 8 { return b0 * 128 + b1 * 64 + b2 * 32 + b3 * 16 + b4 * 8 + b5 * 4 + b6 * 2 + b7; }
  return b0 * 1024 + b1 * 512 + b2 * 256 + b3 * 128 + b4 * 64 + b5 * 32 + b6 * 16 + b7 * 8 + b8 * 4 + b9 * 2 + b10;
}

fn append_word_bits(data: string, value: i32, word_size: i32) -> string {
  let mut result: string = data;
  let mut shift: i32 = word_size - 1;
  while shift >= 0 {
    result = string_concat(result, aztec_bit(dec.bit_test(value, shift)));
    shift = shift - 1;
  }
  return string_concat(result, "");
}

fn decode_binary_payload(bits: string) -> string {
  let length: i32 = string_length(bits);
  if length < 10 { return ""; }
  if read_bits(bits, 0, 5) != 31 { return ""; }
  let short_len: i32 = read_bits(bits, 5, 5);
  let mut offset: i32 = 10;
  let mut count: i32 = short_len;
  if short_len == 0 {
    if length < 21 { return ""; }
    count = read_bits(bits, 10, 11);
    offset = 21;
  }
  let mut output: string = "";
  let mut index: i32 = 0;
  while index < count {
    if offset + 8 > length { return ""; }
    output = string_concat(output, dec.byte_char3(read_bits(bits, offset, 8)));
    offset = offset + 8;
    index = index + 1;
  }
  return string_concat(output, "");
}

export fn decode_aztec(width: i32, height: i32, modules: Array<i32>, erasures: Array<i32>) -> string {
  if width != height { return ""; }
  let size: i32 = width;
  if size < 15 { return ""; }
  let size_rem: i32 = size - 11;
  if size_rem - size_rem / 4 * 4 != 0 { return ""; }
  let layers: i32 = size_rem / 4;
  if layers < 1 { return ""; }
  if layers > 4 { return ""; }

  let mode_bits: string = extract_mode_message(size, modules);
  let mode_words: string = bits_to_nibbles(mode_bits);
  let mode_erased: string = dec.dzeros(7);
  let corrected_mode: string = rs.rs_correct(mode_words, 5, 19, 16, mode_erased);
  if string_length(corrected_mode) == 0 { return ""; }
  let data_bits_mode: i32 = dec.dget(corrected_mode, 0) * 16 + dec.dget(corrected_mode, 1);
  let parsed_layers: i32 = data_bits_mode / 64 + 1;
  let data_words: i32 = data_bits_mode - data_bits_mode / 64 * 64 + 1;
  if parsed_layers != layers { return ""; }
  if data_words <= 0 { return ""; }
  let word_size: i32 = aztec_word_size(layers);
  let total_bits: i32 = total_aztec_bits(layers);
  let total_words: i32 = total_bits / word_size;
  if data_words > total_words { return ""; }

  let extracted: string = extract_message_bits(size, modules, erasures, layers, total_bits);
  let mut split: i32 = 0;
  while split < string_length(extracted) {
    if string_byte_at(extracted, split) == 124 {
      let message: string = string_slice(extracted, 0, split);
      let message_erasures: string = string_slice(extracted, split + 1, string_length(extracted));
      let start_pad: i32 = total_bits - total_bits / word_size * word_size;
      let mut words: string = dec.dzeros(total_words);
      let mut word_erased: string = dec.dzeros(total_words);
      let mut index: i32 = 0;
      while index < total_words {
        let bit_start: i32 = start_pad + index * word_size;
        let value: i32 = aztec_word_value(message, bit_start, word_size);
        let mut offset: i32 = 0;
        let mut erased_word: bool = false;
        while offset < word_size {
          let bit_index: i32 = bit_start + offset;
          if dec.bit_array_get(message_erasures, bit_index) {
            erased_word = true;
          }
          offset = offset + 1;
        }
        words = dec.dset(words, index, value);
        if erased_word {
          word_erased = dec.dset(word_erased, index, 1);
        }
        index = index + 1;
      }
      let ecc_words: i32 = total_words - data_words;
      let mut primitive: i32 = 67;
      let mut field_size: i32 = 64;
      if word_size == 8 {
        primitive = 301;
        field_size = 256;
      }
      let corrected: string = rs.rs_correct(words, total_words - data_words, primitive, field_size, word_erased);
      if string_length(corrected) == 0 { return ""; }
      let mut corrected_bits: string = "";
      let mut corrected_index: i32 = 0;
      while corrected_index < data_words {
        corrected_bits = append_word_bits(corrected_bits, dec.dget(corrected, corrected_index), word_size);
        corrected_index = corrected_index + 1;
      }
      let stuffed: string = string_slice(corrected_bits, 0, data_words * word_size);
      let payload_bits: string = unstuff_bits(stuffed, word_size);
      let payload: string = decode_binary_payload(payload_bits);
      return string_concat(payload, "");
    }
    split = split + 1;
  }
  return "";
}



