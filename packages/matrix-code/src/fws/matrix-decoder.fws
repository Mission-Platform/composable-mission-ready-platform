// Matrix decoder ABI graph.
//
// The graph owns the symbology dispatch boundary. The registered TypeScript
// decoder performs the codeword and Reed-Solomon work so the same implementation
// can also be used by scanner adapters that provide erasure masks. The packed
// string is returned unchanged by this small ABI stage; an empty result denotes
// an unsupported symbology.

export enum MatrixSymbologyId {
  DataMatrix = 0,
  Gs1DataMatrix = 1,
  DataMatrixRectangular = 2,
  Aztec = 3,
}

export fn decode_matrix(symbology: MatrixSymbologyId, packed: string, erasures: string) -> string {
  switch symbology {
    case DataMatrix: return packed;
    case Gs1DataMatrix: return packed;
    case DataMatrixRectangular: return packed;
    case Aztec: return packed;
    default: return "";
  }
}