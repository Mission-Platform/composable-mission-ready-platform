// Matrix decoder ABI graph.
//
// Each implementation is statically linked into this dispatcher. The public
// adapter supplies validated numeric module and erasure arrays and receives an
// ASCII decimal triplet stream containing the recovered UTF-8 bytes.
import "./matrix-decoder-datamatrix.fws" as datamatrix;
import "./matrix-decoder-aztec.fws" as aztec;

export enum MatrixSymbologyId {
  DataMatrix = 0,
  Gs1DataMatrix = 1,
  DataMatrixRectangular = 2,
  Aztec = 3,
}

export fn decode_matrix(symbology: MatrixSymbologyId, width: i32, height: i32, modules: Array<i32>, erasures: Array<i32>) -> string {
  switch symbology {
    case DataMatrix: return string_concat(datamatrix.decode_datamatrix(0, width, height, modules, erasures), "");
    case Gs1DataMatrix: return string_concat(datamatrix.decode_datamatrix(1, width, height, modules, erasures), "");
    case DataMatrixRectangular: return string_concat(datamatrix.decode_datamatrix(2, width, height, modules, erasures), "");
    case Aztec: return string_concat(aztec.decode_aztec(width, height, modules, erasures), "");
    default: return "";
  }
}
