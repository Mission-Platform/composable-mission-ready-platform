// Matrix decoder graph. Payloads cross the ABI as ASCII decimal triplets, one
// triplet per UTF-8 byte. An empty value denotes a malformed or unrecoverable
// symbol. The TypeScript adapter is deliberately limited to triplet-to-UTF-8
// materialisation and public `null` normalisation.

import "./matrix-encoder.fws" as enc;

export enum MatrixSymbologyId {
  DataMatrix = 0,
  Gs1DataMatrix = 1,
  DataMatrixRectangular = 2,
  Aztec = 3,
}

fn xor8(a: i32, b: i32) -> i32 {
  let result: i32 = 0;
  let place: i32 = 1;
  let x: i32 = a;
  let y: i32 = b;
  let index: i32 = 0;
  while index < 8 {
    let xb: i32 = x - x / 2 * 2;
    let yb: i32 = y - y / 2 * 2;
    let bit: i32 = xb + yb - 2 * xb * yb;
    result = result + bit * place;
    place = place * 2;
    x = x / 2;
    y = y / 2;
    index = index + 1;
  }
  return result;
}

fn bit_at(value: i32, shift: i32) -> bool {
  let divisor: i32 = 1;
  let index: i32 = 0;
  while index < shift {
    divisor = divisor * 2;
    index = index + 1;
  }
  return value / divisor - value / divisor / 2 * 2 == 1;
}

fn valid_modules(modules: Array<i32>, index: i32) -> bool {
  if index >= modules.length() { return true; }
  if modules[index] != 0 && modules[index] != 1 { return false; }
  return valid_modules(modules, index + 1);
}

fn rs_poly_mul(a: string, b: string, exp: string, log: string) -> string {
  let result: string = enc.bytes_zeros(string_length(a) / 3 + string_length(b) / 3 - 1);
  let i: i32 = 0;
  while i < string_length(a) / 3 {
    let av: i32 = enc.bytes_get(a, i);
    if av != 0 {
      let j: i32 = 0;
      while j < string_length(b) / 3 {
        let old: i32 = enc.bytes_get(result, i + j);
        let product: i32 = enc.gf_mul(exp, log, av, enc.bytes_get(b, j));
        result = enc.bytes_set(result, i + j, xor8(old, product));
        j = j + 1;
      }
    }
    i = i + 1;
  }
  return result;
}

fn rs_syndromes_zero(block: string, ecc: i32, exp: string, log: string) -> bool {
  let index: i32 = 0;
  while index < ecc {
    let alpha: i32 = enc.bytes_get(exp, index + 1);
    let value: i32 = 0;
    let coefficient: i32 = 0;
    while coefficient < string_length(block) / 3 {
      value = xor8(enc.gf_mul(exp, log, value, alpha), enc.bytes_get(block, coefficient));
      coefficient = coefficient + 1;
    }
    if value != 0 { return false; }
    index = index + 1;
  }
  return true;
}

fn finder_row(modules: Array<i32>, width: i32, y: i32, x: i32, end: i32, alternating: bool) -> bool {
  if x >= end { return true; }
  let expected: i32 = 1;
  let parity: i32 = x - x / 2 * 2;
  if alternating && parity == 1 { expected = 0; }
  if modules[y * width + x] != expected { return false; }
  return finder_row(modules, width, y, x + 1, end, alternating);
}

fn finder_col(modules: Array<i32>, width: i32, x: i32, y: i32, end: i32, alternating: bool) -> bool {
  if y >= end { return true; }
  let expected: i32 = 1;
  let parity: i32 = y - y / 2 * 2;
  if alternating && parity == 0 { expected = 0; }
  if modules[y * width + x] != expected { return false; }
  return finder_col(modules, width, x, y + 1, end, alternating);
}

fn valid_dm_finders(modules: Array<i32>, width: i32, height: i32, region_rows: i32, region_cols: i32, grid_cols: i32) -> bool {
  let region: i32 = 0;
  while region < grid_cols {
    let region_width: i32 = region_cols + 2;
    let left: i32 = region * region_width;
    let right: i32 = left + region_cols + 1;
    if !finder_col(modules, width, left, 0, height, false) { return false; }
    if !finder_col(modules, width, right, 0, height, true) { return false; }
    if !finder_row(modules, width, 0, left, right + 1, true) { return false; }
    if !finder_row(modules, width, height - 1, left, right + 1, false) { return false; }
    region = region + 1;
  }
  return true;
}

fn dm_extract(
  modules: Array<i32>, erasures: Array<i32>, width: i32, region_rows: i32, region_cols: i32, grid_cols: i32, total: i32
) -> string {
  let map: string = enc.dm_placement_map(region_rows, region_cols * grid_cols);
  if string_length(map) / 3 != region_rows * region_cols * grid_cols { return ""; }
  let block: string = enc.bytes_zeros(total);
  let erased: string = enc.bits_zeros(total);
  let row: i32 = 0;
  while row < region_rows {
    let column: i32 = 0;
    while column < region_cols * grid_cols {
      let placement: i32 = enc.bytes_get(map, row * region_cols * grid_cols + column);
      if placement != 999 {
        let region: i32 = column / region_cols;
        let outer_region_width: i32 = region_cols + 2;
        let region_start: i32 = region * outer_region_width;
        let x: i32 = region_start + 1 + column - region * region_cols;
        let matrix_row: i32 = row + 1;
        let module_index: i32 = matrix_row * width + x;
        let codeword: i32 = placement / 8;
        let offset: i32 = placement - codeword * 8;
        let value: i32 = enc.bytes_get(block, codeword);
        if modules[module_index] == 1 {
          let bit: i32 = 1;
          let shift: i32 = 0;
          while shift < 7 - offset { bit = bit * 2; shift = shift + 1; }
          value = value + bit;
        }
        block = enc.bytes_set(block, codeword, value);
        if erasures.length() == modules.length() && erasures[module_index] != 0 {
          erased = enc.bits_set(erased, codeword, true);
        }
      }
      column = column + 1;
    }
    row = row + 1;
  }
  return string_concat(block, erased);
}

fn decode_ascii(block: string, data: i32) -> string {
  let output: string = "";
  let index: i32 = 0;
  while index < data {
    let codeword: i32 = enc.bytes_get(block, index);
    if codeword == 129 { return output; }
    if codeword == 232 { index = index + 1; }
    else {
      if codeword >= 1 && codeword <= 128 { output = enc.bytes_push(output, codeword - 1); index = index + 1; }
      else {
        if codeword >= 130 && codeword <= 229 {
          let value: i32 = codeword - 130;
          output = enc.bytes_push(output, 48 + value / 10);
          output = enc.bytes_push(output, 48 + value - value / 10 * 10);
          index = index + 1;
        } else {
          if codeword == 235 {
            if index + 1 >= data { return ""; }
            let shifted: i32 = enc.bytes_get(block, index + 1);
            if shifted < 1 || shifted > 128 { return ""; }
            output = enc.bytes_push(output, shifted + 127);
            index = index + 2;
          } else { return ""; }
        }
      }
    }
  }
  return output;
}

// Correct a codeword block with Berlekamp-Massey and Forney. The implementation
// is intentionally byte-string based so it shares the encoder's ASCII-safe GF
// table representation. `erasures` has one bit per codeword.
fn rs_correct(block: string, ecc: i32, erasures: string, primitive: i32, size: i32) -> string {
  let exp: string = enc.field_exp_table(primitive, size);
  let log: string = enc.field_log_table(primitive, size);
  if rs_syndromes_zero(block, ecc, exp, log) { return block; }
  let count: i32 = string_length(block) / 3;
  let erasure_count: i32 = 0;
  let locator: string = enc.bytes_push("", 1);
  let position: i32 = 0;
  while position < count {
    if enc.bits_get(erasures, position) {
      erasure_count = erasure_count + 1;
      let root_index: i32 = count - 1 - position;
      let root: i32 = enc.bytes_get(exp, root_index);
      let factor: string = enc.bytes_push(enc.bytes_push("", 1), root);
      locator = rs_poly_mul(locator, factor, exp, log);
    }
    position = position + 1;
  }
  if erasure_count > ecc { return ""; }
  let syndromes: string = enc.bytes_zeros(ecc);
  let syndrome_index: i32 = 0;
  while syndrome_index < ecc {
    let alpha: i32 = enc.bytes_get(exp, syndrome_index + 1);
    let value: i32 = 0;
    let coefficient: i32 = 0;
    while coefficient < count {
      value = xor8(enc.gf_mul(exp, log, value, alpha), enc.bytes_get(block, coefficient));
      coefficient = coefficient + 1;
    }
    syndromes = enc.bytes_set(syndromes, syndrome_index, value);
    syndrome_index = syndrome_index + 1;
  }
  let forney: string = syndromes;
  position = 0;
  while position < count {
    if enc.bits_get(erasures, position) {
      let root: i32 = enc.bytes_get(exp, count - 1 - position);
      let j: i32 = 0;
      while j < ecc - 1 {
        let next: i32 = xor8(enc.gf_mul(exp, log, enc.bytes_get(forney, j), root), enc.bytes_get(forney, j + 1));
        forney = enc.bytes_set(forney, j, next);
        j = j + 1;
      }
    }
    position = position + 1;
  }
  let rounds: i32 = ecc - erasure_count;
  let lambda: string = enc.bytes_push("", 1);
  let previous: string = enc.bytes_push("", 1);
  let errors: i32 = 0;
  let shift: i32 = 1;
  let previous_discrepancy: i32 = 1;
  let round: i32 = 0;
  while round < rounds {
    let discrepancy: i32 = enc.bytes_get(forney, round);
    let index: i32 = 1;
    while index <= errors && index < string_length(lambda) / 3 {
      let term: i32 = enc.gf_mul(exp, log, enc.bytes_get(lambda, index), enc.bytes_get(forney, round - index));
      discrepancy = xor8(discrepancy, term);
      index = index + 1;
    }
    if discrepancy == 0 { shift = shift + 1; }
    else {
      let saved: string = lambda;
      let inverse: i32 = enc.bytes_get(exp, size - 1 - enc.bytes_get(log, previous_discrepancy));
      let scale: i32 = enc.gf_mul(exp, log, discrepancy, inverse);
      let required: i32 = shift + string_length(previous) / 3;
      while string_length(lambda) / 3 < required { lambda = enc.bytes_push(lambda, 0); }
      index = 0;
      while index < string_length(previous) / 3 {
        let old: i32 = enc.bytes_get(lambda, index + shift);
        let add: i32 = enc.gf_mul(exp, log, scale, enc.bytes_get(previous, index));
        lambda = enc.bytes_set(lambda, index + shift, xor8(old, add));
        index = index + 1;
      }
      let twice_errors: i32 = errors * 2;
      if twice_errors <= round {
        previous = saved;
        errors = round + 1 - errors;
        previous_discrepancy = discrepancy;
        shift = 1;
      } else { shift = shift + 1; }
    }
    round = round + 1;
  }
  if errors * 2 + erasure_count > ecc { return ""; }
  let sigma: string = rs_poly_mul(lambda, locator, exp, log);
  let found: string = enc.bits_zeros(count);
  let found_count: i32 = 0;
  let index: i32 = 0;
  while index < count {
    let order: i32 = size - 1;
    let exponent: i32 = index - index / order * order;
    let inverse: i32 = enc.bytes_get(exp, order - exponent);
    let sum: i32 = 0;
    let power: i32 = 1;
    let coefficient: i32 = 0;
    while coefficient < string_length(sigma) / 3 {
      sum = xor8(sum, enc.gf_mul(exp, log, enc.bytes_get(sigma, coefficient), power));
      power = enc.gf_mul(exp, log, power, inverse);
      coefficient = coefficient + 1;
    }
    if sum == 0 { found = enc.bits_set(found, count - 1 - index, true); found_count = found_count + 1; }
    index = index + 1;
  }
  if found_count != errors + erasure_count { return ""; }
  let omega: string = enc.bytes_zeros(ecc);
  index = 0;
  while index < ecc {
    let value: i32 = 0;
    let tap: i32 = 0;
    while tap <= index && tap < string_length(sigma) / 3 {
      value = xor8(value, enc.gf_mul(exp, log, enc.bytes_get(sigma, tap), enc.bytes_get(syndromes, index - tap)));
      tap = tap + 1;
    }
    omega = enc.bytes_set(omega, index, value);
    index = index + 1;
  }
  let corrected: string = block;
  position = 0;
  while position < count {
    if enc.bits_get(found, position) {
      let order: i32 = size - 1;
      let locator_exponent: i32 = count - 1 - position;
      locator_exponent = locator_exponent - locator_exponent / order * order;
      let locator_value: i32 = enc.bytes_get(exp, locator_exponent);
      let inverse: i32 = enc.bytes_get(exp, size - 1 - enc.bytes_get(log, locator_value));
      let omega_value: i32 = 0;
      let power: i32 = 1;
      index = 0;
      while index < ecc {
        omega_value = xor8(omega_value, enc.gf_mul(exp, log, enc.bytes_get(omega, index), power));
        power = enc.gf_mul(exp, log, power, inverse);
        index = index + 1;
      }
      let derivative: i32 = 0;
      power = 1;
      index = 0;
      while index < string_length(sigma) / 3 {
        let remainder: i32 = index - index / 2 * 2;
        if remainder == 1 { derivative = xor8(derivative, enc.gf_mul(exp, log, enc.bytes_get(sigma, index), power)); }
        if index >= 1 { power = enc.gf_mul(exp, log, power, inverse); }
        index = index + 1;
      }
      if derivative == 0 { return ""; }
      let magnitude: i32 = enc.gf_mul(exp, log, omega_value, enc.bytes_get(exp, size - 1 - enc.bytes_get(log, derivative)));
      corrected = enc.bytes_set(corrected, position, xor8(enc.bytes_get(corrected, position), magnitude));
    }
    position = position + 1;
  }
  if !rs_syndromes_zero(corrected, ecc, exp, log) { return ""; }
  return corrected;
}

fn decode_datamatrix(modules: Array<i32>, erasures: Array<i32>, width: i32, height: i32, rectangular: bool) -> string {
  let region_rows: i32 = height - 2;
  let region_cols: i32 = width - 2;
  let grid_cols: i32 = 1;
  let data: i32 = 0;
  let ecc: i32 = 0;
  if rectangular {
    if width == 18 && height == 8 { region_rows = 6; region_cols = 16; data = 5; ecc = 7; }
    else { if width == 32 && height == 8 { region_rows = 6; region_cols = 14; grid_cols = 2; data = 10; ecc = 11; }
    else { if width == 26 && height == 12 { region_rows = 10; region_cols = 24; data = 16; ecc = 14; }
    else { if width == 36 && height == 12 { region_rows = 10; region_cols = 16; grid_cols = 2; data = 22; ecc = 18; }
    else { if width == 36 && height == 16 { region_rows = 14; region_cols = 16; grid_cols = 2; data = 32; ecc = 24; }
    else { if width == 48 && height == 16 { region_rows = 14; region_cols = 22; grid_cols = 2; data = 49; ecc = 28; }
    else { return ""; } } } } } }
  } else {
    if width != height { return ""; }
    if width == 10 { data = 3; ecc = 5; }
    else { if width == 12 { data = 5; ecc = 7; }
    else { if width == 14 { data = 8; ecc = 10; }
    else { if width == 16 { data = 12; ecc = 12; }
    else { if width == 18 { data = 18; ecc = 14; }
    else { if width == 20 { data = 22; ecc = 18; }
    else { if width == 22 { data = 30; ecc = 20; }
    else { if width == 24 { data = 36; ecc = 24; }
    else { if width == 26 { data = 44; ecc = 28; }
    else { return ""; } } } } } } } } }
  }
  if !valid_dm_finders(modules, width, height, region_rows, region_cols, grid_cols) { return ""; }
  let total_codewords: i32 = data + ecc;
  let extracted: string = dm_extract(modules, erasures, width, region_rows, region_cols, grid_cols, total_codewords);
  if string_length(extracted) != total_codewords * 4 { return ""; }
  let block_end: i32 = total_codewords * 3;
  let flags_end: i32 = total_codewords * 4;
  let block: string = string_slice(extracted, 0, block_end);
  let flags: string = string_slice(extracted, block_end, flags_end);
  let corrected: string = rs_correct(block, ecc, flags, 301, 256);
  if string_length(corrected) == 0 { return ""; }
  return decode_ascii(corrected, data);
}

export fn decode_matrix(symbology: MatrixSymbologyId, width: i32, height: i32, modules: Array<i32>, erasures: Array<i32>) -> string {
  if width <= 0 || height <= 0 || modules.length() != width * height || !valid_modules(modules, 0) { return ""; }
  if erasures.length() != 0 && erasures.length() != modules.length() { return ""; }
  switch symbology {
    case DataMatrix: return decode_datamatrix(modules, erasures, width, height, false);
    case Gs1DataMatrix: return decode_datamatrix(modules, erasures, width, height, false);
    case DataMatrixRectangular: return decode_datamatrix(modules, erasures, width, height, true);
    // Compact Aztec is implemented in the second decoder graph pass. Do not
    // treat its modules as Data Matrix input.
    case Aztec: return "";
    default: return "";
  }
}