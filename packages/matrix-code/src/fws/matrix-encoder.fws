// Matrix encoder ABI graph.
//
// Each symbology implementation is compiled as its own Forge module and then
// statically linked into this thin dispatcher. Keeping the public entry tiny
// avoids the self-hosted bootstrap stack overflow that the previous monolithic
// encoder source triggered during Vite tests.
import "./matrix-encoder-core.fws" as core;
import "./matrix-encoder-datamatrix.fws" as datamatrix;
import "./matrix-encoder-aztec.fws" as aztec;

export enum MatrixSymbologyId {
  DataMatrix = 0,
  Gs1DataMatrix = 1,
  DataMatrixRectangular = 2,
  Aztec = 3,
}

export fn encode_matrix(symbology: MatrixSymbologyId, payload: string) -> string {
  switch symbology {
    case DataMatrix: return datamatrix.encode_datamatrix_square(payload, false);
    case Gs1DataMatrix: return datamatrix.encode_datamatrix_square(payload, true);
    case DataMatrixRectangular: return datamatrix.encode_datamatrix_rect(payload);
    case Aztec: return aztec.encode_aztec(payload);
    default: return "";
  }
}

// Test-only diagnostic hooks preserved for matrix-encoder.spec.ts; they alias
// the shared GF(256) and Data Matrix ASCII helpers used by encode_matrix.
export fn __test_gf256_exp(index: i32) -> i32 {
  return core.bytes_get(core.field_exp_table(301, 256), index);
}

export fn __test_gf256_mul(a: i32, b: i32) -> i32 {
  return core.gf_mul(core.field_exp_table(301, 256), core.field_log_table(301, 256), a, b);
}

export fn __test_string_byte_at(data: string, index: i32) -> i32 {
  return string_byte_at(data, index);
}

export fn __test_byte_char3(value: i32) -> string {
  return core.byte_char3(value);
}

export fn __test_ascii_codewords(data: string) -> string {
  return core.ascii_codewords(data);
}

export fn __test_bytes_get(data: string, index: i32) -> i32 {
  return core.bytes_get(data, index);
}

export fn __test_dm_10x10_message(data: string) -> string {
  return datamatrix.dm_test_10x10_message(data);
}

export fn __test_pad_codeword_at(position: i32) -> i32 {
  return core.pad_codeword_at(position);
}

export fn __test_dm_place_10x10(data: string) -> string {
  return datamatrix.dm_test_place_10x10(data);
}
