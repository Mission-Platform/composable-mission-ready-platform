{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:ts": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:wasm": {
      "inputs": ["build.sh", "docker/**", "src/wasm/**"],
      "outputs": ["src/generated/**", "dist/wasm/**"],
      "cache": true
    },
    "build:wasm:clean": {
      "cache": false
    }
  }
}
