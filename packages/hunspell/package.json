{
  "name": "@mission-platform/hunspell",
  "version": "0.3.2",
  "description": "Hunspell spell checker compiled to WebAssembly via Emscripten",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hunspell.js"
    },
    "./worker": {
      "types": "./dist/worker/hunspell.worker.d.ts",
      "import": "./dist/hunspell.worker.js"
    },
    "./src/dictionaries/*": "./src/dictionaries/*"
  },
  "main": "./dist/hunspell.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/dictionaries"
  ],
  "scripts": {
    "build:check": "vue-tsc -b",
    "build:bundle": "vite build",
    "build:types": "vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "vite build --watch",
    "build:wasm": "bash build.sh",
    "build:wasm:clean": "bash build.sh --no-cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "monaco-editor": "catalog:code"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:testing",
    "@vue/test-utils": "catalog:vue",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
