{
  "name": "@mission-platform/hunspell",
  "version": "0.2.0",
  "description": "Hunspell spell checker compiled to WebAssembly via Emscripten",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/hunspell.d.ts",
      "import": "./dist/hunspell.js"
    },
    "./worker": {
      "types": "./dist/hunspell.worker.d.ts",
      "import": "./dist/hunspell.worker.js"
    },
    "./src/dictionaries/*": "./src/dictionaries/*"
  },
  "main": "./dist/hunspell.js",
  "types": "./dist/hunspell.d.ts",
  "files": [
    "dist",
    "src/dictionaries"
  ],
  "scripts": {
    "build": "pnpm build:wasm && pnpm build:ts",
    "build:ts": "vue-tsc -b && vite build && vue-tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:wasm": "bash build.sh",
    "build:wasm:clean": "bash build.sh --no-cache",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@vue/tsconfig": "catalog:vue",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vue-tsc": "catalog:vue"
  }
}
