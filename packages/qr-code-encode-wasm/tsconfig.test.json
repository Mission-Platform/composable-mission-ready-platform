{
  "extends": "@mission-platform/typescript-config/base",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "node",
      "vitest/globals",
      "@mission-platform/typescript-config/client"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.d.ts"]
}
