{
  "extends": "@mission-platform/typescript-config/test",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.spec.ts"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.stories.tsx"]
}
