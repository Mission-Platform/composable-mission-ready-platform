{
  "name": "@mission-platform/flint-stdlib",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Class-free Flint standard-library sources and deterministic collection contracts",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "flint"
  ],
  "scripts": {
    "type-check": "tsc --project tsconfig.build.json --noEmit",
    "build": "node --experimental-strip-types ../../../scripts/build-package.ts",
    "build:bundle": "vite build",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing"
  },
  "dependencies": {
    "@mission-platform/flint-runtime": "workspace:*"
  }
}
