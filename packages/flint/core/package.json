{
  "name": "@mission-platform/flint",
  "version": "1.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Flint v1 language contracts, bootstrap parser, and conformance fixtures",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/self-hosted/flint"
  ],
  "scripts": {
    "type-check": "tsc --project tsconfig.build.json --noEmit",
    "build": "node --experimental-strip-types ../../../scripts/build-package.ts",
    "build:bundle": "vite build",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/flint-analysis": "workspace:*",
    "@mission-platform/flint-ast": "workspace:*",
    "@mission-platform/flint-backend-metal-arm": "workspace:*",
    "@mission-platform/flint-backend-metal-native": "workspace:*",
    "@mission-platform/flint-backend-web-wasm": "workspace:*",
    "@mission-platform/flint-c-abi": "workspace:*",
    "@mission-platform/flint-linker": "workspace:*",
    "@mission-platform/flint-machir": "workspace:*",
    "@mission-platform/flint-macro": "workspace:*",
    "@mission-platform/flint-parser": "workspace:*",
    "@mission-platform/flint-regex": "workspace:*",
    "@mission-platform/flint-sonir": "workspace:*",
    "@mission-platform/flint-types": "workspace:*",
    "@mission-platform/flint-wasm": "workspace:*"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing"
  }
}
