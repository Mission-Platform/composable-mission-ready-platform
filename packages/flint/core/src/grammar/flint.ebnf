(*
 * Flint v1 grammar
 *
 * This file is the checked-in grammar contract for the TypeScript frontend,
 * language service, and later self-hosted lexer/parser stages. It describes
 * significant tokens; comments remain in the token stream for documentation
 * consumers but are ignored between grammar terminals by the parser.
 *
 * Source offsets are UTF-16 code-unit offsets in the TypeScript frontend. A
 * self-hosted byte scanner must convert its UTF-8 offsets before emitting the
 * shared token payload. All ranges are half-open [start, end).
 *)

source                  = { trivia }, ( regular-source | component-source ), { trivia }, eof ;
regular-source          = compilation-unit ;
component-source        = script-region, template-region, style-region ;
script-region           = "<script>", { ? any source character other than the matching closing tag ? }, "</script>" ;
template-region         = "<template>", { ? any source character other than the matching closing tag ? }, "</template>" ;
style-region            = "<style>", { ? any source character other than the matching closing tag ? }, "</style>" ;
compilation-unit        = legacy-module | { top-level-declaration } ;
legacy-module           = "module", identifier, "{", { top-level-declaration }, "}" ;
top-level-declaration   = import-declaration
                        | foreign-capability-declaration
                        | opaque-foreign-type-declaration
                        | macro-declaration
                        | comptime-statement
                        | struct-declaration
                        | record-declaration
                        | enum-declaration
                        | interface-declaration
                        | function-declaration
                        | unsupported-class-declaration ;

(* Lexical grammar *)
trivia                  = whitespace | line-comment | block-comment ;
whitespace              = { horizontal-whitespace | line-terminator } ;
horizontal-whitespace  = ? Unicode WhiteSpace code point other than CR or LF ? ;
line-terminator         = "\n" | "\r" | "\r\n" ;
line-comment            = "//", { ? any source character other than LF ? } ;
block-comment           = "/*", { ? any source character, including line terminators ? }, "*/" ;
identifier              = identifier-start, { identifier-part } ;
identifier-start        = letter | "_" ;
identifier-part         = identifier-start | decimal-digit ;
letter                  = "A" .. "Z" | "a" .. "z" ;
decimal-digit           = "0" .. "9" ;
hex-digit               = decimal-digit | "A" .. "F" | "a" .. "f" ;
binary-digit            = "0" | "1" ;
octal-digit             = "0" .. "7" ;

decimal-literal         = decimal-digit, { [ "_" ], decimal-digit } ;
hex-literal             = ( "0x" | "0X" ), hex-digit, { [ "_" ], hex-digit } ;
binary-literal          = ( "0b" | "0B" ), binary-digit, { [ "_" ], binary-digit } ;
octal-literal           = ( "0o" | "0O" ), octal-digit, { [ "_" ], octal-digit } ;

integer-literal         = hex-literal | binary-literal | octal-literal | decimal-literal ;
exponent-part           = ( "e" | "E" ), [ "+" | "-" ], decimal-digit, { [ "_" ], decimal-digit } ;
float-literal           = decimal-literal, ( ".", decimal-literal, [ exponent-part ] | exponent-part ) ;
numeric-type-suffix     = [ "_" ], ( "i8" | "i32" | "i64" | "u8" | "u32" | "u64" | "f32" | "f64"
                        | "c_char" | "c_uchar" | "c_short" | "c_ushort" | "c_int"
                        | "c_uint" | "c_long" | "c_ulong" | "c_longlong" | "c_ulonglong"
                        | "c_size" | "c_ssize" | "c_float" | "c_double" | "c_void" ) ;

numeric-literal         = ( float-literal | integer-literal ), [ numeric-type-suffix ] ;
integer                 = numeric-literal ;
string                  = "\"", { string-character | escape-sequence }, "\"" ;
string-character        = ? any source character other than quote, backslash, CR, or LF ? ;
escape-sequence         = "\\", ( "\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | unicode-escape ) ;
unicode-escape          = "u", hex-digit, hex-digit, hex-digit, hex-digit ;

(* The scanner uses longest match for operators before one-character forms. *)
operator                = "!=" | "&&" | "==" | "||" | "<=" | ">=" | "->" | "=>" | "::" | "|>"
                        | "!" | "%" | "*" | "+" | "-" | "/" | "<" | ">" | "=" | "&" | "?" ;
punctuation             = "{" | "}" | "(" | ")" | "[" | "]" | ":" | ";"
                        | "," | "|" | "." | "#" | "@" ;

keyword                 = "as" | "capability" | "case" | "catch" | "class"
                        | "comptime" | "constructor" | "default" | "derive" | "do" | "else" | "enum"
                        | "emit" | "emits" | "event" | "events" | "extends" | "export" | "for" | "foreign"
                        | "from" | "fn" | "if" | "impl"
                        | "import" | "inline" | "interface" | "iter" | "let" | "macro" | "mut"
                        | "likely" | "loop" | "match" | "model" | "module" | "new"
                        | "noinline" | "opaque" | "record" | "return" | "struct" | "switch" | "throw"
                        | "property" | "properties" | "readonly" | "setup" | "trait" | "try" | "type"
                        | "unlikely" | "while" | "yield" ;
boolean-literal         = "true" | "false" ;

(* Lexical recovery *)
(*
 * An unterminated block comment consumes through EOF and reports
 * FLINT-LEX-003. An unterminated string consumes through EOF and reports
 * FLINT-LEX-001. Invalid escapes report FLINT-LEX-004; raw CR, LF, or CRLF in a
 * string reports FLINT-LEX-005. Any other source character consumes one source
 * code unit and reports FLINT-LEX-002. Recovery always advances and the scanner
 * emits one eof token after the final source offset.
 *
 * An unclosed delimiter reaching end-of-input reports FLINT-PARSE-004 at the
 * opening delimiter span, allowing the parser to maintain AST continuity.
 *)
eof                     = ? zero-width end-of-input token ? ;

(* Imports and declarations *)
import-declaration      = capability-import | source-import ;
capability-import       = "import", "capability", string, "as", identifier,
                          parameter-list, "->", type, ";" ;
source-import           = "import", [ "module" ], ( legacy-source-import | named-source-import | namespace-source-import ) ;
legacy-source-import    = string, "as", identifier, ";" ;
named-source-import     = "{", identifier, { [ "as", identifier ], ",", identifier }, "}", "from", string, ";" ;
namespace-source-import = "*", "as", identifier, "from", string, ";" ;
foreign-capability-declaration = "foreign", string, "capability", string, "{",
                                 { foreign-function-declaration }, "}" ;
foreign-function-declaration   = "fn", identifier, parameter-list, "->", type, ";" ;
opaque-foreign-type-declaration = "opaque", "foreign", "type", identifier, ";" ;
parameter-list          = "(", [ parameters ], ")" ;
parameters              = parameter, { ",", parameter } ;
parameter               = [ "mut" ], identifier, ":", type ;

attribute-annotation    = ( "@", identifier, [ call-arguments ] )
                        | ( "#", "[", identifier, [ "(", [ attribute-argument, { ",", attribute-argument } ], ")" ], "]" ) ;
attribute-argument      = identifier | integer | string | expression ;

macro-declaration       = ( "macro" | "derive" ), identifier, parameter-list, block ;

function-declaration    = { attribute-annotation }, { function-modifier }, "fn", identifier,
                          [ generic-parameters ], parameter-list, "->", type, block ;
function-modifier       = "export" | "iter" | "inline" | "noinline" ;
generic-parameters      = "<", generic-parameter, { ",", generic-parameter }, ">" ;
generic-parameter       = identifier, [ ":", identifier, { "+", identifier } ] ;

struct-attribute        = attribute-annotation ;
struct-declaration      = { attribute-annotation }, "struct", identifier, [ generic-parameters ], "{",
                          { struct-field }, "}" ;
record-declaration      = { attribute-annotation }, "record", identifier, [ generic-parameters ], "{",
                          { struct-field }, "}" ;
struct-field            = identifier, ":", type, ( "," | ";" ) ;
enum-declaration        = { attribute-annotation }, [ "export" ], "enum", identifier, [ generic-parameters ],
                          "{", [ enum-variant, { ",", enum-variant }, [ "," ] ], "}" ;
enum-variant            = identifier, [ parameter-list ], [ "=", [ "-" ], integer ] ;
interface-declaration   = { attribute-annotation }, "interface", identifier, [ generic-parameters ], "{",
                          { interface-function }, "}" ;
interface-function      = "fn", identifier, [ generic-parameters ], parameter-list,
                          "->", type, ";" ;

(* Statements *)
block                   = "{", { statement }, "}" ;
statement               = let-statement
                        | assignment-statement
                        | return-statement
                        | yield-statement
                        | iterator-loop-statement
                        | if-statement
                        | while-statement
                        | do-while-statement
                        | switch-statement
                        | comptime-statement
                        | unsupported-exception-statement
                        | unsupported-for-statement
                        | expression-statement ;
let-statement           = "let", [ "mut" ], identifier, ":", type, "=", expression, ";" ;
assignment-statement    = identifier, [ "[", expression, "]" ], "=", expression, ";" ;
return-statement        = "return", [ expression ], ";" ;
yield-statement         = "yield", expression, ";" ;
iterator-loop-statement = "loop", identifier, "=", expression, block ;
if-statement            = "if", [ "likely" | "unlikely" ], expression, block,
                          [ "else", block ] ;
while-statement         = "while", expression, block ;
do-while-statement      = "do", block, "while", expression, ";" ;
comptime-statement      = "comptime", block ;
switch-statement        = "switch", expression, "{", { switch-arm }, "}" ;
switch-arm              = "case", switch-case-value, ":", switch-arm-body
                        | "default", ":", switch-arm-body ;
switch-case-value       = [ "-" ], ( integer | identifier ) ;
switch-arm-body         = block | statement ;
for-clause              = let-clause | assignment-clause | expression ;
let-clause              = "let", identifier, ":", type, "=", expression ;
assignment-clause       = identifier, "=", expression ;
unsupported-for-statement = "for", "(", [ for-clause ], ";", expression, ";",
                            [ for-clause ], ")", block ;
unsupported-exception-statement = ( "throw" | "try" | "catch" ),
                                 { ? token other than semicolon or closing brace ? }, [ ";" ] ;

(* Types and expressions *)
type                    = fixed-array-type | type-name ;
fixed-array-type        = "[", type, ";", integer, "]" ;
type-name               = [ "&", [ "mut" ] ], type-atom, [ "<", type, { ",", type }, ">" ] ;
type-atom               = primitive-type | identifier ;
primitive-type          = "bool" | "bytes" | "f32" | "f64" | "i8" | "i32" | "i64"
                        | "string" | "u8" | "u32" | "u64" | "unit"
                        | "c_char" | "c_uchar" | "c_short" | "c_ushort" | "c_int"
                        | "c_uint" | "c_long" | "c_ulong" | "c_longlong" | "c_ulonglong"
                        | "c_size" | "c_ssize" | "c_float" | "c_double" | "c_void" ;

expression              = binary-expression ;
binary-expression       = unary-expression, { binary-operator, unary-expression } ;
binary-operator         = "||" | "&&" | "==" | "!=" | "<" | "<=" | ">" | ">="
                        | "+" | "-" | "*" | "/" | "%" ;
unary-expression        = ( "!" | "-" ), unary-expression | postfix-expression ;
postfix-expression      = primary-expression, { member-access | index-access } ;
member-access           = ".", member-name, [ call-arguments ] ;
member-name             = identifier | "iter" | "next" ;
index-access            = "[", expression, "]" ;
primary-expression      = integer
                        | string
                        | boolean-literal
                        | identifier-expression
                        | comptime-expression
                        | function-value
                        | array-literal
                        | vector-literal
                        | match-expression ;
comptime-expression     = "comptime", ( block | expression ) ;
identifier-expression   = identifier, [ qualified-constructor | call-arguments
                        | record-initializer ] ;
qualified-constructor   = "::", identifier, [ call-arguments ] ;
function-value          = "fn", identifier ;
call-arguments          = "(", [ expression, { ",", expression } ], ")" ;
record-initializer      = "{", identifier, ":", expression, { ",", identifier, ":", expression }, "}" ;
array-literal           = "[", [ expression, { ",", expression } ], "]" ;
vector-literal          = "vector", "[", [ expression, { ",", expression } ], "]" ;
match-expression        = "match", expression, "{", { [ "case" ], match-arm, [ "," ] }, "}" ;
match-arm               = pattern, "=>", expression ;
pattern                 = "_" | integer | string | boolean-literal
                        | identifier, [ "::", identifier ], [ "(", [ identifier, { ",", identifier } ], ")" ] ;

(* Unsupported declarations are consumed for stable recovery and report
 * FLINT-PARSE-052; they are not part of the accepted AST contract. *)
unsupported-class-declaration = ( "class" | "constructor" | "extends" | "impl" | "new" | "trait" ),
                                { ? token until a balanced declaration boundary ? } ;
