{
  "name": "@mission-platform/vite-plugin-forge",
  "version": "1.2.1",
  "license": "BSD-4-Clause",
  "description": "A Vite plugin that compiles framework-neutral @mission-platform/forge-jsx components to React, Astro, Vue 3, Solid, Svelte, or Web Components at build time",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./compiler/ast": {
      "types": "./dist/compiler/ast.d.ts",
      "import": "./dist/compiler/ast.js"
    },
    "./compiler/ast.js": {
      "types": "./dist/compiler/ast.d.ts",
      "import": "./dist/compiler/ast.js"
    },
    "./compiler/oxc": {
      "types": "./dist/compiler/oxc.d.ts",
      "import": "./dist/compiler/oxc.js"
    },
    "./compiler/oxc.js": {
      "types": "./dist/compiler/oxc.d.ts",
      "import": "./dist/compiler/oxc.js"
    },
    "./compiler/optimize": {
      "types": "./dist/compiler/optimize.d.ts",
      "import": "./dist/compiler/optimize.js"
    },
    "./compiler/optimize.js": {
      "types": "./dist/compiler/optimize.d.ts",
      "import": "./dist/compiler/optimize.js"
    },
    "./compiler/hoist-static": {
      "types": "./dist/compiler/hoist-static.d.ts",
      "import": "./dist/compiler/hoist-static.js"
    },
    "./compiler/hoist-static.js": {
      "types": "./dist/compiler/hoist-static.d.ts",
      "import": "./dist/compiler/hoist-static.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "bench": "FORGE_BENCH_RUN=1 FORGE_BENCH_IMPLEMENTATION=oxc FORGE_BENCH_OUTPUT=benchmarks/oxc-comparison.json vitest run src/compiler/benchmark.spec.ts --reporter=dot",
    "bench:baseline": "FORGE_BENCH_RUN=1 FORGE_BENCH_IMPLEMENTATION=typescript vitest run src/compiler/benchmark.spec.ts --reporter=dot",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/forge-jsx": "workspace:*",
    "@mission-platform/forge-plugin-api": "workspace:*",
    "@mission-platform/forge-router-plugin-api": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:svelte",
    "oxc-parser": "catalog:compiler",
    "svelte": "catalog:svelte",
    "typescript": "catalog:typescript"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-vue-jsx": "catalog:vue",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "solid-js": "catalog:solid",
    "svelte2tsx": "catalog:build",
    "tsdown": "catalog:build",
    "unplugin-vue": "catalog:build",
    "vite": "catalog:vite",
    "vite-plugin-solid": "catalog:solid",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
