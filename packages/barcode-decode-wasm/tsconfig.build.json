{
  "extends": "@mission-platform/typescript-config/base",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    // The wasm-pack glue in `src/wasm/` is plain JS; allow it so the wrapper can
    // import the bindings, but do not type-check the generated files.
    "allowJs": true,
    "checkJs": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "types": ["node", "@mission-platform/typescript-config/client"],
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.d.ts"]
}
