{
  "name": "@mission-platform/tokens",
  "version": "1.0.0",
  "license": "BSD-4-Clause",
  "description": "CSS design tokens and SCSS theme definitions for Mission Platform",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": "./dist/tokens.js",
    "./scss/tokens": "./src/tokens.scss",
    "./scss/themes/light": "./src/scss/themes/light/index.scss",
    "./scss/themes/dark": "./src/scss/themes/dark/index.scss",
    "./scss/mixins": "./src/scss/_mixins.scss",
    "./scss/breakpoints-mixins": "./src/scss/_breakpoints.scss",
    "./scss/breakpoints-utilities": "./src/scss/_breakpoints-utilities.scss",
    "./scss/size": "./src/scss/_size.scss",
    "./scss/a11y": "./src/scss/_a11y.scss"
  },
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "files": [
    "dist",
    "src/**/*.scss",
    "src/fonts/**/*.ttf",
    "tokens/*.tokens.json"
  ],
  "scripts": {
    "build:bundle": "vite build",
    "build:types": "tsc --project tsconfig.build.json --declaration --declarationDir dist --emitDeclarationOnly --noEmit false --rootDir src",
    "build:watch": "vite build --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/i18n-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-tokens": "workspace:*",
    "eslint": "catalog:eslint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "sass-embedded": "catalog:vite",
    "stylelint": "catalog:stylelint",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite"
  }
}
