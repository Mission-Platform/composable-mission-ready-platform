{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:bundle", "build:types"],
      "inputs": ["tokens/**", "src/**", "vite.config.ts", "tsconfig*.json", ".config/**"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "build:bundle": {
      "dependsOn": ["^build"],
      "inputs": ["tokens/**", "src/**", "vite.config.ts", "tsconfig*.json", ".config/**"],
      "outputs": ["dist/**", "src/generated/**", "!dist/**/*.d.ts", "!dist/**/*.d.ts.map"]
    },
    "build:types": {
      "dependsOn": ["^build", "build:bundle"],
      "inputs": ["tokens/**", "src/**", "vite.config.ts", "tsconfig*.json", ".config/**"],
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map"]
    }
  }
}
