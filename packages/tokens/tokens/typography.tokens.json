{
  "$description": "Composite typography styles for Mission Platform. Each token is a DTCG `typography` value composed from the primitive font tokens in font.tokens.json plus the `marginBlock`/`marginInline` logical-margin steps from spacing.tokens.json. The variants mirror the `ForgeTypography` component variants and resolve, at generation time, to the matching `--mp-typography-<variant>-*` CSS custom properties (which themselves reference the primitive `--mp-font-*`, `--mp-line-height-*`, `--mp-letter-spacing-*` and `--mp-spacing-*` tokens).",
  "typography": {
    "$type": "typography",
    "display": {
      "$description": "Hero / marketing headline.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.5xl}",
        "fontWeight": "{font.weight.bold}",
        "lineHeight": "{line-height.tight}",
        "letterSpacing": "{letter-spacing.tight}",
        "marginBlock": "{spacing.3}",
        "marginInline": "{spacing.0}"
      }
    },
    "h1": {
      "$description": "Heading level 1.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.4xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{line-height.tight}",
        "letterSpacing": "{letter-spacing.tight}",
        "marginBlock": "{spacing.3}",
        "marginInline": "{spacing.0}"
      }
    },
    "h2": {
      "$description": "Heading level 2.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.3xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{line-height.tight}",
        "letterSpacing": "{letter-spacing.tight}",
        "marginBlock": "{spacing.2}",
        "marginInline": "{spacing.0}"
      }
    },
    "h3": {
      "$description": "Heading level 3.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.2xl}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{line-height.snug}",
        "letterSpacing": "{letter-spacing.tight}",
        "marginBlock": "{spacing.2}",
        "marginInline": "{spacing.0}"
      }
    },
    "h4": {
      "$description": "Heading level 4.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.xl}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{line-height.snug}",
        "letterSpacing": "{letter-spacing.tight}",
        "marginBlock": "{spacing.2}",
        "marginInline": "{spacing.0}"
      }
    },
    "h5": {
      "$description": "Heading level 5.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{line-height.snug}",
        "letterSpacing": "{letter-spacing.normal}",
        "marginBlock": "{spacing.1}",
        "marginInline": "{spacing.0}"
      }
    },
    "h6": {
      "$description": "Heading level 6.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
        "fontWeight": "{font.weight.medium}",
        "lineHeight": "{line-height.normal}",
        "letterSpacing": "{letter-spacing.normal}",
        "marginBlock": "{spacing.1}",
        "marginInline": "{spacing.0}"
      }
    },
    "body-lg": {
      "$description": "Body large — introductory / lead text.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.lg}",
        "fontWeight": "{font.weight.regular}",
        "lineHeight": "{line-height.relaxed}",
        "letterSpacing": "{letter-spacing.normal}",
        "marginBlock": "{spacing.1}",
        "marginInline": "{spacing.0}"
      }
    },
    "body-md": {
      "$description": "Body medium — default body copy.",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.md}",
