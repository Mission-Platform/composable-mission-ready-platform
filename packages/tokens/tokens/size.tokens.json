{
  "$description": "Unified component size scale for Mission Platform (2xs → 2xl). All rem values are relative to the 14px root font-size.",
  "size": {
    "$description": "Unified component size scale (2xs → 2xl) covering font, padding, gap, radius, icon, shadow, leading, height and width. Each subgroup is one facet of a component at a given size step, so a `sm` button reads its font, padding, radius, etc. from the matching `sm` key across these subgroups.",
    "font": {
      "$description": "Per-size component font-size (text within a sized control).",
      "$type": "dimension",
      "2xs": { "$value": "0.643rem" },
      "xs": { "$value": "0.786rem" },
      "sm": { "$value": "0.929rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.143rem" },
      "xl": { "$value": "1.286rem" },
      "2xl": { "$value": "1.714rem" }
    },
    "leading": {
      "$description": "Per-size line-height (unitless) for text within a sized control.",
      "$type": "number",
      "2xs": { "$value": 1.25 },
      "xs": { "$value": 1.25 },
      "sm": { "$value": 1.375 },
      "md": { "$value": 1.5 },
      "lg": { "$value": 1.5 },
      "xl": { "$value": 1.5 },
      "2xl": { "$value": 1.375 }
    },
    "pad-block": {
      "$description": "Per-size block (top/bottom) padding for sized controls.",
      "$type": "dimension",
      "2xs": { "$value": "0.143rem" },
      "xs": { "$value": "0.286rem" },
      "sm": { "$value": "0.429rem" },
      "md": { "$value": "0.571rem" },
      "lg": { "$value": "0.714rem" },
      "xl": { "$value": "0.857rem" },
      "2xl": { "$value": "1.143rem" }
    },
    "pad-inline": {
      "$description": "Per-size inline (left/right) padding for sized controls.",
      "$type": "dimension",
      "2xs": { "$value": "0.286rem" },
      "xs": { "$value": "0.571rem" },
      "sm": { "$value": "0.714rem" },
      "md": { "$value": "0.857rem" },
      "lg": { "$value": "1.143rem" },
      "xl": { "$value": "1.429rem" },
      "2xl": { "$value": "1.714rem" }
    },
    "gap": {
      "$description": "Per-size internal gap between elements (e.g. icon-to-label) in sized controls; also reused as the margin scale.",
      "$type": "dimension",
      "sm": { "$value": "0.429rem" },
      "md": { "$value": "0.571rem" }
    },
    "radius": {
      "$description": "Per-size corner radius for sized controls.",
      "$type": "dimension",
      "md": { "$value": "0.429rem" }
    },
    "icon": {
      "$description": "Per-size icon dimension (square) for sized controls.",
      "$type": "dimension",
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.143rem" }
    },
    "height": {
      "$description": "Per-size control height (e.g. button / input height).",
      "$type": "dimension",
      "2xs": { "$value": "1.429rem" },
      "xs": { "$value": "1.714rem" },
      "sm": { "$value": "2rem" },
      "md": { "$value": "2.571rem" },
      "lg": { "$value": "2.857rem" },
      "xl": { "$value": "3.429rem" },
      "2xl": { "$value": "4rem" }
    },
    "width": {
      "$description": "Per-size container/overlay max-width (e.g. modal width); 2xs/xs fall back to full viewport width.",
      "$type": "dimension",
      "2xs": { "$value": "100vw" },
      "xs": { "$value": "100vw" },
      "sm": { "$value": "34.286rem" },
      "md": { "$value": "45.714rem" },
      "lg": { "$value": "85.714rem" },
      "xl": { "$value": "114.286rem" },
      "2xl": { "$value": "171.429rem" }
    },
    "checkable": {
      "$description": "Exact track, thumb, switch, and rating dimensions used by checkable controls.",
      "control": { "$value": "18px" },
      "indicator": { "$value": "8px" },
      "2xs": {
        "slider-track-height": { "$value": "0.1875rem" },
        "slider-thumb-size": { "$value": "0.625rem" },
        "rating-font-size": { "$value": "0.625rem" },
        "switch": { "width": { "$value": "24px" }, "height": { "$value": "14px" }, "padding": { "$value": "2px" }, "thumb-size": { "$value": "10px" }, "translate": { "$value": "12px" } }
      },
      "xs": {
        "slider-track-height": { "$value": "0.25rem" },
        "slider-thumb-size": { "$value": "0.75rem" },
        "rating-font-size": { "$value": "0.875rem" },
        "switch": { "width": { "$value": "28px" }, "height": { "$value": "16px" }, "padding": { "$value": "2px" }, "thumb-size": { "$value": "12px" }, "translate": { "$value": "14px" } }
      },
      "sm": {
        "slider-track-height": { "$value": "0.25rem" },
        "slider-thumb-size": { "$value": "0.875rem" },
        "rating-font-size": { "$value": "1rem" },
        "switch": { "width": { "$value": "32px" }, "height": { "$value": "18px" }, "padding": { "$value": "2px" }, "thumb-size": { "$value": "14px" }, "translate": { "$value": "16px" } }
      },
      "md": {
        "slider-track-height": { "$value": "0.375rem" },
        "slider-thumb-size": { "$value": "1.125rem" },
        "rating-font-size": { "$value": "1.5rem" },
        "switch": { "width": { "$value": "40px" }, "height": { "$value": "22px" }, "padding": { "$value": "2px" }, "thumb-size": { "$value": "18px" }, "translate": { "$value": "20px" } }
      },
      "lg": {
        "slider-track-height": { "$value": "0.5rem" },
        "slider-thumb-size": { "$value": "1.5rem" },
        "rating-font-size": { "$value": "2rem" },
        "switch": { "width": { "$value": "52px" }, "height": { "$value": "28px" }, "padding": { "$value": "3px" }, "thumb-size": { "$value": "22px" }, "translate": { "$value": "26px" } }
      },
      "xl": {
        "slider-track-height": { "$value": "0.625rem" },
        "slider-thumb-size": { "$value": "1.875rem" },
        "rating-font-size": { "$value": "2.5rem" },
        "switch": { "width": { "$value": "60px" }, "height": { "$value": "32px" }, "padding": { "$value": "3px" }, "thumb-size": { "$value": "26px" }, "translate": { "$value": "30px" } }
      },
      "2xl": {
        "slider-track-height": { "$value": "0.75rem" },
        "slider-thumb-size": { "$value": "2.25rem" },
        "rating-font-size": { "$value": "3rem" },
        "switch": { "width": { "$value": "72px" }, "height": { "$value": "38px" }, "padding": { "$value": "4px" }, "thumb-size": { "$value": "30px" }, "translate": { "$value": "36px" } }
      }
    }
  }
}
