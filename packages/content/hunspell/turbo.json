{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:check"]
    },
    "build:wasm": {
      "cache": false,
      "outputs": ["src/wasm/**"]
    },
    "build:wasm:clean": {
      "cache": false,
      "outputs": ["src/wasm/**"]
    }
  }
}
