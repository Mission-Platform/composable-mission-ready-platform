/**
 * Registered inherited custom properties for forge-wysiwyg-toolbar overrides.
 *
 * Kept in a dedicated partial so the component module can stay focused on
 * selectors while @property initial values remain token-backed defaults.
 */
@property --forge-wysiwyg-toolbar-editor-toolbar-gap {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-gap);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-padding {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-padding);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-border-width {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-border-width);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-border {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-border);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-surface {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-surface);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-group-gap {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-group-gap);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-group-padding-inline-end {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-group-padding-inline-end);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-group-border-width {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-group-border-width);
}
@property --forge-wysiwyg-toolbar-editor-toolbar-group-border {
  syntax: "*";
  inherits: true;
  initial-value: var(--mp-editor-toolbar-group-border);
}
@layer mp.content {
  .wysiwyg-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--forge-wysiwyg-toolbar-editor-toolbar-gap, var(--mp-editor-toolbar-gap));
    padding: var(--forge-wysiwyg-toolbar-editor-toolbar-padding, var(--mp-editor-toolbar-padding));
    border-bottom: var(--forge-wysiwyg-toolbar-editor-toolbar-border-width, var(--mp-editor-toolbar-border-width)) solid var(--forge-wysiwyg-toolbar-editor-toolbar-border, var(--mp-editor-toolbar-border));
    background-color: var(--forge-wysiwyg-toolbar-editor-toolbar-surface, var(--mp-editor-toolbar-surface));
  }
  .wysiwyg-toolbar__group {
    display: flex;
    align-items: center;
    gap: var(--forge-wysiwyg-toolbar-editor-toolbar-group-gap, var(--mp-editor-toolbar-group-gap));
  }
  .wysiwyg-toolbar__group:not(:last-child) {
    padding-right: var(--forge-wysiwyg-toolbar-editor-toolbar-group-padding-inline-end, var(--mp-editor-toolbar-group-padding-inline-end));
    border-right: var(--forge-wysiwyg-toolbar-editor-toolbar-group-border-width, var(--mp-editor-toolbar-group-border-width)) solid var(--forge-wysiwyg-toolbar-editor-toolbar-group-border, var(--mp-editor-toolbar-group-border));
  }
  .wysiwyg-toolbar__group--end {
    margin-left: auto;
    border-right: none;
  }
}
