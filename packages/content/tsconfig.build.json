{
  "extends": "@mission-platform/typescript-config/forge-neutral-library",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "types": ["@mission-platform/typescript-config/client", "@mission-platform/forge/jsx-globals"],
    "rootDir": "./src",
    "declarationDir": "./dist",
    "emitDeclarationOnly": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["src/**/*.stories.ts", "src/**/*.stories.tsx", "src/**/*.spec.ts"]
}
