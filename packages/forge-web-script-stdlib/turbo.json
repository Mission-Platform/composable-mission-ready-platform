{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:check", "build:bundle", "build:types"]
    },
    "build:bundle": {
      "dependsOn": ["^build", "build:check"]
    },
    "build:types": {
      "dependsOn": ["^build", "build:bundle"]
    }
  }
}