{
  "name": "@mission-platform/typography",
  "version": "1.0.0",
  "license": "BSD-4-Clause",
  "description": "Write-once typography components for Mission Platform, authored with @mission-platform/forge and compiled to Vue, React, Svelte, Solid, and Web Components",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/web-components/**/*.js"
  ],
  "exports": {
    ".": {
      "mp:vue": {
        "types": "./dist/vue/index.d.ts",
        "import": "./dist/vue/index.js"
      },
      "mp:react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      },
      "mp:solid": {
        "types": "./dist/solid/index.d.ts",
        "import": "./dist/solid/index.js"
      },
      "mp:svelte": {
        "types": "./dist/svelte/index.d.ts",
        "import": "./dist/svelte/index.js"
      },
      "mp:web-component": {
        "types": "./dist/web-components/index.d.ts",
        "import": "./dist/web-components/index.js"
      },
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./*": {
      "mp:vue": {
        "types": "./dist/vue/index.d.ts",
        "import": "./dist/vue/*.js"
      },
      "mp:react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/*.js"
      },
      "mp:solid": {
        "types": "./dist/solid/index.d.ts",
        "import": "./dist/solid/*.js"
      },
      "mp:web-component": {
        "types": "./dist/web-components/index.d.ts",
        "import": "./dist/web-components/*.js"
      },
      "mp:svelte": {
        "types": "./dist/svelte/index.d.ts",
        "import": "./dist/svelte/*.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prebuild": "node --experimental-strip-types ../../scripts/extract-package-docs.ts --package=.",
    "build:forge": "node --experimental-strip-types ../../scripts/build-forge.ts --target forge",
    "build:react": "node --experimental-strip-types ../../scripts/build-forge.ts --target react",
    "build:vue": "node --experimental-strip-types ../../scripts/build-forge.ts --target vue",
    "build:svelte": "node --experimental-strip-types ../../scripts/build-forge.ts --target svelte",
    "build:solid": "node --experimental-strip-types ../../scripts/build-forge.ts --target solid",
    "build:web-components": "node --experimental-strip-types ../../scripts/build-forge.ts --target web-components",
    "build": "node --experimental-strip-types ../../scripts/build-forge.ts",
    "build:check": "tsc --project tsconfig.build.json --noEmit",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.scss\"",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@mission-platform/forge": "workspace:*",
    "@mission-platform/tokens": "workspace:*"
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "solid-js": "^1.9.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/stylelint-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/storybook-framework": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@mission-platform/forge-plugin-react": "workspace:*",
    "@mission-platform/forge-plugin-solid": "workspace:*",
    "@mission-platform/forge-plugin-svelte": "workspace:*",
    "@mission-platform/forge-plugin-vue": "workspace:*",
    "@mission-platform/forge-plugin-web-components": "workspace:*",
    "@storybook/vue3-vite": "catalog:storybook",
    "@tsdown/css": "catalog:build",
    "@types/node": "catalog:typescript",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-vue": "catalog:vue",
    "@vitejs/plugin-vue-jsx": "catalog:vue",
    "@vitest/coverage-v8": "catalog:testing",
    "eslint": "catalog:eslint",
    "jsdom": "catalog:testing",
    "lit": "catalog:webcomponents",
    "postcss-html": "catalog:stylelint",
    "postcss-scss": "catalog:stylelint",
    "prettier": "catalog:prettier",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "sass-embedded": "catalog:vite",
    "solid-js": "catalog:solid",
    "svelte": "catalog:svelte",
    "storybook": "catalog:storybook",
    "stylelint": "catalog:stylelint",
    "stylelint-config-recommended-vue": "catalog:stylelint",
    "stylelint-config-standard-scss": "catalog:stylelint",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vue": "catalog:vue"
  }
}
