{
  "name": "flint-vscode",
  "displayName": "Flint",
  "description": "Flint language support backed by the shared Flint language server.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "publisher": "mission-platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/mission-platform/composable-mission-ready-platform"
  },
  "icon": "./resources/flint.png",
  "license": "BSD-4-Clause",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:flint",
    "onDebugResolve:flint"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "flint",
        "aliases": [
          "Flint",
          "flint"
        ],
        "extensions": [
          ".flint",
          ".flt"
        ],
        "icon": {
          "light": "./resources/flint.svg",
          "dark": "./resources/flint.svg"
        },
        "configuration": "./language-configuration.json",
        "firstLine": "^#!.*\\bflint\\b"
      }
    ],
    "grammars": [
      {
        "language": "flint",
        "scopeName": "source.flint",
        "path": "./syntaxes/flint.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "flint",
        "label": "Flint",
        "languages": [
          "flint"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Flint program to launch."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Working directory for the Flint runtime."
              },
              "runtimePath": {
                "type": "string",
                "description": "Flint runtime executable. Defaults to flint.runtimePath."
              },
              "runtimeArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the Flint runtime."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the Flint program."
              },
              "env": {
                "type": "object",
                "description": "Environment variables passed to the Flint runtime."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop before executing the first statement."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "flint",
            "request": "launch",
            "name": "Launch Flint",
            "program": "${file}",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Flint: Launch",
            "description": "Launch the active Flint file.",
            "body": {
              "type": "flint",
              "request": "launch",
              "name": "Launch Flint",
              "program": "${file}",
              "cwd": "${workspaceFolder}"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "languageIds": [
          "flint"
        ]
      }
    ],
    "configuration": {
      "title": "Flint",
      "properties": {
        "flint.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to launch the Flint language server. Node.js 24 or newer is required."
        },
        "flint.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional path override for the Flint language-server entrypoint. The packaged server is used when empty."
        },
        "flint.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to the Flint language server."
        },
        "flint.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Disable LSP tracing.",
            "Log LSP messages.",
            "Log LSP messages and payload details."
          ],
          "default": "off",
          "description": "Trace level for the Flint language server."
        },
        "flint.dapPath": {
          "type": "string",
          "default": "",
          "description": "Optional path override for the Flint debug adapter entrypoint. The packaged adapter is used when empty."
        },
        "flint.runtimePath": {
          "type": "string",
          "default": "",
          "description": "Flint runtime executable used by the debugger."
        },
        "flint.runtimeArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the Flint runtime by the debugger."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm run compile && node --experimental-strip-types scripts/stage-server.ts",
    "compile": "tsc --project tsconfig.build.json",
    "type-check": "tsc --project tsconfig.json --noEmit",
    "check:packaging": "node --experimental-strip-types scripts/check-staged-server.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "package": "pnpm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/flint-dap": "workspace:*",
    "@mission-platform/flint-lsp": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "@types/vscode": "^1.137.0",
    "@vscode/vsce": "4.0.0",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  }
}
