{
  "extends": "@mission-platform/typescript-config/library",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@forge-example/runtime.fws": ["./src/runtime.fws.d.ts"]
    },
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "vite.config.ts"]
}