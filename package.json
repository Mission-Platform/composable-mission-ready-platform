{
  "name": "mission-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "i18n:extract": "pnpm --filter @mission-platform/scripts i18n:extract",
    "deploy:my-care-notes": "turbo run deploy --filter=@mission-platform/my-care-notes",
    "deploy:my-care-notes:staging": "turbo run deploy:staging --filter=@mission-platform/my-care-notes",
    "preview:my-care-notes": "pnpm --filter @mission-platform/my-care-notes cf:dev",
    "version:my-care-notes": "turbo run version --filter=@mission-platform/my-care-notes",
    "version:my-care-notes:staging": "turbo run version:staging --filter=@mission-platform/my-care-notes",
    "deploy:website": "turbo run deploy --filter=@mission-platform/website",
    "deploy:website:staging": "turbo run deploy:staging --filter=@mission-platform/website",
    "preview:website": "pnpm --filter @mission-platform/website cf:dev",
    "version:website": "turbo run version --filter=@mission-platform/website",
    "version:website:staging": "turbo run version:staging --filter=@mission-platform/website"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "js-yaml": "catalog:",
    "turbo": "^2.9.16",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
