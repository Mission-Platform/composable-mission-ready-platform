{
  "name": "mission-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "i18n:extract": "pnpm --filter @mission-platform/scripts i18n:extract",
    "storybook": "pnpm exec turbo run --filter @mission-platform/storybook storybook",
    "storybook-react": "pnpm exec turbo run --filter @mission-platform/storybook-react storybook",
    "chromatic:deploy": "pnpm exec turbo run chromatic:deploy",
    "build": "pnpm exec turbo run build",
    "build:force": "pnpm exec turbo run build --force",
    "test": "pnpm exec turbo run test",
    "lint": "pnpm exec turbo run lint",
    "lint:fix": "pnpm exec turbo run lint:fix",
    "lint:style": "pnpm exec turbo run lint:style",
    "lint:style:fix": "pnpm exec turbo run lint:style:fix",
    "format": "pnpm exec turbo run format",
    "format:write": "pnpm exec turbo run format:write"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:utilities",
    "@commitlint/cli": "catalog:utilities",
    "@commitlint/config-conventional": "catalog:utilities",
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@vue/compiler-sfc": "catalog:vue",
    "husky": "catalog:utilities",
    "js-yaml": "catalog:",
    "turbo": "catalog:utilities",
    "wrangler": "catalog:cloudflare"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578"
}
