{
  "name": "mission-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:config": "pnpm --filter @mission-platform/eslint-config --filter @mission-platform/prettier-config --filter @mission-platform/stylelint-config --filter @mission-platform/postcss-config --parallel build",
    "build:assets": "pnpm --filter @mission-platform/tokens --filter @mission-platform/icons --parallel build",
    "build:packages": "pnpm --filter @mission-platform/components --filter @mission-platform/breakpoints --filter @mission-platform/i18n --filter @mission-platform/map --filter @mission-platform/hunspell --parallel build",
    "build:apps": "pnpm --filter @mission-platform/storybook --filter @mission-platform/my-care-notes --parallel build",
    "build": "pnpm build:config && pnpm build:assets && pnpm build:packages && pnpm build:apps",
    "lint": "pnpm -r --parallel run lint",
    "lint:fix": "pnpm -r --parallel run lint --fix",
    "lint:style": "pnpm -r --parallel run lint:style",
    "lint:style:fix": "pnpm -r --parallel run lint:style --fix",
    "format": "pnpm -r --parallel run format",
    "storybook": "pnpm --filter @mission-platform/storybook storybook"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
