{
  "name": "mission-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint",
    "i18n:extract": "pnpm --filter @mission-platform/scripts i18n:extract",
    "storybook": "pnpm exec turbo run --filter @mission-platform/storybook storybook",
    "build": "pnpm exec turbo run build",
    "test": "pnpm exec turbo run test",
    "lint": "pnpm exec turbo run lint",
    "lint:fix": "pnpm exec turbo run lint:fix",
    "lint:style": "pnpm exec turbo run lint:style",
    "lint:style:fix": "pnpm exec turbo run lint:style:fix",
    "format": "pnpm exec turbo run format",
    "format:write": "pnpm exec turbo run format:write"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "husky": "^9.1.7",
    "js-yaml": "catalog:",
    "turbo": "^2.10.0",
    "wrangler": "catalog:"
  },
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620"
