{
  "name": "mission-platform",
  "private": true,
  "license": "BSD-4-Clause",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "commitlint": "commitlint",
    "dev:docs": "pnpm exec turbo run dev --filter @mission-platform/docs",
    "dev:website": "pnpm exec turbo run dev --filter @mission-platform/website",
    "dev:my-care-notes": "pnpm exec turbo run dev --filter @mission-platform/my-care-notes",
    "dev:service-monitor": "pnpm exec turbo run dev --filter @mission-platform/service-monitor",
    "storybook:vue": "STORYBOOK_FRAMEWORK=vue pnpm exec turbo run storybook --filter @mission-platform/storybook -- -p 6006",
    "storybook:react": "STORYBOOK_FRAMEWORK=react pnpm exec turbo run storybook --filter @mission-platform/storybook -- -p 6007",
    "storybook:solid": "STORYBOOK_FRAMEWORK=solid pnpm exec turbo run storybook --filter @mission-platform/storybook -- -p 6008",
    "storybook:svelte": "STORYBOOK_FRAMEWORK=svelte pnpm exec turbo run storybook --filter @mission-platform/storybook -- -p 6009",
    "storybook:web-component": "STORYBOOK_FRAMEWORK=web-component pnpm exec turbo run storybook --filter @mission-platform/storybook -- -p 6010",
    "chromatic:deploy": "pnpm exec turbo run chromatic:deploy",
    "build": "pnpm exec turbo run build",
    "build:package": "node --experimental-strip-types scripts/package-task.ts build",
    "build:check": "pnpm exec turbo run build:check",
    "build:apps": "pnpm exec turbo run build --filter=\"./apps/*\"",
    "bench": "pnpm exec turbo run bench",
    "build:force": "pnpm exec turbo run build --force",
    "docs:generate": "pnpm exec turbo run docs:generate --filter=@mission-platform/scripts",
    "build-storybook:vue": "STORYBOOK_FRAMEWORK=vue pnpm exec turbo run build-storybook --filter @mission-platform/storybook",
    "build-storybook:react": "STORYBOOK_FRAMEWORK=react pnpm exec turbo run build-storybook --filter @mission-platform/storybook",
    "build-storybook:solid": "STORYBOOK_FRAMEWORK=solid pnpm exec turbo run build-storybook --filter @mission-platform/storybook",
    "build-storybook:svelte": "STORYBOOK_FRAMEWORK=svelte pnpm exec turbo run build-storybook --filter @mission-platform/storybook",
    "build-storybook:web-component": "STORYBOOK_FRAMEWORK=web-component pnpm exec turbo run build-storybook --filter @mission-platform/storybook",
    "test": "pnpm exec turbo run test",
    "test:package": "node --experimental-strip-types scripts/package-task.ts test",
    "i18n:extract": "pnpm exec turbo run i18n:extract",
    "lint": "pnpm exec turbo run lint",
    "lint:fix": "pnpm exec turbo run lint:fix",
    "lint:style": "pnpm exec turbo run lint:style",
    "lint:style:fix": "pnpm exec turbo run lint:style:fix",
    "format": "pnpm exec turbo run format",
    "format:write": "pnpm exec turbo run format:write",
    "gen": "pnpm exec turbo gen",
    "gen:package": "pnpm exec turbo gen package",
    "validate": "pnpm exec turbo run validate:component-properties --filter=@mission-platform/scripts",
    "validate:locales": "pnpm exec turbo run validate:locales --filter=@mission-platform/scripts --",
    "validate:exports": "pnpm exec turbo run validate:exports --filter=@mission-platform/scripts --",
    "validate:component-properties": "pnpm exec turbo run validate:component-properties --filter=@mission-platform/scripts --",
    "validate:inventory": "pnpm exec turbo run validate:inventory --filter=@mission-platform/scripts --",
    "validate:framework": "pnpm exec turbo run validate:framework --filter=@mission-platform/scripts --",
    "validate:app": "pnpm exec turbo run validate:app --filter=@mission-platform/scripts --",
    "validate:target": "pnpm exec turbo run validate:target --filter=@mission-platform/scripts --",
    "validate:runtime": "pnpm exec turbo run validate:runtime --filter=@mission-platform/scripts --",
    "visual:parity": "pnpm exec turbo run visual:parity --filter=@mission-platform/scripts --",
    "test:runtime-validation": "pnpm exec turbo run test:runtime-validation --filter=@mission-platform/scripts --",
    "worktree:list": "node --experimental-strip-types scripts/worktree-manager.ts list",
    "worktree:setup": "node --experimental-strip-types scripts/worktree-manager.ts setup",
    "worktree:create": "node --experimental-strip-types scripts/worktree-manager.ts create",
    "worktree:remove": "node --experimental-strip-types scripts/worktree-manager.ts remove",
    "project:setup": "node --experimental-strip-types scripts/github-project-manager.ts setup",
    "project:status": "node --experimental-strip-types scripts/github-project-manager.ts status",
    "project:board": "node --experimental-strip-types scripts/github-project-manager.ts board",
    "project:plan": "node --experimental-strip-types scripts/github-project-manager.ts plan"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:utilities",
    "@commitlint/cli": "catalog:utilities",
    "@commitlint/config-conventional": "catalog:utilities",
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "husky": "catalog:utilities",
    "oxc-parser": "catalog:compiler",
    "@turbo/gen": "catalog:utilities",
    "turbo": "catalog:utilities",
    "wrangler": "catalog:cloudflare",
    "yaml-language-server": "catalog:utilities",
    "stylelint-lsp": "catalog:utilities",
    "vscode-langservers-extracted": "catalog:utilities",
    "typescript": "catalog:typescript"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
