# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file; editors stop looking at parent directories.
root = true

# ── Defaults for all files ──────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ── Vue single-file components ───────────────────────────────────────────────
[*.vue]
indent_size = 2

# ── TypeScript / JavaScript ──────────────────────────────────────────────────
[*.{ts,tsx,js,mjs,cjs}]
indent_size = 2

# ── JSON / JSONC ─────────────────────────────────────────────────────────────
[*.{json,jsonc}]
indent_size = 2

# ── YAML ─────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── SCSS / CSS ───────────────────────────────────────────────────────────────
[*.{scss,css}]
indent_size = 2

# ── Markdown — preserve trailing spaces (line-break syntax) ──────────────────
[*.md]
trim_trailing_whitespace = false

# ── Makefiles require real tabs ───────────────────────────────────────────────
[Makefile]
indent_style = tab
