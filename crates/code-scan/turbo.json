{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "command": [
        "sh",
        "-c",
        "wasm-pack build . --target bundler --release --weak-refs --reference-types --no-pack --panic-unwind --out-dir ../../packages/code-scan-wasm/src/wasm --out-name code-scan"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.turbo/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/code-scan/**",
        "!$TURBO_ROOT$/crates/code-scan/.turbo/**",
        "$TURBO_ROOT$/crates/qr-code-decode/**",
        "$TURBO_ROOT$/crates/qr-code-common/**",
        "$TURBO_ROOT$/crates/matrix-code-decode/**",
        "$TURBO_ROOT$/crates/matrix-code-common/**",
        "$TURBO_ROOT$/crates/barcode-decode/**",
        "$TURBO_ROOT$/crates/barcode-common/**",
        "$TURBO_ROOT$/crates/gs1-databar-decode/**",
        "$TURBO_ROOT$/crates/gs1-databar-common/**",
        "$TURBO_ROOT$/crates/pdf417-decode/**",
        "$TURBO_ROOT$/crates/pdf417-common/**",
        "$TURBO_ROOT$/crates/maxicode-decode/**",
        "$TURBO_ROOT$/crates/maxicode-common/**",
        "!$TURBO_ROOT$/crates/qr-code-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/qr-code-common/.turbo/**",
        "!$TURBO_ROOT$/crates/matrix-code-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/matrix-code-common/.turbo/**",
        "!$TURBO_ROOT$/crates/barcode-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/barcode-common/.turbo/**",
        "!$TURBO_ROOT$/crates/gs1-databar-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/gs1-databar-common/.turbo/**",
        "!$TURBO_ROOT$/crates/pdf417-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/pdf417-common/.turbo/**",
        "!$TURBO_ROOT$/crates/maxicode-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/maxicode-common/.turbo/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/code-scan-wasm/src/wasm/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "command": [
        "wasm-pack",
        "test",
        "--node",
        "--release",
        "."
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.turbo/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/code-scan/**",
        "!$TURBO_ROOT$/crates/code-scan/.turbo/**",
        "$TURBO_ROOT$/crates/qr-code-decode/**",
        "$TURBO_ROOT$/crates/qr-code-common/**",
        "$TURBO_ROOT$/crates/matrix-code-decode/**",
        "$TURBO_ROOT$/crates/matrix-code-common/**",
        "$TURBO_ROOT$/crates/barcode-decode/**",
        "$TURBO_ROOT$/crates/barcode-common/**",
        "$TURBO_ROOT$/crates/gs1-databar-decode/**",
        "$TURBO_ROOT$/crates/gs1-databar-common/**",
        "$TURBO_ROOT$/crates/pdf417-decode/**",
        "$TURBO_ROOT$/crates/pdf417-common/**",
        "$TURBO_ROOT$/crates/maxicode-decode/**",
        "$TURBO_ROOT$/crates/maxicode-common/**",
        "!$TURBO_ROOT$/crates/qr-code-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/qr-code-common/.turbo/**",
        "!$TURBO_ROOT$/crates/matrix-code-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/matrix-code-common/.turbo/**",
        "!$TURBO_ROOT$/crates/barcode-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/barcode-common/.turbo/**",
        "!$TURBO_ROOT$/crates/gs1-databar-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/gs1-databar-common/.turbo/**",
        "!$TURBO_ROOT$/crates/pdf417-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/pdf417-common/.turbo/**",
        "!$TURBO_ROOT$/crates/maxicode-decode/.turbo/**",
        "!$TURBO_ROOT$/crates/maxicode-common/.turbo/**"
      ],
      "outputs": []
    }
  }
}
