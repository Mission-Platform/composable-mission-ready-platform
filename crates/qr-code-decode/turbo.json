{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "command": [
        "sh",
        "-c",
        "wasm-pack build . --target bundler --release --weak-refs --reference-types --no-pack --out-dir ../../packages/qr-code-decode-wasm/src/wasm --out-name qr-code-decode"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.turbo/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/qr-code-decode/**",
        "!$TURBO_ROOT$/crates/qr-code-decode/.turbo/**",
        "$TURBO_ROOT$/crates/qr-code-common/**",
        "!$TURBO_ROOT$/crates/qr-code-common/.turbo/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/packages/qr-code-decode-wasm/src/wasm/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "command": [
        "wasm-pack",
        "test",
        "--node",
        "--release",
        "."
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.turbo/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/.cargo/config.toml",
        "$TURBO_ROOT$/crates/qr-code-decode/**",
        "!$TURBO_ROOT$/crates/qr-code-decode/.turbo/**",
        "$TURBO_ROOT$/crates/qr-code-common/**",
        "!$TURBO_ROOT$/crates/qr-code-common/.turbo/**"
      ],
      "outputs": []
    }
  }
}
