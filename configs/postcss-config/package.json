{
  "name": "@mission-platform/postcss-config",
  "version": "0.1.2",
  "license": "BSD-4-Clause",
  "description": "Shared PostCSS configuration for all Mission Platform packages and apps",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "peerDependencies": {
    "postcss": ">=8.0.0"
  },
  "dependencies": {
    "autoprefixer": "catalog:vite"
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "eslint": "catalog:eslint",
    "postcss": "catalog:vite",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript"
  }
}
