{
  "name": "@mission-platform/eslint-config",
  "version": "1.0.1",
  "license": "BSD-4-Clause",
  "description": "Shared ESLint flat configuration for all Mission Platform packages and apps",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "peerDependencies": {
    "eslint": ">=10.0.0",
    "typescript": ">=5.0.0"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "catalog:eslint",
    "@typescript-eslint/parser": "catalog:eslint",
    "eslint-config-prettier": "catalog:eslint",
    "eslint-config-turbo": "catalog:eslint",
    "eslint-import-resolver-typescript": "catalog:eslint",
    "eslint-plugin-i18next": "catalog:i18next",
    "eslint-plugin-import-x": "catalog:eslint",
    "eslint-plugin-sonarjs": "catalog:eslint",
    "eslint-plugin-unicorn": "catalog:eslint",
    "eslint-plugin-vue": "catalog:eslint",
    "eslint-plugin-vuejs-accessibility": "catalog:eslint",
    "typescript-eslint": "catalog:eslint",
    "vue-eslint-parser": "catalog:eslint"
  },
  "devDependencies": {
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript"
  }
}
