{
  "name": "@mission-platform/forge-plugin-solid",
  "version": "0.1.0",
  "license": "BSD-4-Clause",
  "description": "Solid output plugin and build adapter for the Forge component compiler",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@mission-platform/forge-plugin-api": "workspace:*",
    "typescript": "catalog:typescript",
    "vite-plugin-solid": "catalog:solid"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/tsdown-config": "workspace:*",
    "@mission-platform/typescript-config": "workspace:*",
    "@mission-platform/vite-config": "workspace:*",
    "@types/node": "catalog:typescript",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:build",
    "vite": "catalog:vite",
    "vitest": "catalog:testing"
  }
}
