{
  "name": "@mission-platform/scripts",
  "private": true,
  "version": "0.0.0",
  "license": "BSD-4-Clause",
  "type": "module",
  "scripts": {
    "docs:generate": "node --experimental-strip-types extract-package-docs.ts --all",
    "validate:exports": "node validate-package-exports.mjs",
    "validate:component-properties": "node --experimental-strip-types validate-component-property-declarations.ts",
    "validate:inventory": "node --experimental-strip-types runtime-validation/cli.ts inventory",
    "validate:framework": "node --experimental-strip-types runtime-validation/cli.ts framework",
    "validate:app": "node --experimental-strip-types runtime-validation/cli.ts app",
    "validate:target": "node --experimental-strip-types runtime-validation/cli.ts target",
    "validate:runtime": "node --experimental-strip-types runtime-validation/cli.ts full",
    "visual:parity": "node --experimental-strip-types visual-parity/cli.ts",
    "test:runtime-validation": "pnpm --filter @mission-platform/components exec vitest run --config ../../../scripts/runtime-validation/vitest.config.ts",
    "test": "vitest run --test-timeout 60000",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/markdown": "catalog:eslint",
    "@mission-platform/eslint-config": "workspace:*",
    "@mission-platform/forge-plugin-api": "workspace:*",
    "@mission-platform/forge-plugin-react": "workspace:*",
    "@mission-platform/forge-plugin-solid": "workspace:*",
    "@mission-platform/forge-plugin-svelte": "workspace:*",
    "@mission-platform/forge-plugin-vue": "workspace:*",
    "@mission-platform/forge-plugin-web-components": "workspace:*",
    "@mission-platform/forge-web-script": "workspace:*",
    "@mission-platform/prettier-config": "workspace:*",
    "@mission-platform/vite-plugin-forge": "workspace:*",
    "@types/node": "catalog:typescript",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "catalog:eslint",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "catalog:prettier",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
